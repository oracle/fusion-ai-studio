        "name": "GetPersonStockHistory",
        "description": "Returns global stock-grant history for the supplied worker person Id and assignment Id.",
        "operationType": "GET",
        "resourcePath": "/hcmRestApi/resources/11.13.18.05:9/personStocks?finder=findByAssignmentIdPersonIdGlobalHistory;AssignmentId={assignmentId},PersonId={personId},GetGlobalHistory=undefined&fields=TradingSymbol,GrantName,ExpirationDate,ExercisableShares,GrantTypeMeaning,OriginalGrantDate,OriginalGrantPrice,OriginalSharesGranted,TotalShares,UnvestedShares,VestedShares,VestDate,StockPriceCurrencyCode,EstimatedStockPrice&onlyData=true",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "assignmentId",
            "dataType": "string",
            "description": "Worker assignment Id used in the stock-history finder.",
            "id": 2,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "personId",
            "dataType": "string",
            "description": "Worker person Id used in the stock-history finder.",
            "id": 3,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
        "sampleQueries": [
          {
            "description": "Sample worker stock history response.",
            "query": [
              {
                "TradingSymbol": "<trading symbol>",
                "GrantName": "<grant name>",
                "ExpirationDate": "<expiration date>",
                "ExercisableShares": "<exercisable shares>",
                "GrantTypeMeaning": "<grant type meaning>",
                "OriginalGrantDate": "<original grant date>",
                "OriginalGrantPrice": "<original grant price>",
                "OriginalSharesGranted": "<original shares granted>",
                "TotalShares": "<total shares>",
                "UnvestedShares": "<unvested shares>",
