      {
        "name": "GetCurrentIndividualCompensation",
        "description": "Returns the employee's current individual compensation records, including future records, as of the supplied system effective date.",
        "operationType": "GET",
        "resourcePath": "/hcmRestApi/resources/11.13.18.05:9/individualCompensationDetails?finder=findGlobalCurrentCompByAssignmentIdandDate;AssignmentId={assignmentId},PersonId={personId},SysEffectiveDate={sysEffectiveDate},Intent=CompensationInfo,ActionTypeCode=CMP_INDIVIDUAL_COMPENSATION,ActionCode=MNG_INDIV_CMP,ShowFutureRecords=Y&onlyData=true&limit=25&offset=0",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "assignmentId",
            "dataType": "string",
            "description": "Employee assignment Id used to retrieve individual compensation details",
            "id": 2,
            "isToken": true,
