        {
          "id": "1786086531426",
          "code": "ALL_DIRECT_REPORT_COMP_DETAILS",
          "type": "CODE",
          "metadata": {
            "name": "all direct report comp details",
            "returnType": "array",
            "sourceCode": "// Reject incomplete, duplicated, mismatched or failed employee results before grouping.\nconst expectedTeamRows = $context.$nodes.SEC_VALIDATE_DIRECT_REPORTS_STOCKS_AND_BONUS_7D2ABF30.$output.result.items;\nconst completedTeamRows = $context.$nodes.DIRECT_REPORTS_STOCKS_AND_BONUS.$output;\nfunction teamResultId(value) {\n  if (typeof value === 'number' && Number.isSafeInteger(value) && value > 0) return String(value);\n  return typeof value === 'string' && /^[1-9][0-9]{0,29}$/.test(value) ? value : '';\n}\nfunction teamResultKey(row) {\n  if (!row || typeof row !== 'object' || Array.isArray(row)) throw new Error('Incomplete team compensation response.');\n  const person = teamResultId(row.PersonId), assignment = teamResultId(row.AssignmentId);\n  if (!person || !assignment) throw new Error('Incomplete team compensation response.');\n  return person + ':' + assignment;\n}\nif (!Array.isArray(expectedTeamRows) || !Array.isArray(completedTeamRows) || expectedTeamRows.length !== completedTeamRows.length) throw new Error('Incomplete team compensation response.');\nconst remainingTeamResults = new Map();\nfor (const row of expectedTeamRows) { const key = teamResultKey(row); remainingTeamResults.set(key, (remainingTeamResults.get(key) || 0) + 1); }\nfor (const item of completedTeamRows) {\n  if (typeof item !== 'string') throw new Error('Incomplete team compensation response.');\n  let parsed; try { parsed = JSON.parse(item); } catch { throw new Error('Incomplete team compensation response.'); }\n  const row = parsed && parsed.result;\n  if (!parsed || parsed.error || parsed.timeout === true || parsed.timedOut === true || parsed.success === false || !row || row.error || row.timeout === true || row.success === false) throw new Error('Incomplete team compensation response.');\n  const key = teamResultKey(row), count = remainingTeamResults.get(key) || 0;\n  if (!count) throw new Error('Incomplete team compensation response.');\n  remainingTeamResults.set(key, count - 1);\n}\nif ([...remainingTeamResults.values()].some(count => count !== 0)) throw new Error('Incomplete team compensation response.');\n\nconst input = $context?.$nodes?.DIRECT_REPORTS_STOCKS_AND_BONUS?.$output ?? [];\n\nconst grouped = {};\n\nfor (const item of input) {\n  if (typeof item !== \"string\") continue;\n  if (!item.trim().startsWith(\"{\")) continue;\n\n  try {\n    const parsed = JSON.parse(item);\n    const r = parsed.result;\n    if (!r) continue;\n\n    const currency = r.CmpCurrencyCode || \"UNKNOWN\";\n\n    const normalized = {\n      ...r,\n      compensationDetails: r.individualCompensationDetails ?? [],\n      stockDetails: r.stockDetails ?? [],\n    };\n\n    if (!grouped[currency]) {\n      grouped[currency] = {\n        currencyCode: currency,\n        data: [],\n      };\n    }\n\n    grouped[currency].data.push(normalized);\n  } catch {\n    continue;\n  }\n}\n\nreturn Object.values(grouped);",
            "errorNodeId": "error_incomplete_team_compensation"
          },
          "diagram": {
