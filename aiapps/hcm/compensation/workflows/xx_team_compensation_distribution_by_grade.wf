        {
          "id": "1786087624986",
          "code": "COMPENSATIONDISTRIBUTION",
          "type": "LLM",
          "metadata": {
            "name": "CompensationDistribution",
            "errorNodeId": "fix_processing_error"
          },
          "diagram": {
