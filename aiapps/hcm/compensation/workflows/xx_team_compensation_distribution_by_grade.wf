          "id": "person_context_session_number",
          "code": "FETCH_CONTEXT_SESSION_PERSON_NUMBER",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Fetch signed-in context person number",
            "businessObjectCode": "ORA_HCM_EMPINFO_XX_FETCHLOGGEDINUSERDETAILS",
            "functionName": "Get_User_Session_Details",
            "errorNodeId": "person_context_unavailable"
          },
          "inputs": [],
          "outcomes": {
            "success": "person_context_validate_session"
