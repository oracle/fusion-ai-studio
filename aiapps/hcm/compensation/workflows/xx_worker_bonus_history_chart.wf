        {
          "id": "BUILD_BONUS_HISTORY",
          "code": "BUILD_BONUS_HISTORY",
          "type": "CODE",
          "metadata": {
            "name": "Build Bonus History",
            "returnType": "object",
            "sourceCode": "// Validate service envelopes before their data is consumed; valid empty collections remain valid.\nfunction hcmHttpStatus(value) {\n  if (value == null || value === '') return 0;\n  if (typeof value === 'string') {\n    if (!/^[1-5][0-9]{2}$/.test(value)) throw new Error('A service returned an invalid HTTP status.');\n    value = Number(value);\n  }\n  if (typeof value !== 'number' || !Number.isInteger(value) || value < 100 || value > 599) throw new Error('A service returned an invalid HTTP status.');\n  return value;\n}\nfunction hcmResponseStatus(value) {\n  if (value.statusCode != null) return hcmHttpStatus(value.statusCode);\n  const status = value.status;\n  if (typeof status === 'number' || (typeof status === 'string' && /^[1-5][0-9]{2}$/.test(status))) return hcmHttpStatus(status);\n  return typeof status === 'string' && /^(failed|failure|error|timeout|timed_out|cancelled)$/i.test(status) ? 500 : 0;\n}\nfunction hcmCheckServiceNode(node) {\n  if (!node || !Object.prototype.hasOwnProperty.call(node, '$output')) return;\n  let value = node.$output;\n  for (let depth=0; depth<12; depth++) {\n    if (typeof value === 'string') { if (!value.trim()) throw new Error('A required service response is empty.'); value=JSON.parse(value); continue; }\n    if (value == null || typeof value !== 'object') throw new Error('A required service response is missing or invalid.');\n    if (Array.isArray(value)) return;\n    if (value.error || value.timeout === true || value.timedOut === true || value.isError === true || value.success === false || hcmResponseStatus(value) >= 400) throw new Error('A required service request failed.');\n    if (value.hasMore === true || value.hasMore === 'true') throw new Error('The service returned incomplete, paginated data. Complete data is required.');\n    if (Object.prototype.hasOwnProperty.call(value,'result')) {value=value.result;continue;}\n    if (Object.prototype.hasOwnProperty.call(value,'output')) {value=value.output;continue;}\n    return;\n  }\n  throw new Error('A service response has too many nested envelopes.');\n}\n\nhcmCheckServiceNode($context?.$nodes?.GET_CURRENT_COMPENSATION);\nhcmCheckServiceNode($context?.$nodes?.GET_PRIOR_COMPENSATION);\nfunction strictNumber(value) {\n  if (value == null) return null;\n  if (typeof value === 'string') {\n    if (!/^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$/.test(value.trim())) throw new Error('Invalid compensation number.');\n    value = Number(value.trim());\n  }\n  if (typeof value !== 'number' || !Number.isFinite(value) || Math.abs(value) > Number.MAX_SAFE_INTEGER / 100) throw new Error('Compensation number is invalid or outside the supported range.');\n  return value;\n}\nfunction checked(value) { const result = strictNumber(value); if (result === null) throw new Error('A required compensation amount is missing.'); return result; }\nfunction componentCurrency(value) {\n  if (typeof value !== 'string' || !/^[A-Z]{3}$/.test(value.trim().toUpperCase())) throw new Error('A compensation component currency is missing or invalid.');\n  return value.trim().toUpperCase();\n}\nfunction list(value){if(Array.isArray(value))return value;if(value&&Array.isArray(value.items))return value.items;if(value&&value.result&&Array.isArray(value.result.items))return value.result.items;if(value&&value.output&&Array.isArray(value.output.items))return value.output.items;return []}function number(value){return strictNumber(value)}function text(value,fallback){return value===null||value===undefined||String(value).trim()===''?fallback:String(value)}function formatAmount(row){const raw=row.ValueNumber??row.ValueString??row.ScreenEntryValue;const value=raw===null||raw===undefined||String(raw).trim()===''?null:number(raw);if(value===null)return 'Not available';const currency=text(row.DisplayCurrency,'');return currency==='USD'?'$'+value:(currency?currency+' '+value:String(value))}function map(rows,recordType){return rows.map(function(row){return {recordType:recordType,planName:text(row.PlanName,'Not available'),componentName:text(row.ComponentName,'Not available'),effectiveStartDate:text(row.EffectiveStartDate,'Not available'),effectiveEndDate:text(row.EffectiveEndDate,'Not available'),amount:formatAmount(row),amountValue:number(row.ValueNumber??row.ValueString??row.ScreenEntryValue),currency:text(row.DisplayCurrency,'Not available'),status:text(row.Status,'Not available')}})}const current=map(list($context.$nodes.GET_CURRENT_COMPENSATION.$output),'Current / Future');const prior=map(list($context.$nodes.GET_PRIOR_COMPENSATION.$output),'Prior');const rows=prior.concat(current).sort(function(a,b){return String(b.effectiveStartDate).localeCompare(String(a.effectiveStartDate))});const years=Array.from(new Set(rows.map(function(row){return /^\\d{4}/.test(row.effectiveStartDate)?row.effectiveStartDate.slice(0,4):'Unknown'}))).sort(function(a,b){if(a==='Unknown')return 1;if(b==='Unknown')return -1;return Number(b)-Number(a)});const currencies=Array.from(new Set(rows.filter(row=>row.amountValue!==null).map(row=>componentCurrency(row.currency)))).sort();\nfunction values(type,currency){return years.map(function(year){const matches=rows.filter(function(row){return row.recordType===type&&componentCurrency(row.currency)===currency&&(row.effectiveStartDate.slice(0,4)===year||(year==='Unknown'&&!/^\\d{4}/.test(row.effectiveStartDate)))});return matches.some(row=>row.amountValue===null)?null:matches.reduce((sum,row)=>checked(sum+checked(row.amountValue)),0)})}\nconst datasets=[];currencies.forEach(currency=>{datasets.push({label:'Prior bonus amount'+(currencies.length>1?' ('+currency+')':''),currencyCode:currency,data:values('Prior',currency)});datasets.push({label:'Current / future bonus amount'+(currencies.length>1?' ('+currency+')':''),currencyCode:currency,data:values('Current / Future',currency)})});\nreturn {personId:$context.$nodes.RESOLVE_PERSON_ID.$output.result.personId,assignmentId:$context.$nodes.SELECT_PRIMARY_ASSIGNMENT.$output.result.assignmentId,sysEffectiveDate:$context.$nodes.RESOLVE_SYSTEM_EFFECTIVE_DATE.$output.result.sysEffectiveDate,rows:rows,chart:{labels:years,datasets:datasets}};",
            "errorNodeId": "fix_processing_error"
          },
          "outcomes": {
            "success": "BUILD_BONUS_CHART"
          },
          "inputs": [],
          "diagram": {
            "x": 5450,
            "y": 11866
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
