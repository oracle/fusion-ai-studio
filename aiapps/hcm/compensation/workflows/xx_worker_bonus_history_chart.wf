        {
          "id": "1",
          "code": "SEC_VALIDATE_FETCH_CONTEXT_PERSON_BY_ID_CC23AE55",
          "type": "CODE",
          "metadata": {
            "name": "Validate inputs: FETCH_CONTEXT_PERSON_BY_ID",
            "sourceCode": "function numericString(value) {\n  if (typeof value === 'number') {\n    if (!Number.isSafeInteger(value) || value <= 0) return '';\n    value = String(value);\n  }\n  if (typeof value !== 'string' || !/^[0-9]+$/.test(value) || !/[1-9]/.test(value)) return '';\n  return value;\n}\nfunction personNumber(value) {\n  return typeof value === 'string' && /^[A-Za-z0-9][A-Za-z0-9._ -]{0,79}$/.test(value) && value === value.trim() ? value : '';\n}\nfunction currency(value) {\n  if (typeof value !== 'string') return '';\n  value = value.toUpperCase();\n  return /^[A-Z]{3}$/.test(value) ? value : '';\n}\nfunction calendarDate(value) {\n  if (typeof value !== 'string' || !/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(value)) return '';\n  const date = new Date(value + 'T00:00:00Z');\n  return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === value ? value : '';\n}\n\ntry {\n  const parameters = {};\n  parameters[\"personId\"] = numericString(($context.$nodes.EXTRACT_WORKFLOW_PERSON_CONTEXT.$output.result.personId));\n  return { valid: parameters[\"personId\"] !== \"\", parameters };\n} catch (error) {\n  return { valid: false, parameters: {} };\n}",
