        {
          "id": "BUILD_BONUS_CHART",
          "code": "BUILD_BONUS_CHART",
          "type": "CODE",
          "metadata": {
            "name": "Build Bonus Amount by Year Chart",
            "returnType": "object",
            "sourceCode": "function strictNumber(value) {\n  if (value == null) return null;\n  if (typeof value === 'string') {\n    if (!/^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$/.test(value.trim())) throw new Error('Invalid compensation number.');\n    value = Number(value.trim());\n  }\n  if (typeof value !== 'number' || !Number.isFinite(value) || Math.abs(value) > Number.MAX_SAFE_INTEGER / 100) throw new Error('Compensation number is invalid or outside the supported range.');\n  return value;\n}\nfunction checked(value) { const result = strictNumber(value); if (result === null) throw new Error('A required compensation amount is missing.'); return result; }\nfunction componentCurrency(value) {\n  if (typeof value !== 'string' || !/^[A-Z]{3}$/.test(value.trim().toUpperCase())) throw new Error('A compensation component currency is missing or invalid.');\n  return value.trim().toUpperCase();\n}\nconst data = $context.$nodes.BUILD_BONUS_HISTORY.$output.result || {};\n\nconst rows = (Array.isArray(data.rows) ? data.rows : []).map(function (row) {\n  const candidate = String(row.effectiveStartDate || '').slice(0, 4);\n  return Object.assign({}, row, {\n    year: /^\\d{4}$/.test(candidate) ? candidate : 'Unknown'\n  });\n});\n\nconst currencies = Array.from(new Set(rows.filter(row => row.amountValue !== null).map(row => componentCurrency(row.currency)))).sort();\nconst labels = Array.from(new Set(rows.map(row => row.year))).sort(function(a,b){if(a==='Unknown')return 1;if(b==='Unknown')return -1;return Number(a)-Number(b)});\nconst datasets = currencies.map(function(currency) {\n  return {label:'Bonus amount'+(currencies.length>1?' ('+currency+')':''),currencyCode:currency,data:labels.map(function(year) {\n    const matches=rows.filter(row=>row.year===year && componentCurrency(row.currency)===currency);\n    if(matches.some(row=>row.amountValue===null))return null;\n    return matches.reduce((sum,row)=>checked(sum+checked(row.amountValue)),0);\n  })};\n});\n\nreturn {\n  personId: data.personId,\n  assignmentId: data.assignmentId,\n  sysEffectiveDate: data.sysEffectiveDate,\n  rows: rows,\n  chart: {\n    labels: labels,\n    datasets: datasets\n  }\n};",
            "errorNodeId": "fix_processing_error"
          },
          "outcomes": {
            "success": "resolve_compensation_display_mode"
          },
          "inputs": [],
          "diagram": {
