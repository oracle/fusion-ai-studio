yAmountScale\": {\n            \"type\": \"number\"\n          },\n          \"AmountRoundingCode\": {\n            \"type\": \"null\"\n          },\n          \"AnnualRoundingCode\": {\n            \"type\": \"null\"\n          },\n          \"RangeRoundingCode\": {\n            \"type\": \"null\"\n          },\n          \"WorkAtHome\": {\n            \"type\": \"string\"\n          },\n          \"QuartileMeaning\": {\n            \"type\": \"null\"\n          },\n          \"QuintileMeaning\": {\n            \"type\": \"null\"\n          },\n          \"LegislativeDataGroupId\": {\n            \"type\": \"string\"\n          },\n          \"hasFutureSalary\": {\n            \"type\": \"string\"\n          },\n          \"MultipleComponents\": {\n            \"type\": \"string\"\n          },\n          \"ComponentUsage\": {\n            \"type\": \"string\"\n          },\n          \"PendingTransactionExists\": {\n            \"type\": \"null\"\n          },\n          \"RangeErrorWarning\": {\n            \"type\": \"string\"\n          },\n          \"PayrollFactor\": {\n            \"type\": \"number\"\n          },\n          \"SalaryFactor\": {\n            \"type\": \"number\"\n          },\n          \"PayrollFrequencyCode\": {\n            \"type\": \"string\"\n          },\n          \"PersonId\": {\n            \"type\": \"string\"\n          },\n          \"BusinessTitle\": {\n            \"type\": \"string\"\n          },\n          \"PersonNumber\": {\n            \"type\": \"string\"\n          },\n          \"PersonDisplayName\": {\n            \"type\": \"string\"\n          },\n          \"GradeCode\": {\n            \"type\": \"null\"\n          },\n          \"ActionOccurrenceId\": {\n            \"type\": \"string\"\n          },\n          \"SalaryTransactionStatus\": {\n            \"type\": \"null\"\n          },\n          \"AdjustedAnnualFtSalary\": {\n            \"type\": \"null\"\n          },\n          \"AdjustedAnnualSalary\": {\n 