        {
          "id": "resolve_compensation_display_mode",
          "code": "RESOLVE_COMPENSATION_DISPLAY_MODE",
          "type": "CODE",
          "metadata": {
            "name": "Resolve compensation display mode",
            "sourceCode": "// Validate service envelopes before their data is consumed; valid empty collections remain valid.\nfunction hcmHttpStatus(value) {\n  if (value == null || value === '') return 0;\n  if (typeof value === 'string') {\n    if (!/^[1-5][0-9]{2}$/.test(value)) throw new Error('A service returned an invalid HTTP status.');\n    value = Number(value);\n  }\n  if (typeof value !== 'number' || !Number.isInteger(value) || value < 100 || value > 599) throw new Error('A service returned an invalid HTTP status.');\n  return value;\n}\nfunction hcmResponseStatus(value) {\n  if (value.statusCode != null) return hcmHttpStatus(value.statusCode);\n  const status = value.status;\n  if (typeof status === 'number' || (typeof status === 'string' && /^[1-5][0-9]{2}$/.test(status))) return hcmHttpStatus(status);\n  return typeof status === 'string' && /^(failed|failure|error|timeout|timed_out|cancelled)$/i.test(status) ? 500 : 0;\n}\nfunction hcmCheckServiceNode(node) {\n  if (!node || !Object.prototype.hasOwnProperty.call(node, '$output')) return;\n  let value = node.$output;\n  for (let depth=0; depth<12; depth++) {\n    if (typeof value === 'string') { if (!value.trim()) throw new Error('A required service response is empty.'); value=JSON.parse(value); continue; }\n    if (value == null || typeof value !== 'object') throw new Error('A required service response is missing or invalid.');\n    if (Array.isArray(value)) return;\n    if (value.error || value.timeout === true || value.timedOut === true || value.isError === true || value.success === false || hcmResponseStatus(value) >= 400) throw new Error('A required service request failed.');\n    if (value.hasMore === true || value.hasMore === 'true') throw new Error('The service returned incomplete, paginated data. Complete data is required.');\n    if (Object.prototype.hasOwnProperty.call(value,'result')) {value=value.result;continue;}\n    if (Object.prototype.hasOwnProperty.call(value,'output')) {value=value.output;continue;}\n    return;\n  }\n  throw new Error('A service response has too many nested envelopes.');\n}\nhcmCheckServiceNode($context?.$nodes?.FETCH_CONTEXT_PERSON_BY_ID);\nhcmCheckServiceNode($context?.$nodes?.GET_EMPLOYEE_SALARY_HISTORY);\nhcmCheckServiceNode($context?.$nodes?.RETRIEVE_EMPLOYEE_SALARY_HISTORY);\nhcmCheckServiceNode($context?.$nodes?.FETCH_CONTEXT_SESSION_PERSON_NUMBER);\nhcmCheckServiceNode($context?.$nodes?.FETCH_CONTEXT_PERSON_BY_NUMBER);\nconst mode = ($context.$nodes.EXTRACT_WORKFLOW_PERSON_CONTEXT.$output.result.isQuestionRequest === true ? 'Query' : $context.$app.$OraMessageHint != null && $context.$app.$OraMessageHint !== '' ? $context.$app.$OraMessageHint : $context.$nodes.EXTRACT_WORKFLOW_PERSON_CONTEXT.$output.result.displayMode); return { mode: [\"InitDisplay\", \"Query\"].indexOf(mode) >= 0 ? mode : 'Unsupported' };",
            "returnType": "object",
            "errorNodeId": "fix_processing_error"
          },
