          "diagram": {
            "x": 7812.5,
            "y": 6316
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"PersonId\": {\n      \"type\": \"string\"\n    },\n    \"PersonNumber\": {\n      \"type\": \"string\"\n    },\n    \"LastName\": {\n      \"type\": \"string\"\n    },\n    \"FirstName\": {\n      \"type\": \"string\"\n    },\n    \"Title\": {\n      \"type\": \"string\"\n    },\n    \"PreNameAdjunct\": {\n      \"type\": \"string\"\n    },\n    \"Suffix\": {\n      \"type\": \"string\"\n    },\n    \"MiddleNames\": {\n      \"type\": \"string\"\n    },\n    \"Honors\": {\n      \"type\": \"string\"\n    },\n    \"KnownAs\": {\n      \"type\": \"string\"\n    },\n    \"DisplayName\": {\n      \"type\": \"string\"\n    },\n    \"ListName\": {\n      \"type\": \"string\"\n    },\n    \"OrderName\": {\n      \"type\": \"string\"\n    },\n    \"WorkEmail\": {\n      \"type\": \"string\"\n    },\n    \"Username\": {\n      \"type\": \"string\"\n    },\n    \"links\": {\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"PersonId\",\n    \"PersonNumber\",\n    \"LastName\",\n    \"FirstName\",\n    \"Title\",\n    \"PreNameAdjunct\",\n    \"Suffix\",\n    \"MiddleNames\",\n    \"Honors\",\n    \"KnownAs\",\n    \"DisplayName\",\n    \"ListName\",\n    \"OrderName\",\n    \"WorkEmail\",\n    \"Username\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "person_context_resolve",
          "code": "RESOLVE_WORKFLOW_PERSON_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Resolve workflow person context",
            "sourceCode": "// Validate service envelopes before their data is consumed; valid empty collections remain valid.\nfunction hcmHttpStatus(value) {\n  if (value == null || value === '') return 0;\n  if (typeof value === 'string') {\n    if (!/^[1-5][0-9]{2}$/.test(value)) throw new Error('A service returned an invalid HTTP status.');\n    value = Number(value);\n  }\n  if (typeof value !== 'number' || !Number.isInteger(value) || value < 100 || value > 599) throw new Error('A service returned an invalid HTTP status.');\n  return value;\n}\nfunction hcmResponseStatus(value) {\n  if (value.statusCode != null) return hcmHttpStatus(value.statusCode);\n  const status = value.status;\n  if (typeof status === 'number' || (typeof status === 'string' && /^[1-5][0-9]{2}$/.test(status))) return hcmHttpStatus(status);\n  return typeof status === 'string' && /^(failed|failure|error|timeout|timed_out|cancelled)$/i.test(status) ? 500 : 0;\n}\nfunction hcmCheckServiceNode(node) {\n  if (!node || !Object.prototype.hasOwnProperty.call(node, '$output')) return;\n  let value = node.$output;\n  for (let depth=0; depth<12; depth++) {\n    if (typeof value === 'string') { if (!value.trim()) throw new Error('A required service response is empty.'); value=JSON.parse(value); continue; }\n    if (value == null || typeof value !== 'object') throw new Error('A required service response is missing or invalid.');\n    if (Array.isArray(value)) return;\n    if (value.error || value.timeout === true || value.timedOut === true || value.isError === true || value.success === false || hcmResponseStatus(value) >= 400) throw new Error('A required service request failed.');\n    if (value.hasMore === true || value.hasMore === 'true') throw new Error('The service returned incomplete, paginated data. Complete data is required.');\n    if (Object.prototype.hasOwnProperty.call(value,'result')) {value=value.result;continue;}\n    if (Object.prototype.hasOwnProperty.call(value,'output')) {value=value.output;continue;}\n    return;\n  }\n  throw new Error('A service response has too many nested envelopes.');\n}\n\nfunction fail(code, message) {\n  const error = { code, message };\n  return { valid: false, error, errorResponse: JSON.stringify({ error }) };\n}\nfunction stop(code, message) { throw { safePersonContextError: true, code, message }; }\nfunction parseObject(value) {\n  if (value == null || value === '') return {};\n  if (typeof value === 'string') {\n    try { value = JSON.parse(value); }\n    catch { stop('INVALID_PERSON_CONTEXT', 'The person context could not be read. Provide a valid personId and try again.'); }\n  }\n  if (!value || typeof value !== 'object' || Array.isArray(value)) stop('INVALID_PERSON_CONTEXT', 'The person context must be an object. Provide a valid personId and try again.');\n  return value;\n}\nfunction validId(value) {\n  return typeof value === 'number'\n    ? Number.isSafeInteger(value) && value > 0\n    : typeof value === 'string' && /^[1-9][0-9]{0,29}$/.test(value) && value === value.trim();\n}\nfunction readId(context, names) {\n  for (const name of names) {\n    const value = context[name];\n    if (value == null || (typeof value === 'string' && !value.trim())) continue;\n    if (!validId(value)) stop('INVALID_PERSON', 'A valid positive numeric personId is required. Select a person or provide personId and try again.');\n    return String(value);\n  }\n  return '';\n}\nfunction healthy(value) {\n  if (typeof value === 'string') {\n    try { value = JSON.parse(value); }\n    catch { stop('INVALID_PERSON_RESPONSE', 'The person lookup returned an unreadable response. Provide personId or sign in again.'); }\n  }\n  if (!value || typeof value !== 'object' || Array.isArray(value)) stop('PERSON_UNAVAILABLE', 'No person details are available. Provide personId or sign in again.');\n  if (value.error || value.timeout === true || value.timedOut === true || value.success === false ||\n      (typeof value.statusCode === 'number' && hcmHttpStatus(value.statusCode) >= 400)) stop('PERSON_LOOKUP_FAILED', 'Person details could not be retrieved. Provide personId or sign in again and retry.');\n  if (value.result != null) return healthy(value.result);\n  return value;\n}\n\ntry {\nhcmCheckServiceNode($context?.$nodes?.FETCH_CONTEXT_PERSON_BY_ID);\nhcmCheckServiceNode($context?.$nodes?.FETCH_CONTEXT_PERSON_BY_NUMBER);\nconst context = $context.$nodes.EXTRACT_WORKFLOW_PERSON_CONTEXT.$output.result;\nconst supplied = context.personId;\nconst value = healthy(supplied\n  ? $context.$nodes.FETCH_CONTEXT_PERSON_BY_ID.$output\n  : $context.$nodes.FETCH_CONTEXT_PERSON_BY_NUMBER.$output);\nconst person = Array.isArray(value.items) ? value.items[0] : value;\nif (!person || !validId(person.PersonId)) stop('PERSON_UNAVAILABLE', 'No valid person record was found. Provide a personId or sign in again.');\nconst personId = String(person.PersonId);\nif (supplied && personId !== supplied) stop('PERSON_CONTEXT_MISMATCH', 'The person lookup did not match the supplied personId. Verify the selected person and try again.');\nif (!supplied) {\n  const expectedNumber = $context.$nodes.VALIDATE_CONTEXT_SESSION_PERSON_NUMBER.$output.result.personNumber;\n  if (person.PersonNumber != null && String(person.PersonNumber) !== expectedNumber) stop('PERSON_CONTEXT_MISMATCH', 'The person lookup did not match the signed-in user. Provide personId or sign in again.');\n}\nreturn { valid: true, personId, personNumber: person.PersonNumber || '', displayName: person.DisplayName,\n  viewerPersonId: context.viewerPersonId || (!supplied ? personId : ''),\n  personSource: context.personSource || 'signed-in', workflowMode: context.workflowMode,\n  isRestRequestWithoutAppHint: context.isRestRequestWithoutAppHint };\n} catch (error) {\n  return error && error.safePersonContextError === true\n    ? fail(error.code, error.message)\n    : fail('PERSON_CONTEXT_FAILED', 'The person context could not be resolved. Provide personId or sign in again.');\n}",
