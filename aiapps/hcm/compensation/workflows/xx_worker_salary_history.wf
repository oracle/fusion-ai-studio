        {
          "id": "salary_format_dates",
          "code": "FORMAT_SALARY_DATES_FOR_VIEWER",
          "type": "CODE",
          "metadata": {
            "name": "Format Salary Dates for Viewer",
            "sourceCode": "// Validate service envelopes before their data is consumed; valid empty collections remain valid.\nfunction hcmHttpStatus(value) {\n  if (value == null || value === '') return 0;\n  if (typeof value === 'string') {\n    if (!/^[1-5][0-9]{2}$/.test(value)) throw new Error('A service returned an invalid HTTP status.');\n    value = Number(value);\n  }\n  if (typeof value !== 'number' || !Number.isInteger(value) || value < 100 || value > 599) throw new Error('A service returned an invalid HTTP status.');\n  return value;\n}\nfunction hcmResponseStatus(value) {\n  if (value.statusCode != null) return hcmHttpStatus(value.statusCode);\n  const status = value.status;\n  if (typeof status === 'number' || (typeof status === 'string' && /^[1-5][0-9]{2}$/.test(status))) return hcmHttpStatus(status);\n  return typeof status === 'string' && /^(failed|failure|error|timeout|timed_out|cancelled)$/i.test(status) ? 500 : 0;\n}\nfunction hcmCheckServiceNode(node) {\n  if (!node || !Object.prototype.hasOwnProperty.call(node, '$output')) return;\n  let value = node.$output;\n  for (let depth=0; depth<12; depth++) {\n    if (typeof value === 'string') { if (!value.trim()) throw new Error('A required service response is empty.'); value=JSON.parse(value); continue; }\n    if (value == null || typeof value !== 'object') throw new Error('A required service response is missing or invalid.');\n    if (Array.isArray(value)) return;\n    if (value.error || value.timeout === true || value.timedOut === true || value.isError === true || value.success === false || hcmResponseStatus(value) >= 400) throw new Error('A required service request failed.');\n    if (value.hasMore === true || value.hasMore === 'true') throw new Error('The service returned incomplete, paginated data. Complete data is required.');\n    if (Object.prototype.hasOwnProperty.call(value,'result')) {value=value.result;continue;}\n    if (Object.prototype.hasOwnProperty.call(value,'output')) {value=value.output;continue;}\n    return;\n  }\n  throw new Error('A service response has too many nested envelopes.');\n}\n\nhcmCheckServiceNode($context?.$nodes?.GET_EMPLOYEE_SALARY_HISTORY);\n// Date-only values must never be converted through a time zone.\nfunction parse(value) {\n  if (typeof value === \"string\") { try { return JSON.parse(value); } catch (error) { return null; } }\n  return value;\n}\nfunction collection(value) {\n  const response = parse(value);\n  if (!response || response.error || response.timeout || response.isError ||\n      hcmResponseStatus(response) >= 400 ||\n      String(response.hasMore).toLowerCase() === \"true\" || !Array.isArray(response.items)) return [];\n  return response.items;\n}\nconst salaryResponse = parse($context.$nodes.GET_EMPLOYEE_SALARY_HISTORY.$output);\nconst goals = salaryResponse && Array.isArray(salaryResponse.items) ? salaryResponse.items : [];\nconst viewerId = $context.$nodes.RESOLVE_EMPLOYEE_CONTEXT.$output.result.viewerPersonId;\n// USER_SESSION is bound to the authenticated viewer, never OraAppContext's subject.\nconst sessions = collection($context.$nodes.READ_VIEWER_SESSION?.$output);\nconst session = sessions.length === 1 && sessions[0] ? sessions[0] : {};\nconst preference = typeof session.DateFormat === \"string\" ? session.DateFormat.trim() : \"\";\nconst language = String(session.Language || session.DefaultLanguage || \"\").toLowerCase();\nlet country = typeof session.Territory === \"string\" ? session.Territory.trim().toUpperCase() : \"\";\nif (!country && viewerId) {\n  const countries = [];\n  collection($context.$nodes.GET_VIEWER_WORK_ASSIGNMENT?.$output).forEach(function (row) {\n    if (!row || (row.PersonId != null && String(row.PersonId).trim() !== viewerId)) return;\n    if (row.PrimaryFlag != null && !/^(true|y)$/i.test(String(row.PrimaryFlag))) return;\n    const value = typeof row.LocationCountry === \"string\" ? row.LocationCountry.trim().toUpperCase() : \"\";\n    if (countries.indexOf(value) < 0) countries.push(value);\n  });\n  if (countries.length === 1) country = countries[0];\n}\nconst monthNames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\nfunction preferenceFormat(parts) {\n  // Oracle selfDetails.DateFormat uses Java-style day/month/year tokens.\n  if (!preference || preference.length > 80) return null;\n  const tokens = preference.match(/yyyy|YYYY|yy|YY|MMMM|MMM|MM|M|dd|DD|d|D|[\\s/.,-]+/g);\n  if (!tokens || tokens.join(\"\") !== preference) return null;\n  const dateTokens = tokens.filter(function (token) { return /[yYMdD]/.test(token); });\n  if (dateTokens.length !== 3 ||\n      dateTokens.filter(function (t) { return /^[yY]/.test(t); }).length !== 1 ||\n      dateTokens.filter(function (t) { return /^M/.test(t); }).length !== 1 ||\n      dateTokens.filter(function (t) { return /^[dD]/.test(t); }).length !== 1) return null;\n  if (preference.indexOf(\"MMM\") >= 0 && !/^en(?:[-_]|$)/.test(language)) return null;\n  return tokens.map(function (token) {\n    if (/^(yyyy|YYYY)$/.test(token)) return parts[1];\n    if (/^(yy|YY)$/.test(token)) return parts[1].slice(-2);\n    if (token === \"MMMM\") return monthNames[Number(parts[2]) - 1];\n    if (token === \"MMM\") return monthNames[Number(parts[2]) - 1].slice(0, 3);\n    if (token === \"MM\") return parts[2];\n    if (token === \"M\") return String(Number(parts[2]));\n    if (/^(dd|DD)$/.test(token)) return parts[3];\n    if (/^(d|D)$/.test(token)) return String(Number(parts[3]));\n    return token;\n  }).join(\"\");\n}\nfunction formatDate(value) {\n  if (value == null || value === \"\") return \"Not available\";\n  if (typeof value !== \"string\") return value;\n  const parts = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(value);\n  if (!parts) return value;\n  const year = Number(parts[1]), month = Number(parts[2]), day = Number(parts[3]);\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  if (year < 1 || month < 1 || month > 12 || day < 1 || day > days[month - 1]) return value;\n  const preferred = preferenceFormat(parts);\n  if (preferred !== null) return preferred;\n  if (country === \"US\") return parts[2] + \"/\" + parts[3] + \"/\" + parts[1];\n  if ([\"IN\", \"GB\", \"UK\", \"AU\", \"SG\"].indexOf(country) >= 0) return parts[3] + \"/\" + parts[2] + \"/\" + parts[1];\n  return value;\n}\nconst items = goals.map(function (goal) {\n  const row = Object.assign({}, goal);\n  row.StartDateDisplay = formatDate(goal.DateFrom);\n  row.EndDateDisplay = goal.DateTo === \"4712-12-31\" ? \"Ongoing\" : formatDate(goal.DateTo);\n  return row;\n});\nreturn Object.assign({}, salaryResponse || {}, { items: items });\n",
            "returnType": "object",
            "errorNodeId": "fix_processing_error"
          },
