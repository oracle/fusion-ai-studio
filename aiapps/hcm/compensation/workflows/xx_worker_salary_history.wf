        {
          "id": "validate_numeric_ids_1785319584799",
          "code": "VALIDATE_NUMERIC_IDS_FOR_RETRIEVE_EMPLOYEE_SALARY_HISTORY",
          "type": "CODE",
          "metadata": {
            "name": "Validate Numeric IDs for Retrieve Employee Salary History 1",
