        {
          "id": "1",
          "code": "RESOLVE_EMPLOYEE_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Resolve Employee Context",
            "description": "Resolves the employee person ID and Agentic App message hint from the available request context.",
            "returnType": "object",
            "sourceCode": "function parseContext(value) {\n  if (value && typeof value === \"object\") return value;\n  if (typeof value !== \"string\" || value.trim() === \"\") return {};\n  try { return JSON.parse(value); } catch (error) { return {}; }\n}\n\nconst appContext = parseContext($context?.$app?.$OraAppContext);\nconst restInput = $context?.$triggers?.REST?.$input || {};\n\nconst personId = $context.$nodes.RESOLVE_WORKFLOW_PERSON_CONTEXT.$output.result.personId;\nconst messageHint = appContext.msgHint ?? $context?.$app?.$OraMessageHint ?? restInput.msgHint ?? \"InitDisplay\";\n\nconst userContext = parseContext($context?.$app?.$OraUserContext);\nconst rawViewerId = userContext.userId == null ? \"\" : String(userContext.userId).trim();\nconst viewerPersonId = /^\\d+$/.test(rawViewerId) ? rawViewerId : $context.$nodes.RESOLVE_WORKFLOW_PERSON_CONTEXT.$output.result.viewerPersonId;\n\nreturn { personId: String(personId), messageHint: String(messageHint), viewerPersonId };",
            "errorNodeId": "fix_processing_error"
          },
          "outcomes": {
            "success": "validate_numeric_ids_2"
          },
          "inputs": [],
          "diagram": {
            "x": 6800,
            "y": 7870
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "validate_numeric_ids_2",
          "code": "VALIDATE_NUMERIC_IDS_FOR_GET_EMPLOYEE_SALARY_HISTORY",
          "type": "CODE",
          "metadata": {
            "name": "Validate Numeric IDs for Retrieve Employee Salary History",
            "description": "Fails closed unless every identifier supplied to this call is a non-empty numeric string.",
            "returnType": "object",
            "sourceCode": "function numericString(value) {\n  if (typeof value === 'number') {\n    if (!Number.isSafeInteger(value) || value <= 0) return false;\n    value = String(value);\n  }\n  return typeof value === 'string' && /^[0-9]+$/.test(value) && /[1-9]/.test(value);\n}\n\nreturn { valid: numericString(($context.$nodes.RESOLVE_EMPLOYEE_CONTEXT.$output.result.personId)) };",
            "errorNodeId": "fix_processing_error"
          },
          "outcomes": {
            "success": "if_numeric_ids_valid_2"
          },
          "inputs": [],
