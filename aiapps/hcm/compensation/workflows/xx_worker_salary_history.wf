,\n          \"FrequencyName\",\n          \"SalaryBasisName\",\n          \"Quartile\",\n          \"QuartileMeaning\",\n          \"CompaRatio\",\n          \"SalaryRangeMinimum\",\n          \"SalaryRangeMidPoint\",\n          \"SalaryRangeMaximum\",\n          \"LastUpdateDate\",\n          \"PersonId\",\n          \"PersonNumber\",\n          \"PersonDisplayName\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
