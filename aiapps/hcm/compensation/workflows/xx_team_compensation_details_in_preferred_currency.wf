          },
          "inputs": [
            {
              "id": "1785403563688_condition",
              "name": "condition",
              "type": "string",
              "value": "{{!!$context.$variables.DirectReportsCompensationDetails && $context.$variables.TeamCompensationPersonId === $context.$nodes.RESOLVE_WORKFLOW_PERSON_CONTEXT.$output.result.personId}}"
            }
