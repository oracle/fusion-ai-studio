        {
          "id": "1793873407803",
          "code": "DIRECT_REPORTS_COMPENSATION_DETAILS_IN_PREFERRED_CURRENCY",
          "type": "CODE",
          "metadata": {
            "name": "direct reports compensation details in preferred currency",
            "returnType": "object",
            "sourceCode": "function strictNumber(value) {\n  if (value == null) return null;\n  if (typeof value === 'string') {\n    if (!/^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$/.test(value.trim())) throw new Error('Invalid compensation number.');\n    value = Number(value.trim());\n  }\n  if (typeof value !== 'number' || !Number.isFinite(value) || Math.abs(value) > Number.MAX_SAFE_INTEGER / 100) throw new Error('Compensation number is invalid or outside the supported range.');\n  return value;\n}\nfunction checked(value) { const result = strictNumber(value); if (result === null) throw new Error('A required compensation amount is missing.'); return result; }\nfunction componentCurrency(value) {\n  if (typeof value !== 'string' || !/^[A-Z]{3}$/.test(value.trim().toUpperCase())) throw new Error('A compensation component currency is missing or invalid.');\n  return value.trim().toUpperCase();\n}\nvar reportsInput = $context.$variables.DirectReportsCompensationDetails;\nvar ratesInput = $context.$nodes.GET_CURRENCY_EXCHANGE_DETAILS.$output;\n\nfunction parseJSON(value) {\n  return typeof value === \"string\" ? JSON.parse(value) : value;\n}\n\nfunction currencyCode(value) {\n  return typeof value === \"string\" ? value.trim().toUpperCase() : \"\";\n}\n\nfunction copyObject(value) {\n  return JSON.parse(JSON.stringify(value));\n}\n\nfunction readNumber(value, label) { return checked(value); }\n\nvar exchangeRates = [];\n\nfunction collectRates(input) {\n  var value = parseJSON(input);\n\n  if (Array.isArray(value)) {\n    for (var i = 0; i < value.length; i++) {\n      collectRates(value[i]);\n    }\n    return;\n  }\n\n  if (value && typeof value === \"object\") {\n    if (Object.prototype.hasOwnProperty.call(value, \"result\")) {\n      collectRates(value.result);\n      return;\n    }\n\n    if (value.fromCurrency && value.toCurrency) {\n      exchangeRates.push(value);\n      return;\n    }\n  }\n\n  throw new Error(\"Invalid exchange-rate response.\");\n}\n\ncollectRates(ratesInput);\n\nif (exchangeRates.length === 0) {\n  throw new Error(\"No exchange rates were supplied.\");\n}\n\n// All supplied rates must target the preferred currency.\nvar preferredCurrency = currencyCode(exchangeRates[0].toCurrency);\nvar rateLookup = {};\n\nif (!/^[A-Z]{3}$/.test(preferredCurrency)) {\n  throw new Error(\"Invalid preferred currency.\");\n}\n\nfor (var r = 0; r < exchangeRates.length; r++) {\n  var exchange = exchangeRates[r];\n  var from = currencyCode(exchange.fromCurrency);\n  var to = currencyCode(exchange.toCurrency);\n  var rate = readNumber(exchange.exchangeRate, from + \" -> \" + to);\n\n  if (!/^[A-Z]{3}$/.test(from) || to !== preferredCurrency) {\n    throw new Error(\"All exchange rates must target \" + preferredCurrency);\n  }\n\n  if (rate <= 0 || (from === to && rate !== 1)) {\n    throw new Error(\"Invalid exchange rate: \" + from + \" -> \" + to);\n  }\n\n  if (\n    Object.prototype.hasOwnProperty.call(rateLookup, from) &&\n    rateLookup[from] !== rate\n  ) {\n    throw new Error(\"Conflicting exchange rates for \" + from);\n  }\n\n  rateLookup[from] = rate;\n}\n\nvar reports = parseJSON(reportsInput);\nvar groups;\n\nif (Array.isArray(reports)) {\n  groups = reports;\n} else if (reports && typeof reports === \"object\") {\n  groups =\n    reports.DirectReportsCompensationDetails ||\n    reports.compensationGroups;\n}\n\nif (!Array.isArray(groups)) {\n  throw new Error(\"Expected an array of direct-report compensation groups.\");\n}\n\nfunction convertAmount(value, multiplier, label) {\n  if (value === null || typeof value === \"undefined\") {\n    return null;\n  }\n\n  var amount = readNumber(value, label) * multiplier;\n\n  if (!isFinite(amount)) {\n    throw new Error(\"Conversion overflow: \" + label);\n  }\n\n  var rounded = Math.round(amount);\n\n  if (Math.abs(rounded) > 9007199254740991) {\n    throw new Error(\"Converted amount exceeds safe numeric precision: \" + label);\n  }\n\n  return rounded === 0 ? 0 : rounded;\n}\n\nvar employees = [];\nvar monetaryFields = [\n  \"computedAnnualSalary\",\n  \"computedBonus\",\n  \"computedStockValue\",\n  \"computedTotalCompensation\"\n];\n\nfor (var g = 0; g < groups.length; g++) {\n  var group = parseJSON(groups[g]);\n\n  if (!group || !Array.isArray(group.data)) {\n    throw new Error(\"Each compensation group must contain a data array.\");\n  }\n\n  for (var e = 0; e < group.data.length; e++) {\n    var employee = parseJSON(group.data[e]);\n\n    if (\n      !employee ||\n      typeof employee !== \"object\" ||\n      Array.isArray(employee)\n    ) {\n      throw new Error(\"Invalid employee record.\");\n    }\n\n    var sourceCurrency =\n      currencyCode(employee.computedCompensationCurrency) ||\n      currencyCode(employee.CmpCurrencyCode) ||\n      currencyCode(group.currencyCode);\n\n    if (!/^[A-Z]{3}$/.test(sourceCurrency)) {\n      throw new Error(\"Missing currency for employee \" + employee.PersonId);\n    }\n\n    var multiplier = 1;\n\n    if (sourceCurrency !== preferredCurrency) {\n      if (!Object.prototype.hasOwnProperty.call(rateLookup, sourceCurrency)) {\n        throw new Error(\n          \"Missing exchange rate: \" +\n          sourceCurrency +\n          \" -> \" +\n          preferredCurrency\n        );\n      }\n\n      multiplier = rateLookup[sourceCurrency];\n    }\n\n    // Preserve every employee and all original details.\n    var convertedEmployee = copyObject(employee);\n\n    var breakdown = employee.computedCurrencyTotals;\n    if (!Array.isArray(breakdown) || breakdown.length === 0) throw new Error('Validated component currency totals are required. Refresh compensation data.');\n    for (var f = 0; f < monetaryFields.length; f++) {\n      var field = monetaryFields[f];\n      var convertedSum = null;\n      for (var part = 0; part < breakdown.length; part++) {\n        var component = breakdown[part];\n        var componentCode = componentCurrency(component.currencyCode);\n        if (component[field] == null) continue;\n        var componentRate = componentCode === preferredCurrency ? 1 : rateLookup[componentCode];\n        if (componentRate == null) throw new Error('Missing exchange rate: ' + componentCode + ' -> ' + preferredCurrency);\n        convertedSum = checked((convertedSum == null ? 0 : convertedSum) + checked(readNumber(component[field], field) * componentRate));\n      }\n      convertedEmployee[field] = convertedSum === null ? null : convertAmount(convertedSum, 1, field);\n    }\n    // A total still requires an available annual salary, as before.\n    if (employee.computedAnnualSalary == null) convertedEmployee.computedTotalCompensation = null;\n\n    // Shares are counts, so they must never be currency-converted.\n    convertedEmployee.computedVestedShares =\n      employee.computedVestedShares == null\n        ? null\n        : employee.computedVestedShares;\n\n    convertedEmployee.sourceCurrencyTotals = copyObject(breakdown);\n    convertedEmployee.computedCurrencyTotals = [{ currencyCode:preferredCurrency, computedAnnualSalary:convertedEmployee.computedAnnualSalary, computedBonus:convertedEmployee.computedBonus, computedStockValue:convertedEmployee.computedStockValue, computedVestedShares:convertedEmployee.computedVestedShares, computedTotalCompensation:convertedEmployee.computedTotalCompensation }];\n    convertedEmployee.computedCompensationCurrency = preferredCurrency;\n\n    employees.push(convertedEmployee);\n  }\n}\n\nvar output = {\n  preferredCurrency: preferredCurrency,\n  DirectReportsCompensationDetails: [\n    {\n      currencyCode: preferredCurrency,\n      data: employees\n    }\n  ]\n};\n\noutput.displayData = {\n  preferredCurrency: preferredCurrency,\n  DirectReportsCompensationDetails: [{ currencyCode: preferredCurrency, data: employees.map(function(employee) {\n    var display = {};\n    ['PersonId','AssignmentId','DisplayName','AssignmentName','computedAnnualSalary','computedBonus','computedStockValue','computedVestedShares','computedTotalCompensation'].forEach(function(key) { display[key] = employee[key]; });\n    return display;\n  }) }]\n};\n\nfunction text(v) { return v==null||v==='' ? '-' : String(v).replace(/[\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]/g,'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\nfunction employeeId(v) { if(typeof v==='number'&&Number.isSafeInteger(v)&&v>0)return String(v); if(typeof v==='string'&&/^[1-9][0-9]{0,29}$/.test(v))return v; throw new Error('Invalid employee navigation identifier.'); }\nfunction amount(v) { if(v==null)return '-';var n=readNumber(v,'display amount');if(Math.abs(n)>Number.MAX_SAFE_INTEGER)throw new Error('Unsafe amount.');return (preferredCurrency==='USD'?'$':preferredCurrency+' ')+n.toFixed(2); }\nvar widget={title:'',patternId:'multiRecordWidget',description:'Employee compensation summary in '+preferredCurrency,properties:{cols:['Employee Name','Business Title','Annual Salary','Bonus','Stocks','Total Compensation'],rows:employees.map(function(e){\nvar payload={personId:employeeId(e.PersonId),assignmentId:employeeId(e.AssignmentId)};\nreturn {cells:[text(e.DisplayName),text(e.AssignmentName),amount(e.computedAnnualSalary),amount(e.computedBonus),e.computedStockValue==null||e.computedVestedShares==null?'-':amount(e.computedStockValue)+' ('+text(e.computedVestedShares)+(String(e.computedVestedShares)==='1'?' RSU)':' RSUs)'),amount(e.computedTotalCompensation)],drillDownAction:'ora.Invoke(\"appNavigate\", '+JSON.stringify(payload)+')'};\n})}};\noutput.panelDisplay='<oraInfoDisplay key=\"list\">\\n'+JSON.stringify(widget)+'\\n</oraInfoDisplay>';\nreturn output;\n",
            "errorNodeId": "fix_processing_error"
          },
          "diagram": {
