          "code": "RESOLVE_EMPLOYEE_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Resolve Employee Context",
            "description": "Uses the selected Agentic App person ID when present, otherwise preserves the REST person ID.",
            "returnType": "object",
            "sourceCode": "function parseContext(value) {\n  if (value && typeof value === \"object\") return value;\n  if (typeof value !== \"string\" || value.trim() === \"\") return {};\n  try { return JSON.parse(value); } catch (error) { return {}; }\n}\n\nconst appContext = parseContext($context?.$app?.$OraAppContext);\nconst restInput = $context?.$triggers?.REST?.$input || {};\nconst personId = $context.$nodes.RESOLVE_WORKFLOW_PERSON_CONTEXT.$output.result.personId;\nconst messageHint = appContext.msgHint ?? $context?.$app?.$OraMessageHint ?? restInput.msgHint ?? \"InitDisplay\";\n\nconst userContext = parseContext($context?.$app?.$OraUserContext);\nconst rawViewerId = userContext.userId == null ? \"\" : String(userContext.userId).trim();\nconst viewerPersonId = /^\\d+$/.test(rawViewerId) ? rawViewerId : $context.$nodes.RESOLVE_WORKFLOW_PERSON_CONTEXT.$output.result.viewerPersonId;\n\nreturn { personId: String(personId), messageHint: String(messageHint), viewerPersonId };",
            "errorNodeId": "fix_processing_error"
          },
