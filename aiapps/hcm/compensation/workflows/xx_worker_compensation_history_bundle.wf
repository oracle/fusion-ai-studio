        {
          "id": "6",
          "code": "RUN_COMPENSATION_HISTORIES_IN_PARALLEL",
          "type": "PARALLEL",
          "metadata": {
            "name": "Run Compensation Histories in Parallel",
            "description": "Runs salary, bonus, and stock history workflow calls concurrently.",
            "errorNodeId": "fix_processing_error"
          },
          "outcomes": {
            "0": "validate_numeric_ids_1",
            "1": "validate_numeric_ids_2",
            "2": "validate_numeric_ids_3"
          },
          "convergenceTargetId": "4",
          "inputs": [],
