        },
        {
          "id": "resolve_compensation_display_mode",
          "code": "RESOLVE_COMPENSATION_DISPLAY_MODE",
          "type": "CODE",
          "metadata": {
            "name": "Resolve compensation display mode",
            "sourceCode": "// Validate service envelopes before their data is consumed; valid empty collections remain valid.\nfunction hcmHttpStatus(value) {\n  if (value == null || value === '') return 0;\n  if (typeof value === 'string') {\n    if (!/^[1-5][0-9]{2}$/.test(value)) throw new Error('A service returned an invalid HTTP status.');\n    value = Number(value);\n  }\n  if (typeof value !== 'number' || !Number.isInteger(value) || value < 100 || value > 599) throw new Error('A service returned an invalid HTTP status.');\n  return value;\n}\nfunction hcmResponseStatus(value) {\n  if (value.statusCode != null) return hcmHttpStatus(value.statusCode);\n  const status = value.status;\n  if (typeof status === 'number' || (typeof status === 'string' && /^[1-5][0-9]{2}$/.test(status))) return hcmHttpStatus(status);\n  return typeof status === 'string' && /^(failed|failure|error|timeout|timed_out|cancelled)$/i.test(status) ? 500 : 0;\n}\nfunction hcmCheckServiceNode(node) {\n  if (!node || !Object.prototype.hasOwnProperty.call(node, '$output')) return;\n  let value = node.$output;\n  for (let depth=0; depth<12; depth++) {\n    if (typeof value === 'string') { if (!value.trim()) throw new Error('A required service response is empty.'); value=JSON.parse(value); continue; }\n    if (value == null || typeof value !== 'object') throw new Error('A required service response is missing or invalid.');\n    if (Array.isArray(value)) return;\n    if (value.error || value.timeout === true || value.timedOut === true || value.isError === true || value.success === false || hcmResponseStatus(value) >= 400) throw new Error('A required service request failed.');\n    if (value.hasMore === true || value.hasMore === 'true') throw new Error('The service returned incomplete, paginated data. Complete data is required.');\n    if (Object.prototype.hasOwnProperty.call(value,'result')) {value=value.result;continue;}\n    if (Object.prototype.hasOwnProperty.call(value,'output')) {value=value.output;continue;}\n    return;\n  }\n  throw new Error('A service response has too many nested envelopes.');\n}\nhcmCheckServiceNode($context?.$nodes?.FETCH_CONTEXT_PERSON_BY_ID);\nhcmCheckServiceNode($context?.$nodes?.GET_PRIMARY_ASSIGNMENT_REST);\nhcmCheckServiceNode($context?.$nodes?.FETCH_CONTEXT_SESSION_PERSON_NUMBER);\nhcmCheckServiceNode($context?.$nodes?.FETCH_CONTEXT_PERSON_BY_NUMBER);\nhcmCheckServiceNode($context?.$nodes?.RETRIEVE_EMPLOYEE_SALARY_HISTORY);\nhcmCheckServiceNode($context?.$nodes?.GET_CURRENT_COMPENSATION_REST);\nhcmCheckServiceNode($context?.$nodes?.GET_PRIOR_COMPENSATION_REST);\nhcmCheckServiceNode($context?.$nodes?.GET_STOCK_HISTORY_FOR_REST_PERSON);\nconst mode = ($context.$nodes.EXTRACT_WORKFLOW_PERSON_CONTEXT.$output.result.isQuestionRequest === true ? 'Query' : $context.$app.$OraMessageHint != null && $context.$app.$OraMessageHint !== '' ? $context.$app.$OraMessageHint : $context.$nodes.EXTRACT_WORKFLOW_PERSON_CONTEXT.$output.result.displayMode); return { mode: [\"InitDisplay\", \"REST\", \"Query\"].indexOf(mode) >= 0 ? mode : 'Unsupported' };",
            "returnType": "object",
            "errorNodeId": "fix_processing_error"
          },
          "outcomes": {
            "success": "10"
          },
          "inputs": [],
          "diagram": {
            "x": 6032.5,
            "y": 12933
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "salary_currency_conversion_error",
          "code": "SALARY_CURRENCY_CONVERSION_ERROR",
          "type": "RETURN",
          "metadata": {
            "name": "Return salary-currency conversion error"
          },
          "outcomes": {},
          "inputs": [
            {
              "id": "salary_currency_conversion_error_returnValue",
              "name": "returnValue",
              "type": "string",
              "value": "{\"error\": {\"code\": \"CURRENCY_CONVERSION_FAILED\", \"message\": \"Compensation could not be converted to the employee's salary currency because a currency, exchange rate or required amount is missing or invalid. Refresh the data and try again.\"}}"
            }
          ],
          "diagram": {
            "x": 9157.5,
            "y": 5000
          }
        },
        {
          "id": "prepare_salary_currency_conversion",
          "code": "PREPARE_SALARY_CURRENCY_CONVERSION",
          "type": "CODE",
          "metadata": {
            "name": "Prepare component-to-salary currency conversions",
            "sourceCode": "function fxNumber(value) {\n  if (typeof value === 'string') {\n    if (!/^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$/.test(value.trim())) throw new Error('A compensation amount or exchange rate is not numeric.');\n    value=Number(value.trim());\n  }\n  if (typeof value !== 'number' || !Number.isFinite(value) || Math.abs(value)>Number.MAX_SAFE_INTEGER/100) throw new Error('A compensation amount or exchange rate is outside the supported range.');\n  return value;\n}\nfunction fxCurrency(value) {\n  if (typeof value !== 'string' || !/^[A-Z]{3}$/.test(value.trim().toUpperCase())) throw new Error('The salary or component currency is missing or invalid.');\n  return value.trim().toUpperCase();\n}\nfunction fxDate(value) {\n  if (typeof value !== 'string') throw new Error('A conversion date is required.');\n  if (/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})?$/.test(value)) { if(!Number.isFinite(new Date(value).getTime()))throw new Error('The conversion timestamp is invalid.'); value=value.slice(0,10); }\n  if (!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(value)) throw new Error('The conversion date is invalid.');\n  const date=new Date(value+'T00:00:00Z');\n  if (!Number.isFinite(date.getTime()) || date.toISOString().slice(0,10)!==value) throw new Error('The conversion date is invalid.');\n  return value;\n}\nfunction fxDecode(value) {\n  for(let depth=0;depth<12;depth++) {\n    if(typeof value==='string'){\n      const text=value.trim();\n      if(!text || !/^[\\[{\"]/.test(text))throw new Error('Exchange-rate execution returned text instead of JSON rate data.');\n      try{value=JSON.parse(text);}catch(error){throw new Error('Exchange-rate execution returned malformed JSON rate data.');}\n      continue;\n    }\n    if(value==null || typeof value!=='object') throw new Error('An exchange-rate response is empty or invalid.');\n    if(Array.isArray(value))return value;\n    if(value.error || value.success===false || value.timeout===true || value.timedOut===true || value.hasMore===true)throw new Error('Exchange-rate retrieval failed or returned incomplete data.');\n    if(Object.prototype.hasOwnProperty.call(value,'result')){value=value.result;continue;}\n    if(Object.prototype.hasOwnProperty.call(value,'output')){value=value.output;continue;}\n    return value;\n  }\n  throw new Error('An exchange-rate response has too many nested envelopes.');\n}\nfunction fxRound(value){value=fxNumber(value);const scaled=Math.abs(value)*100;const cents=Math.round(scaled+Number.EPSILON*Math.max(1,scaled));if(!Number.isSafeInteger(cents))throw new Error('A converted amount exceeds safe precision.');return (value<0?-cents:cents)/100;}\nfunction fxAdd(a,b){return fxNumber(a+b);}\nfunction fxCopy(value){return JSON.parse(JSON.stringify(value));}\n\nconst conversionDate=fxDate($context?.$system?.$currentDate);\nconst requests=[];\nfunction addRequest(from,to){from=fxCurrency(from);to=fxCurrency(to);if(from===to)return;if(!requests.some(item=>item.fromCurrency===from&&item.toCurrency===to))requests.push({fromCurrency:from,toCurrency:to,conversionDate});}\n\nconst history=$context.$nodes.COMBINE_COMPENSATION_HISTORY_OUTPUTS.$output.result;\nif(!history || !Array.isArray(history.yearlyCompensation))throw new Error('Yearly compensation history is unavailable.');\nconst targets={};\nfunction historyTarget(year){\n  const supplied=history.yearlyCompensation.filter(row=>String(row.year)===year).map(row=>row.targetSalaryCurrency || row.salaryCurrency).filter(Boolean);\n  if(supplied.length){const target=fxCurrency(supplied[0]);if(supplied.some(code=>fxCurrency(code)!==target))throw new Error('A history year has conflicting salary currencies.');return target;}\n  const start=year+'-01-01',end=year+'-12-31';\n  const salaries=history.salaryHistory.filter(row=>{const from=fxDate(row.DateFrom);const open=row.DateTo==null||row.DateTo===''||row.DateTo==='4712-12-31';return from<=end && (open || fxDate(row.DateTo)>=start);}).sort((a,z)=>String(z.DateFrom).localeCompare(String(a.DateFrom)));\n  if(!salaries.length)throw new Error('The salary currency for a compensation history year is unavailable.');\n  return fxCurrency(salaries[0].CurrencyCode);\n}\nfor(const row of history.yearlyCompensation){\n  const year=String(row.year);const target=historyTarget(year);targets[year]=target;\n  for(const pair of [['annualSalary','salaryCurrency'],['bonus','bonusCurrency'],['stocks','stockCurrency']]){\n    if(row[pair[0]]!=null)addRequest(row[pair[1]],target);\n  }\n}\nfor(const item of history.bonusHistory){const year=fxDate(item.EffectiveStartDate).slice(0,4);const target=targets[year] || historyTarget(year);targets[year]=target;addRequest(item.DisplayCurrency || item.CurrencyCode,target);}\nfor(const item of history.stockHistory){const year=fxDate(item.OriginalGrantDate).slice(0,4);const target=targets[year] || historyTarget(year);targets[year]=target;addRequest(item.StockPriceCurrencyCode,target);}\nreturn {history,requests,conversionDate,targets};\n",
