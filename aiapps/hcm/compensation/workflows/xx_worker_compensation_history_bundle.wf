        {
          "id": "convert_compensation_to_salary_currency",
          "code": "CONVERT_COMPENSATION_TO_SALARY_CURRENCY",
          "type": "CODE",
          "metadata": {
            "name": "Convert compensation amounts to salary currency",
            "sourceCode": "function fxNumber(value) {\n  if (typeof value === 'string') {\n    if (!/^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$/.test(value.trim())) throw new Error('A compensation amount or exchange rate is not numeric.');\n    value=Number(value.trim());\n  }\n  if (typeof value !== 'number' || !Number.isFinite(value) || Math.abs(value)>Number.MAX_SAFE_INTEGER/100) throw new Error('A compensation amount or exchange rate is outside the supported range.');\n  return value;\n}\nfunction fxCurrency(value) {\n  if (typeof value !== 'string' || !/^[A-Z]{3}$/.test(value.trim().toUpperCase())) throw new Error('The salary or component currency is missing or invalid.');\n  return value.trim().toUpperCase();\n}\nfunction fxDate(value) {\n  if (typeof value !== 'string') throw new Error('A conversion date is required.');\n  if (/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})?$/.test(value)) { if(!Number.isFinite(new Date(value).getTime()))throw new Error('The conversion timestamp is invalid.'); value=value.slice(0,10); }\n  if (!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(value)) throw new Error('The conversion date is invalid.');\n  const date=new Date(value+'T00:00:00Z');\n  if (!Number.isFinite(date.getTime()) || date.toISOString().slice(0,10)!==value) throw new Error('The conversion date is invalid.');\n  return value;\n}\nfunction fxDecode(value) {\n  for(let depth=0;depth<12;depth++) {\n    if(typeof value==='string'){\n      const text=value.trim();\n      if(!text || !/^[\\[{\"]/.test(text))throw new Error('Exchange-rate execution returned text instead of JSON rate data.');\n      try{value=JSON.parse(text);}catch(error){throw new Error('Exchange-rate execution returned malformed JSON rate data.');}\n      continue;\n    }\n    if(value==null || typeof value!=='object') throw new Error('An exchange-rate response is empty or invalid.');\n    if(Array.isArray(value))return value;\n    if(value.error || value.success===false || value.timeout===true || value.timedOut===true || value.hasMore===true)throw new Error('Exchange-rate retrieval failed or returned incomplete data.');\n    if(Object.prototype.hasOwnProperty.call(value,'result')){value=value.result;continue;}\n    if(Object.prototype.hasOwnProperty.call(value,'output')){value=value.output;continue;}\n    return value;\n  }\n  throw new Error('An exchange-rate response has too many nested envelopes.');\n}\nfunction fxRound(value){value=fxNumber(value);const scaled=Math.abs(value)*100;const cents=Math.round(scaled+Number.EPSILON*Math.max(1,scaled));if(!Number.isSafeInteger(cents))throw new Error('A converted amount exceeds safe precision.');return (value<0?-cents:cents)/100;}\nfunction fxAdd(a,b){return fxNumber(a+b);}\nfunction fxCopy(value){return JSON.parse(JSON.stringify(value));}\n\nconst prepared=$context.$nodes.PREPARE_SALARY_CURRENCY_CONVERSION.$output.result;\nconst lookup={};\nfunction collect(value){value=fxDecode(value);if(Array.isArray(value)){value.forEach(collect);return;}const from=fxCurrency(value.fromCurrency),to=fxCurrency(value.toCurrency),date=fxDate(value.conversionDate);const rate=fxNumber(value.exchangeRate);if(rate<=0 || date!==prepared.conversionDate)throw new Error('An exchange rate is invalid or has the wrong date.');const request=prepared.requests.find(r=>r.fromCurrency===from&&r.toCurrency===to&&r.conversionDate===date);if(!request)throw new Error('An exchange rate does not match a requested currency pair.');const key=from+'|'+to;if(lookup[key]!=null&&lookup[key]!==rate)throw new Error('Conflicting exchange rates were returned.');lookup[key]=rate;}\nif(prepared.requests.length)collect($context.$nodes.FETCH_SALARY_CURRENCY_EXCHANGE_RATES.$output);\nfunction rate(from,to){from=fxCurrency(from);to=fxCurrency(to);if(from===to)return 1;const value=lookup[from+'|'+to];if(value==null)throw new Error('An exchange rate required for the salary currency is missing.');return value;}\nfunction money(value,from,to){return value==null?null:fxRound(fxNumber(value)*rate(from,to));}\nfunction normalizeBonus(records,target){return records.map(original=>{const row=fxCopy(original),from=fxCurrency(row.DisplayCurrency || row.CurrencyCode);const multiplier=rate(from,target);for(const field of ['ValueCurrency','ValueNumber','ScreenEntryValue','ValueString']){if(row[field]==null)continue;if(field==='ValueString' && typeof row[field]==='string' && !/^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$/.test(row[field].trim()))continue;const converted=fxRound(fxNumber(row[field])*multiplier);row[field]=typeof row[field]==='string'?converted.toFixed(2):converted;}row.DisplayCurrency=target;if(row.CurrencyCode!=null)row.CurrencyCode=target;row.sourceCurrency=row.sourceCurrency || from;row.exchangeRate=from===target && row.exchangeRate!=null?row.exchangeRate:multiplier;return row;});}\nfunction normalizeStocks(records,target){return records.map(original=>{const row=fxCopy(original),from=fxCurrency(row.StockPriceCurrencyCode),multiplier=rate(from,target);for(const field of ['OriginalGrantPrice','EstimatedStockPrice']){if(row[field]!=null)row[field]=fxNumber(fxNumber(row[field])*multiplier);}row.StockPriceCurrencyCode=target;row.sourceCurrency=row.sourceCurrency || from;row.exchangeRate=from===target && row.exchangeRate!=null?row.exchangeRate:multiplier;return row;});}\n\nconst history=fxCopy(prepared.history),years={};\nfor(const row of history.yearlyCompensation){\n  const target=fxCurrency(row.targetSalaryCurrency || row.salaryCurrency),key=String(row.year);\n  if(!years[key])years[key]={year:row.year,annualSalary:null,salaryCurrency:target,bonus:null,bonusCurrency:target,stocks:null,stockCurrency:target,vestedShares:null,totalCompensation:null,totalCurrency:target,conversionDate:prepared.conversionDate};\n  const total=years[key];if(total.totalCurrency!==target)throw new Error('A history year has conflicting salary currencies.');\n  for(const pair of [['annualSalary','salaryCurrency'],['bonus','bonusCurrency'],['stocks','stockCurrency']]){const amount=money(row[pair[0]],row[pair[1]],target);if(amount!=null)total[pair[0]]=fxAdd(total[pair[0]]??0,amount);}\n  if(row.vestedShares!=null)total.vestedShares=fxAdd(total.vestedShares??0,fxNumber(row.vestedShares));\n}\nhistory.sourceYearlyCompensation=history.yearlyCompensation;\nhistory.yearlyCompensation=Object.keys(years).sort((a,b)=>b.localeCompare(a)).map(key=>{const row=years[key];for(const f of ['annualSalary','bonus','stocks'])if(row[f]!=null)row[f]=fxRound(row[f]);row.totalCompensation=fxRound(fxAdd(fxAdd(row.annualSalary??0,row.bonus??0),row.stocks??0));return row;});\nfunction targetForDate(date){const valid=fxDate(date),year=valid.slice(0,4);const row=years[year] || (prepared.targets[year]?{totalCurrency:prepared.targets[year]}:null);if(!row)throw new Error('The salary currency for a compensation history year is unavailable.');return row.totalCurrency;}\nhistory.sourceBonusHistory=history.bonusHistory;history.sourceStockHistory=history.stockHistory;\nhistory.bonusHistory=history.bonusHistory.map(row=>normalizeBonus([row],targetForDate(row.EffectiveStartDate))[0]);\nhistory.stockHistory=history.stockHistory.map(row=>normalizeStocks([row],targetForDate(row.OriginalGrantDate))[0]);\nhistory.salaryCurrencyConversionDate=prepared.conversionDate;\nreturn history;\n",
            "returnType": "object",
            "errorNodeId": "salary_currency_conversion_error"
          },
