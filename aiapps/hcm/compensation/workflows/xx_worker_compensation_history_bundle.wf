        {
          "id": "4",
          "code": "COMBINE_COMPENSATION_HISTORY_OUTPUTS",
          "type": "CODE",
          "metadata": {
            "name": "Combine Compensation History Outputs",
            "description": "Combines the completed salary, bonus, and stock history workflow outputs into one payload.",
            "returnType": "object",
            "sourceCode": "// Validate service envelopes before their data is consumed; valid empty collections remain valid.\nfunction hcmHttpStatus(value) {\n  if (value == null || value === '') return 0;\n  if (typeof value === 'string') {\n    if (!/^[1-5][0-9]{2}$/.test(value)) throw new Error('A service returned an invalid HTTP status.');\n    value = Number(value);\n  }\n  if (typeof value !== 'number' || !Number.isInteger(value) || value < 100 || value > 599) throw new Error('A service returned an invalid HTTP status.');\n  return value;\n}\nfunction hcmResponseStatus(value) {\n  if (value.statusCode != null) return hcmHttpStatus(value.statusCode);\n  const status = value.status;\n  if (typeof status === 'number' || (typeof status === 'string' && /^[1-5][0-9]{2}$/.test(status))) return hcmHttpStatus(status);\n  return typeof status === 'string' && /^(failed|failure|error|timeout|timed_out|cancelled)$/i.test(status) ? 500 : 0;\n}\nfunction hcmCheckServiceNode(node) {\n  if (!node || !Object.prototype.hasOwnProperty.call(node, '$output')) return;\n  let value = node.$output;\n  for (let depth=0; depth<12; depth++) {\n    if (typeof value === 'string') { if (!value.trim()) throw new Error('A required service response is empty.'); value=JSON.parse(value); continue; }\n    if (value == null || typeof value !== 'object') throw new Error('A required service response is missing or invalid.');\n    if (Array.isArray(value)) return;\n    if (value.error || value.timeout === true || value.timedOut === true || value.isError === true || value.success === false || hcmResponseStatus(value) >= 400) throw new Error('A required service request failed.');\n    if (value.hasMore === true || value.hasMore === 'true') throw new Error('The service returned incomplete, paginated data. Complete data is required.');\n    if (Object.prototype.hasOwnProperty.call(value,'result')) {value=value.result;continue;}\n    if (Object.prototype.hasOwnProperty.call(value,'output')) {value=value.output;continue;}\n    return;\n  }\n  throw new Error('A service response has too many nested envelopes.');\n}\n\nhcmCheckServiceNode($context?.$nodes?.RETRIEVE_EMPLOYEE_SALARY_HISTORY);\nhcmCheckServiceNode($context?.$nodes?.GET_STOCK_HISTORY_FOR_REST_PERSON);\nfunction strictNumber(value) {\n  if (value == null) return null;\n  if (typeof value === 'string') {\n    if (!/^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$/.test(value.trim())) throw new Error('Invalid compensation number.');\n    value = Number(value.trim());\n  }\n  if (typeof value !== 'number' || !Number.isFinite(value) || Math.abs(value) > Number.MAX_SAFE_INTEGER / 100) throw new Error('Compensation number is invalid or outside the supported range.');\n  return value;\n}\nfunction checked(value) { const result = strictNumber(value); if (result === null) throw new Error('A required compensation amount is missing.'); return result; }\nfunction componentCurrency(value) {\n  if (typeof value !== 'string' || !/^[A-Z]{3}$/.test(value.trim().toUpperCase())) throw new Error('A compensation component currency is missing or invalid.');\n  return value.trim().toUpperCase();\n}\nfunction parseResult(value) {\n  let parsed = value;\n\n  // Support JSON strings and result wrappers.\n  for (let depth = 0; depth < 10; depth += 1) {\n    if (typeof parsed === \"string\") {\n      if (!parsed.trim()) return {};\n      parsed = JSON.parse(parsed);\n      continue;\n    }\n\n    if (\n      parsed !== null &&\n      typeof parsed === \"object\" &&\n      Object.prototype.hasOwnProperty.call(parsed, \"result\")\n    ) {\n      parsed = parsed.result;\n      continue;\n    }\n\n    return parsed ?? {};\n  }\n\n  throw new Error(\"Compensation input has too many nested result wrappers.\");\n}\n\nfunction asArray(value) {\n  return Array.isArray(value) ? value : [];\n}\n\n// New input paths.\nconst bonusResult = parseResult(\n  $context.$nodes.GET_EMPLOYEE_BONUS_HISTORY.$output?.result\n);\n\nconst salaryResult = parseResult(\n  $context.$nodes.RETRIEVE_EMPLOYEE_SALARY_HISTORY.$output\n);\n\nconst stockResult = parseResult(\n  $context.$nodes.GET_STOCK_HISTORY_FOR_REST_PERSON.$output\n);\n\nconst salaryHistory = asArray(salaryResult.items);\n\nconst bonusHistory = [\n  ...asArray(bonusResult.priorCompensation),\n  ...asArray(bonusResult.currentCompensation)\n];\n\nconst stockHistory = asArray(stockResult.items);\n\nfunction toNumber(value) { return strictNumber(value); }\n\nfunction toDate(value) {\n  if (typeof value !== \"string\") return null;\n\n  const text = value.trim();\n\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(text)) return null;\n\n  const date = new Date(text + \"T00:00:00Z\");\n\n  if (!Number.isFinite(date.getTime())) return null;\n  if (date.toISOString().slice(0, 10) !== text) return null;\n\n  const year = Number(text.slice(0, 4));\n\n  return year > 0 && year < 4712 ? text : null;\n}\n\nfunction toCurrency(value) {\n  if (typeof value !== \"string\") return null;\n\n  const code = value.trim().toUpperCase();\n\n  return /^[A-Z]{3}$/.test(code) ? code : null;\n}\n\nfunction sum(entries) {\n  return entries.reduce((total, entry) => checked(total + checked(entry.amount)), 0);\n}\n\nfunction commonCurrency(entries) {\n  if (!entries.length || !entries[0].currency) return null;\n\n  const code = entries[0].currency;\n\n  return entries.every(entry => entry.currency === code)\n    ? code\n    : null;\n}\n\nfunction roundAmount(value) {\n  return Number(value.toFixed(2));\n}\n\n// Current year in India: UTC + 05:30.\nconst indiaOffsetMs = 19800000;\nconst currentYear = new Date(\n  Date.now() + indiaOffsetMs\n).getUTCFullYear();\n\nconst sourceDates = [\n  ...salaryHistory.map(record => toDate(record.DateFrom)),\n  ...bonusHistory.map(record => toDate(record.EffectiveStartDate)),\n  ...stockHistory.map(record => toDate(record.OriginalGrantDate))\n].filter(Boolean);\n\nconst earliestYear = sourceDates.length\n  ? Math.min(...sourceDates.map(date => Number(date.slice(0, 4))))\n  : null;\n\nconst yearlyCompensation = [];\n\nif (earliestYear !== null) {\n  for (let year = earliestYear; year <= currentYear; year += 1) {\n    const yearStart = String(year) + \"-01-01\";\n    const yearEnd = String(year) + \"-12-31\";\n\n    const effectiveSalaries = salaryHistory\n      .filter(record => {\n        const start = toDate(record.DateFrom);\n\n        const openEnded =\n          record.DateTo == null ||\n          record.DateTo === \"\" ||\n          record.DateTo === \"4712-12-31\";\n\n        const end = openEnded ? null : toDate(record.DateTo);\n\n        return (\n          start !== null &&\n          start <= yearEnd &&\n          (openEnded || (end !== null && end >= yearStart))\n        );\n      })\n      .sort((a, b) => {\n        if (a.DateFrom < b.DateFrom) return 1;\n        if (a.DateFrom > b.DateFrom) return -1;\n        return 0;\n      });\n\n    // Preserve original logic: latest applicable annual salary\n    // for the year, without prorating.\n    const salaryRecord = effectiveSalaries[0];\n    const salaryEntries = [];\n\n    if (salaryRecord) {\n      let annualSalary = toNumber(salaryRecord.AnnualSalary);\n\n      if (\n        annualSalary === null &&\n        salaryRecord.SalaryFrequencyCode === \"MONTHLY\"\n      ) {\n        const monthlySalary = toNumber(salaryRecord.SalaryAmount);\n\n        if (monthlySalary !== null) {\n          annualSalary = checked(monthlySalary * 12);\n        }\n      }\n\n      if (\n        annualSalary !== null &&\n        Number.isFinite(annualSalary)\n      ) {\n        salaryEntries.push({\n          amount: annualSalary,\n          currency: toCurrency(salaryRecord.CurrencyCode)\n        });\n      }\n    }\n\n    const bonusEntries = [];\n\n    for (const record of bonusHistory) {\n      const date = toDate(record.EffectiveStartDate);\n\n      if (!date || Number(date.slice(0, 4)) !== year) continue;\n\n      const amount =\n        toNumber(record.ValueCurrency) ??\n        toNumber(record.ScreenEntryValue);\n\n      if (amount === null) continue;\n\n      bonusEntries.push({\n        amount,\n        currency: toCurrency(record.DisplayCurrency)\n      });\n    }\n\n    const stockEntries = [];\n\n    for (const record of stockHistory) {\n      const date = toDate(record.OriginalGrantDate);\n\n      if (!date || Number(date.slice(0, 4)) !== year) continue;\n\n      const shares = toNumber(record.VestedShares);\n      const price = toNumber(record.OriginalGrantPrice);\n\n      if (\n        shares === null ||\n        price === null ||\n        shares <= 0 ||\n        price < 0\n      ) {\n        continue;\n      }\n\n      const amount = checked(shares * price);\n\n      if (!Number.isFinite(amount)) continue;\n\n      stockEntries.push({\n        amount,\n        shares,\n        currency: toCurrency(record.StockPriceCurrencyCode)\n      });\n    }\n\n    const allEntries = [\n      ...salaryEntries,\n      ...bonusEntries,\n      ...stockEntries\n    ];\n\n    if (!allEntries.length) continue;\n\n    const targetSalaryCurrency = salaryRecord ? toCurrency(salaryRecord.CurrencyCode) : null;\n    const currencies = Array.from(new Set(allEntries.map(entry => componentCurrency(entry.currency)))).sort();\n    for (const currency of currencies) {\n      const salaryEntriesForCurrency = salaryEntries.filter(entry => entry.currency === currency);\n      const bonusEntriesForCurrency = bonusEntries.filter(entry => entry.currency === currency);\n      const stockEntriesForCurrency = stockEntries.filter(entry => entry.currency === currency);\n      const allEntriesForCurrency = salaryEntriesForCurrency.concat(bonusEntriesForCurrency, stockEntriesForCurrency);\n      yearlyCompensation.push({\n      targetSalaryCurrency,\n      year,\n\n      annualSalary: salaryEntriesForCurrency.length\n        ? roundAmount(sum(salaryEntriesForCurrency))\n        : null,\n\n      salaryCurrency: commonCurrency(salaryEntriesForCurrency),\n\n      bonus: bonusEntriesForCurrency.length\n        ? roundAmount(sum(bonusEntriesForCurrency))\n        : null,\n\n      bonusCurrency: commonCurrency(bonusEntriesForCurrency),\n\n      stocks: stockEntriesForCurrency.length\n        ? roundAmount(sum(stockEntriesForCurrency))\n        : null,\n\n      stockCurrency: commonCurrency(stockEntriesForCurrency),\n\n      vestedShares: stockEntriesForCurrency.length\n        ? stockEntriesForCurrency.reduce(\n            (total, entry) => total + entry.shares,\n            0\n          )\n        : null,\n\n      // Sum only components sharing this validated currency.\n      totalCompensation: roundAmount(sum(allEntriesForCurrency)),\n\n      // Each row has exactly one validated currency.\n      totalCurrency: commonCurrency(allEntriesForCurrency)\n    });\n    }\n  }\n}\n\nreturn {\n  salaryHistory,\n  bonusHistory,\n  stockHistory,\n  yearlyCompensation\n};",
            "errorNodeId": "fix_processing_error"
          },
          "outcomes": {
            "success": "prepare_salary_currency_conversion"
          },
          "inputs": [],
