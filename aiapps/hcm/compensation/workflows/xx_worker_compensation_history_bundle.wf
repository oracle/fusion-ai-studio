            "sourceCode": "function numericId(value) {\n  if (typeof value === 'number') {\n    if (!Number.isSafeInteger(value) || value <= 0) return false;\n    value = String(value);\n  }\n  return typeof value === 'string' && /^[0-9]+$/.test(value) && /[1-9]/.test(value);\n}\n\nconst personId =\n  $context.$nodes.RESOLVE_EMPLOYEE_CONTEXT.$output.result?.personId;\n\nreturn { valid: numericId(personId) };",
