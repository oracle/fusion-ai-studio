            "description": "Fails closed unless every identifier supplied to this call is a non-empty numeric string.",
            "returnType": "object",
            "sourceCode": "function numericString(value) {\n  if (typeof value === 'number') {\n    if (!Number.isSafeInteger(value) || value <= 0) return false;\n    value = String(value);\n  }\n  return typeof value === 'string' && /^[0-9]+$/.test(value) && /[1-9]/.test(value);\n}\n\nconst groups = $context.$variables.DirectReportsCompensationDetails;\nif (!Array.isArray(groups)) throw new Error('Incomplete team compensation response.');\nconst displayGroups = groups.map(group => {\n  if (!group || !Array.isArray(group.data)) throw new Error('Incomplete team compensation response.');\n  return { currencyCode: group.currencyCode, data: group.data.map(row => {\n    const display = {};\n    for (const key of ['PersonId','AssignmentId','DisplayName','AssignmentName','computedAnnualSalary','computedBonus','computedStockValue','computedVestedShares','computedTotalCompensation','computedCurrencyTotals']) display[key] = row[key];\n    return display;\n  }) };\n});\nreturn { valid: numericString(($context.$nodes.RESOLVE_WORKFLOW_PERSON_CONTEXT.$output.result.personId)), groups: displayGroups };",
