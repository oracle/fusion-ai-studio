        {
          "id": "prepare_salary_currency_conversion",
          "code": "PREPARE_SALARY_CURRENCY_CONVERSION",
          "type": "CODE",
          "metadata": {
            "name": "Prepare component-to-salary currency conversions",
            "sourceCode": "function fxNumber(value) {\n  if (typeof value === 'string') {\n    if (!/^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$/.test(value.trim())) throw new Error('A compensation amount or exchange rate is not numeric.');\n    value=Number(value.trim());\n  }\n  if (typeof value !== 'number' || !Number.isFinite(value) || Math.abs(value)>Number.MAX_SAFE_INTEGER/100) throw new Error('A compensation amount or exchange rate is outside the supported range.');\n  return value;\n}\nfunction fxCurrency(value) {\n  if (typeof value !== 'string' || !/^[A-Z]{3}$/.test(value.trim().toUpperCase())) throw new Error('The salary or component currency is missing or invalid.');\n  return value.trim().toUpperCase();\n}\nfunction fxDate(value) {\n  if (typeof value !== 'string') throw new Error('A conversion date is required.');\n  if (/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})?$/.test(value)) { if(!Number.isFinite(new Date(value).getTime()))throw new Error('The conversion timestamp is invalid.'); value=value.slice(0,10); }\n  if (!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(value)) throw new Error('The conversion date is invalid.');\n  const date=new Date(value+'T00:00:00Z');\n  if (!Number.isFinite(date.getTime()) || date.toISOString().slice(0,10)!==value) throw new Error('The conversion date is invalid.');\n  return value;\n}\nfunction fxDecode(value) {\n  for(let depth=0;depth<12;depth++) {\n    if(typeof value==='string'){\n      const text=value.trim();\n      if(!text || !/^[\\[{\"]/.test(text))throw new Error('Exchange-rate execution returned text instead of JSON rate data.');\n      try{value=JSON.parse(text);}catch(error){throw new Error('Exchange-rate execution returned malformed JSON rate data.');}\n      continue;\n    }\n    if(value==null || typeof value!=='object') throw new Error('An exchange-rate response is empty or invalid.');\n    if(Array.isArray(value))return value;\n    if(value.error || value.success===false || value.timeout===true || value.timedOut===true || value.hasMore===true)throw new Error('Exchange-rate retrieval failed or returned incomplete data.');\n    if(Object.prototype.hasOwnProperty.call(value,'result')){value=value.result;continue;}\n    if(Object.prototype.hasOwnProperty.call(value,'output')){value=value.output;continue;}\n    return value;\n  }\n  throw new Error('An exchange-rate response has too many nested envelopes.');\n}\nfunction fxRound(value){value=fxNumber(value);const scaled=Math.abs(value)*100;const cents=Math.round(scaled+Number.EPSILON*Math.max(1,scaled));if(!Number.isSafeInteger(cents))throw new Error('A converted amount exceeds safe precision.');return (value<0?-cents:cents)/100;}\nfunction fxAdd(a,b){return fxNumber(a+b);}\nfunction fxCopy(value){return JSON.parse(JSON.stringify(value));}\n\nconst conversionDate=fxDate($context?.$system?.$currentDate);\nconst requests=[];\nfunction addRequest(from,to){from=fxCurrency(from);to=fxCurrency(to);if(from===to)return;if(!requests.some(item=>item.fromCurrency===from&&item.toCurrency===to))requests.push({fromCurrency:from,toCurrency:to,conversionDate});}\n\nconst workflowMode=$context.$nodes.EXTRACT_WORKFLOW_PERSON_CONTEXT.$output.result.workflowMode===true;\nconst personId=$context.$nodes.RESOLVE_WORKFLOW_PERSON_CONTEXT.$output.result.personId;\nconst cached=$context?.$variables?.DirectReportsCompensationDetails;\nconst useCachedData=!!cached && $context?.$variables?.TeamCompensationPersonId===personId;\nlet groups=workflowMode ? $context.$nodes.ALL_DIRECT_REPORT_COMP_DETAILS_WF.$output.result : useCachedData ? cached : $context.$nodes.ALL_DIRECT_REPORT_COMP_DETAILS.$output.result;\nif(typeof groups==='string')groups=JSON.parse(groups);\nif(!Array.isArray(groups))throw new Error('Employee compensation groups are unavailable.');\ngroups=fxCopy(groups);\nfor(const group of groups){\n  if(!group || !Array.isArray(group.data))throw new Error('An employee compensation group is invalid.');\n  for(const employee of group.data){\n    const target=fxCurrency(employee.CmpCurrencyCode);\n    if(Array.isArray(employee.sourceCurrencyTotals) && (employee.salaryCurrencyConversionDate!==conversionDate || employee.computedCompensationCurrency!==target)) {\n      employee.computedCurrencyTotals=fxCopy(employee.sourceCurrencyTotals);\n      if(employee.sourceIndividualCompensationDetails)employee.individualCompensationDetails=fxCopy(employee.sourceIndividualCompensationDetails);\n      if(employee.sourceCompensationDetails)employee.compensationDetails=fxCopy(employee.sourceCompensationDetails);\n      if(employee.sourceStockDetails)employee.stockDetails=fxCopy(employee.sourceStockDetails);\n    }\n    if(!Array.isArray(employee.computedCurrencyTotals) || !employee.computedCurrencyTotals.length)throw new Error('Component currency totals are unavailable. Refresh the compensation records.');\n    for(const component of employee.computedCurrencyTotals){\n      const source=fxCurrency(component.currencyCode);\n      if(['computedAnnualSalary','computedBonus','computedStockValue'].some(field=>component[field]!=null))addRequest(source,target);\n    }\n  }\n}\nreturn {groups,requests,conversionDate,workflowMode};\n",
            "returnType": "object",
            "errorNodeId": "salary_currency_conversion_error"
          },
