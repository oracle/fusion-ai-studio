          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentNumber\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentName\": {\n            \"type\": \"string\"\n          },\n          \"LegalEmployerName\": {\n            \"type\": \"string\"\n          },\n          \"StartDate\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryFlag\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryAssignmentFlag\": {\n            \"type\": \"string\"\n          },\n          \"WorkerType\": {\n            \"type\": \"string\"\n          },\n          \"WorkerNumber\": {\n            \"type\": \"string\"\n          },\n          \"ManagerName\": {\n            \"type\": \"string\"\n          },\n          \"BusinessUnitName\": {\n            \"type\": \"string\"\n          },\n          \"DepartmentName\": {\n            \"type\": \"string\"\n          },\n          \"JobCode\": {\n            \"type\": \"string\"\n          },\n          \"JobName\": {\n            \"type\": \"string\"\n          },\n          \"PositionCode\": {\n            \"type\": \"string\"\n          },\n          \"PositionName\": {\n            \"type\": \"string\"\n          },\n          \"LocationCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationName\": {\n            \"type\": \"string\"\n          },\n          \"GradeCode\": {\n            \"type\": \"string\"\n          },\n          \"GradeName\": {\n            \"type\": \"string\"\n          },\n          \"LocationPostalCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationCountry\": {\n            \"type\": \"string\"\n          },\n          \"LengthOfServiceYears\": {\n            \"type\": \"string\"\n          },\n          \"MarkedAsFavoriteFlag\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"PersonId\",\n          \"AssignmentId\",\n          \"AssignmentNumber\",\n          \"AssignmentName\",\n          \"LegalEmployerName\",\n          \"StartDate\",\n          \"PrimaryFlag\",\n          \"PrimaryAssignmentFlag\",\n          \"WorkerType\",\n          \"WorkerNumber\",\n          \"ManagerName\",\n          \"BusinessUnitName\",\n          \"DepartmentName\",\n          \"JobCode\",\n          \"JobName\",\n          \"PositionCode\",\n          \"PositionName\",\n          \"LocationCode\",\n          \"LocationName\",\n          \"GradeCode\",\n          \"GradeName\",\n          \"LocationPostalCode\",\n          \"LocationCountry\",\n          \"LengthOfServiceYears\",\n          \"MarkedAsFavoriteFlag\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "BUILD_STOCK_HISTORY_DISPLAY_DATA",
          "code": "BUILD_STOCK_HISTORY_DISPLAY_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Build Stock History Display Data",
            "returnType": "object",
            "sourceCode": "// Validate service envelopes before their data is consumed; valid empty collections remain valid.\nfunction hcmHttpStatus(value) {\n  if (value == null || value === '') return 0;\n  if (typeof value === 'string') {\n    if (!/^[1-5][0-9]{2}$/.test(value)) throw new Error('A service returned an invalid HTTP status.');\n    value = Number(value);\n  }\n  if (typeof value !== 'number' || !Number.isInteger(value) || value < 100 || value > 599) throw new Error('A service returned an invalid HTTP status.');\n  return value;\n}\nfunction hcmResponseStatus(value) {\n  if (value.statusCode != null) return hcmHttpStatus(value.statusCode);\n  const status = value.status;\n  if (typeof status === 'number' || (typeof status === 'string' && /^[1-5][0-9]{2}$/.test(status))) return hcmHttpStatus(status);\n  return typeof status === 'string' && /^(failed|failure|error|timeout|timed_out|cancelled)$/i.test(status) ? 500 : 0;\n}\nfunction hcmCheckServiceNode(node) {\n  if (!node || !Object.prototype.hasOwnProperty.call(node, '$output')) return;\n  let value = node.$output;\n  for (let depth=0; depth<12; depth++) {\n    if (typeof value === 'string') { if (!value.trim()) throw new Error('A required service response is empty.'); value=JSON.parse(value); continue; }\n    if (value == null || typeof value !== 'object') throw new Error('A required service response is missing or invalid.');\n    if (Array.isArray(value)) return;\n    if (value.error || value.timeout === true || value.timedOut === true || value.isError === true || value.success === false || hcmResponseStatus(value) >= 400) throw new Error('A required service request failed.');\n    if (value.hasMore === true || value.hasMore === 'true') throw new Error('The service returned incomplete, paginated data. Complete data is required.');\n    if (Object.prototype.hasOwnProperty.call(value,'result')) {value=value.result;continue;}\n    if (Object.prototype.hasOwnProperty.call(value,'output')) {value=value.output;continue;}\n    return;\n  }\n  throw new Error('A service response has too many nested envelopes.');\n}\n\nhcmCheckServiceNode($context?.$nodes?.GET_PERSON_STOCK_HISTORY);\nfunction strictNumber(value) {\n  if (value == null) return null;\n  if (typeof value === 'string') {\n    if (!/^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$/.test(value.trim())) throw new Error('Invalid compensation number.');\n    value = Number(value.trim());\n  }\n  if (typeof value !== 'number' || !Number.isFinite(value) || Math.abs(value) > Number.MAX_SAFE_INTEGER / 100) throw new Error('Compensation number is invalid or outside the supported range.');\n  return value;\n}\nfunction checked(value) { const result = strictNumber(value); if (result === null) throw new Error('A required compensation amount is missing.'); return result; }\nfunction componentCurrency(value) {\n  if (typeof value !== 'string' || !/^[A-Z]{3}$/.test(value.trim().toUpperCase())) throw new Error('A compensation component currency is missing or invalid.');\n  return value.trim().toUpperCase();\n}\nfunction parse(value) {\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return null;\n    }\n  }\n  return value;\n}\n\nfunction list(value) {\n  value = parse(value);\n  if (Array.isArray(value)) return value;\n  if (value && Array.isArray(value.items)) return value.items;\n  if (value && value.result && Array.isArray(value.result.items)) {\n    return value.result.items;\n  }\n  if (value && value.output && Array.isArray(value.output.items)) {\n    return value.output.items;\n  }\n  return [];\n}\n\nfunction collection(value) {\n  const response = parse(value);\n  if (\n    !response ||\n    response.error ||\n    response.timeout ||\n    response.isError ||\n    hcmResponseStatus(response) >= 400 ||\n    String(response.hasMore).toLowerCase() === \"true\" ||\n    !Array.isArray(response.items)\n  ) return [];\n  return response.items;\n}\n\nfunction text(value, fallback) {\n  return value === null ||\n    value === undefined ||\n    String(value).trim() === \"\"\n    ? fallback\n    : String(value);\n}\n\nfunction number(value) {\n  return strictNumber(value);\n}\n\n// USER_SESSION is bound to the authenticated viewer.\nconst viewerId =\n  $context.$nodes.RESOLVE_PERSON_ID?.$output?.result?.viewerPersonId;\n\nconst sessions = collection(\n  $context.$nodes.READ_VIEWER_SESSION?.$output\n);\nconst session = sessions.length === 1 && sessions[0] ? sessions[0] : {};\n\nconst preference =\n  typeof session.DateFormat === \"string\"\n    ? session.DateFormat.trim()\n    : \"\";\n\nconst language = String(\n  session.Language || session.DefaultLanguage || \"\"\n).toLowerCase();\n\nlet country =\n  typeof session.Territory === \"string\"\n    ? session.Territory.trim().toUpperCase()\n    : \"\";\n\nif (!country && viewerId) {\n  const countries = [];\n\n  collection(\n    $context.$nodes.GET_VIEWER_WORK_ASSIGNMENT?.$output\n  ).forEach(function (row) {\n    if (\n      !row ||\n      (row.PersonId != null &&\n        String(row.PersonId).trim() !== String(viewerId).trim())\n    ) return;\n\n    if (\n      row.PrimaryFlag != null &&\n      !/^(true|y)$/i.test(String(row.PrimaryFlag))\n    ) return;\n\n    const value =\n      typeof row.LocationCountry === \"string\"\n        ? row.LocationCountry.trim().toUpperCase()\n        : \"\";\n\n    if (value && countries.indexOf(value) < 0) {\n      countries.push(value);\n    }\n  });\n\n  if (countries.length === 1) country = countries[0];\n}\n\nconst monthNames = [\n  \"January\", \"February\", \"March\", \"April\",\n  \"May\", \"June\", \"July\", \"August\",\n  \"September\", \"October\", \"November\", \"December\"\n];\n\nfunction preferenceFormat(parts) {\n  // Oracle selfDetails.DateFormat uses Java-style day/month/year tokens.\n  if (!preference || preference.length > 80) return null;\n\n  const tokens = preference.match(\n    /yyyy|YYYY|yy|YY|MMMM|MMM|MM|M|dd|DD|d|D|[\\s/.,-]+/g\n  );\n\n  if (!tokens || tokens.join(\"\") !== preference) return null;\n\n  const dateTokens = tokens.filter(function (token) {\n    return /[yYMdD]/.test(token);\n  });\n\n  if (\n    dateTokens.length !== 3 ||\n    dateTokens.filter(function (token) {\n      return /^[yY]/.test(token);\n    }).length !== 1 ||\n    dateTokens.filter(function (token) {\n      return /^M/.test(token);\n    }).length !== 1 ||\n    dateTokens.filter(function (token) {\n      return /^[dD]/.test(token);\n    }).length !== 1\n  ) return null;\n\n  if (\n    preference.indexOf(\"MMM\") >= 0 &&\n    !/^en(?:[-_]|$)/.test(language)\n  ) return null;\n\n  return tokens.map(function (token) {\n    if (/^(yyyy|YYYY)$/.test(token)) return parts[1];\n    if (/^(yy|YY)$/.test(token)) return parts[1].slice(-2);\n    if (token === \"MMMM\") return monthNames[Number(parts[2]) - 1];\n    if (token === \"MMM\") {\n      return monthNames[Number(parts[2]) - 1].slice(0, 3);\n    }\n    if (token === \"MM\") return parts[2];\n    if (token === \"M\") return String(Number(parts[2]));\n    if (/^(dd|DD)$/.test(token)) return parts[3];\n    if (/^(d|D)$/.test(token)) return String(Number(parts[3]));\n    return token;\n  }).join(\"\");\n}\n\nfunction formatDate(value) {\n  if (value == null || String(value).trim() === \"\") {\n    return \"Not available\";\n  }\n  if (typeof value !== \"string\") return value;\n\n  const parts = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(value);\n  if (!parts) return value;\n\n  const year = Number(parts[1]);\n  const month = Number(parts[2]);\n  const day = Number(parts[3]);\n\n  const leap =\n    year % 4 === 0 &&\n    (year % 100 !== 0 || year % 400 === 0);\n\n  const days = [\n    31, leap ? 29 : 28, 31, 30, 31, 30,\n    31, 31, 30, 31, 30, 31\n  ];\n\n  if (\n    year < 1 ||\n    month < 1 ||\n    month > 12 ||\n    day < 1 ||\n    day > days[month - 1]\n  ) return value;\n\n  const preferred = preferenceFormat(parts);\n  if (preferred !== null) return preferred;\n\n  if (country === \"US\") {\n    return parts[2] + \"/\" + parts[3] + \"/\" + parts[1];\n  }\n\n  if ([\"IN\", \"GB\", \"UK\", \"AU\", \"SG\"].indexOf(country) >= 0) {\n    return parts[3] + \"/\" + parts[2] + \"/\" + parts[1];\n  }\n\n  return value;\n}\n\nconst source = list(\n  $context.$nodes.GET_PERSON_STOCK_HISTORY.$output\n).slice().sort(function (a, b) {\n  return String(b.OriginalGrantDate || \"\").localeCompare(\n    String(a.OriginalGrantDate || \"\")\n  );\n});\n\nconst rows = source.map(function (stock) {\n  return {\n    tradingSymbol: text(stock.TradingSymbol, \"Not available\"),\n    grantName: text(stock.GrantName, \"Not available\"),\n    grantType: text(stock.GrantTypeMeaning, \"Not available\"),\n    originalGrantDate: formatDate(stock.OriginalGrantDate),\n    vestDate: formatDate(stock.VestDate),\n    expirationDate: formatDate(stock.ExpirationDate),\n    originalSharesGranted: number(stock.OriginalSharesGranted),\n    totalShares: number(stock.TotalShares),\n    vestedShares: number(stock.VestedShares),\n    unvestedShares: number(stock.UnvestedShares),\n    exercisableShares:\n      stock.ExercisableShares == null\n        ? \"Not available\"\n        : number(stock.ExercisableShares),\n    originalGrantPrice:\n      stock.OriginalGrantPrice == null\n        ? \"Not available\"\n        : number(stock.OriginalGrantPrice),\n    estimatedStockPrice:\n      stock.EstimatedStockPrice == null\n        ? \"Not available\"\n        : number(stock.EstimatedStockPrice),\n    currency: text(stock.StockPriceCurrencyCode, \"Not available\")\n  };\n});\n\nconst grouped = {};\nconst stockCurrencies = Array.from(new Set(source.map(stock => componentCurrency(stock.StockPriceCurrencyCode)))).sort();\n\nsource.forEach(function (stock) {\n  const date = String(stock.OriginalGrantDate || \"\");\n  const candidate = date.slice(0, 4);\n  const year = /^\\d{4}$/.test(candidate) ? candidate : \"Unknown\";\n  const code = componentCurrency(stock.StockPriceCurrencyCode);\n  const key = year + ':' + code;\n\n  if (!grouped[key]) {\n    grouped[key] = { grantValue: 0 };\n  }\n\n  const shares = number(stock.TotalShares ?? stock.OriginalSharesGranted);\n  const price = number(stock.OriginalGrantPrice);\n  if (shares === null || price === null) { grouped[key].grantValue = null; return; }\n  if (shares < 0 || price < 0) throw new Error('Stock shares and grant prices must be non-negative.');\n  if (grouped[key].grantValue !== null) grouped[key].grantValue = checked(grouped[key].grantValue + checked(shares * price));\n});\n\nconst labels = Array.from(new Set(Object.keys(grouped).map(key => key.split(':')[0]))).sort(function (a, b) {\n  if (a === \"Unknown\") return 1;\n  if (b === \"Unknown\") return -1;\n  return Number(a) - Number(b);\n});\n\nreturn {\n  personId:\n    $context.$nodes.RESOLVE_PERSON_ID.$output.result.personId,\n  assignmentId:\n    $context.$nodes.SELECT_PRIMARY_ASSIGNMENT.$output.result.assignmentId,\n  assignmentName:\n    $context.$nodes.SELECT_PRIMARY_ASSIGNMENT.$output.result.assignmentName,\n  rows: rows,\n  chart: {\n    labels: labels,\n    datasets: stockCurrencies.length ? stockCurrencies.map(function(code) {\n      return {label:'Total stock grant value'+(stockCurrencies.length>1?' ('+code+')':''),currencyCode:code,data:labels.map(function(year) {\n        const entry=grouped[year+':'+code];return entry ? entry.grantValue : 0;\n      })};\n    }) : [{label:'Total stock grant value',data:[]}]\n  }\n};",
            "errorNodeId": "fix_processing_error"
          },
          "outcomes": {
            "success": "resolve_compensation_display_mode"
          },
          "inputs": [],
