            "sourceCode": "return { personId: $context.$nodes.RESOLVE_WORKFLOW_PERSON_CONTEXT.$output.result.personId, viewerPersonId: $context.$nodes.RESOLVE_WORKFLOW_PERSON_CONTEXT.$output.result.viewerPersonId };",
