          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "validate_numeric_ids_GET_PRIMARY_ASSIGNMENT",
          "code": "VALIDATE_NUMERIC_IDS_FOR_GET_PRIMARY_ASSIGNMENT",
          "type": "CODE",
          "metadata": {
            "name": "Validate Numeric IDs for Get Primary Assignment",
            "description": "Fails closed unless every identifier supplied to this call is a non-empty numeric string.",
            "returnType": "object",
            "sourceCode": "function numericString(value) {\n  if (typeof value === 'number') {\n    if (!Number.isSafeInteger(value) || value <= 0) return false;\n    value = String(value);\n  }\n  return typeof value === 'string' && /^[0-9]+$/.test(value) && /[1-9]/.test(value);\n}\n\nreturn { valid: numericString(($context.$nodes.RESOLVE_PERSON_ID.$output.result.personId)) };",
            "errorNodeId": "fix_processing_error"
          },
