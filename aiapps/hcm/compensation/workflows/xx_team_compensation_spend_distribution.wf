          \"CmpSalaryRange\": {\n            \"type\": \"string\"\n          },\n          \"CmpAction\": {\n            \"type\": \"string\"\n          },\n          \"CmpCurrentSalary\": {\n            \"type\": \"string\"\n          },\n          \"CmpFrequencyName\": {\n            \"type\": \"string\"\n          },\n          \"CmpSalaryEndDate\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"DisplayName\",\n          \"PersonId\",\n          \"AssignmentId\",\n          \"ManagerType\",\n          \"CmpSalaryBasis\",\n          \"CmpAdjustmentAmount\",\n          \"CmpRangeIndicator\",\n          \"CmpCompaRatio\",\n          \"CmpRateMaxAmount\",\n          \"CmpSalaryStartDate\",\n          \"CmpSalaryAmountScale\",\n          \"CmpRangePosition\",\n          \"CmpNextSalaryReviewDate\",\n          \"CmpAnnualFtSalary\",\n          \"CmpCurrencyCode\",\n          \"CmpQuartile\",\n          \"CmpAdjustmentPercentage\",\n          \"CmpRateMinAmount\",\n          \"CmpQuintile\",\n          \"CmpAnnualSalary\",\n          \"CmpLastSalaryChange\",\n          \"CmpSalaryRange\",\n          \"CmpAction\",\n          \"CmpCurrentSalary\",\n          \"CmpFrequencyName\",\n          \"CmpSalaryEndDate\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
