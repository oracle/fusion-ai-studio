          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"PersonId\": {\n      \"type\": \"string\"\n    },\n    \"PersonNumber\": {\n      \"type\": \"string\"\n    },\n    \"LastName\": {\n      \"type\": \"string\"\n    },\n    \"FirstName\": {\n      \"type\": \"string\"\n    },\n    \"Title\": {\n      \"type\": \"string\"\n    },\n    \"PreNameAdjunct\": {\n      \"type\": \"string\"\n    },\n    \"Suffix\": {\n      \"type\": \"string\"\n    },\n    \"MiddleNames\": {\n      \"type\": \"string\"\n    },\n    \"Honors\": {\n      \"type\": \"string\"\n    },\n    \"KnownAs\": {\n      \"type\": \"string\"\n    },\n    \"DisplayName\": {\n      \"type\": \"string\"\n    },\n    \"ListName\": {\n      \"type\": \"string\"\n    },\n    \"OrderName\": {\n      \"type\": \"string\"\n    },\n    \"WorkEmail\": {\n      \"type\": \"string\"\n    },\n    \"Username\": {\n      \"type\": \"string\"\n    },\n    \"links\": {\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"PersonId\",\n    \"PersonNumber\",\n    \"LastName\",\n    \"FirstName\",\n    \"Title\",\n    \"PreNameAdjunct\",\n    \"Suffix\",\n    \"MiddleNames\",\n    \"Honors\",\n    \"KnownAs\",\n    \"DisplayName\",\n    \"ListName\",\n    \"OrderName\",\n    \"WorkEmail\",\n    \"Username\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
