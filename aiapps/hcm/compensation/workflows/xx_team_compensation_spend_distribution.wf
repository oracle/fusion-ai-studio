                {
                  "id": "1795008740936",
                  "code": "DIRECT_REPORT_COMP_DETAILS",
                  "type": "CODE",
                  "metadata": {
                    "name": "direct report comp details",
                    "returnType": "object",
                    "sourceCode": "// Validate service envelopes before their data is consumed; valid empty collections remain valid.\nfunction hcmHttpStatus(value) {\n  if (value == null || value === '') return 0;\n  if (typeof value === 'string') {\n    if (!/^[1-5][0-9]{2}$/.test(value)) throw new Error('A service returned an invalid HTTP status.');\n    value = Number(value);\n  }\n  if (typeof value !== 'number' || !Number.isInteger(value) || value < 100 || value > 599) throw new Error('A service returned an invalid HTTP status.');\n  return value;\n}\nfunction hcmResponseStatus(value) {\n  if (value.statusCode != null) return hcmHttpStatus(value.statusCode);\n  const status = value.status;\n  if (typeof status === 'number' || (typeof status === 'string' && /^[1-5][0-9]{2}$/.test(status))) return hcmHttpStatus(status);\n  return typeof status === 'string' && /^(failed|failure|error|timeout|timed_out|cancelled)$/i.test(status) ? 500 : 0;\n}\nfunction hcmCheckServiceNode(node) {\n  if (!node || !Object.prototype.hasOwnProperty.call(node, '$output')) return;\n  let value = node.$output;\n  for (let depth=0; depth<12; depth++) {\n    if (typeof value === 'string') { if (!value.trim()) throw new Error('A required service response is empty.'); value=JSON.parse(value); continue; }\n    if (value == null || typeof value !== 'object') throw new Error('A required service response is missing or invalid.');\n    if (Array.isArray(value)) return;\n    if (value.error || value.timeout === true || value.timedOut === true || value.isError === true || value.success === false || hcmResponseStatus(value) >= 400) throw new Error('A required service request failed.');\n    if (value.hasMore === true || value.hasMore === 'true') throw new Error('The service returned incomplete, paginated data. Complete data is required.');\n    if (Object.prototype.hasOwnProperty.call(value,'result')) {value=value.result;continue;}\n    if (Object.prototype.hasOwnProperty.call(value,'output')) {value=value.output;continue;}\n    return;\n  }\n  throw new Error('A service response has too many nested envelopes.');\n}\n\nhcmCheckServiceNode($context?.$nodes?.DIRECT_REPORTS_STOCKS_AND_BONUS?.FETCH_DIRECT_REPORTS_INDIVIDUAL_COMPENSATION_DETAILS);\nhcmCheckServiceNode($context?.$nodes?.DIRECT_REPORTS_STOCKS_AND_BONUS?.PRIOR_INDIVIDUAL_COMPENSATION_DETAILS);\nhcmCheckServiceNode($context?.$nodes?.DIRECT_REPORTS_STOCKS_AND_BONUS?.FETCH_DIRECT_REPORTS_STOCK_GRANTS);\nconst currentSalary =\n  $context.$nodes.DIRECT_REPORTS_STOCKS_AND_BONUS.$currentItem;\n\nconst salary = { ...currentSalary };\n\nconst primaryIndividualRaw =\n  $context.$nodes.DIRECT_REPORTS_STOCKS_AND_BONUS.FETCH_DIRECT_REPORTS_INDIVIDUAL_COMPENSATION_DETAILS.$output;\n\nconst priorIndividualRaw =\n  $context.$nodes.DIRECT_REPORTS_STOCKS_AND_BONUS.PRIOR_INDIVIDUAL_COMPENSATION_DETAILS.$output;\n\nconst getItems = (raw) =>\n  raw?.result?.items ??\n  raw?.items ??\n  [];\n\nconst primaryItems = getItems(primaryIndividualRaw);\n\nconst individualRaw =\n  primaryItems.length === 0\n    ? priorIndividualRaw\n    : primaryIndividualRaw;\n\nconst individualItems = getItems(individualRaw);\n\nconst rawStockOutput =\n  $context.$nodes.DIRECT_REPORTS_STOCKS_AND_BONUS.FETCH_DIRECT_REPORTS_STOCK_GRANTS.$output;\n\nconst parsedStockOutput =\n  typeof rawStockOutput === \"string\"\n    ? JSON.parse(rawStockOutput)\n    : rawStockOutput;\n\nconst stockPayload =\n  parsedStockOutput?.output ?? parsedStockOutput;\n\nconst stockOutput =\n  typeof stockPayload === \"string\"\n    ? JSON.parse(stockPayload)\n    : stockPayload;\n\nconst stockItems =\n  stockOutput?.result?.items ??\n  stockOutput?.items ??\n  [];\n\nconst getYear = (dateStr) => {\n  if (!dateStr) return null;\n\n  const date = new Date(dateStr);\n  return Number.isNaN(date.getTime()) ? null : date.getFullYear();\n};\n\nfunction strictNumber(value) {\n  if (value == null) return null;\n  if (typeof value === 'string') {\n    if (!/^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$/.test(value.trim())) throw new Error('Invalid compensation number.');\n    value = Number(value.trim());\n  }\n  if (typeof value !== 'number' || !Number.isFinite(value) || Math.abs(value) > Number.MAX_SAFE_INTEGER / 100) throw new Error('Compensation number is invalid or outside the supported range.');\n  return value;\n}\nfunction checked(value) { const result = strictNumber(value); if (result === null) throw new Error('A required compensation amount is missing.'); return result; }\nfunction componentCurrency(value) {\n  if (typeof value !== 'string' || !/^[A-Z]{3}$/.test(value.trim().toUpperCase())) throw new Error('A compensation component currency is missing or invalid.');\n  return value.trim().toUpperCase();\n}\n\nconst toNumber = strictNumber;\n\nconst currentYear = new Date().getFullYear();\n\nconst belongsToEmployee = (item) => {\n  const samePerson =\n    item.PersonId == null ||\n    String(item.PersonId) === String(salary.PersonId);\n\n  const sameAssignment =\n    item.AssignmentId == null ||\n    String(item.AssignmentId) === String(salary.AssignmentId);\n\n  return samePerson && sameAssignment;\n};\n\nconst individualCompensationDetails = individualItems.filter((item) => {\n  const effectiveYear = getYear(item.EffectiveStartDate);\n\n  return (\n    belongsToEmployee(item) &&\n    effectiveYear === currentYear &&\n    toNumber(\n      item.ValueCurrency ??\n      item.ValueNumber ??\n      item.ScreenEntryValue\n    ) !== null\n  );\n});\n\nconst seenElementEntryIds = new Set();\n\nconst uniqueIndividualCompensationDetails =\n  individualCompensationDetails.filter((item) => {\n    const entryId = item.ElementEntryId;\n\n    if (!entryId) return true;\n    if (seenElementEntryIds.has(String(entryId))) return false;\n\n    seenElementEntryIds.add(String(entryId));\n    return true;\n  });\n\nconst stockDetails = stockItems.filter((item) => {\n  const grantYear = getYear(item.OriginalGrantDate);\n\n  return (\n    belongsToEmployee(item) &&\n    grantYear === currentYear &&\n    toNumber(item.VestedShares) !== null &&\n    toNumber(item.OriginalGrantPrice) !== null\n  );\n});\n\nconst getAnnualSalary = () => {\n  const currentSalaryAmount = toNumber(salary.CmpCurrentSalary);\n\n  if (currentSalaryAmount === null) return null;\n\n  switch (salary.CmpFrequencyName) {\n    case \"Monthly\":\n      return checked(currentSalaryAmount * 12);\n    case \"Hourly\":\n      return checked(currentSalaryAmount * 40 * 52);\n    case \"Annual\":\n    case \"Annually\":\n      return currentSalaryAmount;\n    default:\n      return null;\n  }\n};\n\nconst computedAnnualSalary = getAnnualSalary();\nconst salaryCurrency = componentCurrency(salary.CmpCurrencyCode);\nconst currencyBuckets = {};\nfunction bucket(code) {\n  code = componentCurrency(code);\n  if (!currencyBuckets[code]) currencyBuckets[code] = {currencyCode:code, computedAnnualSalary:null, computedBonus:null, computedStockValue:null, computedVestedShares:null, computedTotalCompensation:0};\n  return currencyBuckets[code];\n}\nfunction addComponent(code, field, value) {\n  const group = bucket(code);\n  group[field] = checked((group[field] == null ? 0 : group[field]) + checked(value));\n}\nif (computedAnnualSalary !== null) addComponent(salaryCurrency, 'computedAnnualSalary', computedAnnualSalary);\nuniqueIndividualCompensationDetails.forEach(item => addComponent(item.DisplayCurrency, 'computedBonus', toNumber(item.ValueCurrency ?? item.ValueNumber ?? item.ScreenEntryValue)));\nstockDetails.forEach(item => {\n  const shares = checked(toNumber(item.VestedShares)), price = checked(toNumber(item.OriginalGrantPrice));\n  if (shares < 0 || price < 0) throw new Error('Stock shares and grant prices must be non-negative.');\n  addComponent(item.StockPriceCurrencyCode, 'computedStockValue', checked(shares * price));\n  addComponent(item.StockPriceCurrencyCode, 'computedVestedShares', shares);\n});\nconst computedCurrencyTotals = Object.keys(currencyBuckets).sort().map(code => {\n  const group = currencyBuckets[code];\n  group.computedTotalCompensation = checked((group.computedAnnualSalary ?? 0) + (group.computedBonus ?? 0) + (group.computedStockValue ?? 0));\n  return group;\n});\nconst payBucket = currencyBuckets[salaryCurrency];\nconst hasBonus = uniqueIndividualCompensationDetails.length > 0;\nconst hasStocks = stockDetails.length > 0;\n// Legacy scalar amounts are valid only when every component of that type uses pay currency.\nconst computedBonus = uniqueIndividualCompensationDetails.every(item => componentCurrency(item.DisplayCurrency) === salaryCurrency) ? (payBucket?.computedBonus ?? 0) : null;\nconst computedStockValue = stockDetails.every(item => componentCurrency(item.StockPriceCurrencyCode) === salaryCurrency) ? (payBucket?.computedStockValue ?? 0) : null;\nconst computedVestedShares = stockDetails.reduce((sum,item) => checked(sum + checked(toNumber(item.VestedShares))),0);\nconst computedTotalCompensation = computedAnnualSalary === null || computedCurrencyTotals.some(group => group.currencyCode !== salaryCurrency) ? null : payBucket.computedTotalCompensation;\n\nconst ManagerName =\n  $context.$nodes.RESOLVE_WORKFLOW_PERSON_CONTEXT.$output.result.displayName;\n\nreturn {\n  ...salary,\n  ManagerName,\n\n  individualCompensationDetails:\n    uniqueIndividualCompensationDetails,\n\n  stockDetails,\n\n  computedCurrencyTotals,\n  computedAnnualSalary,\n  computedBonus: hasBonus ? computedBonus : null,\n  computedStockValue: hasStocks ? computedStockValue : null,\n  computedVestedShares: hasStocks ? computedVestedShares : null,\n  computedTotalCompensation,\n\n  computedCompensationCurrency:\n    salary.CmpCurrencyCode ?? null\n};",
                    "errorNodeId": "fix_child_failure_c8e83d01"
                  },
                  "diagram": {
                    "x": 6727.5,
                    "y": 14825
                  },
                  "outcomes": {
                    "success": "end_1786086705308"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "security_4_85cd35bf",
