          "metadata": {
            "name": "Validate app summary response",
            "returnType": "object",
            "sourceCode": "// Validate service envelopes before their data is consumed; valid empty collections remain valid.\nfunction hcmHttpStatus(value) {\n  if (value == null || value === '') return 0;\n  if (typeof value === 'string') {\n    if (!/^[1-5][0-9]{2}$/.test(value)) throw new Error('A service returned an invalid HTTP status.');\n    value = Number(value);\n  }\n  if (typeof value !== 'number' || !Number.isInteger(value) || value < 100 || value > 599) throw new Error('A service returned an invalid HTTP status.');\n  return value;\n}\nfunction hcmResponseStatus(value) {\n  if (value.statusCode != null) return hcmHttpStatus(value.statusCode);\n  const status = value.status;\n  if (typeof status === 'number' || (typeof status === 'string' && /^[1-5][0-9]{2}$/.test(status))) return hcmHttpStatus(status);\n  return typeof status === 'string' && /^(failed|failure|error|timeout|timed_out|cancelled)$/i.test(status) ? 500 : 0;\n}\nfunction hcmCheckServiceNode(node) {\n  if (!node || !Object.prototype.hasOwnProperty.call(node, '$output')) return;\n  let value = node.$output;\n  for (let depth=0; depth<12; depth++) {\n    if (typeof value === 'string') { if (!value.trim()) throw new Error('A required service response is empty.'); value=JSON.parse(value); continue; }\n    if (value == null || typeof value !== 'object') throw new Error('A required service response is missing or invalid.');\n    if (Array.isArray(value)) return;\n    if (value.error || value.timeout === true || value.timedOut === true || value.isError === true || value.success === false || hcmResponseStatus(value) >= 400) throw new Error('A required service request failed.');\n    if (value.hasMore === true || value.hasMore === 'true') throw new Error('The service returned incomplete, paginated data. Complete data is required.');\n    if (Object.prototype.hasOwnProperty.call(value,'result')) {value=value.result;continue;}\n    if (Object.prototype.hasOwnProperty.call(value,'output')) {value=value.output;continue;}\n    return;\n  }\n  throw new Error('A service response has too many nested envelopes.');\n}\n\nfunction failure(code, message) {\n  const error = { code, message };\n  return { valid: false, error, errorResponse: JSON.stringify({ error }) };\n}\nfunction stop(code, message) { throw { safeWorkflowError: true, code, message }; }\nfunction validId(value) {\n  if (typeof value === 'number') return Number.isSafeInteger(value) && value > 0;\n  return typeof value === 'string' && value === value.trim() && /^[1-9][0-9]{0,29}$/.test(value);\n}\nfunction decoded(value) {\n  if (typeof value === 'string') {\n    if (!value.trim()) stop('EMPTY_RESPONSE', 'A required service response was empty. Please try again.');\n    try { value = JSON.parse(value); }\n    catch { stop('INVALID_RESPONSE', 'A service returned an unreadable response. Please try again.'); }\n  }\n  if (value == null || typeof value !== 'object') stop('EMPTY_RESPONSE', 'A required service response was empty. Please try again.');\n  return value;\n}\nfunction healthy(value) {\n  value = decoded(value);\n  if (value.error || value.timeout === true || value.success === false ||\n      (typeof value.statusCode === 'number' && hcmHttpStatus(value.statusCode) >= 400) ||\n      (typeof value.status === 'string' && /^(failed|failure|error|timed_out|timeout|cancelled)$/i.test(value.status))) {\n    stop('DEPENDENCY_FAILED', 'Compensation information could not be retrieved. Please try again or contact support.');\n  }\n  return value;\n}\nfunction responseBody(value) {\n  value = healthy(value);\n  if (Object.prototype.hasOwnProperty.call(value, 'output')) value = healthy(value.output);\n  if (Object.prototype.hasOwnProperty.call(value, 'result')) value = healthy(value.result);\n  return value;\n}\nfunction requireRows(value, allowEmpty) {\n  if (!Array.isArray(value)) stop('INVALID_RESPONSE', 'A service returned an unexpected record format. Please try again.');\n  if (!allowEmpty && value.length === 0) stop('NO_RECORDS', 'No records were found for this person, or you do not have access to them.');\n  if (value.some(row => !row || typeof row !== 'object' || Array.isArray(row))) stop('INVALID_RESPONSE', 'A service returned an invalid record. Please try again.');\n  return value;\n}\nfunction requirePerson(value) {\n  if (!validId(value)) stop('INVALID_PERSON', 'A valid person ID is required. Select a person and try again.');\n}\nfunction requireAssignment(value) {\n  if (!validId(value)) stop('INVALID_ASSIGNMENT', 'No valid primary assignment was found for this person. Verify the person and your access.');\n}\nfunction safeDate(value) {\n  if (typeof value !== 'string' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n  const date = new Date(value + 'T00:00:00Z');\n  return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === value;\n}\nfunction requireGroups(value) {\n  value = decoded(value);\n  if (!Array.isArray(value) || !value.length) stop('NO_TEAM_COMPENSATION', 'No team compensation information is available for this person.');\n  let count = 0;\n  for (const group of value) {\n    if (!group || typeof group !== 'object' || !Array.isArray(group.data) || !group.data.length) stop('INVALID_TEAM_DATA', 'Team compensation information is incomplete. Refresh the summary and try again.');\n    for (const row of group.data) {\n      if (!row || typeof row !== 'object') stop('INVALID_TEAM_DATA', 'Team compensation information is incomplete. Refresh the summary and try again.');\n      requirePerson(row.PersonId);\n      requireAssignment(row.AssignmentId);\n      count += 1;\n    }\n  }\n  if (!count) stop('NO_TEAM_COMPENSATION', 'No team compensation information is available for this person.');\n  return value;\n}\n\ntry {\n  const raw = $context.$nodes.APP_SUMMARY.$output;\n  function present(value) {\n    if (typeof value === 'string') return value.trim().length > 0;\n    if (typeof value === 'number') return Number.isFinite(value);\n    if (Array.isArray(value)) return value.some(present);\n    if (!value || typeof value !== 'object' || value.error || value.timeout === true) return false;\n    return Object.keys(value).filter(key => key !== 'error' && key !== 'timeout').some(key => present(value[key]));\n  }\n  if (!present(raw)) return failure('EMPTY_ANSWER', 'No compensation answer could be generated. Please try again.');\n  return { valid: true };\n} catch {\n  return failure('SUMMARY_FAILED', 'The compensation answer could not be generated. Please try again.');\n}",
