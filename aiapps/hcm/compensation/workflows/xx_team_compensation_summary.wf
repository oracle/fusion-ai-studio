        {
          "id": "check_validate_display_mode",
          "code": "CHECK_VALIDATE_DISPLAY_MODE",
          "type": "CONDITION",
          "metadata": {
            "name": "Check validate app display mode",
            "errorNodeId": "error_processing_failed"
          },
          "outcomes": {
            "true": "calculate_team_compensation_summary",
            "false": "return_validate_display_mode"
