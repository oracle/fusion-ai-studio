        {
          "id": "calculate_team_compensation_summary",
          "code": "CALCULATE_TEAM_COMPENSATION_SUMMARY",
          "type": "CODE",
          "metadata": {
            "name": "Calculate team compensation summary figures",
            "sourceCode": "if ($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.displayMode === 'Query') return { skipped: true };\nfunction invalid() { throw new Error('Complete team compensation totals could not be calculated.'); }\nfunction unpack(value) { if (typeof value === 'string') { try { return JSON.parse(value); } catch { invalid(); } } return value; }\nfunction id(value) { if (typeof value === 'number' && Number.isSafeInteger(value) && value > 0) return String(value); if (typeof value === 'string' && /^[1-9][0-9]{0,29}$/.test(value)) return value; invalid(); }\nfunction number(value) { if (typeof value !== 'number' && (typeof value !== 'string' || !/^-?\\d+(?:\\.\\d+)?$/.test(value))) invalid(); const n=Number(value); if (!Number.isFinite(n)) invalid(); return n; }\nfunction cents(value) { const result=Math.round(number(value)*100); if (!Number.isSafeInteger(result)) invalid(); return result; }\nfunction add(a,b) { const result=a+b; if (!Number.isSafeInteger(result)) invalid(); return result; }\nfunction date(value) { if (typeof value !== 'string' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) invalid(); const d=new Date(value+'T00:00:00Z'); if (!Number.isFinite(d.getTime()) || d.toISOString().slice(0,10)!==value) invalid(); return value; }\nfunction currency(value) { if (typeof value !== 'string' || !/^[A-Z]{3}$/.test(value)) invalid(); return value; }\nfunction annual(row) {\n  if (row.CmpAnnualSalary != null && row.CmpAnnualSalary !== '') return cents(row.CmpAnnualSalary);\n  if (row.computedAnnualSalary != null && row.computedAnnualSalary !== '') return cents(row.computedAnnualSalary);\n  const value=number(row.CmpCurrentSalary);\n  const frequency=String(row.CmpFrequencyName || '').toLowerCase();\n  if (frequency==='annual' || frequency==='annually') return cents(value);\n  if (frequency==='monthly') return cents(value*12);\n  if (frequency==='hourly') return cents(value*40*52);\n  invalid();\n}\nfunction list(value) { value=unpack(value); if (value==null) return []; if (!Array.isArray(value)) invalid(); return value.slice(); }\nfunction owned(item,row) { if (!item || typeof item!=='object' || Array.isArray(item)) invalid(); if (item.PersonId!=null && id(item.PersonId)!==row.personId) invalid(); return item.AssignmentId==null || id(item.AssignmentId)===row.assignmentId; }\nconst groups=unpack($context.$variables.DirectReportsCompensationDetails);\nif (!Array.isArray(groups) || !groups.length) invalid();\nconst employees=new Map();\nfor (const group of groups) {\n  if (!group || !Array.isArray(group.data)) invalid();\n  const code=currency(group.currencyCode);\n  for (const item of group.data) {\n    if (!item || typeof item!=='object' || Array.isArray(item)) invalid();\n    if (item.CmpCurrencyCode!=null && currency(item.CmpCurrencyCode)!==code) invalid();\n    const row={source:item,personId:id(item.PersonId),assignmentId:id(item.AssignmentId),currencyCode:code,startDate:date(item.CmpSalaryStartDate || item.CmpSalaryDateFrom || item.DateFrom),annualSalaryCents:annual(item),bonusRows:list(item.individualCompensationDetails ?? item.compensationDetails),stockRows:list(item.stockDetails)};\n    if (row.annualSalaryCents<0) invalid();\n    const previous=employees.get(row.personId);\n    if (!previous || previous.startDate<row.startDate) employees.set(row.personId,row);\n    else if (previous.startDate===row.startDate) {\n      if (previous.assignmentId!==row.assignmentId || previous.currencyCode!==row.currencyCode || previous.annualSalaryCents!==row.annualSalaryCents) invalid();\n      previous.bonusRows.push(...row.bonusRows); previous.stockRows.push(...row.stockRows);\n    }\n  }\n}\nif (!employees.size) invalid();\nconst salaryYear=Math.max(...Array.from(employees.values(),row=>Number(row.startDate.slice(0,4))));\nconst totals=new Map();\nfunction currencyTotal(code) {\n  let total=totals.get(code);\n  if (!total) {total={currencyCode:code,employeeCount:0,annualSalaryCents:0,bonusCents:0,stockAwardCents:0};totals.set(code,total);}\n  return total;\n}\nfor (const row of employees.values()) {\n  let total=totals.get(row.currencyCode);\n  if (!total) {total={currencyCode:row.currencyCode,employeeCount:0,annualSalaryCents:0,bonusCents:0,stockAwardCents:0};totals.set(row.currencyCode,total);}\n  total.employeeCount++; total.annualSalaryCents=add(total.annualSalaryCents,row.annualSalaryCents);\n  const bonuses=new Set();\n  for (const item of row.bonusRows) {\n    if (!owned(item,row)) continue;\n    const effectiveStart=item.EffectiveStartDate ? date(item.EffectiveStartDate) : '';\n    const effectiveEnd=item.EffectiveEndDate ? date(item.EffectiveEndDate) : '';\n    if (effectiveStart && effectiveEnd && effectiveEnd<effectiveStart) invalid();\n    if ((effectiveStart && effectiveStart>salaryYear+'-12-31') || (effectiveEnd && effectiveEnd<salaryYear+'-01-01')) continue;\n    const bonusTotal=currencyTotal(currency(item.DisplayCurrency || item.CurrencyCode));\n    const amount=item.ValueCurrency ?? item.ValueNumber ?? item.ScreenEntryValue;\n    const value=cents(amount);\n    const key=item.ElementEntryId!=null ? id(item.ElementEntryId) : JSON.stringify([item.PlanName,item.ComponentName,item.EffectiveStartDate,item.EffectiveEndDate,value]);\n    if (bonuses.has(key)) continue; bonuses.add(key); bonusTotal.bonusCents=add(bonusTotal.bonusCents,value);\n  }\n  const awards=new Set();\n  for (const item of row.stockRows) {\n    if (!owned(item,row)) continue;\n    const grantDate=item.OriginalGrantDate ? date(item.OriginalGrantDate) : '';\n    const vestDate=item.VestDate ? date(item.VestDate) : '';\n    if (Number((grantDate || vestDate).slice(0,4))!==salaryYear) continue;\n    // No implicit conversion or mixing a foreign award currency into pay-currency totals.\n    const stockTotal=currencyTotal(currency(item.StockPriceCurrencyCode));\n    const shares=number(item.OriginalSharesGranted ?? item.TotalShares),price=number(item.OriginalGrantPrice);\n    if (shares<0 || price<0) invalid();\n    const key=item.StockGrantId!=null ? String(item.StockGrantId) : JSON.stringify([item.TradingSymbol,item.GrantName,grantDate,shares,price]);\n    if (awards.has(key)) continue; awards.add(key); stockTotal.stockAwardCents=add(stockTotal.stockAwardCents,cents(shares*price));\n  }\n}\nconst statistics=Array.from(totals.values()).sort((a,b)=>b.employeeCount-a.employeeCount || a.currencyCode.localeCompare(b.currencyCode));\nfor (const total of statistics) {\n  total.totalCompensationCents=add(add(total.annualSalaryCents,total.bonusCents),total.stockAwardCents);\n  total.averageAnnualSalaryCents=total.employeeCount ? total.annualSalaryCents/total.employeeCount : null;\n}\nfunction join(values) { return values.length<2 ? values[0] : values.slice(0,-1).join(', ')+' and '+values[values.length-1]; }\nfunction whole(value) { return String(Math.round(value/100)).replace(/\\B(?=(\\d{3})+(?!\\d))/g,','); }\nfunction money(value,code) { return ({USD:'$',GBP:'£',EUR:'€'}[code] || code+' ')+whole(value); }\nconst counts=join(statistics.filter(t=>t.employeeCount>0).map(t=>t.employeeCount+' paid in '+t.currencyCode));\nconst spends=join(statistics.map(t=>money(t.totalCompensationCents,t.currencyCode)+' in '+t.currencyCode));\nconst mixes=statistics.map(t=>{\n  if (t.totalCompensationCents<=0) return 'the compensation mix in '+t.currencyCode+' is unavailable';\n  return 'in '+t.currencyCode+', '+join([['salaries',t.annualSalaryCents],['bonuses',t.bonusCents],['stock awards',t.stockAwardCents]].filter(x=>x[1]!==0).map(x=>x[0]+' account for about '+Math.round(x[1]/t.totalCompensationCents*100)+'%'));\n});\nconst averages=join(statistics.filter(t=>t.employeeCount>0).map(t=>money(t.averageAnnualSalaryCents,t.currencyCode)+' for employees paid in '+t.currencyCode));\nconst summaryText='There are '+employees.size+' direct reports: '+counts+'; for '+salaryYear+', total compensation spend is '+spends+'. '+mixes.map((value,index)=>index===0?value.charAt(0).toUpperCase()+value.slice(1):value).join('; ')+'. Average annual salary is '+averages+'.';\nconst panelDisplay='<oraInfoDisplay key=\"direct_reports_compensation_summary\">\\n'+JSON.stringify({title:'',description:'',patternId:'cardWidget',properties:{summary:summaryText}})+'\\n</oraInfoDisplay>';\nreturn {salaryYear,employeeCount:employees.size,statistics,summaryText,panelDisplay};\n",
