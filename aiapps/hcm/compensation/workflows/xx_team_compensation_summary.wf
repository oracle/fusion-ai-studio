        {
          "id": "1786086531433",
          "code": "QUERY_NODE",
          "type": "LLM",
          "metadata": {
            "name": "Answer compensation question",
            "errorNodeId": "error_summary_failed",
            "chatHistoryEnabled": true
          },
          "diagram": {
