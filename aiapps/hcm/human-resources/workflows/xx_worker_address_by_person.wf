            "y": 5428
          },
          "convergenceTargetId": "1777019455079"
        },
        {
          "id": "VALIDATE_REQUEST_GET_WORKER_ADDRESSES_VIA_PERSON_ID",
          "code": "VALIDATE_REQUEST_GET_WORKER_ADDRESSES_VIA_PERSON_ID",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get Worker Addresses Via Person Id",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\n\nconst checked={};\nchecked[\"personId\"]=id(($context.$triggers.REST.$input.personId),\"personId\");\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1777019590924"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5000,
            "y": 5650
          }
        },
        {
          "id": "1777019590924",
          "code": "GET_WORKER_ADDRESSES_VIA_PERSON_ID",
          "type": "BO_FUNCTION",
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_WORKERDETAILSGHR",
            "functionName": "GetWorkerAddressesByPersonId",
            "name": "Get Worker Addresses by Person Id",
            "description": "Returns worker address details for the supplied person identifier."
          },
          "outcomes": {
            "success": "1777019455079"
          },
          "inputs": [
            {
              "id": "1777019617114_1",
              "name": "personId",
              "type": "integer",
              "value": "{{$context.$nodes.VALIDATE_REQUEST_GET_WORKER_ADDRESSES_VIA_PERSON_ID.$output.result.personId}}",
              "required": true
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 5872
          },
          "outputSpecification": "{}"
        },
        {
          "id": "1777019455079",
          "code": "GET_LIST_OF_ADDRESSES",
          "type": "CODE",
          "metadata": {
            "name": "Get List of Addresses",
            "returnType": "array",
            "sourceCode": "const type = $context.$nodes.GET_QUERY_TYPE.$output.result;\nconst worker = type === \"PersonId\"\n  ? $context.$nodes.GET_WORKER_ADDRESSES_VIA_PERSON_ID.$output.items[0]\n  : $context.$nodes.GET_WORKER_ADDRESSES_VIA_PERSON_NUMBER.$output.items[0];\nreturn worker.addresses.items;"
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
          "diagram": {
            "x": 5225,
            "y": 6094
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "VALIDATE_REQUEST_GET_WORKER_ADDRESSES_VIA_PERSON_NUMBER",
          "code": "VALIDATE_REQUEST_GET_WORKER_ADDRESSES_VIA_PERSON_NUMBER",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get Worker Addresses Via Person Number",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction personNumber(value,name) {\n  if(typeof value!==\"string\" && !(typeof value===\"number\" && Number.isSafeInteger(value) && value>0)) reject(name);\n  const text=String(value).trim();if(!/^[A-Za-z0-9_.@-]{1,50}$/.test(text)) reject(name);return text;\n}\n\nconst checked={};\nchecked[\"personNumber\"]=personNumber(($context.$triggers.REST.$input.personNumber),\"personNumber\");\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1777019627574"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5450,
            "y": 5650
          }
        },
