            "PersonId": "VALIDATE_REQUEST_GET_WORKER_ADDRESSES_VIA_PERSON_ID",
            "PersonNumber": "VALIDATE_REQUEST_GET_WORKER_ADDRESSES_VIA_PERSON_NUMBER"
          },
          "inputs": [
            {
              "id": "1777019565059_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.GET_QUERY_TYPE.$output.result}}"
            }
