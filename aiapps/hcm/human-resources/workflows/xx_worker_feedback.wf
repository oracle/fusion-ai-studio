          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonNumber\": {\n            \"type\": [\n              \"string\",\n              \"number\"\n            ]\n          }\n        },\n        \"additionalProperties\": true\n      }\n    }\n  },\n  \"additionalProperties\": true\n}"
        },
        {
          "id": "1791801000101",
          "code": "VALIDATE_FEEDBACK_USER_SESSION",
          "type": "CODE",
          "metadata": {
            "name": "Validate Feedback User Session",
            "description": "Requires one valid session person number before resolving the feedback author.",
            "returnType": "object",
            "sourceCode": "const response = $context.$nodes.READ_FEEDBACK_USER_SESSION.$output;\nconst rejected = { valid: false, personNumber: \"\" };\nif (!response || typeof response !== \"object\" || Array.isArray(response) ||\n    response.error || response.timeout || response.isError || Number(response.statusCode || 0) >= 400 ||\n    !Array.isArray(response.items) || response.items.length !== 1 ||\n    (response.hasMore !== undefined && response.hasMore !== false)) return rejected;\nconst session = response.items[0];\nif (!session || typeof session !== \"object\" || Array.isArray(session)) return rejected;\nconst rawPersonNumber = session.PersonNumber;\nif (typeof rawPersonNumber !== \"string\" &&\n    !(typeof rawPersonNumber === \"number\" && Number.isSafeInteger(rawPersonNumber) && rawPersonNumber > 0)) return rejected;\nconst personNumber = String(rawPersonNumber).trim();\nif (!personNumber || personNumber.length > 50 || !/^[A-Za-z0-9_.@-]+$/.test(personNumber)) return rejected;\nreturn { valid: true, personNumber: personNumber };",
            "errorNodeId": "1787651228309"
          },
          "outcomes": {
            "success": "1791801000102"
          },
          "inputs": [],
          "diagram": {
            "x": 6125,
            "y": 8758
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
