          "id": "18",
          "code": "RENDER_NO_FEEDBACK_INITIAL_DISPLAY",
          "type": "LLM",
          "metadata": {
            "name": "Render No Feedback Initial Display",
            "description": "Renders an empty feedback list with the Add Feedback action.",
            "modelConfiguration": {
              "code": "ORA_MODEL_GPT_5_6_LUNA",
              "modelName": "GPT-5.6 Luna (Balanced)",
              "provider": "CERT_PREMIUM",
