        {
          "id": "4",
          "code": "EXTRACT_PERSON_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Extract Person Context",
            "returnType": "object",
            "description": "Resolves the selected worker or the logged-in worker from the app context.",
            "sourceCode": "const maxContextLength = 16384;\n\nfunction parseContextObject(value) {\n  if (typeof value === \"string\") {\n    if (value.length === 0 || value.length > maxContextLength) return null;\n    try { value = JSON.parse(value); } catch (e) { return null; }\n  }\n  return value && typeof value === \"object\" && !Array.isArray(value) ? value : null;\n}\n\nfunction normalizePersonId(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : null;\n  if (typeof value !== \"string\") return null;\n  const trimmed = value.trim();\n  return /^[1-9][0-9]{0,29}$/.test(trimmed) ? trimmed : null;\n}\n\nfunction missing(value) {\n  return value == null || (typeof value === \"string\" && !value.trim());\n}\n\nconst appContext = parseContextObject($context?.$app?.$OraAppContext);\nconst userContext = parseContextObject($context?.$app?.$OraUserContext);\nconst appPersonId = normalizePersonId(appContext?.personId);\nconst rawRestPersonId = $context?.$triggers?.REST?.$input?.personId;\n\nlet personId = appPersonId;\nif (!personId) {\n  if (!missing(rawRestPersonId)) {\n    // A supplied invalid REST ID must not silently select the viewer.\n    personId = normalizePersonId(rawRestPersonId);\n  } else {\n    personId = normalizePersonId(userContext?.userId);\n  }\n}\n\nreturn { valid: Boolean(personId), personId: personId || \"\", loggedInPersonId: normalizePersonId(userContext?.userId), isFeedbackAction: $context?.$app?.$OraMessageHint === \"InvokeAction\", isFeedbackQuery: $context?.$app?.$OraMessageHint === \"Query\"};"
          },
          "outcomes": {
            "success": "5"
          },
          "inputs": [],
          "diagram": {
            "x": 7025,
            "y": 5650
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
