          },
          "inputs": [
            {
              "id": "1791801000103_personNumber",
              "name": "personNumber",
              "type": "string",
              "value": "{{$context.$nodes.VALIDATE_REQUEST_GET_FEEDBACK_AUTHOR.$output.result.personNumber}}"
            }
          ],
          "diagram": {
            "x": 5675,
            "y": 9424
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonNumber\": {\n            \"type\": [\n              \"string\",\n              \"number\"\n            ]\n          },\n          \"PersonId\": {\n            \"type\": [\n              \"string\",\n              \"number\"\n            ]\n          }\n        },\n        \"additionalProperties\": true\n      }\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"additionalProperties\": true\n}"
        },
        {
          "id": "1791801000104",
          "code": "VALIDATE_FEEDBACK_AUTHOR",
          "type": "CODE",
          "metadata": {
            "name": "Validate Feedback Author",
            "description": "Requires one matching session worker and rejects a conflicting app viewer identity. This does not grant feedback-write access to the selected subject.",
            "returnType": "object",
            "sourceCode": "function normalizePersonId(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  return typeof value === \"string\" && /^[1-9][0-9]{0,19}$/.test(value.trim()) ? value.trim() : \"\";\n}\n\nconst rejected = { valid: false, authorId: \"\", workerId: \"\" };\nconst session = $context.$nodes.VALIDATE_FEEDBACK_USER_SESSION.$output.result;\nconst response = $context.$nodes.GET_FEEDBACK_AUTHOR.$output;\nconst context = $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result;\nif (!session || session.valid !== true || !response || typeof response !== \"object\" || Array.isArray(response) ||\n    response.error || response.timeout || response.isError || Number(response.statusCode || 0) >= 400 ||\n    !Array.isArray(response.items) || response.items.length !== 1 ||\n    (response.hasMore !== undefined && response.hasMore !== false)) return rejected;\nconst author = response.items[0];\nif (!author || typeof author !== \"object\" || Array.isArray(author) ||\n    (typeof author.PersonNumber !== \"string\" &&\n     !(typeof author.PersonNumber === \"number\" && Number.isSafeInteger(author.PersonNumber) && author.PersonNumber > 0)) ||\n    String(author.PersonNumber).trim() !== session.personNumber) return rejected;\nconst authorId = normalizePersonId(author.PersonId);\nconst viewerId = normalizePersonId(context && context.loggedInPersonId);\nconst workerId = normalizePersonId(context && context.personId);\n// The session-resolved worker is the author. A caller-selected subject is not proof of write authorization.\nif (!authorId || !viewerId || authorId !== viewerId || !workerId) return rejected;\nreturn { valid: true, authorId: authorId, workerId: workerId };",
            "errorNodeId": "1787651228309"
          },
          "outcomes": {
            "success": "1791801000105"
          },
          "inputs": [],
          "diagram": {
            "x": 5675,
            "y": 9646
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
