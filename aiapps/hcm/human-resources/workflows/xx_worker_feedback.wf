        {
          "id": "VALIDATE_REQUEST_GET_FEEDBACK_AUTHOR",
          "code": "VALIDATE_REQUEST_GET_FEEDBACK_AUTHOR",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get Feedback Author",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction personNumber(value,name) {\n  if(typeof value!==\"string\" && !(typeof value===\"number\" && Number.isSafeInteger(value) && value>0)) reject(name);\n  const text=String(value).trim();if(!/^[A-Za-z0-9_.@-]{1,50}$/.test(text)) reject(name);return text;\n}\n\nconst checked={};\nchecked[\"personNumber\"]=personNumber(($context.$nodes.VALIDATE_FEEDBACK_USER_SESSION.$output.result.personNumber),\"personNumber\");\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1791801000103"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
