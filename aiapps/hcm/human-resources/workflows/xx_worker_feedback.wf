        {
          "id": "VALIDATE_RENDER_NO_FEEDBACK_INITIAL_DISPLAY",
          "code": "VALIDATE_RENDER_NO_FEEDBACK_INITIAL_DISPLAY",
          "type": "CODE",
          "metadata": {
            "name": "Validate Render No Feedback Initial Display",
            "returnType": "object",
            "sourceCode": "const output = $context.$nodes.RENDER_NO_FEEDBACK_INITIAL_DISPLAY.$output;\n\nfunction reject() { throw new Error(\"The generated feedback response did not match the trusted output contract.\"); }\nfunction same(a, b) {\n  if (a === b) return true;\n  if (!a || !b || typeof a !== \"object\" || typeof b !== \"object\" || Array.isArray(a) !== Array.isArray(b)) return false;\n  const ak = Object.keys(a), bk = Object.keys(b);\n  return ak.length === bk.length && ak.every(function (key) {\n    return Object.prototype.hasOwnProperty.call(b, key) && same(a[key], b[key]);\n  });\n}\nfunction parseJson(body) {\n  const stack = [];\n  const tokens = /\"(?:\\\\.|[^\"\\\\])*\"|[{}\\[\\]]/g;\n  let token;\n  while ((token = tokens.exec(body))) {\n    const text = token[0];\n    if (text === \"{\") stack.push({});\n    else if (text === \"[\") stack.push(null);\n    else if (text === \"}\" || text === \"]\") stack.pop();\n    else if (/^\\s*:/.test(body.slice(tokens.lastIndex))) {\n      const key = JSON.parse(text), keys = stack[stack.length - 1];\n      if (!keys || [\"__proto__\", \"constructor\", \"prototype\"].includes(key) || Object.prototype.hasOwnProperty.call(keys, key)) reject();\n      keys[key] = true;\n    }\n    if (stack.length > 20) reject();\n  }\n  return JSON.parse(body);\n}\nfunction blocks(value) {\n  if (typeof value !== \"string\" || value.length > 250000) reject();\n  const result = [];\n  let rest = value.trim();\n  while (rest) {\n    const opening = rest.match(/^<(oraInfoDisplay|oraInsight)(?:\\s+key=\"[A-Za-z0-9_-]{1,80}\")?>/);\n    if (!opening) reject();\n    if (opening[1] === \"oraInfoDisplay\" && opening[0] !== \"<oraInfoDisplay key=\\\"worker_feedback_initial\\\">\") reject();\n    rest = rest.slice(opening[0].length).trimStart();\n    if (rest[0] !== \"{\") reject();\n    let depth = 0, quoted = false, escaped = false, end = -1;\n    for (let i = 0; i < rest.length; i++) {\n      const ch = rest[i];\n      if (quoted) {\n        if (escaped) escaped = false;\n        else if (ch === \"\\\\\") escaped = true;\n        else if (ch === '\"') quoted = false;\n      } else if (ch === '\"') quoted = true;\n      else if (ch === \"{\" || ch === \"[\") { if (++depth > 20) reject(); }\n      else if (ch === \"}\" || ch === \"]\") { if (--depth === 0) { end = i + 1; break; } }\n    }\n    if (end < 0) reject();\n    const payload = parseJson(rest.slice(0, end));\n    rest = rest.slice(end).trimStart();\n    const close = \"</\" + opening[1] + \">\";\n    if (rest.slice(0, close.length) !== close) reject();\n    rest = rest.slice(close.length).trimStart();\n    result.push({ type: opening[1], payload: payload });\n    if (result.length > 2) reject();\n  }\n  return result;\n}\nconst data = $context.$variables.contextObj.displayData;\nif (!data) reject();\nconst records = [];\n\nif (!Array.isArray(records)) reject();\nconst expected = [{ type: \"oraInfoDisplay\", payload: { patternId: \"messageListWidget\", properties: {\n  items: records.map(function (note) {\n    return { title: note.feedback, subtitle: \"Recieved from \" + note.author + \", \" + note.createdOn };\n  })\n} } }];\nexpected.push({ type: \"oraInsight\", payload: data.addFeedbackAction });\nif (!same(blocks(output), expected)) reject();\nreturn { valid: true };\n",
            "description": "Rejects unsupported output, changed display records, and actions that differ from the trusted prepared contract.",
            "errorNodeId": "1787651228304"
