        {
          "id": "1787651228302",
          "code": "PARSE_ADD_FEEDBACK_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Parse Add Feedback Payload",
            "returnType": "object",
            "description": "Accepts only the Add Feedback action or an exact bounded two-field form submission; rejects duplicate, unknown and canceled submissions before writes.",
            "sourceCode": "let actionContext = $context?.$app?.$OraAction;\nif (typeof actionContext === \"string\" && actionContext.length > 32768) return { valid: false };\n\nif (typeof actionContext === \"string\") {\n  const actionText = actionContext.trim();\n\n  try {\n    actionContext = JSON.parse(actionText);\n  } catch (e) {\n    const formSubmitMatch = actionText.match(/^<oraFormSubmit\\s+id=\"([^\"]+)\">([\\s\\S]*)<\\/oraFormSubmit>$/);\n\n    if (formSubmitMatch && formSubmitMatch[1] === \"add_feedback_form\") {\n      try {\n        const submittedFields = JSON.parse(formSubmitMatch[2]);\n\n        if (Array.isArray(submittedFields)) {\n          const fieldValues = {};\n\n          if (submittedFields.length !== 2) return { valid: false };\n          for (const field of submittedFields) {\n            if (!field || typeof field.value !== \"string\" ||\n                ![\"feedback\", \"visibility\"].includes(field.id) ||\n                Object.keys(field).some(function (key) { return ![\"id\", \"value\"].includes(key); }) ||\n                Object.prototype.hasOwnProperty.call(fieldValues, field.id)) return { valid: false };\n            fieldValues[field.id] = field.value;\n          }\n\n          const feedback = typeof fieldValues.feedback === \"string\" ? fieldValues.feedback.trim() : \"\";\n          const visibility = typeof fieldValues.visibility === \"string\" ? fieldValues.visibility.trim() : \"\";\n          const context = $context?.$nodes?.EXTRACT_PERSON_CONTEXT?.$output?.result || {};\n          const authorId = String(context.loggedInPersonId || \"\");\n          const workerId = String(context.personId || \"\");\n          const allowedVisibility = [\"ALL\", \"MANAGERS\", \"MANAGERS_AND_SUBJECT\", \"PRIVATE\", \"SUBJECT\", \"MANAGERS_SUBJECT_PEERS\"];\n          return {\n            valid: feedback.length > 0 && feedback.length <= 4000 && allowedVisibility.indexOf(visibility) !== -1 && /^[1-9][0-9]{0,19}$/.test(authorId) && /^[1-9][0-9]{0,19}$/.test(workerId),\n            actionId: \"submitFeedback\",\n            feedback: feedback,\n            visibility: visibility\n          };\n        }\n      } catch (formError) {\n        actionContext = null;\n      }\n    }\n\n    actionContext = null;\n  }\n}\n\nconst actionId = actionContext?.actionId === \"addFeedback\" ? \"addFeedback\" : \"\";\n\nreturn {\n  valid: Boolean(actionId),\n  actionId: actionId,\n  feedback: \"\",\n  visibility: \"\"\n};"
          },
          "outcomes": {
            "success": "1787651228303"
          },
          "inputs": [],
          "diagram": {
            "x": 6575,
            "y": 7870
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
