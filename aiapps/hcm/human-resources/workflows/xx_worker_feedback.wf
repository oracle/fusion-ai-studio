        },
        {
          "id": "1791801000103",
          "code": "GET_FEEDBACK_AUTHOR",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Feedback Author",
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_WORKERDETAILSGHR",
            "functionName": "GetWorkerDetailsByPersonNumber",
            "errorNodeId": "1787651228309",
            "description": "Resolves the authenticated session person number to the feedback author person ID."
          },
          "outcomes": {
