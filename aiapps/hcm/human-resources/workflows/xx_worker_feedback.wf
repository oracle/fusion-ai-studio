          "id": "1791801000107",
          "code": "VALIDATE_FEEDBACK_WRITE",
          "type": "CODE",
          "metadata": {
            "name": "Validate Feedback Write",
            "description": "Allows creation only with the verified author and a visibility option currently returned by the backend.",
            "returnType": "object",
            "sourceCode": "const rejected = { valid: false, authorId: \"\", workerId: \"\", visibility: \"\" };\nconst author = $context.$nodes.VALIDATE_FEEDBACK_AUTHOR.$output.result;\nconst submitted = $context.$nodes.PARSE_ADD_FEEDBACK_PAYLOAD.$output.result;\nconst response = $context.$nodes.GET_SUBMITTED_FEEDBACK_VISIBILITY_OPTIONS.$output;\nconst allowedVisibilityCodes = [\"ALL\", \"MANAGERS\", \"MANAGERS_AND_SUBJECT\", \"PRIVATE\", \"SUBJECT\", \"MANAGERS_SUBJECT_PEERS\"];\nif (!author || author.valid !== true || !submitted || submitted.valid !== true || submitted.actionId !== \"submitFeedback\" ||\n    !response || typeof response !== \"object\" || Array.isArray(response) ||\n    response.error || response.timeout || response.isError || Number(response.statusCode || 0) >= 400 ||\n    !Array.isArray(response.items) || allowedVisibilityCodes.indexOf(submitted.visibility) === -1) return rejected;\nconst matching = response.items.filter(function (item) {\n  return item && typeof item === \"object\" && !Array.isArray(item) && item.VisibilityCode === submitted.visibility &&\n    typeof item.VisibilityMeaning === \"string\" && Boolean(item.VisibilityMeaning.trim());\n});\nif (matching.length !== 1) return rejected;\nreturn { valid: true, authorId: author.authorId, workerId: author.workerId, visibility: submitted.visibility };",
            "errorNodeId": "1787651228309"
          },
          "outcomes": {
            "success": "1791801000108"
          },
          "inputs": [],
          "diagram": {
            "x": 5225,
            "y": 10312
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
