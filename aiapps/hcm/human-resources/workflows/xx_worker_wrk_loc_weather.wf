            "success": "PREPARE_SAFE_RENDER_WEATHER_AND_TIME_CARD"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "PREPARE_SAFE_RENDER_WEATHER_AND_TIME_CARD",
          "code": "PREPARE_SAFE_RENDER_WEATHER_AND_TIME_CARD",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Safe Render Weather And Time Card",
            "description": "Enforces the permitted data and output contract for this HR panel.",
            "returnType": "object",
            "sourceCode": "const allowed=[\"LocationName\", \"Expertise Tags\"];\n\nfunction reject() { throw new Error(\"Unverified HR answer.\"); }\nfunction clean(value) { return value.replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]/g,\"\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\nlet size=0;const blocked=[];\nfunction project(value,depth) {\n  if(depth>20) reject();\n  if(typeof value === \"string\") {\n    size+=value.length;if(size>1000000) reject();\n    // Cached contexts and the existing *Json values can be serialized JSON.\n    const trimmed=value.trim();\n    if(depth===0 && /^[\\[{\\\"]/.test(trimmed)) {try {return project(JSON.parse(trimmed),depth+1);}catch(e){reject();}}\n    return clean(value);\n  }\n  if(Array.isArray(value)) {if(value.length>1000) reject();return value.map(function(v){return project(v,depth+1);});}\n  if(value && typeof value === \"object\") {\n    const result={};Object.keys(value).forEach(function(k){\n      if(allowed.indexOf(k)>=0) result[k]=project(value[k],depth+1);\n      else if(/(?:Id|ID|Identifier|Key)$/.test(k) && [\"string\",\"number\"].includes(typeof value[k])) blocked.push(String(value[k]));\n    });return result;\n  }\n  if(value==null || typeof value === \"boolean\" || (typeof value === \"number\" && Number.isFinite(value))) return value;\n  reject();\n}\n\nconst raw=[$context.$nodes.NORMALIZE_LOCATION_INPUT.$output.result];\nconst projected=raw.map(function(v){return project(v,0);});\n\nconst allowedUrls=[];\nfunction collectUrls(v) {\n  if(typeof v === \"string\") (v.match(/https?:\\/\\/[^\\s<>\"\\])]+/gi)||[]).forEach(function(url){allowedUrls.push(url);});\n  else if(Array.isArray(v)) v.forEach(collectUrls);\n  else if(v && typeof v===\"object\") Object.keys(v).forEach(function(k){collectUrls(v[k]);});\n}\n// No business-authored URL is approved merely because it appears in text.\nreturn {modelJson:JSON.stringify(projected),values:projected.map(function(v){return JSON.stringify(v);}),blocked:blocked,allowedUrls:allowedUrls};\n",
            "errorNodeId": "HR_RESPONSE_REJECTED"
          },
          "outcomes": {
            "success": "1779890762061"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 6760
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1779890762061",
          "code": "RENDER_WEATHER_AND_TIME_CARD",
          "type": "LLM",
          "metadata": {
            "name": "Render Weather And Time Card",
            "modelConfiguration": {
              "code": "ORA_LLM_PREMIUM",
              "modelName": "GPT-4.1 Mini (Premium)",
              "provider": "CERT_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelProperties": {
                "k": 0,
