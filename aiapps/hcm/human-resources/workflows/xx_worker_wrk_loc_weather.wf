        {
          "id": "1779889406181",
          "code": "EXTRACT_PERSON_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Extract Person Context",
            "returnType": "object",
            "sourceCode": "const maxContextLength = 16384;\n\nconst parseContextObject = function (value) {\n  if (value === null || value === undefined || value === \"\") return null;\n  if (typeof value === \"string\") {\n    if (value.length > maxContextLength) throw new Error(\"Invalid person context\");\n    try { value = JSON.parse(value); } catch (e) { throw new Error(\"Invalid person context\"); }\n    if (value === null) return null;\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) throw new Error(\"Invalid person context\");\n  let serialized;\n  try { serialized = JSON.stringify(value); } catch (e) { throw new Error(\"Invalid person context\"); }\n  if (typeof serialized !== \"string\" || serialized.length > maxContextLength) throw new Error(\"Invalid person context\");\n  let count = 0;\n  function safeKeys(object, depth) {\n    if (++count > 1000 || depth > 12) return false;\n    if (!object || typeof object !== \"object\") return true;\n    return Object.keys(object).every(function (key) {\n      return [\"__proto__\", \"constructor\", \"prototype\"].indexOf(key) === -1 && safeKeys(object[key], depth + 1);\n    });\n  }\n  if (!safeKeys(value, 0)) throw new Error(\"Invalid person context\");\n  return value;\n};\nconst normalizePersonId = function (value) {\n  if (value === null || value === undefined || value === \"\") return null;\n  if (typeof value === \"number\") {\n    if (!Number.isSafeInteger(value) || value <= 0) throw new Error(\"Invalid person context\");\n    return value;\n  }\n  if (typeof value !== \"string\") throw new Error(\"Invalid person context\");\n  const trimmed = value.trim();\n  if (!/^[1-9][0-9]{0,19}$/.test(trimmed) || !Number.isSafeInteger(Number(trimmed))) throw new Error(\"Invalid person context\");\n  return trimmed;\n};\nconst appContext = parseContextObject($context?.$app?.$OraAppContext);\nconst userContext = parseContextObject($context?.$app?.$OraUserContext);\n// Resolve the subject: REST input, app context, then the logged-in person.\nconst passedPersonId = normalizePersonId($context?.$triggers?.REST?.$input?.personId);\nconst appPersonId = passedPersonId === null ? normalizePersonId(appContext?.personId) : null;\nconst selectedPersonId = passedPersonId !== null ? passedPersonId : appPersonId;\nconst loggedInPersonId = normalizePersonId(userContext?.userId);\n\nif (selectedPersonId === null && loggedInPersonId === null) throw new Error(\"Invalid person context\");\n\nreturn {\n  personId: selectedPersonId !== null ? selectedPersonId : loggedInPersonId\n};"
          },
