        {
          "id": "1779787912738",
          "code": "RENDER_EMERGENCY_CONTACTS_LIST",
          "type": "LLM",
          "metadata": {
            "name": "Render Emergency Contacts List",
            "chatHistoryEnabled": false,
            "answerInUserLanguage": false,
            "errorNodeId": "1781103257385"
