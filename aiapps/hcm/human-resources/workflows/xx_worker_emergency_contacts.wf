          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentNumber\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentName\": {\n            \"type\": \"string\"\n          },\n          \"LegalEmployerName\": {\n            \"type\": \"string\"\n          },\n          \"StartDate\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryFlag\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryAssignmentFlag\": {\n            \"type\": \"string\"\n          },\n          \"WorkerType\": {\n            \"type\": \"string\"\n          },\n          \"WorkerNumber\": {\n            \"type\": \"string\"\n          },\n          \"ManagerName\": {\n            \"type\": \"string\"\n          },\n          \"BusinessUnitName\": {\n            \"type\": \"string\"\n          },\n          \"DepartmentName\": {\n            \"type\": \"string\"\n          },\n          \"JobCode\": {\n            \"type\": \"string\"\n          },\n          \"JobName\": {\n            \"type\": \"string\"\n          },\n          \"PositionCode\": {\n            \"type\": \"string\"\n          },\n          \"PositionName\": {\n            \"type\": \"string\"\n          },\n          \"LocationCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationName\": {\n            \"type\": \"string\"\n          },\n          \"GradeCode\": {\n            \"type\": \"string\"\n          },\n          \"GradeName\": {\n            \"type\": \"string\"\n          },\n          \"LocationPostalCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationCountry\": {\n            \"type\": \"string\"\n          },\n          \"LengthOfServiceYears\": {\n            \"type\": \"string\"\n          },\n          \"MarkedAsFavoriteFlag\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"PersonId\",\n          \"AssignmentId\",\n          \"AssignmentNumber\",\n          \"AssignmentName\",\n          \"LegalEmployerName\",\n          \"StartDate\",\n          \"PrimaryFlag\",\n          \"PrimaryAssignmentFlag\",\n          \"WorkerType\",\n          \"WorkerNumber\",\n          \"ManagerName\",\n          \"BusinessUnitName\",\n          \"DepartmentName\",\n          \"JobCode\",\n          \"JobName\",\n          \"PositionCode\",\n          \"PositionName\",\n          \"LocationCode\",\n          \"LocationName\",\n          \"GradeCode\",\n          \"GradeName\",\n          \"LocationPostalCode\",\n          \"LocationCountry\",\n          \"LengthOfServiceYears\",\n          \"MarkedAsFavoriteFlag\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "1781103257369",
          "code": "PREPARE_EMERGENCY_CONTACTS_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Emergency Contacts Output",
            "sourceCode": "// Date-only values must never be converted through a time zone.\nfunction parse(value) {\n  if (typeof value === \"string\") { try { return JSON.parse(value); } catch (error) { return null; } }\n  return value;\n}\nfunction collection(value) {\n  const response = parse(value);\n  if (!response || response.error || response.timeout || response.isError ||\n      Number(response.statusCode || response.status || 0) >= 400 ||\n      String(response.hasMore).toLowerCase() === \"true\" || !Array.isArray(response.items)) return [];\n  return response.items;\n}\nconst viewerId = $context.$nodes.RESOLVE_VIEWER_DATE_CONTEXT.$output.result.viewerPersonId;\n// USER_SESSION is bound to the authenticated viewer, never OraAppContext's subject.\nconst sessions = collection($context.$nodes.READ_VIEWER_SESSION?.$output);\nconst session = sessions.length === 1 && sessions[0] ? sessions[0] : {};\nconst preference = typeof session.DateFormat === \"string\" ? session.DateFormat.trim() : \"\";\nconst language = String(session.Language || session.DefaultLanguage || \"\").toLowerCase();\nlet country = typeof session.Territory === \"string\" ? session.Territory.trim().toUpperCase() : \"\";\nif (!country && viewerId) {\n  const countries = [];\n  collection($context.$nodes.GET_VIEWER_WORK_ASSIGNMENT?.$output).forEach(function (row) {\n    if (!row || (row.PersonId != null && String(row.PersonId).trim() !== viewerId)) return;\n    if (row.PrimaryFlag != null && !/^(true|y)$/i.test(String(row.PrimaryFlag))) return;\n    const value = typeof row.LocationCountry === \"string\" ? row.LocationCountry.trim().toUpperCase() : \"\";\n    if (countries.indexOf(value) < 0) countries.push(value);\n  });\n  if (countries.length === 1) country = countries[0];\n}\nconst monthNames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\nfunction preferenceFormat(parts) {\n  // Oracle selfDetails.DateFormat uses Java-style day/month/year tokens.\n  if (!preference || preference.length > 80) return null;\n  const tokens = preference.match(/yyyy|YYYY|yy|YY|MMMM|MMM|MM|M|dd|DD|d|D|[\\s/.,-]+/g);\n  if (!tokens || tokens.join(\"\") !== preference) return null;\n  const dateTokens = tokens.filter(function (token) { return /[yYMdD]/.test(token); });\n  if (dateTokens.length !== 3 ||\n      dateTokens.filter(function (t) { return /^[yY]/.test(t); }).length !== 1 ||\n      dateTokens.filter(function (t) { return /^M/.test(t); }).length !== 1 ||\n      dateTokens.filter(function (t) { return /^[dD]/.test(t); }).length !== 1) return null;\n  if (preference.indexOf(\"MMM\") >= 0 && !/^en(?:[-_]|$)/.test(language)) return null;\n  return tokens.map(function (token) {\n    if (/^(yyyy|YYYY)$/.test(token)) return parts[1];\n    if (/^(yy|YY)$/.test(token)) return parts[1].slice(-2);\n    if (token === \"MMMM\") return monthNames[Number(parts[2]) - 1];\n    if (token === \"MMM\") return monthNames[Number(parts[2]) - 1].slice(0, 3);\n    if (token === \"MM\") return parts[2];\n    if (token === \"M\") return String(Number(parts[2]));\n    if (/^(dd|DD)$/.test(token)) return parts[3];\n    if (/^(d|D)$/.test(token)) return String(Number(parts[3]));\n    return token;\n  }).join(\"\");\n}\nfunction formatDate(value) {\n  if (value == null || value === \"\") return \"\";\n  if (typeof value !== \"string\") return value;\n  const parts = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(value);\n  if (!parts) return value;\n  const year = Number(parts[1]), month = Number(parts[2]), day = Number(parts[3]);\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  if (year < 1 || month < 1 || month > 12 || day < 1 || day > days[month - 1]) return value;\n  const preferred = preferenceFormat(parts);\n  if (preferred !== null) return preferred;\n  if (country === \"US\") return parts[2] + \"/\" + parts[3] + \"/\" + parts[1];\n  if ([\"IN\", \"GB\", \"UK\", \"AU\", \"SG\"].indexOf(country) >= 0) return parts[3] + \"/\" + parts[2] + \"/\" + parts[1];\n  return value;\n}\n\nfunction displayText(value) {\n  return value === null || value === undefined ? \"\" : String(value).trim();\n}\n\nfunction isPrimary(value) {\n  return value === true || value === 1 || /^(true|y|1)$/i.test(displayText(value));\n}\n\nfunction displayRecord(row) {\n  const phone = displayText(row.ContactPhoneNumber);\n  const email = displayText(row.ContactEmailAddress);\n  const startDate = formatDate(displayText(row.EffectiveStartDate));\n  const contactDetails = [];\n\n  if (isPrimary(row.PrimaryContactFlag)) contactDetails.push(\"Primary\");\n  if (phone) contactDetails.push(\"Phone: \" + phone);\n  if (email) contactDetails.push(\"Email: \" + email);\n\n  return {\n    displayName: displayText(row.ContactDisplayName) || \"Contact\",\n    relationship: displayText(row.ContactTypeMeaning),\n    contactDetails: contactDetails.join(\" | \"),\n    relationshipStartDate: startDate ? \"Start Date: \" + startDate : \"\"\n  };\n}\n\n// Expose only the requested display fields, never IDs, links, or raw records.\nconst records = $context.$nodes.SORT_CONTACT_RECORDS.$output.result;\nreturn {\n  initialRecords: records.initialRecords.map(displayRecord),\n  additionalRecords: records.additionalRecords.map(displayRecord)\n};",
            "returnType": "object",
            "errorNodeId": "1781103257385"
