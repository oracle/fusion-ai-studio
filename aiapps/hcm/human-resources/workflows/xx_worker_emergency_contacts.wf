        {
          "id": "1779787732253",
          "code": "EXTRACT_PERSON_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Extract Person Context",
            "sourceCode": "const maximumContextLength = 32768;\nconst own = (object, key) => Object.prototype.hasOwnProperty.call(object, key);\nfunction fail() { throw new Error('Invalid contact request.'); }\n\nfunction contextObject(value) {\n  if (value == null || value === '') return {};\n  if (typeof value === 'string') {\n    if (value.length > maximumContextLength) fail();\n    try { value = JSON.parse(value); } catch (error) { fail(); }\n  }\n  if (!value || typeof value !== 'object' || Array.isArray(value)) fail();\n  const prototype = Object.getPrototypeOf(value);\n  if (prototype !== Object.prototype && prototype !== null) fail();\n  let serialized;\n  try { serialized = JSON.stringify(value); } catch (error) { fail(); }\n  if (typeof serialized !== 'string' || serialized.length > maximumContextLength) fail();\n  let visited = 0;\n  function inspect(item, depth) {\n    if (++visited > 2000 || depth > 12) fail();\n    if (!item || typeof item !== 'object') return;\n    Object.keys(item).forEach(function (key) {\n      if (key === '__proto__' || key === 'prototype' || key === 'constructor') fail();\n      inspect(item[key], depth + 1);\n    });\n  }\n  inspect(value, 0);\n  return value;\n}\n\nfunction positiveId(object, key) {\n  if (!own(object, key) || object[key] === undefined) return null;\n  const value = object[key];\n  if (typeof value === 'number') {\n    if (!Number.isSafeInteger(value) || value <= 0) fail();\n    return String(value);\n  }\n  if (typeof value !== 'string') fail();\n  const normalized = value.trim();\n  if (!/^[1-9][0-9]{0,29}$/.test(normalized)) fail();\n  return normalized;\n}\n\nconst appContext = contextObject($context?.$app?.$OraAppContext);\nconst userContext = contextObject($context?.$app?.$OraUserContext);\nconst restInput = contextObject($context?.$triggers?.REST?.$input);\nconst appPersonId = positiveId(appContext, 'personId');\n// Optional REST inputs may be materialized as blank or null when omitted.\n// A valid app subject wins; an unused REST field cannot change that selection.\nconst triggerValue = own(restInput, 'personId') ? restInput.personId : undefined;\nconst triggerAbsent = triggerValue == null ||\n  (typeof triggerValue === 'string' && !triggerValue.trim());\nconst triggerPersonId = appPersonId || triggerAbsent ? null : positiveId(restInput, 'personId');\nconst viewerPersonId = positiveId(userContext, 'userId');\n// Require a viewer identity before accepting any selected or REST subject.\n// Subject authorization remains enforced by the native-authenticated backend.\nif (!viewerPersonId) fail();\nconst personId = appPersonId || triggerPersonId || viewerPersonId;\nif (!personId) fail();\n\nconst hint = $context?.$app?.$OraMessageHint;\nconst stage = hint == null || hint === '' ? 'Query' : hint;\nif (['InitDisplay', 'AdditionalContent', 'Query'].indexOf(stage) === -1) fail();\nlet question = '';\nif (stage === 'Query') {\n  const message = $context?.$system?.$inputMessage;\n  if (typeof message !== 'string' || !message.trim() || message.length > 8000) fail();\n  question = message.trim();\n}\n// Valid syntax selects the subject; the existing backend still enforces authorization.\n// The authenticated viewer remains separate from the viewed person's date context.\n\nconst effectiveDate = $context?.$system?.$currentDate;\nif (typeof effectiveDate !== 'string') fail();\nconst dateParts = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(effectiveDate);\nif (!dateParts) fail();\nconst year = Number(dateParts[1]), month = Number(dateParts[2]), day = Number(dateParts[3]);\nconst leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\nconst days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\nif (year < 1 || month < 1 || month > 12 || day < 1 || day > days[month - 1]) fail();\n\nreturn { personId, viewerPersonId, stage, messageHint: stage, question, effectiveDate };",
            "returnType": "object",
            "description": "Validates request context and resolves app, optional REST, then viewer person identifiers without accepting malformed or injected values.",
            "errorNodeId": "1781103257385"
          },
          "diagram": {
            "x": 5675,
            "y": 5206
          },
