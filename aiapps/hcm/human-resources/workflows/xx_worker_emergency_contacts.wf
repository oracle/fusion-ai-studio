                  ],
                  "diagram": {
                    "x": 5675,
                    "y": 6113
                  },
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"ContactRelationshipId\": {\n            \"type\": \"string\"\n          },\n          \"EffectiveStartDate\": {\n            \"type\": \"string\"\n          },\n          \"EffectiveEndDate\": {\n            \"type\": \"string\"\n          },\n          \"ContactType\": {\n            \"type\": \"string\"\n          },\n          \"ContactTypeMeaning\": {\n            \"type\": \"string\"\n          },\n          \"LegislationCode\": {\n            \"type\": \"string\"\n          },\n          \"LegislationName\": {\n            \"type\": \"string\"\n          },\n          \"EmergencyContactFlag\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryContactFlag\": {\n            \"type\": \"string\"\n          },\n          \"StatutoryDependent\": {\n            \"type\": \"string\"\n          },\n          \"StatutoryDependentMeaning\": {\n            \"type\": \"string\"\n          },\n          \"CreatedBy\": {\n            \"type\": \"string\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdatedBy\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateDate\": {\n            \"type\": \"string\"\n          },\n          \"RelatedPersonId\": {\n            \"type\": \"string\"\n          },\n          \"ContactPersonId\": {\n            \"type\": \"string\"\n          },\n          \"ExistingPerson\": {\n            \"type\": \"string\"\n          },\n          \"ContactDisplayName\": {\n            \"type\": \"string\"\n          },\n          \"ContactPhoneNumber\": {\n            \"type\": \"string\"\n          },\n          \"ContactPersonNumber\": {\n            \"type\": \"string\"\n          },\n          \"ContactEmailAddress\": {\n            \"type\": \"string\"\n          },\n          \"ContactFormattedMultiLineAddress\": {\n            \"type\": \"string\"\n          },\n          \"IsStatusNewFlag\": {\n            \"type\": \"string\"\n          },\n          \"RowPostState\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"ContactRelationshipId\",\n          \"EffectiveStartDate\",\n          \"EffectiveEndDate\",\n          \"ContactType\",\n          \"ContactTypeMeaning\",\n          \"LegislationCode\",\n          \"LegislationName\",\n          \"EmergencyContactFlag\",\n          \"PrimaryContactFlag\",\n          \"StatutoryDependent\",\n          \"StatutoryDependentMeaning\",\n          \"CreatedBy\",\n          \"CreationDate\",\n          \"LastUpdatedBy\",\n          \"LastUpdateDate\",\n          \"RelatedPersonId\",\n          \"ContactPersonId\",\n          \"ExistingPerson\",\n          \"ContactDisplayName\",\n          \"ContactPhoneNumber\",\n          \"ContactPersonNumber\",\n          \"ContactEmailAddress\",\n          \"ContactFormattedMultiLineAddress\",\n          \"IsStatusNewFlag\",\n          \"RowPostState\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
                },
                {
                  "id": "1781103257373",
                  "code": "COLLECT_CONTACT_PAGE",
                  "type": "CODE",
                  "metadata": {
                    "name": "Collect Contact Page",
                    "sourceCode": "function parseResponse(value) {\n  if (typeof value !== \"string\") return value;\n  if (value.length > 1048576) throw new Error(\"The contact response exceeds the safe size limit.\");\n  try {\n    return JSON.parse(value);\n  } catch (error) {\n    throw new Error(\"The contact page could not be read.\");\n  }\n}\n\nfunction integer(value) {\n  if (typeof value !== \"number\" && typeof value !== \"string\") return null;\n  if (typeof value === \"string\" && !/^\\d+$/.test(value.trim())) return null;\n  const number = Number(value);\n  return Number.isSafeInteger(number) && number >= 0 && Math.floor(number) === number ? number : null;\n}\n\nfunction flag(value) {\n  if (value === true || value === false) return value;\n  if (typeof value === \"string\" && /^(true|false)$/i.test(value.trim())) {\n    return value.trim().toLowerCase() === \"true\";\n  }\n  return null;\n}\n\nconst state = $context.$variables.contactPaging;\nconst response = parseResponse($context.$nodes.WHILE_FETCH_CONTACT_PAGES.GET_EMERGENCY_CONTACTS.$output);\nif (!state || !Array.isArray(state.rows) || state.hasMore !== true ||\n    !Number.isSafeInteger(state.offset) || state.offset < 0 || state.offset > 50000 ||\n    !Number.isSafeInteger(state.pageCount) || state.pageCount < 0 || state.pageCount >= 500 ||\n    state.pageSize !== 100 || state.personId !== $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId ||\n    state.effectiveDate !== $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.effectiveDate) {\n  throw new Error(\"The contact paging state is invalid.\");\n}\nif (!response || typeof response !== \"object\" || Array.isArray(response)\n    || response.error || response.timeout || response.isError\n    || Number(response.statusCode || response.status || 0) >= 400\n    || !Array.isArray(response.items)) {\n  throw new Error(\"The contact page could not be loaded completely.\");\n}\n\nconst hasMore = flag(response.hasMore);\nconst pageOffset = integer(response.offset);\nconst pageCount = integer(response.count);\nconst pageLimit = integer(response.limit);\nif (hasMore === null || pageOffset !== state.offset || pageCount !== response.items.length\n    || pageLimit === null || pageLimit < 1 || pageLimit > state.pageSize || pageCount > pageLimit) {\n  throw new Error(\"The contact page has invalid pagination metadata.\");\n}\nif (hasMore && pageCount === 0) {\n  throw new Error(\"The contact paging response made no progress.\");\n}\nif (hasMore && state.pageCount + 1 >= 500) {\n  throw new Error(\"The complete contact list exceeds the safe paging limit.\");\n}\n\nfunction recordKey(row) {\n  const id = row.ContactRelationshipId;\n  return id == null ? \"\" : String(id) + \"|\" + String(row.EffectiveStartDate || \"\") + \"|\" + String(row.EffectiveEndDate || \"\");\n}\n\nconst keys = {};\nstate.rows.forEach(function (row) {\n  const key = recordKey(row);\n  if (key) keys[\"record:\" + key] = true;\n});\nresponse.items.forEach(function (row) {\n  if (!row || typeof row !== \"object\" || Array.isArray(row)) {\n    throw new Error(\"The contact page contains an invalid record.\");\n  }\n  const rowPersonId = row.RelatedPersonId;\n  if (rowPersonId == null || String(rowPersonId).trim() !== state.personId) {\n    throw new Error(\"The contact page does not match the selected employee.\");\n  }\n  const key = recordKey(row);\n  if (!key) throw new Error(\"A contact record has no stable identifier.\");\n  if (key && keys[\"record:\" + key]) {\n    throw new Error(\"The contact pages overlap. Please refresh the panel.\");\n  }\n  if (key) keys[\"record:\" + key] = true;\n});\n\nreturn {\n  rows: state.rows.concat(response.items),\n  offset: state.offset + pageCount,\n  pageSize: state.pageSize,\n  pageCount: state.pageCount + 1,\n  hasMore: hasMore,\n  personId: state.personId,\n  effectiveDate: state.effectiveDate\n};",
                    "returnType": "object",
                    "errorNodeId": "1781103257385"
                  },
