        {
          "id": "1781103257375",
          "code": "SORT_CONTACT_RECORDS",
          "type": "CODE",
          "metadata": {
            "name": "Sort Contact Records",
            "sourceCode": "// Sort only after all pages are present. Date-only values never pass through a time zone.\nfunction dateKey(value) {\n  if (typeof value !== \"string\") return \"\";\n  const match = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(value.trim());\n  if (!match) return \"\";\n  const year = Number(match[1]);\n  const month = Number(match[2]);\n  const day = Number(match[3]);\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  return year >= 1 && month >= 1 && month <= 12 && day >= 1 && day <= days[month - 1]\n    ? match[0] : \"\";\n}\n\nfunction isEmergency(value) {\n  return value === true || value === 1\n    || (typeof value === \"string\" && /^(true|y|1)$/i.test(value.trim()));\n}\n\nconst state = $context.$variables.contactPaging;\nif (!state || state.hasMore !== false || !Array.isArray(state.rows) || state.pageCount < 1) {\n  throw new Error(\"The contact list is incomplete. Please refresh the panel.\");\n}\n\n// EffectiveStartDate is the approved date source for this display.\n// Keep every emergency contact before non-emergency contacts, then oldest dates first.\nconst ordered = state.rows.map(function (row, index) {\n  return {\n    row: row,\n    index: index,\n    date: dateKey(row.EffectiveStartDate),\n    emergency: isEmergency(row.EmergencyContactFlag)\n  };\n}).sort(function (left, right) {\n  if (left.emergency !== right.emergency) return left.emergency ? -1 : 1;\n  if (left.date !== right.date) {\n    if (!left.date) return 1;\n    if (!right.date) return -1;\n    return left.date < right.date ? -1 : 1;\n  }\n  return left.index - right.index;\n}).map(function (entry) {\n  return entry.row;\n});\n\nreturn {\n  initialRecords: ordered,\n  additionalRecords: [],\n  hasAdditionalRecords: false\n};",
            "returnType": "object",
            "errorNodeId": "1781103257385"
          },
          "outcomes": {
            "success": "1781103257381"
          },
          "inputs": [],
          "diagram": {
