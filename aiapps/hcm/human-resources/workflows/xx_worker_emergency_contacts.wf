                {
                  "id": "1781103257367",
                  "code": "GET_EMERGENCY_CONTACTS",
                  "type": "BO_FUNCTION",
                  "metadata": {
                    "name": "Get Emergency Contacts",
                    "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_PERSONFAMILYANDEMERGENCYCONTACTSHISTORYV2",
                    "functionName": "get_current_and_future_person_family_and_emergency_contacts",
                    "errorNodeId": "1781103257385"
