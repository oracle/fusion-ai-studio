            "sourceCode": "// Keep pagination state isolated to this display request.\nconst personId = $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId;\nif (personId === null || personId === undefined || String(personId).trim() === \"\") {\n  throw new Error(\"A valid employee context is required.\");\n}\nreturn {\n  rows: [],\n  offset: 0,\n  pageSize: 100,\n  pageCount: 0,\n  hasMore: true,\n  personId: String(personId).trim(),\n  effectiveDate: $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.effectiveDate\n};",
            "returnType": "object",
