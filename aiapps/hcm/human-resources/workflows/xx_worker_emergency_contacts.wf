          "inputs": [],
          "diagram": {
            "x": 5675,
            "y": 7924
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1781103257386",
          "code": "PREPARE_SAFE_CONTACT_MODEL_INPUT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Safe Contact Model Input",
            "sourceCode": "function fail() { throw new Error(\"The contact data could not be validated.\"); }\nfunction text(value) {\n  if (typeof value !== \"string\" || value.length > 8192) fail();\n  return value;\n}\nfunction flag(value) {\n  if (value === null || value === undefined || value === \"\") return false;\n  if (value === true || value === 1 || /^(true|y|1)$/i.test(String(value))) return true;\n  if (value === false || value === 0 || /^(false|n|0)$/i.test(String(value))) return false;\n  fail();\n}\nfunction safeJson(value) {\n  return JSON.stringify(value).replace(/[<>&]/g, function (character) {\n    return \"\\\\u\" + character.charCodeAt(0).toString(16).padStart(4, \"0\");\n  });\n}\nconst prepared = $context.$nodes.PREPARE_EMERGENCY_CONTACTS_OUTPUT.$output.result;\nconst source = $context.$nodes.SORT_CONTACT_RECORDS.$output.result;\nif (!prepared || !Array.isArray(prepared.initialRecords) ||\n    !Array.isArray(prepared.additionalRecords) || prepared.additionalRecords.length !== 0 ||\n    !source || !Array.isArray(source.initialRecords) ||\n    prepared.initialRecords.length !== source.initialRecords.length) fail();\nconst initialRecords = prepared.initialRecords.map(function (row) {\n  if (!row || typeof row !== \"object\" || Array.isArray(row)) fail();\n  return {\n    displayName: text(row.displayName),\n    relationship: text(row.relationship),\n    contactDetails: text(row.contactDetails),\n    relationshipStartDate: text(row.relationshipStartDate)\n  };\n});\nconst queryRecords = initialRecords.map(function (row, index) {\n  return {\n    name: row.displayName,\n    relationship: row.relationship,\n    contactDetails: row.contactDetails,\n    startDate: row.relationshipStartDate,\n    emergencyContact: flag(source.initialRecords[index].EmergencyContactFlag),\n    primaryContact: flag(source.initialRecords[index].PrimaryContactFlag)\n  };\n});\nreturn {\n  initialRecordsJson: safeJson(initialRecords),\n  additionalRecordsJson: \"[]\",\n  queryRecordsJson: safeJson(queryRecords),\n  questionJson: safeJson($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.question)\n};",
