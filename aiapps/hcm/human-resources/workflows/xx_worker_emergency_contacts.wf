            "sourceCode": "const records=[];\nconst expected={patternId:\"messageListWidget\",properties:{items:records.map(function(r){const item={title:r.displayName,subtitle:r.contactDetails,summary:r.relationshipStartDate};if(r.relationship){item.badgeText=r.relationship;item.priority=\"medium\";}return item;})}};\n\nconst output = $context.$nodes.RENDER_NO_ADDITIONAL_CONTACTS.$output;\nconst rendered = typeof output === \"string\" ? output : output && typeof output.result === \"string\" ? output.result : null;\nif (rendered === null) throw new Error(\"Display output is missing\");\nfunction exact(a,b) {\n  if (a === b) return true;\n  if (!a || !b || typeof a !== \"object\" || typeof b !== \"object\" || Array.isArray(a) !== Array.isArray(b)) return false;\n  const ak=Object.keys(a).sort(), bk=Object.keys(b).sort();\n  return ak.length===bk.length && ak.every(function(k,i){return k===bk[i] && exact(a[k],b[k]);});\n}\nconst prefix = '<oraInfoDisplay key=\"summary\">', suffix = '</oraInfoDisplay>';\nconst text = rendered.trim();\nif (!text.startsWith(prefix) || !text.endsWith(suffix)) throw new Error(\"Invalid display envelope\");\nlet actual;\ntry { actual=JSON.parse(text.slice(prefix.length,-suffix.length)); } catch(error) { throw new Error(\"Invalid display JSON\"); }\nif (!exact(actual,expected)) throw new Error(\"Display differs from the prepared records\");\nreturn prefix + JSON.stringify(expected).replace(/&/g,\"\\\\u0026\").replace(/</g,\"\\\\u003c\").replace(/>/g,\"\\\\u003e\") + suffix;\n",
