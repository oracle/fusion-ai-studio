  "workflowId": "300100717478122",
  "workflowCode": "XX_PER_PASSPORTS",
  "name": "Worker Passports",
  "description": "Displays the selected worker's passports, including passport number, type, issuing country, issue date, and expiration date. Answers questions using the available passport records.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "id": "start",
          "code": "START",
          "type": "START",
          "metadata": {
            "name": "Start",
            "description": "Start of data pipeline"
          },
          "outcomes": {
            "success": "1"
          },
          "inputs": [],
          "diagram": {
            "x": 5797,
