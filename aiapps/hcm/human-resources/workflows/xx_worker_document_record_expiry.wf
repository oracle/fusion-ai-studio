        {
          "id": "VALIDATE_REQUEST_FETCH_EXPIRING_DOCUMENT_RECORDS",
          "code": "VALIDATE_REQUEST_FETCH_EXPIRING_DOCUMENT_RECORDS",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Fetch Expiring Document Records",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction personNumber(value,name) {\n  if(typeof value!==\"string\" && !(typeof value===\"number\" && Number.isSafeInteger(value) && value>0)) reject(name);\n  const text=String(value).trim();if(!/^[A-Za-z0-9_.@-]{1,50}$/.test(text)) reject(name);return text;\n}\nfunction date(value,name) {\n  if(typeof value!==\"string\" || !/^\\d{4}-\\d{2}-\\d{2}$/.test(value) || value<\"1900-01-01\" || value>\"9999-12-31\") reject(name);\n  const parsed=new Date(value+\"T00:00:00Z\");if(!Number.isFinite(parsed.getTime()) || parsed.toISOString().slice(0,10)!==value) reject(name);return value;\n}\n\nconst checked={};\nchecked[\"pPersonNumber\"]=personNumber(($context.$nodes.VALIDATE_DOCUMENT_RECORD_EXPIRY_INPUTS.$output.result.personNumber),\"pPersonNumber\");\nchecked[\"pStartDate\"]=date(($context.$nodes.CALCULATE_DOCUMENT_EXPIRY_DATE_RANGE.$output.result.currentDate),\"pStartDate\");\nchecked[\"pEndDate\"]=date(($context.$nodes.CALCULATE_DOCUMENT_EXPIRY_DATE_RANGE.$output.result.dateAfter30Days),\"pEndDate\");\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1782288793680"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
