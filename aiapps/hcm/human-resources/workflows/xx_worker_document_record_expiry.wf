            "success": "PREPARE_SAFE_GENERATE_OUTPUT_FOR_DOCUMENT_RECORDS_DATA"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "PREPARE_SAFE_GENERATE_OUTPUT_FOR_DOCUMENT_RECORDS_DATA",
          "code": "PREPARE_SAFE_GENERATE_OUTPUT_FOR_DOCUMENT_RECORDS_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Safe Generate Output For Document Records Data",
            "description": "Enforces the permitted data and output contract for this HR panel.",
            "returnType": "object",
            "sourceCode": "function reject() { throw new Error(\"The response did not match the permitted HR display contract.\"); }\nfunction text(v) {\n  if (typeof v !== \"string\" && typeof v !== \"number\") return \"\";\n  return String(v).replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]/g, \"\").trim()\n    .replace(/&(?!amp;|lt;|gt;|quot;|apos;|nbsp;)/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\");\n}\nfunction list(v) { if (!Array.isArray(v) || v.length > 1000) reject(); return v; }\nfunction display(pattern,properties,extra) { return {type:\"oraInfoDisplay\",payload:Object.assign({patternId:pattern},extra || {},{properties:properties})}; }\nfunction message(items,extra) { return display(\"messageListWidget\",{items:items},extra); }\n\nlet blocks=[],visibleText=\"\";\nconst rows=list($context.$nodes.PROCESS_DOCUMENT_RECORDS_DATA.$output.result);\nconst items=rows.map(function(row){const item={status:text(row.DocumentType),subtitle:text(row.DocumentName),summary:\"Attachments Count: \"+text(row.AttachmentsCount)+\",\\nLast Update Date: \"+text(row.LastUpdateDate),badgeText:text(row.DateTo),priority:\"warning\"};\n\nreturn item;});\nblocks=[message(items,{description:rows.length ? \"You have \"+rows.length+\" document(s) that are due to expire soon. Please review them and take the appropriate action.\" : \"No documents about to expire.\" })];\n\n// Keep internal identifiers and executable commands outside the model context.\nconst references = {};\nlet referenceIndex = 0;\nfunction protect(value,key,parent) {\n  if (typeof value === \"string\" && ([\"action\",\"drillDownAction\",\"followUpCommand\",\"image\"].includes(key) || (key === \"id\" && /\\d/.test(value)) || (key === \"value\" && parent && [\"hidden\",\"system\"].includes(parent.type)))) {\n    const token = \"HR_REF_\" + (++referenceIndex);\n    references[token] = value;\n    return token;\n  }\n  if (Array.isArray(value)) return value.map(function(v) { return protect(v,\"\",null); });\n  if (value && typeof value === \"object\") {\n    const result = {};\n    Object.keys(value).forEach(function(k) { if ([\"__proto__\",\"prototype\",\"constructor\"].includes(k)) reject(); result[k] = protect(value[k],k,value); });\n    return result;\n  }\n  if (typeof value === \"string\" && /HR_REF_\\d+/.test(value)) reject();\n  return value;\n}\nconst contract = {blocks:blocks,text:visibleText};\nconst modelContract = protect(contract,\"\",null);\nconst modelJson = JSON.stringify(modelContract);\nif (modelJson.length > 1000000) reject();\nreturn {modelJson:modelJson,contract:modelContract,references:references};\n",
            "errorNodeId": "HR_RESPONSE_REJECTED"
          },
          "outcomes": {
            "success": "1782288932908"
          },
