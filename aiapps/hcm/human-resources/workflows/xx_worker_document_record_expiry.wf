          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"PersonId\": {\n      \"type\": \"string\"\n    },\n    \"PersonNumber\": {\n      \"type\": \"string\"\n    },\n    \"LastName\": {\n      \"type\": \"string\"\n    },\n    \"FirstName\": {\n      \"type\": \"string\"\n    },\n    \"Title\": {\n      \"type\": \"string\"\n    },\n    \"PreNameAdjunct\": {\n      \"type\": \"string\"\n    },\n    \"Suffix\": {\n      \"type\": \"string\"\n    },\n    \"MiddleNames\": {\n      \"type\": \"string\"\n    },\n    \"Honors\": {\n      \"type\": \"string\"\n    },\n    \"KnownAs\": {\n      \"type\": \"string\"\n    },\n    \"DisplayName\": {\n      \"type\": \"string\"\n    },\n    \"ListName\": {\n      \"type\": \"string\"\n    },\n    \"OrderName\": {\n      \"type\": \"string\"\n    },\n    \"WorkEmail\": {\n      \"type\": \"string\"\n    },\n    \"Username\": {\n      \"type\": \"string\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"PersonId\",\n    \"PersonNumber\",\n    \"LastName\",\n    \"FirstName\",\n    \"Title\",\n    \"PreNameAdjunct\",\n    \"Suffix\",\n    \"MiddleNames\",\n    \"Honors\",\n    \"KnownAs\",\n    \"DisplayName\",\n    \"ListName\",\n    \"OrderName\",\n    \"WorkEmail\",\n    \"Username\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "1782288761466",
          "code": "CALCULATE_DOCUMENT_EXPIRY_DATE_RANGE",
          "type": "CODE",
          "metadata": {
            "name": "Calculate Document Expiry Date Range",
            "returnType": "object",
            "sourceCode": "function pad(value) {\n  return String(value).padStart(2, \"0\");\n}\n\nfunction formatLocalDate(date) {\n  return date.getFullYear() + \"-\" + pad(date.getMonth() + 1) + \"-\" + pad(date.getDate());\n}\n\nconst today = new Date();\nconst currentDate = formatLocalDate(today);\n\nconst dateAfter30 = new Date(today.getTime());\ndateAfter30.setDate(dateAfter30.getDate() + 30);\n\nreturn {\n  currentDate: currentDate,\n  dateAfter30Days: formatLocalDate(dateAfter30)\n};"
          },
          "diagram": {
            "x": 5225,
            "y": 5650
          },
          "outcomes": {
            "success": "1783065300001"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1783065300001",
          "code": "VALIDATE_DOCUMENT_RECORD_EXPIRY_INPUTS",
          "type": "CODE",
          "metadata": {
            "name": "Validate Document Record Expiry Inputs",
            "description": "Validates person number and calculated date inputs before fetching expiring document records.",
            "returnType": "object",
            "sourceCode": "function parseDateOnly(value) {\n  if (value === undefined || value === null) return null;\n  const text = String(value).trim();\n  const match = text.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!match) return null;\n\n  const year = Number(match[1]);\n  const month = Number(match[2]);\n  const day = Number(match[3]);\n  const date = new Date(year, month - 1, day);\n\n  if (date.getFullYear() !== year || date.getMonth() !== month - 1 || date.getDate() !== day) {\n    return null;\n  }\n\n  return date;\n}\n\nfunction validPersonNumber(value) {\n  const text = String(value || \"\").trim();\n  return text.length > 0 && text.length <= 50 && /^[A-Za-z0-9_.@-]+$/.test(text);\n}\n\nconst output = $context.$nodes.FETCH_PERSON_NUMBER_OF_LOGGEDIN_USER.$output || {};\nconst items = Array.isArray(output.items) ? output.items : (output.PersonId != null ? [output] : []);\nif(output.error || output.timeout || output.isError || Number(output.statusCode || output.status || 0)>=400 || items.length!==1 || (output.hasMore!==undefined && output.hasMore!==false && output.hasMore!==\"false\")) throw new Error(\"The worker context could not be resolved.\");\nconst context = items[0] || {};\nconst personNumber = String(context.PersonNumber || \"\").trim();\nif (String(context.PersonId) !== String($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId)) throw new Error(\"The worker did not match the requested person context.\");\nconst dateRange = ($context.$nodes.CALCULATE_DOCUMENT_EXPIRY_DATE_RANGE.$output || {}).result || {};\nconst currentDate = parseDateOnly(dateRange.currentDate);\nconst dateAfter30Days = parseDateOnly(dateRange.dateAfter30Days);\nconst isValid = validPersonNumber(personNumber) && currentDate !== null && dateAfter30Days !== null && currentDate.getTime() <= dateAfter30Days.getTime();\n\nreturn {\n  isValid: isValid,\n  personNumber: isValid ? personNumber : \"\"\n};",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "diagram": {
            "x": 5225,
            "y": 5872
          },
          "outcomes": {
            "success": "1783065300002"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
