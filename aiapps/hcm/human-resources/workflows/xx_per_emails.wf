          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentNumber\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentName\": {\n            \"type\": \"string\"\n          },\n          \"LegalEmployerName\": {\n            \"type\": \"string\"\n          },\n          \"StartDate\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryFlag\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryAssignmentFlag\": {\n            \"type\": \"string\"\n          },\n          \"WorkerType\": {\n            \"type\": \"string\"\n          },\n          \"WorkerNumber\": {\n            \"type\": \"string\"\n          },\n          \"ManagerName\": {\n            \"type\": \"string\"\n          },\n          \"BusinessUnitName\": {\n            \"type\": \"string\"\n          },\n          \"DepartmentName\": {\n            \"type\": \"string\"\n          },\n          \"JobCode\": {\n            \"type\": \"string\"\n          },\n          \"JobName\": {\n            \"type\": \"string\"\n          },\n          \"PositionCode\": {\n            \"type\": \"string\"\n          },\n          \"PositionName\": {\n            \"type\": \"string\"\n          },\n          \"LocationCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationName\": {\n            \"type\": \"string\"\n          },\n          \"GradeCode\": {\n            \"type\": \"string\"\n          },\n          \"GradeName\": {\n            \"type\": \"string\"\n          },\n          \"LocationPostalCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationCountry\": {\n            \"type\": \"string\"\n          },\n          \"LengthOfServiceYears\": {\n            \"type\": \"string\"\n          },\n          \"MarkedAsFavoriteFlag\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"PersonId\",\n          \"AssignmentId\",\n          \"AssignmentNumber\",\n          \"AssignmentName\",\n          \"LegalEmployerName\",\n          \"StartDate\",\n          \"PrimaryFlag\",\n          \"PrimaryAssignmentFlag\",\n          \"WorkerType\",\n          \"WorkerNumber\",\n          \"ManagerName\",\n          \"BusinessUnitName\",\n          \"DepartmentName\",\n          \"JobCode\",\n          \"JobName\",\n          \"PositionCode\",\n          \"PositionName\",\n          \"LocationCode\",\n          \"LocationName\",\n          \"GradeCode\",\n          \"GradeName\",\n          \"LocationPostalCode\",\n          \"LocationCountry\",\n          \"LengthOfServiceYears\",\n          \"MarkedAsFavoriteFlag\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
        },
