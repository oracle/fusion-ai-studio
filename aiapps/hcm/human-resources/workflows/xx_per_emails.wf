        {
          "id": "1",
          "code": "EXTRACT_PERSON_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Extract Person Context",
            "returnType": "object",
            "description": "Validates request context and resolves app, REST, then viewer person identifiers without accepting malformed or injected values.",
            "sourceCode": "const MAX_CONTEXT_LENGTH = 32768;\nconst MAX_QUERY_LENGTH = 8000;\nfunction fail() {\n  throw new Error(\"The contact request could not be validated.\");\n}\nfunction own(object, key) {\n  return Object.prototype.hasOwnProperty.call(object, key);\n}\nfunction contextObject(value) {\n  if (value === null || value === undefined || value === \"\") return {};\n  if (typeof value === \"string\") {\n    if (value.length > MAX_CONTEXT_LENGTH) fail();\n    if (!value.trim()) return {};\n    try { value = JSON.parse(value); } catch (error) { fail(); }\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) fail();\n  const prototype = Object.getPrototypeOf(value);\n  if (prototype !== null && prototype !== Object.prototype) fail();\n  if (own(value, \"__proto__\") || own(value, \"constructor\") || own(value, \"prototype\")) fail();\n  try {\n    if (JSON.stringify(value).length > MAX_CONTEXT_LENGTH) fail();\n  } catch (error) { fail(); }\n  return value;\n}\nfunction identifier(value) {\n  if (typeof value === \"number\") {\n    if (!Number.isSafeInteger(value) || value <= 0) fail();\n    return String(value);\n  }\n  if (typeof value !== \"string\") fail();\n  const result = value.trim();\n  if (!/^[0-9]{1,30}$/.test(result) || /^0+$/.test(result)) fail();\n  return result;\n}\nconst appContext = contextObject($context?.$app?.$OraAppContext);\nconst userContext = contextObject($context?.$app?.$OraUserContext);\nconst restInput = contextObject($context?.$triggers?.REST?.$input);\nconst viewerPersonId = own(userContext, \"userId\") ? identifier(userContext.userId) : \"\";\n// Require a viewer identity before accepting any selected or REST subject.\n// Subject authorization remains enforced by the native-authenticated backend.\nif (!viewerPersonId) fail();\nlet personId;\nif (own(appContext, \"personId\")) personId = identifier(appContext.personId);\nelse if (own(restInput, \"personId\") && restInput.personId != null &&\n         !(typeof restInput.personId === \"string\" && !restInput.personId.trim())) {\n  personId = identifier(restInput.personId);\n}\nelse if (viewerPersonId) personId = viewerPersonId;\nelse fail();\n\nconst rawHint = $context?.$app?.$OraMessageHint;\nconst messageHint = rawHint === null || rawHint === undefined || rawHint === \"\" ? \"\" : rawHint;\nif ([\"InitDisplay\", \"Query\"].indexOf(messageHint) < 0) fail();\nconst rawQuestion = $context?.$system?.$inputMessage;\nlet question = \"\";\nif (messageHint === \"Query\" && rawQuestion != null) {\n  if (typeof rawQuestion !== \"string\" || rawQuestion.length > MAX_QUERY_LENGTH) fail();\n  question = rawQuestion;\n}\n// Identifier validation is not authorization; the BO still enforces backend access.\nreturn { personId: personId, viewerPersonId: viewerPersonId, messageHint: messageHint, question: question };",
            "errorNodeId": "contact_security_error"
          },
          "outcomes": {
            "success": "viewer_date_session"
          },
          "inputs": [],
          "diagram": {
            "x": 5450,
