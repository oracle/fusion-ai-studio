        {
          "id": "VERIFY_TEAM_SESSION_WORKER",
          "code": "VERIFY_TEAM_SESSION_WORKER",
          "type": "CODE",
          "metadata": {
            "name": "Verify Team Session Worker",
            "sourceCode": "\nfunction reject(){throw new Error(\"The signed-in manager's direct-report scope could not be verified.\");}\nfunction id(v){if(typeof v===\"number\" && (!Number.isSafeInteger(v)||v<=0)) reject();const s=String(v==null?\"\":v);if(!/^[1-9][0-9]{0,15}$/.test(s)||!Number.isSafeInteger(Number(s)))reject();return s;}\nfunction collection(v){if(!v||v.error||v.timeout||v.isError||Number(v.statusCode||v.status||0)>=400||!Array.isArray(v.items)||(v.hasMore!==undefined&&v.hasMore!==false&&v.hasMore!==\"false\"))reject();return v.items;}\nconst rows=collection($context.$nodes.GET_TEAM_SESSION_WORKER.$output);\nif(rows.length!==1 || String(rows[0].PersonNumber)!==$context.$nodes.VALIDATE_PERSON_NUMBER.$output.result.personNumber)reject();\nreturn {personId:id(rows[0].PersonId)};",
            "returnType": "object",
            "errorNodeId": "HR_REQUEST_REJECTED"
