          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"PersonId\": {\n      \"type\": \"string\"\n    },\n    \"PersonNumber\": {\n      \"type\": \"string\"\n    },\n    \"LastName\": {\n      \"type\": \"string\"\n    },\n    \"FirstName\": {\n      \"type\": \"string\"\n    },\n    \"Title\": {\n      \"type\": \"string\"\n    },\n    \"PreNameAdjunct\": {\n      \"type\": \"string\"\n    },\n    \"Suffix\": {\n      \"type\": \"string\"\n    },\n    \"MiddleNames\": {\n      \"type\": \"string\"\n    },\n    \"Honors\": {\n      \"type\": \"string\"\n    },\n    \"KnownAs\": {\n      \"type\": \"string\"\n    },\n    \"DisplayName\": {\n      \"type\": \"string\"\n    },\n    \"ListName\": {\n      \"type\": \"string\"\n    },\n    \"OrderName\": {\n      \"type\": \"string\"\n    },\n    \"WorkEmail\": {\n      \"type\": \"string\"\n    },\n    \"Username\": {\n      \"type\": \"string\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"PersonId\",\n    \"PersonNumber\",\n    \"LastName\",\n    \"FirstName\",\n    \"Title\",\n    \"PreNameAdjunct\",\n    \"Suffix\",\n    \"MiddleNames\",\n    \"Honors\",\n    \"KnownAs\",\n    \"DisplayName\",\n    \"ListName\",\n    \"OrderName\",\n    \"WorkEmail\",\n    \"Username\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "1783063057876",
          "code": "VALIDATE_PERSON_NUMBER",
          "type": "CODE",
          "metadata": {
            "name": "Validate Person Number",
            "returnType": "object",
            "sourceCode": "function validPersonNumber(value) {\n  const text = String(value || \"\").trim();\n  return text.length > 0 && text.length <= 50 && /^[A-Za-z0-9_.@-]+$/.test(text);\n}\n\nconst output = $context.$nodes.FETCH_PERSON_NUMBER_OF_LOGGEDIN_USER.$output || {};\nconst items = Array.isArray(output.items) ? output.items : (output.PersonId != null ? [output] : []);\nif(output.error || output.timeout || output.isError || Number(output.statusCode || output.status || 0)>=400 || items.length!==1 || (output.hasMore!==undefined && output.hasMore!==false && output.hasMore!==\"false\")) throw new Error(\"The worker context could not be resolved.\");\nconst context = items[0] || {};\nconst personNumber = String(context.PersonNumber || \"\").trim();\nif (String(context.PersonId) !== String($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId)) throw new Error(\"The worker did not match the requested person context.\");\nconst isValid = validPersonNumber(personNumber);\n\nreturn {\n  isValid: isValid,\n  personNumber: isValid ? personNumber : \"\"\n};",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
