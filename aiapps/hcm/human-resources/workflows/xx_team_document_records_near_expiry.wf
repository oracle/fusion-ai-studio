        {
          "id": "VALIDATE_REQUEST_FETCH_EXPIRING_DOCUMENT_RECORDS",
          "code": "VALIDATE_REQUEST_FETCH_EXPIRING_DOCUMENT_RECORDS",
          "type": "CODE",
          "metadata": {
            "name": "Verify Current Direct Report Scope",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "\nfunction reject(){throw new Error(\"The signed-in manager's direct-report scope could not be verified.\");}\nfunction id(v){if(typeof v===\"number\" && (!Number.isSafeInteger(v)||v<=0)) reject();const s=String(v==null?\"\":v);if(!/^[1-9][0-9]{0,15}$/.test(s)||!Number.isSafeInteger(Number(s)))reject();return s;}\nfunction collection(v){if(!v||v.error||v.timeout||v.isError||Number(v.statusCode||v.status||0)>=400||!Array.isArray(v.items)||(v.hasMore!==undefined&&v.hasMore!==false&&v.hasMore!==\"false\"))reject();return v.items;}\nconst rows=collection($context.$nodes.GET_SIGNED_IN_MANAGERS_DIRECT_REPORTS.$output);if(rows.length>500)reject();\nconst managerId=$context.$nodes.VERIFY_TEAM_SESSION_WORKER.$output.result.personId;\nconst seen={},numbers={},members=[];\nrows.forEach(function(row){\n const personId=id(row.PersonId);const number=row.PersonNumber;\n if(personId===managerId || typeof number!==\"string\" || !/^[A-Za-z0-9_.@-]{1,50}$/.test(number))reject();\n if(seen[personId] && seen[personId]!==number || numbers[number] && numbers[number]!==personId)reject();\n if(!seen[personId])members.push({PersonId:personId,PersonNumber:number});seen[personId]=number;numbers[number]=personId;\n});\n$context.$variables.hrTeamDocuments=[];\nreturn {members:members};",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
