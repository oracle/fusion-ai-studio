                  "metadata": {
                    "name": "Verify Authorized Report Documents",
                    "sourceCode": "\nfunction reject(){throw new Error(\"The signed-in manager's direct-report scope could not be verified.\");}\nfunction id(v){if(typeof v===\"number\" && (!Number.isSafeInteger(v)||v<=0)) reject();const s=String(v==null?\"\":v);if(!/^[1-9][0-9]{0,15}$/.test(s)||!Number.isSafeInteger(Number(s)))reject();return s;}\nfunction collection(v){if(!v||v.error||v.timeout||v.isError||Number(v.statusCode||v.status||0)>=400||!Array.isArray(v.items)||(v.hasMore!==undefined&&v.hasMore!==false&&v.hasMore!==\"false\"))reject();return v.items;}\nconst member=$context.$nodes.FETCH_EXPIRING_DOCUMENT_RECORDS.$currentItem;\nconst rows=collection($context.$nodes.FETCH_EXPIRING_DOCUMENT_RECORDS.FETCH_AUTHORIZED_REPORT_DOCUMENTS.$output);\nconst start=$context.$nodes.CALCULATE_DOCUMENT_EXPIRY_DATE_RANGE.$output.result.currentDate;\nconst end=$context.$nodes.CALCULATE_DOCUMENT_EXPIRY_DATE_RANGE.$output.result.dateAfter30Days;\nrows.forEach(function(row){if(id(row.PersonId)!==member.PersonId || typeof row.DateTo!==\"string\" || row.DateTo<start || row.DateTo>end)reject();});\nconst previous=$context.$variables.hrTeamDocuments;\nif(!Array.isArray(previous)||previous.length+rows.length>5000)reject();\n$context.$variables.hrTeamDocuments=previous.concat(rows);\nreturn {count:rows.length};",
                    "returnType": "object",
