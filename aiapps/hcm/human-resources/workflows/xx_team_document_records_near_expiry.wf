        {
          "id": "1782286946548",
          "code": "PROCESSING_DOCUMENT_RECORDS_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Processing Document Records Data",
            "returnType": "array",
            "sourceCode": "function scrubString(value) {\n  return String(value)\n    .replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, \" \")\n    .replace(/[<>]/g, \"\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nfunction scrub(value) {\n  if (typeof value === \"string\") {\n    return scrubString(value);\n  }\n  if (Array.isArray(value)) {\n    return value.map(function(item) {\n      return scrub(item);\n    });\n  }\n  if (value && typeof value === \"object\") {\n    const clean = {};\n    Object.keys(value).forEach(function(key) {\n      if (key !== \"@context\") {\n        clean[key] = scrub(value[key]);\n      }\n    });\n    return clean;\n  }\n  return value;\n}\n\nfunction imageUrl(personId) {\n  if (!personId) return \"\";\n  return \"/hcmUI/personImage?returnSquare=true&returnInitials=Y&removeBackground=Y&personId=\" + encodeURIComponent(String(personId)) + \"&maxSize=44\";\n}\n\nfunction formatLastUpdateDate(value) {\n  if (!value) return \"\";\n\n  const date = new Date(value);\n  if (isNaN(date.getTime())) return \"\";\n\n  const year = date.getFullYear();\n  const month = String(date.getMonth() + 1).padStart(2, \"0\");\n  const day = String(date.getDate()).padStart(2, \"0\");\n\n  let hours = date.getHours();\n  const minutes = String(date.getMinutes()).padStart(2, \"0\");\n  const meridiem = hours >= 12 ? \"PM\" : \"AM\";\n\n  hours = hours % 12;\n  if (hours === 0) hours = 12;\n\n  return year + \"/\" + month + \"/\" + day + \" \" + hours + \":\" + minutes + \" \" + meridiem;\n}\n\nconst items = $context.$variables.hrTeamDocuments;\nif (!Array.isArray(items)) throw new Error(\"The authorized team document collection is unavailable.\");\nconst currentDate = $context.$nodes.CALCULATE_DOCUMENT_EXPIRY_DATE_RANGE.$output.result.currentDate;\nconst todayUtc = new Date(currentDate + \"T00:00:00Z\");\nconst millisecondsPerDay = 24 * 60 * 60 * 1000;\n\nreturn items.map(function(item) {\n  const clean = scrub(item);\n  let expiringInDays = \"\";\n\n  if (clean.DateTo) {\n    const dateTo = new Date(clean.DateTo + \"T00:00:00Z\");\n    if (!isNaN(dateTo.getTime())) {\n      expiringInDays = Math.ceil((dateTo.getTime() - todayUtc.getTime()) / millisecondsPerDay);\n    }\n  }\n\n  return {\n  DisplayName: clean.DisplayName ?? \"\",\n  ImageUrl: imageUrl(clean.PersonId),\n  DocumentType: clean.DocumentType ?? \"\",\n  DocumentName: clean.DocumentName ?? \"\",\n  DateTo: clean.DateTo ?? \"\",\n  LastUpdateDate: formatLastUpdateDate(clean.LastUpdateDate),\n  AttachmentsCount: clean.AttachmentsCount ?? \"\"\n};\n});"
          },
