        {
          "id": "1782286807815",
          "code": "CALCULATE_DOCUMENT_EXPIRY_DATE_RANGE",
          "type": "CODE",
          "metadata": {
            "description": "Calculates today's date and the date after 30 days in YYYY-MM-DD format.",
            "name": "Calculate Document Expiry Date Range",
            "sourceCode": "function pad(value) {\n  return String(value).padStart(2, \"0\");\n}\n\nfunction formatLocalDate(date) {\n  return date.getFullYear() + \"-\" + pad(date.getMonth() + 1) + \"-\" + pad(date.getDate());\n}\n\nconst today = new Date();\nconst currentDate = formatLocalDate(today);\n\nconst dateAfter30 = new Date(today.getTime());\ndateAfter30.setDate(dateAfter30.getDate() + 30);\n\nreturn {\n  currentDate: currentDate,\n  dateAfter30Days: formatLocalDate(dateAfter30)\n};",
            "returnType": "object"
          },
          "diagram": {
            "x": 5375,
            "y": 5206
          },
          "outcomes": {
            "success": "1783063210812"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1783063210812",
          "code": "EXTRACT_PERSON_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Extract Person Context",
            "sourceCode": "const maxContextLength = 16384;\n\nconst parseContextObject = function (value) {\n  if (value === null || value === undefined || value === \"\") return null;\n  if (typeof value === \"string\") {\n    if (value.length > maxContextLength) throw new Error(\"Invalid person context\");\n    try { value = JSON.parse(value); } catch (e) { throw new Error(\"Invalid person context\"); }\n    if (value === null) return null;\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) throw new Error(\"Invalid person context\");\n  let serialized;\n  try { serialized = JSON.stringify(value); } catch (e) { throw new Error(\"Invalid person context\"); }\n  if (typeof serialized !== \"string\" || serialized.length > maxContextLength) throw new Error(\"Invalid person context\");\n  let count = 0;\n  function safeKeys(object, depth) {\n    if (++count > 1000 || depth > 12) return false;\n    if (!object || typeof object !== \"object\") return true;\n    return Object.keys(object).every(function (key) {\n      return [\"__proto__\", \"constructor\", \"prototype\"].indexOf(key) === -1 && safeKeys(object[key], depth + 1);\n    });\n  }\n  if (!safeKeys(value, 0)) throw new Error(\"Invalid person context\");\n  return value;\n};\nconst normalizePersonId = function (value) {\n  if (value === null || value === undefined || value === \"\") return null;\n  if (typeof value === \"number\") {\n    if (!Number.isSafeInteger(value) || value <= 0) throw new Error(\"Invalid person context\");\n    return value;\n  }\n  if (typeof value !== \"string\") throw new Error(\"Invalid person context\");\n  const trimmed = value.trim();\n  if (!/^[1-9][0-9]{0,19}$/.test(trimmed) || !Number.isSafeInteger(Number(trimmed))) throw new Error(\"Invalid person context\");\n  return trimmed;\n};\nconst appContext = parseContextObject($context?.$app?.$OraAppContext);\nconst userContext = parseContextObject($context?.$app?.$OraUserContext);\nconst passedPersonId = normalizePersonId(null);\nconst appPersonId = passedPersonId === null ? normalizePersonId(appContext?.personId) : null;\nconst selectedPersonId = passedPersonId !== null ? passedPersonId : appPersonId;\nconst loggedInPersonId = normalizePersonId(userContext?.userId);\n\nif (selectedPersonId === null && loggedInPersonId === null) throw new Error(\"Invalid person context\");\n\nreturn {\n  personId: selectedPersonId !== null ? selectedPersonId : loggedInPersonId\n};",
            "returnType": "object",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1782378106955"
          },
          "inputs": [],
          "diagram": {
            "x": 5375,
            "y": 5428
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
