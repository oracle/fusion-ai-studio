                  "type": "CODE",
                  "metadata": {
                    "name": "Build Additional Direct Display Fields",
                    "returnType": "object",
                    "sourceCode": "function text(value) {\n  return value == null ? \"\" : String(value).trim();\n}\nfunction response(value) {\n  for (let i = 0; i < 4 && typeof value === \"string\"; i += 1) {\n    try { value = JSON.parse(value); }\n    catch (error) { throw new Error(\"Invalid Organization response\"); }\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value) ||\n      value.error || value.timeout || value.isError ||\n      Number(value.statusCode || value.status || 0) >= 400) {\n    throw new Error(\"Organization data request failed\");\n  }\n  return value;\n}\nfunction rows(value, allowMore) {\n  const data = response(value);\n  if (!Array.isArray(data.items) ||\n      (!allowMore && String(data.hasMore).toLowerCase() === \"true\")) {\n    throw new Error(\"Incomplete Organization response\");\n  }\n  return data.items;\n}\nfunction count(value) {\n  const number = Number(value);\n  if (value == null || text(value) === \"\" ||\n      !Number.isSafeInteger(number) || number < 0) {\n    throw new Error(\"Invalid Organization report count\");\n  }\n  return String(number);\n}\nfunction primary(value) {\n  return /^(true|y)$/i.test(text(value));\n}\nfunction samePerson(row, personId, required) {\n  if (required || (row && row.PersonId != null)) {\n    if (text(row && row.PersonId) !== personId) {\n      throw new Error(\"Organization employee identity mismatch\");\n    }\n  }\n}\nconst current = $context.$nodes.GET_ALL_DIRECT_COUNTS.$currentItem;\nconst personId = text(current && current.PersonId);\nif (!/^[1-9][0-9]*$/.test(personId)) {\n  throw new Error(\"Invalid direct report identity\");\n}\nconst assignments = rows($context.$nodes.GET_ALL_DIRECT_COUNTS.ALL_GET_DIRECT_REPORT_COUNTS.$output, false);\nassignments.forEach(function (row) { samePerson(row, personId, false); });\nconst primaryAssignments = assignments.filter(function (row) {\n  return row && primary(row.PrimaryFlag) &&\n    (row.PrimaryAssignmentFlag == null || primary(row.PrimaryAssignmentFlag));\n});\nif (primaryAssignments.length > 1) {\n  throw new Error(\"Ambiguous primary assignment\");\n}\nconst assignment = primaryAssignments[0] || {};\nconst worker = response($context.$nodes.GET_ALL_DIRECT_COUNTS.ALL_GET_ALL_REPORT_COUNTS.$output);\nsamePerson(worker, personId, true);\nconst phoneRows = rows($context.$nodes.GET_ALL_DIRECT_COUNTS.ALL_GET_WORK_PHONES.$output, false);\nif (phoneRows.length > 1) {\n  throw new Error(\"Ambiguous worker phone response\");\n}\nconst today = new Date().toISOString().slice(0, 10);\nconst workNumbers = [];\nphoneRows.forEach(function (row) {\n  // The fields=phones endpoint is scoped by the current PersonId, but omits it.\n  samePerson(row, personId, false);\n  if (!row || row.phones == null) {\n    throw new Error(\"Invalid worker phone response\");\n  }\n  // Native workflow runtime wraps child collections; BO samples may flatten them.\n  const phones = Array.isArray(row.phones) ? row.phones : rows(row.phones, false);\n  phones.forEach(function (phone) {\n    samePerson(phone, personId, false);\n    if (!phone || text(phone.PhoneType).toUpperCase() !== \"W1\" ||\n        !primary(phone.PrimaryFlag)) return;\n    const fromDate = text(phone.FromDate).slice(0, 10);\n    const toDate = text(phone.ToDate).slice(0, 10);\n    if ((fromDate && fromDate > today) || (toDate && toDate < today)) return;\n    const number = text(phone.PhoneNumber).replace(/\\D/g, \"\");\n    if (!number) return;\n    const fullNumber = text(phone.CountryCodeNumber).replace(/\\D/g, \"\") +\n      text(phone.AreaCode).replace(/\\D/g, \"\") + number;\n    if (workNumbers.indexOf(fullNumber) < 0) workNumbers.push(fullNumber);\n  });\n});\nreturn {\n  PersonId: personId,\n  DisplayName: text(current.DisplayName),\n  JobName: text(assignment.JobName),\n  DepartmentName: text(assignment.DepartmentName),\n  LocationName: text(assignment.LocationName),\n  WorkEmail: text(worker.WorkEmail),\n  WorkPhone: workNumbers.length === 1 ? workNumbers[0] : \"\",\n  DirectReportsCount: count(current.DirectReportsCount),\n  AllReportsCount: count(current.AllReportsCount)\n};",
                    "description": "Combines identity-checked primary assignment, public worker, and primary work phone with native report counts."
                  },
                  "outcomes": {
                    "success": "end_GET_ALL_DIRECT_COUNTS"
