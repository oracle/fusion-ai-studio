type\": \"string\"\n                    },\n                    \"CreationDate\": {\n                      \"type\": \"string\"\n                    },\n                    \"LastUpdatedBy\": {\n                      \"type\": \"string\"\n                    },\n                    \"LastUpdateDate\": {\n                      \"type\": \"string\"\n                    },\n                    \"PrimaryFlag\": {\n                      \"type\": \"boolean\"\n                    },\n                    \"@context\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"key\": {\n                          \"type\": \"string\"\n                        }\n                      },\n                      \"required\": [\n                        \"key\"\n                      ],\n                      \"additionalProperties\": false\n                    }\n                  },\n                  \"required\": [\n                    \"PhoneId\",\n                    \"PhoneType\",\n                    \"PhoneTypeMeaning\",\n                    \"LegislationCode\",\n                    \"LegislationName\",\n                    \"CountryCodeNumber\",\n                    \"AreaCode\",\n                    \"PhoneNumber\",\n                    \"Extension\",\n                    \"FromDate\",\n                    \"ToDate\",\n                    \"Validity\",\n                    \"ValidityMeaning\",\n                    \"CreatedBy\",\n                    \"CreationDate\",\n                    \"LastUpdatedBy\",\n                    \"LastUpdateDate\",\n                    \"PrimaryFlag\",\n                    \"@context\"\n                  ],\n                  \"additionalProperties\": false\n                }\n              },\n              \"count\": {\n                \"type\": \"number\"\n              },\n              \"hasMore\": {\n                \"type\": \"boolean\"\n              },\n              \"limit\": {\n                \"type\": \"number\"\n              },\n              \"offset\": {\n                \"type\": \"number\"\n              },\n              \"links\": {\n                \"type\": \"array\"\n              }\n            },\n            \"required\": [\n              \"items\",\n              \"count\",\n              \"hasMore\",\n              \"limit\",\n              \"offset\",\n              \"links\"\n            ],\n            \"additionalProperties\": false\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"key\"\n            ],\n            \"additionalProperties\": false\n          }\n        },\n        \"required\": [\n          \"phones\",\n          \"@context\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
