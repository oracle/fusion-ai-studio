        {
          "id": "ENRICH_ALL_DIRECTS",
          "code": "ENRICH_ALL_DIRECTS",
          "type": "CODE",
          "metadata": {
            "name": "Merge Additional Direct Details",
            "returnType": "object",
            "sourceCode": "function text(value) {\n  return value == null ? \"\" : String(value).trim();\n}\nfunction response(value) {\n  for (let i = 0; i < 4 && typeof value === \"string\"; i += 1) {\n    try { value = JSON.parse(value); }\n    catch (error) { throw new Error(\"Invalid Organization response\"); }\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value) ||\n      value.error || value.timeout || value.isError ||\n      Number(value.statusCode || value.status || 0) >= 400) {\n    throw new Error(\"Organization data request failed\");\n  }\n  return value;\n}\nfunction rows(value, allowMore) {\n  const data = response(value);\n  if (!Array.isArray(data.items) ||\n      (!allowMore && String(data.hasMore).toLowerCase() === \"true\")) {\n    throw new Error(\"Incomplete Organization response\");\n  }\n  return data.items;\n}\nfunction count(value) {\n  const number = Number(value);\n  if (value == null || text(value) === \"\" ||\n      !Number.isSafeInteger(number) || number < 0) {\n    throw new Error(\"Invalid Organization report count\");\n  }\n  return String(number);\n}\nconst details = $context.$nodes.PREPARE_ALL_DIRECT_COUNT_INPUTS.$output.result.items;\nconst enriched = $context.$nodes.STORE_ALL_DIRECT_COUNT_RESULTS.$output.result.items;\nif (!Array.isArray(details) || !Array.isArray(enriched) || details.length !== enriched.length) {\n  throw new Error(\"Incomplete direct report enrichment\");\n}\nconst items = details.map(function (detail, index) {\n  const row = enriched[index];\n  if (!row || text(row.PersonId) !== text(detail.PersonId)) {\n    throw new Error(\"Direct report order or identity mismatch\");\n  }\n  return row;\n});\nreturn { items: items };",
            "description": "Checks complete ordered enrichment and returns the existing Organization display contract."
          },
          "outcomes": {
            "success": "PREPARE_SAFE_RENDER_ALL_DIRECT_REPORTS_LIST"
          },
          "inputs": [],
