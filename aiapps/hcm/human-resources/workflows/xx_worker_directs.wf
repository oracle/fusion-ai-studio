        {
          "id": "STORE_TOP_DIRECT_COUNT_RESULTS",
          "code": "STORE_TOP_DIRECT_COUNT_RESULTS",
          "type": "CODE",
          "metadata": {
            "name": "Store Top Direct Count Results",
            "returnType": "object",
            "sourceCode": "function collect(value, depth) {\n  if (depth > 8) throw new Error(\"Invalid Organization loop result\");\n  for (let i = 0; i < 4 && typeof value === \"string\"; i += 1) {\n    try { value = JSON.parse(value); } catch (error) { throw new Error(\"Invalid Organization loop result\"); }\n  }\n  if (Array.isArray(value)) return value.reduce(function (rows, item) { return rows.concat(collect(item, depth + 1)); }, []);\n  if (!value || typeof value !== \"object\" || value.error || value.timeout || value.isError || Number(value.statusCode || value.status || 0) >= 400) throw new Error(\"Organization enrichment request failed\");\n  if (Object.prototype.hasOwnProperty.call(value, \"PersonId\")) return [value];\n  const wrappers = [\"items\", \"result\", \"output\", \"data\"].filter(function (key) { return Object.prototype.hasOwnProperty.call(value, key); });\n  if (wrappers.length !== 1) throw new Error(\"Invalid Organization loop result\");\n  return collect(value[wrappers[0]], depth + 1);\n}\nreturn { items: collect($context.$nodes.GET_TOP_DIRECT_COUNTS.$output, 0) };",
            "description": "Retains all enriched Organization display fields from the completed sequential loop."
