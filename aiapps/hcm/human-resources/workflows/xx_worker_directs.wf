          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AssignmentId\": {\n            \"type\": \"string\"\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"key\"\n            ],\n            \"additionalProperties\": false\n          }\n        },\n        \"required\": [\n          \"AssignmentId\",\n          \"@context\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "VALIDATE_DIRECT_ACTION_ASSIGNMENT",
          "code": "VALIDATE_DIRECT_ACTION_ASSIGNMENT",
          "type": "CODE",
          "metadata": {
            "name": "Validate Direct Action Assignment",
            "description": "Validates the source worker assignment; the selected target still needs a fresh relationship membership check.",
            "sourceCode": "function identifier(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  if (typeof value !== \"string\") return \"\";\n  const trimmed = value.trim();\n  return /^[1-9][0-9]{0,19}$/.test(trimmed) ? trimmed : \"\";\n}\nfunction response(value) {\n  for (let i = 0; i < 4 && typeof value === \"string\"; i += 1) {\n    if (value.length > 1000000) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value) ||\n      value.error || value.timeout || value.isError || Number(value.statusCode || value.status || 0) >= 400) return null;\n  return value;\n}\nconst rejected = { valid: false, personId: \"\", assignmentId: \"\" };\nconst personId = identifier($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId);\nconst data = response($context.$nodes.GET_DIRECT_ACTION_ASSIGNMENT.$output);\nif (!personId || !data || !Array.isArray(data.items) || data.items.length === 0) return rejected;\n// Keep the existing first-primary-assignment choice, validating the row before using it.\nconst row = data.items[0];\nif (!row || typeof row !== \"object\" || Array.isArray(row)) return rejected;\nconst assignmentId = identifier(row.AssignmentId);\nif (!assignmentId || (Object.prototype.hasOwnProperty.call(row, \"PersonId\") && identifier(row.PersonId) !== personId)) return rejected;\nreturn { valid: true, personId: personId, assignmentId: assignmentId };\n",
            "returnType": "object",
            "errorNodeId": "RETURN_DIRECT_REQUEST_ERROR"
          },
          "outcomes": {
            "success": "DIRECT_ACTION_ASSIGNMENT_IS_VALID"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
