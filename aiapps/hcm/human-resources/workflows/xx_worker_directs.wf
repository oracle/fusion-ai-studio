          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}"
        },
        {
          "id": "1780300541407",
          "code": "CREATE_HIERARCHY",
          "type": "CODE",
          "metadata": {
            "name": "Create Hierarchy",
            "returnType": "string",
            "sourceCode": "const maxHierarchyLength = 65536;\nconst rawHierarchy = $context?.$nodes?.GET_PERSON_HIERARCHY?.$output?.output;\nlet parsedHierarchy = null;\n\nif (typeof rawHierarchy === \"string\" && rawHierarchy.length > 0 && rawHierarchy.length <= maxHierarchyLength) {\n  try {\n    parsedHierarchy = JSON.parse(rawHierarchy);\n  } catch (e) {\n    parsedHierarchy = null;\n  }\n} else if (rawHierarchy && typeof rawHierarchy === \"object\") {\n  parsedHierarchy = rawHierarchy;\n}\n\nconst hierarchy = parsedHierarchy && Array.isArray(parsedHierarchy.result)\n  ? parsedHierarchy.result.slice(0, 100)\n  : [];\n\nconst normalizeName = function (value) {\n  if (typeof value !== \"string\") return null;\n  const normalized = value.replace(/[\\u0000-\\u001F\\u007F]/g, \" \").trim();\n  return normalized ? normalized.slice(0, 240) : null;\n};\n\nconst names = [];\nfor (let index = 0; index < hierarchy.length; index += 1) {\n  const name = normalizeName(hierarchy[index]?.DisplayName);\n  if (name) names.push(name);\n}\n\nconst currentName = normalizeName($context?.$nodes?.GET_PERSON_DETAILS?.$output?.DisplayName);\nif (currentName) names.push(currentName);\n\nreturn names.join(\" > \");"
          },
          "diagram": {
            "x": 5225,
            "y": 10588
          },
          "outcomes": {
            "success": "PREPARE_TOP_DIRECT_COUNT_INPUTS"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "PREPARE_TOP_DIRECT_COUNT_INPUTS",
          "code": "PREPARE_TOP_DIRECT_COUNT_INPUTS",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Top Direct Count Inputs",
            "returnType": "object",
            "sourceCode": "function identifier(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  if (typeof value !== \"string\") return \"\";\n  const trimmed = value.trim();\n  return /^[1-9][0-9]{0,19}$/.test(trimmed) ? trimmed : \"\";\n}\nfunction text(value) {\n  return value == null ? \"\" : String(value).trim();\n}\nfunction response(value) {\n  for (let i = 0; i < 4 && typeof value === \"string\"; i += 1) {\n    try { value = JSON.parse(value); }\n    catch (error) { throw new Error(\"Invalid Organization response\"); }\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value) ||\n      value.error || value.timeout || value.isError ||\n      Number(value.statusCode || value.status || 0) >= 400) {\n    throw new Error(\"Organization data request failed\");\n  }\n  return value;\n}\nfunction rows(value, allowMore) {\n  const data = response(value);\n  if (!Array.isArray(data.items) ||\n      (!allowMore && String(data.hasMore).toLowerCase() === \"true\")) {\n    throw new Error(\"Incomplete Organization response\");\n  }\n  return data.items;\n}\nfunction count(value) {\n  const number = Number(value);\n  if (value == null || text(value) === \"\" ||\n      !Number.isSafeInteger(number) || number < 0) {\n    throw new Error(\"Invalid Organization report count\");\n  }\n  return String(number);\n}\nconst details = rows($context.$nodes.GET_TOP_DIRECT_REPORT_DETAILS.$output, true);\nconst seen = {};\nreturn {\n  items: details.map(function (row) {\n    const personId = identifier(row && row.PersonId);\n    if (!personId || seen[personId]) {\n      throw new Error(\"Invalid or duplicate direct report identity\");\n    }\n    seen[personId] = true;\n    return {\n      PersonId: personId,\n      DisplayName: text(row.DisplayName),\n      DirectReportsCount: count(row.DirectReportsCount),\n      AllReportsCount: count(row.AllReportsCount)\n    };\n  })\n};",
            "description": "Validates ordered native REST report rows and carries their counts into enrichment.",
            "errorNodeId": "RETURN_DIRECT_REQUEST_ERROR"
          },
          "outcomes": {
            "success": "initialize_top_direct_count_results"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5225,
            "y": 10810
          }
        },
