          "metadata": {
            "name": "Validate Request Get Direct Action Additional Page",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\nfunction page(value,name,min,max) {\n  if(typeof value!==\"number\" && typeof value!==\"string\") reject(name);\n  if(typeof value===\"string\" && !/^[0-9]{1,7}$/.test(value.trim())) reject(name);\n  const number=Number(value);if(!Number.isSafeInteger(number)||number<min||number>max) reject(name);return number;\n}\n\nconst checked={};\nchecked[\"managerPersonId\"]=id(($context.$nodes.VALIDATE_DIRECT_ACTION_ASSIGNMENT.$output.result.personId),\"managerPersonId\");\nchecked[\"managerAssignmentId\"]=id(($context.$nodes.VALIDATE_DIRECT_ACTION_ASSIGNMENT.$output.result.assignmentId),\"managerAssignmentId\");\nchecked[\"limit\"]=page(\"100\",\"limit\",1,500);\nchecked[\"offset\"]=page(\"5\",\"offset\",0,1000000);\nreturn checked;",
