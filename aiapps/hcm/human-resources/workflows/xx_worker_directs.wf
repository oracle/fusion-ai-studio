        {
          "id": "1780052339687",
          "code": "PARSE_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Parse Payload",
            "returnType": "object",
            "sourceCode": "const maxPayloadLength = 16384;\n\nconst parseObject = function (value) {\n  if (typeof value === \"string\") {\n    if (!value.length || value.length > maxPayloadLength) return null;\n    try { value = JSON.parse(value); } catch (e) { return null; }\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) return null;\n  let serialized;\n  try { serialized = JSON.stringify(value); } catch (e) { return null; }\n  if (typeof serialized !== \"string\" || serialized.length > maxPayloadLength) return null;\n  let count = 0;\n  function safeKeys(object, depth) {\n    if (++count > 1000 || depth > 12) return false;\n    if (!object || typeof object !== \"object\") return true;\n    return Object.keys(object).every(function (key) {\n      return [\"__proto__\", \"constructor\", \"prototype\"].indexOf(key) === -1 && safeKeys(object[key], depth + 1);\n    });\n  }\n  return safeKeys(value, 0) ? value : null;\n};\nconst normalizePersonId = function (value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? value : null;\n  if (typeof value !== \"string\") return null;\n  const trimmed = value.trim();\n  return /^[1-9][0-9]{0,19}$/.test(trimmed) && Number.isSafeInteger(Number(trimmed)) ? trimmed : null;\n};\nconst actionContext = parseObject($context?.$app?.$OraAction);\nconst allowedKeys = [\"actionId\", \"personId\"];\nlet actionId = actionContext && Object.keys(actionContext).every(function (key) { return allowedKeys.indexOf(key) !== -1; }) &&\n  actionContext.actionId === \"selectDirect\" ? \"selectDirect\" : null;\n\nif (actionId && normalizePersonId(actionContext?.personId) === null) actionId = null;\n\nreturn {\n  actionId: actionId,\n  personId: actionId ? normalizePersonId(actionContext?.personId) : null\n};",
            "errorNodeId": "RETURN_DIRECT_REQUEST_ERROR"
          },
          "diagram": {
