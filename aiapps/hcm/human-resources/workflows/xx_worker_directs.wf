          },
          "inputs": [
            {
              "id": "GET_TOP_DIRECT_COUNTS_collection",
              "name": "collection",
              "type": "array",
              "required": true,
              "value": "{{$context.$nodes.PREPARE_TOP_DIRECT_COUNT_INPUTS.$output.result.items}}"
            }
          ],
          "diagram": {
