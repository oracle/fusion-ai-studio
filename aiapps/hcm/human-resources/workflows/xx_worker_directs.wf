        {
          "id": "VALIDATE_DIRECT_ACTION_MEMBERSHIP",
          "code": "VALIDATE_DIRECT_ACTION_MEMBERSHIP",
          "type": "CODE",
          "metadata": {
            "name": "Validate Direct Selection Membership",
            "description": "Accepts only a target present in the fresh initial or additional direct-report page for the source worker.",
            "sourceCode": "function identifier(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  if (typeof value !== \"string\") return \"\";\n  const trimmed = value.trim();\n  return /^[1-9][0-9]{0,19}$/.test(trimmed) ? trimmed : \"\";\n}\nfunction response(value) {\n  for (let i = 0; i < 4 && typeof value === \"string\"; i += 1) {\n    if (value.length > 1000000) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value) ||\n      value.error || value.timeout || value.isError || Number(value.statusCode || value.status || 0) >= 400) return null;\n  return value;\n}\nconst rejected = { valid: false, personId: \"\" };\nconst action = $context.$nodes.PARSE_PAYLOAD.$output.result;\nconst source = $context.$nodes.VALIDATE_DIRECT_ACTION_ASSIGNMENT.$output.result;\nconst targetId = identifier(action && action.personId);\nif (!source || source.valid !== true || !action || action.actionId !== \"selectDirect\" || !targetId) return rejected;\nconst pages = [\n  response($context.$nodes.GET_DIRECT_ACTION_TOP_PAGE.$output),\n  response($context.$nodes.GET_DIRECT_ACTION_ADDITIONAL_PAGE.$output)\n];\nlet member = false;\nfor (let pageIndex = 0; pageIndex < pages.length; pageIndex += 1) {\n  const page = pages[pageIndex];\n  if (!page || !Array.isArray(page.items)) return rejected;\n  if (page.offset !== undefined && String(page.offset) !== (pageIndex === 0 ? \"0\" : \"5\")) return rejected;\n  for (const row of page.items) {\n    if (!row || typeof row !== \"object\" || Array.isArray(row)) return rejected;\n    const personId = identifier(row.PersonId);\n    if (!personId) return rejected;\n    if (personId === targetId) member = true;\n  }\n}\n// Membership in these fresh relationship pages does not grant access to other panels.\nreturn member ? { valid: true, personId: targetId } : rejected;\n",
            "returnType": "object",
            "errorNodeId": "RETURN_DIRECT_REQUEST_ERROR"
          },
          "outcomes": {
            "success": "DIRECT_ACTION_MEMBER_IS_VALID"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
