        {
          "id": "1783332125911",
          "code": "GET_PRIMARY_ASSIGNMENT_QUERY",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Primary Assignment Query",
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_EMPLOYMENTGHR",
            "functionName": "GetAssignmentInformationByPerson",
            "errorNodeId": "RETURN_DIRECT_REQUEST_ERROR"
          },
          "outcomes": {
