        {
          "id": "VALIDATE_REQUEST_GET_ALL_DIRECT_REPORT_DETAILS",
          "code": "VALIDATE_REQUEST_GET_ALL_DIRECT_REPORT_DETAILS",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get All Direct Report Details",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\nfunction page(value,name,min,max) {\n  if(typeof value!==\"number\" && typeof value!==\"string\") reject(name);\n  if(typeof value===\"string\" && !/^[0-9]{1,7}$/.test(value.trim())) reject(name);\n  const number=Number(value);if(!Number.isSafeInteger(number)||number<min||number>max) reject(name);return number;\n}\n\nconst checked={};\nchecked[\"managerPersonId\"]=id(($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId),\"managerPersonId\");\nchecked[\"managerAssignmentId\"]=id(($context.$nodes.VALIDATE_DIRECT_ADDITIONAL_ASSIGNMENT.$output.result.assignmentId),\"managerAssignmentId\");\nchecked[\"limit\"]=page(\"100\",\"limit\",1,500);\nchecked[\"offset\"]=page(\"5\",\"offset\",0,1000000);\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "GET_ALL_DIRECT_REPORT_DETAILS"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 6687.5,
            "y": 6760
          }
        },
        {
          "id": "GET_ALL_DIRECT_REPORT_DETAILS",
          "code": "GET_ALL_DIRECT_REPORT_DETAILS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Additional Direct Reports",
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_PERSONDIRECTREPORTS",
            "functionName": "get_directReports",
            "description": "Retrieves authorized Organization data through the existing native-auth standard REST function; no search index dependency."
