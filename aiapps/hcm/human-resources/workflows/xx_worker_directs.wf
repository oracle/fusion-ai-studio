            "y": 6982
          }
        },
        {
          "id": "PREPARE_ALL_DIRECT_COUNT_INPUTS",
          "code": "PREPARE_ALL_DIRECT_COUNT_INPUTS",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Additional Direct Count Inputs",
            "returnType": "object",
            "sourceCode": "function identifier(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  if (typeof value !== \"string\") return \"\";\n  const trimmed = value.trim();\n  return /^[1-9][0-9]{0,19}$/.test(trimmed) ? trimmed : \"\";\n}\nfunction text(value) {\n  return value == null ? \"\" : String(value).trim();\n}\nfunction response(value) {\n  for (let i = 0; i < 4 && typeof value === \"string\"; i += 1) {\n    try { value = JSON.parse(value); }\n    catch (error) { throw new Error(\"Invalid Organization response\"); }\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value) ||\n      value.error || value.timeout || value.isError ||\n      Number(value.statusCode || value.status || 0) >= 400) {\n    throw new Error(\"Organization data request failed\");\n  }\n  return value;\n}\nfunction rows(value, allowMore) {\n  const data = response(value);\n  if (!Array.isArray(data.items) ||\n      (!allowMore && String(data.hasMore).toLowerCase() === \"true\")) {\n    throw new Error(\"Incomplete Organization response\");\n  }\n  return data.items;\n}\nfunction count(value) {\n  const number = Number(value);\n  if (value == null || text(value) === \"\" ||\n      !Number.isSafeInteger(number) || number < 0) {\n    throw new Error(\"Invalid Organization report count\");\n  }\n  return String(number);\n}\nconst details = rows($context.$nodes.GET_ALL_DIRECT_REPORT_DETAILS.$output, true);\nconst seen = {};\nreturn {\n  items: details.map(function (row) {\n    const personId = identifier(row && row.PersonId);\n    if (!personId || seen[personId]) {\n      throw new Error(\"Invalid or duplicate direct report identity\");\n    }\n    seen[personId] = true;\n    return {\n      PersonId: personId,\n      DisplayName: text(row.DisplayName),\n      DirectReportsCount: count(row.DirectReportsCount),\n      AllReportsCount: count(row.AllReportsCount)\n    };\n  })\n};",
            "description": "Validates ordered native REST report rows and carries their counts into enrichment.",
            "errorNodeId": "RETURN_DIRECT_REQUEST_ERROR"
          },
          "outcomes": {
            "success": "initialize_all_direct_count_results"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 6687.5,
            "y": 7204
          }
        },
