: \"Provides address or geographic information for candidate degree.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Date Acquired\",          \"Column Desc\": \"Provides the date acquired for candidate degree.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"From Date\",          \"Column Desc\": \"Provides the from date for candidate degree.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"To Date\",          \"Column Desc\": \"Provides the to date for candidate degree.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Degree\",          \"Column Desc\": \"Provides education, establishment, honor, or membership information for candidate degree.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Degree Name\",          \"Column Desc\": \"Provides the name for candidate degree.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Educator\",          \"Column Desc\": \"Provides education, establishment, honor, or membership information for candidate degree.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Fee\",          \"Column Desc\": \"Provides the monetary or rate value for candidate degree.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Fee Currency\",          \"Column Desc\": \"Provides the currency information for candidate degree.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Fee Currency Description\",          \"Column Desc\": \"Provides the currency information for candidate degree.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Grade Point Average\",          \"Column Desc\": \"Provides the score, rating, or ranking value for candidate degree.\",          \"isDouble\": \"false\"        },        {          \"Column Na