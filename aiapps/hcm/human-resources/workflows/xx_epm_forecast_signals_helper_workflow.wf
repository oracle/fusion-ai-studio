        {
          "id": "1794843948589",
          "code": "REQ_PREPARE_INITIAL_RESPONSE",
          "type": "CODE",
          "metadata": {
            "name": "Requisitions - Prepare Initial Response",
            "sourceCode": "const data = $context.$nodes.REQ_GET_QUERY_IDENTIFIER.$output || {};\nconst rows = Array.isArray(data.Rows) ? data.Rows : [];\nconst columnData = data.metadata;\nconst columnMap = {};\nif (columnData) {\n  Object.entries(columnData).forEach(function (entry) {\n    const columnKey = entry[0];\n    const meta = entry[1] || {};\n    columnMap[columnKey] = meta[\"saw-sql:columnHeading\"] || columnKey;\n  });\n}\nconst items = rows.map(function (row) {\n  const item = {};\n  Object.keys(columnMap).forEach(function (key) {\n    item[columnMap[key]] = Object.prototype.hasOwnProperty.call(row, key) ? row[key] : null;\n  });\n  Object.keys(row).forEach(function (key) {\n    if (!Object.prototype.hasOwnProperty.call(columnMap, key)) item[key] = row[key];\n  });\n  return item;\n});\n// Return an available page immediately; poll only while awaiting the first page.\nconst finished = data.finished === true || data.finished === \"true\";\nreturn {\n  items: items,\n  columnMap: columnMap,\n  finished: finished,\n  runQuery: !finished && !Array.isArray(data.Rows) && !!data.queryId\n};",
            "returnType": "object"
          },
          "outcomes": {
            "success": "req_1782303205714"
          },
          "inputs": [],
          "diagram": {
