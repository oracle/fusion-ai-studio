                  "code": "REQ_PREPARE_DATA",
                  "type": "CODE",
                  "metadata": {
                    "name": "Requisitions - Prepare Data",
                    "returnType": "array",
                    "sourceCode": "let rows = $context.$nodes.REQ_FETCH_DATA.REQ_RUN_QUERY.$output.Rows || [];\n\nlet columnMap = $context.$variables.req_columnMap || {};\n\nlet items = $context.$variables.req_sqlData || [];\n\nfor(let i=0;i<rows.length;i++){\n  \n  let item = {};\n  \n  let row = rows[i];\n  \n  Object.entries(row).forEach(([key, value]) => {\n    let newKey = columnMap[key] || key;\n    item[newKey] = value;\n  });\n\n  items.push(item);\n\n}\n\n  \n\nreturn items;"
                  },
