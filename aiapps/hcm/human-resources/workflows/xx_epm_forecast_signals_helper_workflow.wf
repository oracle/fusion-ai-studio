                {
                  "id": "emp_1782301808328",
                  "code": "EMP_PREPARE_DATA",
                  "type": "CODE",
                  "metadata": {
                    "name": "Employees - Prepare Data",
                    "returnType": "array",
                    "sourceCode": "let rows = $context.$nodes.EMP_FETCH_DATA.EMP_RUN_QUERY.$output.Rows || [];\nlet columnMap = $context.$variables.emp_columnMap || {};\nlet existingItems = $context.$variables.emp_sqlData || [];\n\nlet mappedItems = rows.map(function (row) {\n  let item = {};\n\n  // Add all mapped columns; missing columns get null\n  Object.keys(columnMap).forEach(function (columnKey) {\n    let columnName = columnMap[columnKey];\n\n    item[columnName] =\n      Object.prototype.hasOwnProperty.call(row, columnKey)\n        ? row[columnKey]\n        : null;\n  });\n\n  // Preserve columns not present in columnMap\n  Object.keys(row).forEach(function (key) {\n    if (!Object.prototype.hasOwnProperty.call(columnMap, key)) {\n      item[key] = row[key];\n    }\n  });\n\n  return item;\n});\n\n// concat creates a new array instead of modifying rows\nreturn existingItems.concat(mappedItems);"
                  },
