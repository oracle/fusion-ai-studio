salary.\",          \"isDouble\": \"false\"        }      ]    },    \"Salary Component Details\": {      \"Table Desc\": \"Provides details for salary components used to itemize salary adjustments.\",      \"columns\": [        {          \"Column Name\": \"Adjustment Amount\",          \"Column Desc\": \"Value used for Adjustment Amount.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Adjustment Percentage\",          \"Column Desc\": \"Percentage value for Adjustment Percentage.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Component\",          \"Column Desc\": \"Name of the salary component.\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Component Reason Code\",          \"Column Desc\": \"Code that identifies the reason for the salary component adjustment.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Components Last Updated By\",          \"Column Desc\": \"User who last updated the salary component record.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Salary Component Approved\",          \"Column Desc\": \"Indicates whether the salary component is approved.\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Salary Component Approved Code\",          \"Column Desc\": \"Code value for the salary component approved indicator.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Salary Component Created By\",          \"Column Desc\": \"User who created the salary component record.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Salary Component Creation Date\",          \"Column Desc\": \"Date and time when the salary component record was created.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Salary Component Identifier\",          \"Column Desc\": \"U