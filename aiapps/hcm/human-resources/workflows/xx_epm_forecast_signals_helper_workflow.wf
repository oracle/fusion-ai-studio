    "triggers": [
      {
        "type": "CAPABILITY",
        "inputs": [
          {
            "name": "getEmployeeData",
            "description": "Retrieves employee assignment, compensation and profile information matching the requested employee filters using OTBI queries. Returns employee records with sessionId, queryId, columnMap and finished for paginated retrieval; does not modify employee records.",
            "category": "Generic",
            "readOnly": true,
            "requiresCompute": true,
            "typeSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"inputMessage\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"sessionId\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"queryId\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"batchSize\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 900,\n      \"default\": 900\n    },\n    \"columnMap\": {\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"inputMessage\",\n    \"sessionId\",\n    \"queryId\",\n    \"batchSize\",\n    \"columnMap\"\n  ],\n  \"additionalProperties\": false\n}"
          },
          {
            "name": "getRequisitionsData",
            "description": "Retrieves job requisition records matching the user’s requested scope from Oracle Recruiting using metadata-valid OTBI queries. Returns available requisition identifiers, titles, statuses, openings, organizational context, dates, and planning fields to support hiring-pipeline and planned hiring spend analysis. Returns records in items, with sessionId, queryId, and finished for pagination. Retrieve all matching pages before analysis. Does not create, update, freeze, or cancel requisitions.",
            "category": "Generic",
            "readOnly": true,
            "requiresCompute": true,
            "typeSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"inputMessage\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"sessionId\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"queryId\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"batchSize\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 900,\n      \"default\": 900\n    },\n    \"columnMap\": {\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"inputMessage\",\n    \"sessionId\",\n    \"queryId\",\n    \"batchSize\",\n    \"columnMap\"\n  ],\n  \"additionalProperties\": false\n}"
          },
          {
            "name": "getOffersData",
            "description": "Retrieves job offer records matching the user’s requested scope from Oracle Recruiting using metadata-valid OTBI queries. Returns available offer identifiers, candidate names, linked requisition identifiers, statuses, dates, and compensation fields to support offer-pipeline and future workforce commitment analysis. Preserves returned identifiers so the consuming skill can reconcile offers with requisitions without double counting. Returns records in items, with sessionId, queryId, and finished for pagination. Retrieve all matching pages before analysis. Does not create, update, pause, reprice, or withdraw offers.",
