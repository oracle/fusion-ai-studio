gency Id\",          \"Column Desc\": \"Provides the identifier for agents details.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Agency Name\",          \"Column Desc\": \"Provides the name for agents details.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Agent First Name\",          \"Column Desc\": \"Provides the first name for the agency agent.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Agent Id\",          \"Column Desc\": \"Provides the identifier for the agency agent.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Agent Invited\",          \"Column Desc\": \"Provides the agent invited for agents details. Supported filter values (Boolean LOV): Yes; No.\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Agent Invited Flag\",          \"Column Desc\": \"Indicates whether agent invited flag applies to agents details. Supported filter values (Boolean LOV): Yes; No.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Agent Last Name\",          \"Column Desc\": \"Provides the last name for the agency agent.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Created By\",          \"Column Desc\": \"Provides the user who created the agents details record.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Creation Date\",          \"Column Desc\": \"Provides the date when the agents details record was created.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Last Update Date\",          \"Column Desc\": \"Provides the last update information for the agents details record.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Last Updated By\",          \"Column Desc\": \"Provides the user who last updated the agents details record.\"