                    "name": "Employees - Prepare Column Map",
                    "sourceCode": "let columnData = $context.$nodes.EMP_FETCH_DATA.EMP_RUN_QUERY.$output.metadata;\n\n\n\n\nif (!columnData) return $context.$variables.emp_columnMap ;\n\nlet columnMap = {};\n\n  Object.entries(columnData).forEach(([columnKey, meta]) => {\n    let displayName = meta[\"saw-sql:columnHeading\"];\n\n    columnMap[columnKey] = displayName || columnKey;\n\n});\n\nreturn columnMap;",
