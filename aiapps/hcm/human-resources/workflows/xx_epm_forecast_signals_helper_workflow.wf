]    },    \"Seniority Date\": {      \"Table Desc\": \"Provides seniority date information used for length-of-service and seniority calculations.\",      \"columns\": [        {          \"Column Name\": \"Calculation Type\",          \"Column Desc\": \"Mode of calculation Manual when created by user and  Automatic.when created by ESS.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Entry Date\",          \"Column Desc\": \"First date in which the seniority attribute value was first assigned to this person at the given level\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Exit Date\",          \"Column Desc\": \"Last date in which the seniority attribute value was assigned to this person at the given level. For example, when a person moved from Grade 1 to Grade 2.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Seniority Date\",          \"Column Desc\": \"The actual seniority date value based on which the length of service will be calculated for date based workers.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Seniority Days Length of Service\",          \"Column Desc\": \"Oracle HCM reporting attribute for Seniority Days Length of Service in the Seniority Date folder.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Seniority Months Length of Service\",          \"Column Desc\": \"Oracle HCM reporting attribute for Seniority Months Length of Service in the Seniority Date folder.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Seniority Years Length of Service\",          \"Column Desc\": \"Oracle HCM reporting attribute for Seniority Years Length of Service in the Seniority Date folder.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Seniority Change End Date\",          \"Column Desc\": \"Date associated with Seniority Change End Date.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Seniority Change Start Date\",          \"Column Desc\": \"Date associated with Seniority Change Start Date.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Triggering Field\",          \"Column Desc\": \"Determines what the seniority rule is based on, for example Job, Grade, Legal Employer, etc\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Triggering Field Value\",          \"Column Desc\": \"Unified redundant column that combines all three seniority key fields - Number, Text, Date\",          \"isDouble\": \"false\"        }      ]    },    \"Additional Attributes\": {      \"Table Desc\": \"Provides audit and additional metadata attributes for seniority date records.\",      \"columns\": [        {          \"Column Name\": \"Created By\",          \"Column Desc\": \"User who created the record.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Creation Date\",          \"Column Desc\": \"Date and time when the record was created.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Last Update Date\",          \"Column Desc\": \"Date and time when the record was last updated.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Last Updated By\",          \"Column Desc\": \"User who last updated the record.\",          \"isDouble\": \"false\"        }      ]    },    \"Adjustment Days and Hours\": {      \"Table Desc\": \"Provides manual and automatic seniority date or seniority hours adjustment information.\",      \"columns\": [        {          \"Column Name\": \"Auto Adjustment Comments\",          \"Column Desc\": \"Comments regarding the adjustment in the seniority date for an auto change.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Auto Adjustment Days\",          \"Column Desc\": \"Offset number of days by which the seniority date gets adjusted in this change by the ESS job.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Auto Adjustment Hours\",          \"Column Desc\": \"Offset number of hours by which the seniority hours gets adjusted in this change by the ESS job.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Manual Adjustment Comments\",          \"Column Desc\": \"Comments regarding the adjustment in the seniority date for manual change.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Manual Adjustment Days\",          \"Column Desc\": \"Offset number of days by which the seniority date gets adjusted in this change manually.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Manual Adjustment Hours\",          \"Column Desc\": \"Offset number of hours by which the seniority hours gets adjusted in this change manually.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Total Adjustment Days\",          \"Column Desc\": \"Total offset number of days by which the seniority date gets adjusted by all sources of change till this point in time.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Total Adjustment Hours\",          \"Column Desc\": \"Total offset number of hours by which the seniority hours gets adjusted by auto and manual sources of change till this point in time.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Total Auto Adjustment Days\",          \"Column Desc\": \"Total offset number of days by which the seniority date gets adjusted by auto change in all changes till this point in time.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Total Auto Adjustment Hours\",          \"Column Desc\": \"Total offset number of hours by which the seniority hours gets adjusted by auto change in all changes till this point in time.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Total Manual Adjustment Days\",          \"Column Desc\": \"Total offset number of days by which the seniority date gets adjusted by manual change in all changes till this point in time.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Total Manual Adjustment Hours\",          \"Column Desc\": \"Total offset number of hours by which the seniority hours gets adjusted by manual change in all changes till this point in time.\",          \"isDouble\": \"false\"        }      ]    },    \"Identifiers\": {      \"Table Desc\": \"System record keys or identifiers for seniority date setup and calculation records.\",      \"columns\": [        {          \"Column Name\": \"Active Code\",          \"Column Desc\": \"Code value for Active Code.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Adjustment Formula Identifier\",          \"Column Desc\": \"Unique identifier for Adjustment Formula.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Allow Edits Code\",          \"Column Desc\": \"Code value for Allow Edits Code.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Bargaining Unit Code\",          \"Column Desc\": \"Code that identifies the bargaining unit.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Basis Code\",          \"Column Desc\": \"Code value for Basis Code.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Cumulative Code\",          \"Column Desc\": \"Code value for Cumulative Code.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Display in UI Code\",          \"Column Desc\": \"Code value for Display in UI Code.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Formula ID\",          \"Column Desc\": \"Identifier of the fast formula for which the seniority date is calculated.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Hours Conversion Formula Identifier\",          \"Column Desc\": \"Unique identifier for Hours Conversion Formula.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Identifier\",          \"Column Desc\": \"Unique identifier for Identifier.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Legislation Code\",          \"Column Desc\": \"Code that identifies the legislation or country context.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Level Code\",          \"Column Desc\": \"Identifies the Seniority Rule Level Code.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Seniority Date Code\",          \"Column Desc\": \"Code to identify the Seniority Date Item.Eg: ORA_ESD_P , ORA_JOB_SD_A\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Setup Identifier\",          \"Column Desc\": \"Unique identifier for Setup.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Triggering Field Code\",          \"Column Desc\": \"Determines what the seniority rule is based on, for example Job, Grade, Legal Employer, etc\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Triggering Field ID\",          \"Column Desc\": \"Number based unique identifier (ID) that identifies the field based on which this seniority date rule is configured. For example, JobID and PositionID.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Triggering Field Text\",          \"Column Desc\": \"Lookup code for the Triggering Field based on which this seniority is defined.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Worker Type Code\",          \"Column Desc\": \"Code that identifies the type of the record.\",          \"isDouble\": \"false\"        }      ]    },    \"Seniority Date Setup\": {      \"Table Desc\": \"Provides configuration information for seniority date rules.\",      \"columns\": [        {          \"Column Name\": \"Active\",          \"Column Desc\": \"Indicates if this rule is active\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Adjustment Formula\",          \"Column Desc\": \"Oracle HCM reporting attribute for Adjustment Formula in the Seniority Date Setup folder.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Allow Edits\",          \"Column Desc\": \"Indicates if this seniority date can be edited by the user\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Basis\",          \"Column Desc\": \"Identifies if the seniority is based on hours or days\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Cumulative\",          \"Column Desc\": \"Indicates if the rule should calculate on a cumulative basis when there are multiple occurrences for the same triggering field value.\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Display in UI\",          \"Column Desc\": \"Indicates if this rule value will be displayed in the seniority dates plug in section on various guided processes like promote etc.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Hours Conversion Formula\",          \"Column Desc\": \"Oracle HCM reporting attribute for Hours Conversion Formula in the Seniority Date Setup folder.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Length of Service Formula\",          \"Column Desc\": \"Name of the fast formula for which the seniority date is calculated.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Level Code\",          \"Column Desc\": \"Identifies the seniority rule level. E.g: Person, Work Relationship, Assignment\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Seniority Rule Name\",          \"Column Desc\": \"Name of the seniority rule\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Triggering Field\",          \"Column Desc\": \"Determines what the seniority rule is based on, for example Job, Grade, Legal Employer, etc\",          \"isDouble\": \"true\"        }      ]    },    \"Filters\": {      \"Table Desc\": \"Provides filter attributes used by seniority date rules, such as bargaining unit, legislation, union, legal employer, and worker type.\",      \"columns\": [        {          \"Column Name\": \"Bargaining Unit\",          \"Column Desc\": \"Filters seniority date on bargaining unit.\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Collective Agreement\",          \"Column Desc\": \"Filters out people who are part of some collective agreements.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Legal Employer\",          \"Column Desc\": \"Filters out people who belong to some legal employers\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Legislation\",          \"Column Desc\": \"Filters seniority date on legislation.\",          \"isDouble\": \"true\"        },        {          \"Column Name\": \"Union\",          \"Column Desc\": \"Filters out people who belong to some unions.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Worker Type\",          \"Column Desc\": \"Filters seniority date on worker type, for example, Employee, Contingent Worker, Pending and Non-Worker.\",          \"isDouble\": \"true\"        }      ]    },    \"Seniority Hours\": {      \"Table Desc\": \"Provides seniority hours information for workers whose seniority is calculated in hours.\",      \"columns\": [        {          \"Column Name\": \"Seniority Hours\",          \"Column Desc\": \"Seniority Hours loaded from Seniority Hours table. This is applicable for workers whose seniority is calculated in hours.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Last Seniority Hours Run Date\",          \"Column Desc\": \"Date on which the process ran last to calculate the hours based on the uploaded hours worked. This is applicable for workers whose seniority is calculated in hours.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Total Seniority Hours\",          \"Column Desc\": \"Total Seniority Hours loaded from Seniority Hours table till this point in time. This is applicable for workers whose seniority is calculated in hours.\",          \"isDouble\": \"false\"        }      ]    },    \"Union\": {      \"Table Desc\": \"Provides information about worker's union details.\",      \"columns\": [        {          \"Column Name\": \"Address Details\",          \"Column Desc\": \"Oracle HCM reporting attribute for Address Details in the Union folder.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"PER_ORGANIZATION_UNIT_DFF_FLEX_CONTEXT_\",          \"Column Desc\": \"Flexfield attribute for CONTEXT in the Union folder.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"PER_ORGANIZATION_UNIT_DFF_DESC_FLEX_CONTEXT_\",          \"Column Desc\": \"Description for CONTEXT.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"PER_ORGANIZATION_UNIT_DFF_NAME_FLEX_CONTEXT_\",          \"Column Desc\": \"Name of NAME CONTEXT.\",          \"isDouble\": \"false\"        },        {          \"Column Name\": \"Country\",          \"Column Desc\": \"Country the union operates in\",          \"isDouble\": \"false\