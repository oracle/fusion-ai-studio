        {
          "id": "emp_1783362075375",
          "code": "EMP_CHECK_PROFILES_DATA",
          "type": "CONDITION",
          "convergenceTargetId": "emp_1782996892043",
          "metadata": {
            "name": "Employees - Check Profiles Data"
          },
          "diagram": {
            "x": 5606,
            "y": 11140
          },
          "outcomes": {
            "true": "emp_1782996892043",
            "false": "emp_1783362158518"
          },
          "inputs": [
            {
              "id": "emp_1783362075375_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.EMP_RUN_PERSON_PROFILES_QUERY.$output.Rows?.length>0}}"
            }
          ]
        },
        {
          "id": "emp_1782996892043",
          "code": "EMP_MERGE_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Employees - Merge Data",
            "returnType": "array",
            "sourceCode": "const riskItemsRaw =\n  $context.$nodes.EMP_RUN_PERSON_PROFILES_QUERY?.$output?.Rows ??\n  $context.$nodes.EMP_RUN_PERSON_PROFILES_QUERY_FALLBACK?.$output?.Rows;\n\nconst existingItemsRaw = $context.$variables.emp_sqlData;\n\n// Always work with arrays.\nconst riskItems = Array.isArray(riskItemsRaw) ? riskItemsRaw : [];\nconst existingItems = Array.isArray(existingItemsRaw) ? existingItemsRaw : [];\n\n// If there is no existing person data, return an empty result.\nif (existingItems.length === 0) {\n  return [];\n}\n\nconst defaultRatings = {\n  \"Risk of Loss\": null,\n  \"Impact of Loss\": null,\n  \"Performance Rating\": null,\n  \"Career Potential\": null\n};\n\nconst personMap = new Map();\n\n// Create exactly one row per person from the existing list.\nexistingItems.forEach(item => {\n  if (!item || typeof item !== \"object\") {\n    return;\n  }\n\n  const personNumber = item[\"Person Number\"];\n\n  if (personNumber == null) {\n    return;\n  }\n\n  personMap.set(personNumber, {\n    ...defaultRatings,\n    ...(personMap.get(personNumber) ?? {}),\n    ...item\n  });\n});\n\n// Merge rating records into their corresponding person.\nriskItems.forEach(item => {\n  if (!item || typeof item !== \"object\") {\n    return;\n  }\n\n  const personNumber = item[\"Person Number\"];\n  const contentType = item[\"Content Type\"];\n\n  // Only update people found in the existing list.\n  if (personNumber == null || !personMap.has(personNumber)) {\n    return;\n  }\n\n  const person = personMap.get(personNumber);\n\n  if (contentType === \"Risk of Loss\") {\n    // Rating Level 1 represents Risk of Loss.\n    if (item[\"Rating Level 1\"] != null) {\n      person[\"Risk of Loss\"] = item[\"Rating Level 1\"];\n    }\n\n    // Rating Level 2 represents Impact of Loss.\n    if (item[\"Rating Level 2\"] != null) {\n      person[\"Impact of Loss\"] = item[\"Rating Level 2\"];\n    }\n  } else if (contentType === \"Performance Rating\") {\n    if (item[\"Rating Level 1\"] != null) {\n      person[\"Performance Rating\"] = item[\"Rating Level 1\"];\n    }\n  } else if (contentType === \"Career Potential\") {\n    if (item[\"Rating Level 1\"] != null) {\n      person[\"Career Potential\"] = item[\"Rating Level 1\"];\n    }\n  }\n});\n\nreturn Array.from(personMap.values());"
          },
          "diagram": {
            "x": 5606,
            "y": 11584
          },
          "outcomes": {
            "success": "emp_1782381728786"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "emp_1782381728786",
          "code": "EMP_PREPARE_OUTPUT_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Employees - Prepare Output Data",
            "sourceCode": "let queryOutput = $context.$nodes.EMP_MERGE_DATA.$output.result;\n\nlet output = {};\n\noutput.sessionId = $context.$variables.emp_sessionId;\noutput.items = queryOutput;\noutput.finished = $context.$variables.emp_finishedFlag;\noutput.queryId = $context.$variables.emp_queryId;\noutput.columnMap = $context.$variables.emp_columnMap;\n\nreturn output;",
            "returnType": "object"
          },
          "diagram": {
            "x": 5606,
            "y": 11806
          },
          "outcomes": {
            "success": "emp_1782305016931"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
