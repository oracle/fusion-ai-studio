                  "metadata": {
                    "name": "Offers - Prepare Column Map",
                    "sourceCode": "let columnData = $context.$nodes.OFF_FETCH_DATA.OFF_RUN_QUERY.$output.metadata;\n\n\n\n\nif (!columnData) return $context.$variables.off_columnMap ;\n\nlet columnMap = {};\n\n  Object.entries(columnData).forEach(([columnKey, meta]) => {\n    let displayName = meta[\"saw-sql:columnHeading\"];\n\n    columnMap[columnKey] = displayName || columnKey;\n\n});\n\nreturn columnMap;",
