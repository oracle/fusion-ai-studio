        {
          "id": "emp_1782993739103",
          "code": "EMP_PREPARE_PAYLOAD_FOR_PERSON_PROFILES",
          "type": "CODE",
          "metadata": {
            "name": "Employees - Prepare Payload for Person Profiles",
            "returnType": "object",
            "sourceCode": "let data = $context.$variables.emp_sqlData;\n\nconst personNumbers = data.map(function (person) {\n    const number = String(person[\"Person Number\"]).replace(/'/g, \"''\");\n    return \"'\" + number + \"'\";\n  })\n\nlet sqlQuery = \"SET VARIABLE PREFERRED_CURRENCY='User Preferred Currency 1';SELECT 0 s_0, \\\"Workforce Profiles - Person Profile Real Time\\\".\\\"- All Profile Content\\\".\\\"Content Type\\\" s_1, \\\"Workforce Profiles - Person Profile Real Time\\\".\\\"- All Profile Content\\\".\\\"Rating Level 1\\\" s_2, \\\"Workforce Profiles - Person Profile Real Time\\\".\\\"- All Profile Content\\\".\\\"Rating Level 2\\\" s_3, \\\"Workforce Profiles - Person Profile Real Time\\\".\\\"Worker\\\".\\\"Person Number\\\" s_4 FROM \\\"Workforce Profiles - Person Profile Real Time\\\" WHERE (\\\"- All Profile Content\\\".\\\"Content Type Id\\\" IN (113, 115, 125) ) AND (\\\"Worker\\\".\\\"Person Number\\\" IN  \";\n\nsqlQuery += \"(\" + personNumbers + \"))\";\nlet payload = {}\n\npayload.sqlQuery = sqlQuery;\npayload.outputFormat = \"CollectionDataFormat\";\npayload.executionOptions = {\n      \"async\": false,\n      \"refresh\": true,\n      \"presentationInfo\": true,\n      \"maxRowsPerPage\": 25\n    };\npayload.sessionId = $context.$variables.emp_sessionId;\n\nreturn payload;"
          },
          "diagram": {
            "x": 5606,
            "y": 10696
          },
          "outcomes": {
            "success": "emp_1782993673127"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
