                      "value": "{{$context.$nodes.EMP_FETCH_DATA.EMP_RUN_QUERY.$output.finished === true || $context.$nodes.EMP_FETCH_DATA.EMP_RUN_QUERY.$output.finished === \"true\"}}",
                      "type": "string"
                    },
                    {
                      "id": "emp_1782300209696_columnMap",
