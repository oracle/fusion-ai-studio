          "metadata": {
            "name": "Check Safe Render About Me Form",
            "description": "Enforces the permitted data and output contract for this HR panel.",
            "returnType": "object",
            "sourceCode": "\nfunction reject() { throw new Error(\"The generated response did not match the permitted HR display contract.\"); }\nfunction same(a,b) {\n  if (a === b) return true;\n  if (!a || !b || typeof a !== \"object\" || typeof b !== \"object\" || Array.isArray(a) !== Array.isArray(b)) return false;\n  const ak = Object.keys(a), bk = Object.keys(b);\n  return ak.length === bk.length && ak.every(function(k) { return Object.prototype.hasOwnProperty.call(b,k) && same(a[k],b[k]); });\n}\nfunction parseJson(body) {\n  const stack = [], tokens = /\"(?:\\\\.|[^\"\\\\])*\"|[{}\\[\\]]/g;\n  let token;\n  while ((token = tokens.exec(body))) {\n    const t = token[0];\n    if (t === \"{\") stack.push({}); else if (t === \"[\") stack.push(null);\n    else if (t === \"}\" || t === \"]\") stack.pop();\n    else if (/^\\s*:/.test(body.slice(tokens.lastIndex))) {\n      const key = JSON.parse(t), keys = stack[stack.length-1];\n      if (!keys || [\"__proto__\",\"constructor\",\"prototype\"].includes(key) || Object.prototype.hasOwnProperty.call(keys,key)) reject();\n      keys[key] = true;\n    }\n    if (stack.length > 30) reject();\n  }\n  return JSON.parse(body);\n}\nfunction readBlocks(value) {\n  const result = []; let rest = value.trim();\n  while (rest.startsWith(\"<ora\")) {\n    const opening = rest.match(/^<(oraInfoDisplay|oraInsight|oraImmediateInsight)(?:\\s+key=\"([A-Za-z0-9_-]{1,80})\")?>/);\n    if (!opening) reject(); rest = rest.slice(opening[0].length).trimStart();\n    if (rest[0] !== \"{\") reject();\n    let depth=0,quoted=false,escaped=false,end=-1;\n    for (let i=0;i<rest.length;i++) {\n      const ch=rest[i];\n      if (quoted) { if (escaped) escaped=false; else if(ch === \"\\\\\") escaped=true; else if(ch === '\"') quoted=false; }\n      else if(ch === '\"') quoted=true;\n      else if(ch === \"{\" || ch === \"[\") { if(++depth > 30) reject(); }\n      else if(ch === \"}\" || ch === \"]\") { if(--depth === 0) { end=i+1; break; } }\n    }\n    if (end < 0) reject();\n    const payload=parseJson(rest.slice(0,end)); rest=rest.slice(end).trimStart();\n    const close=\"</\"+opening[1]+\">\"; if (!rest.startsWith(close)) reject();\n    rest=rest.slice(close.length).trimStart(); const parsed={type:opening[1],payload:payload}; if(opening[2]) parsed.key=opening[2]; result.push(parsed);\n    if(result.length > 10) reject();\n  }\n  return {blocks:result,text:rest};\n}\n\nconst prepared=$context.$nodes.PREPARE_SAFE_RENDER_ABOUT_ME_FORM.$output.result, output=$context.$nodes.RENDER_ABOUT_ME_FORM.$output;\n\nif(typeof output !== \"string\" || output.length > 1500000 || /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]/.test(output)) reject();\nconst actual=readBlocks(output);\nif(!same(actual,prepared.contract)) reject();\n// Restore only exact, validated reference tokens in their original positions.\n// Never evaluate model text as JavaScript or resolve model-invented identifiers.\nfunction restore(value) {\n  if(typeof value === \"string\" && Object.prototype.hasOwnProperty.call(prepared.references,value)) return prepared.references[value];\n  if(Array.isArray(value)) return value.map(restore);\n  if(value && typeof value === \"object\") {const result={};Object.keys(value).forEach(function(k){result[k]=restore(value[k]);});return result;}\n  return value;\n}\nconst restored=actual.blocks.map(function(block){\n  const body=JSON.stringify(restore(block.payload)).replace(/</g,\"\\\\u003c\").replace(/>/g,\"\\\\u003e\").replace(/&/g,\"\\\\u0026\");\n  return \"<\"+block.type+(block.key ? ' key=\"'+block.key+'\"' : \"\")+\">\"+body+\"</\"+block.type+\">\";\n}).join(\"\\n\")+(actual.text ? \"\\n\"+actual.text : \"\");\nreturn {valid:true,output:restored};\n",
            "errorNodeId": "HR_RESPONSE_REJECTED"
