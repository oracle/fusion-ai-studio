          "type": "CODE",
          "metadata": {
            "name": "Project About Me Query Data",
            "returnType": "object",
            "sourceCode": "function plainText(value) {\n  return typeof value === \"string\" ? value.replace(/<[^>]*>/g, \"\").replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/g, \"\").trim().slice(0, 4000) : \"\";\n}\nfunction rows(value) {\n  return Array.isArray(value) ? value : value && Array.isArray(value.items) ? value.items : [];\n}\nlet data = $context.$variables.contextData;\nif (typeof data === \"string\") {\n  if (data.length > 1000000) throw new Error(\"About Me query context is too large.\");\n  try { data = JSON.parse(data); } catch (error) { throw new Error(\"Invalid About Me query context.\"); }\n}\nconst profiles = rows(data);\nif (profiles.length > 1) throw new Error(\"About Me query requires a single profile.\");\nconst profile = profiles[0] || {};\nconst selectedId = String($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId || \"\");\nif (profile.PersonId != null && String(profile.PersonId) !== selectedId) throw new Error(\"About Me query context does not match the selected worker.\");\nreturn {\n  summary: plainText(profile.Summary),\n  expertise: rows(profile.areasOfExpertise).map(function (row) { return plainText(row.Expertise); }).filter(Boolean),\n  interests: rows(profile.areasOfInterest).map(function (row) { return plainText(row.Interest); }).filter(Boolean),\n  tags: rows(profile.tags).map(function (row) { return plainText(row.Tag); }).filter(Boolean)\n};",
            "description": "Projects only bounded About Me text into query prompts, excluding identifiers, links, keys and actions."
          },
          "outcomes": {
            "success": "PREPARE_SAFE_ANSWER_QUERY"
          },
          "inputs": [],
          "diagram": {
            "x": 6518.75,
            "y": 6538
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "PREPARE_SAFE_ANSWER_QUERY",
          "code": "PREPARE_SAFE_ANSWER_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Safe Answer Query",
            "description": "Enforces the permitted data and output contract for this HR panel.",
            "returnType": "object",
            "sourceCode": "const allowed=[\"summary\", \"expertise\", \"interests\", \"tags\", \"Expertise\", \"Interest\", \"areasOfExpertise\", \"areasOfInterest\", \"Expertise\", \"Tags\", \"Expertise Tags\"];\n\nfunction reject() { throw new Error(\"Unverified HR answer.\"); }\nfunction clean(value) { return value.replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]/g,\"\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\nlet size=0;const blocked=[];\nfunction project(value,depth) {\n  if(depth>20) reject();\n  if(typeof value === \"string\") {\n    size+=value.length;if(size>1000000) reject();\n    // Cached contexts and the existing *Json values can be serialized JSON.\n    const trimmed=value.trim();\n    if(depth===0 && /^[\\[{\\\"]/.test(trimmed)) {try {return project(JSON.parse(trimmed),depth+1);}catch(e){reject();}}\n    return clean(value);\n  }\n  if(Array.isArray(value)) {if(value.length>1000) reject();return value.map(function(v){return project(v,depth+1);});}\n  if(value && typeof value === \"object\") {\n    const result={};Object.keys(value).forEach(function(k){\n      if(allowed.indexOf(k)>=0) result[k]=project(value[k],depth+1);\n      else if(/(?:Id|ID|Identifier|Key)$/.test(k) && [\"string\",\"number\"].includes(typeof value[k])) blocked.push(String(value[k]));\n    });return result;\n  }\n  if(value==null || typeof value === \"boolean\" || (typeof value === \"number\" && Number.isFinite(value))) return value;\n  reject();\n}\n\nconst raw=[$context.$system.$inputMessage,$context.$nodes.PREPARE_ABOUT_ME_QUERY_DATA.$output.result];\nconst projected=raw.map(function(v){return project(v,0);});\n\nconst allowedUrls=[];\nfunction collectUrls(v) {\n  if(typeof v === \"string\") (v.match(/https?:\\/\\/[^\\s<>\"\\])]+/gi)||[]).forEach(function(url){allowedUrls.push(url);});\n  else if(Array.isArray(v)) v.forEach(collectUrls);\n  else if(v && typeof v===\"object\") Object.keys(v).forEach(function(k){collectUrls(v[k]);});\n}\n// No business-authored URL is approved merely because it appears in text.\nreturn {modelJson:JSON.stringify(projected),values:projected.map(function(v){return JSON.stringify(v);}),blocked:blocked,allowedUrls:allowedUrls};\n",
            "errorNodeId": "HR_RESPONSE_REJECTED"
          },
          "outcomes": {
            "success": "1780635563090"
          },
          "inputs": [],
