        {
          "id": "VALIDATE_REQUEST_GET_PERSON_TALENT_PROFILE",
          "code": "VALIDATE_REQUEST_GET_PERSON_TALENT_PROFILE",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get Person Talent Profile",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\n\nconst checked={};\nchecked[\"personId\"]=id(($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId),\"personId\");\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
