        },
        {
          "id": "1780635563090",
          "code": "ANSWER_QUERY",
          "type": "LLM",
          "metadata": {
            "name": "Answer Query",
            "modelConfiguration": {
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
