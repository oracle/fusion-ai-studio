          },
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonId\": {\n            \"type\": [\n              \"integer\",\n              \"string\"\n            ]\n          },\n          \"PersonNumber\": {\n            \"type\": [\n              \"string\",\n              \"integer\"\n            ]\n          }\n        },\n        \"additionalProperties\": true\n      }\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"additionalProperties\": true\n}"
        },
        {
          "id": "PARSE_ABOUT_ME_ACTION",
          "code": "PARSE_ABOUT_ME_ACTION",
          "type": "CODE",
          "metadata": {
            "name": "Parse About Me Action",
            "returnType": "object",
            "sourceCode": "let action = $context?.$app?.$OraAction;\nfunction text(value) { return typeof value === \"string\" ? value.trim().slice(0, 4000) : \"\"; }\nfunction id(value) {\n  if (typeof value === \"number\" && (!Number.isSafeInteger(value) || value <= 0)) return \"\";\n  if (typeof value !== \"string\" && typeof value !== \"number\") return \"\";\n  const result = String(value).trim();\n  return /^[1-9][0-9]{0,19}$/.test(result) && Number.isSafeInteger(Number(result)) ? result : \"\";\n}\nfunction paragraph(value) {\n  // Remove control and bidi formatting characters while preserving tabs and line breaks.\n  const plainText = text(value).replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]/g, \"\");\n  return \"<p>\" + plainText.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\") + \"</p>\";\n}\nfunction invalid() { return { valid: false, actionId: \"\", personId: \"\", tags: [], summary: \"\", expertise: \"\", expertiseId: \"\", interest: \"\", interestId: \"\" }; }\nfunction safeObject(value) {\n  if (typeof value === \"string\") {\n    if (value.length > 16384) return null;\n    try { value = JSON.parse(value); } catch (e) { return null; }\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) return null;\n  let serialized;\n  try { serialized = JSON.stringify(value); } catch (e) { return null; }\n  if (typeof serialized !== \"string\" || serialized.length > 16384) return null;\n  let count = 0;\n  function safeKeys(object, depth) {\n    if (++count > 1000 || depth > 12) return false;\n    if (!object || typeof object !== \"object\") return true;\n    return Object.keys(object).every(function (key) {\n      return [\"__proto__\", \"constructor\", \"prototype\"].indexOf(key) === -1 && safeKeys(object[key], depth + 1);\n    });\n  }\n  return safeKeys(value, 0) ? value : null;\n}\nlet userContext = safeObject($context?.$app?.$OraUserContext);\nif (!userContext || typeof userContext !== \"object\" || Array.isArray(userContext)) return invalid();\nconst claimedPersonId = id(userContext.userId ?? userContext.UserId);\nconst sessionPersonNumber = $context.$nodes.VALIDATE_ABOUT_ME_SESSION.$output.result.personNumber;\nconst workerOutput = $context.$nodes.GET_ABOUT_ME_SESSION_WORKER.$output;\nif (!workerOutput || workerOutput.error || workerOutput.timeout || workerOutput.isError || Number(workerOutput.statusCode || 0) >= 400 || (workerOutput.hasMore !== undefined && workerOutput.hasMore !== false) || !Array.isArray(workerOutput.items) || workerOutput.items.length !== 1) return invalid();\nconst sessionWorker = workerOutput.items[0];\nif (!sessionWorker || (typeof sessionWorker.PersonNumber !== \"string\" && !(typeof sessionWorker.PersonNumber === \"number\" && Number.isSafeInteger(sessionWorker.PersonNumber) && sessionWorker.PersonNumber > 0)) || String(sessionWorker.PersonNumber).trim() !== sessionPersonNumber) return invalid();\nconst callerPersonId = id(sessionWorker.PersonId);\nconst selectedPersonId = id($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId);\nif (!callerPersonId || claimedPersonId !== callerPersonId || selectedPersonId !== callerPersonId) return invalid();\nif (typeof action === \"string\" && action.length > 32768) return invalid();\nif (typeof action === \"string\" && action.indexOf(\"<oraFormSubmit\") === 0) {\n  const match = action.match(/^<oraFormSubmit\\s+id=\"edit_about_me_form\">([\\s\\S]*)<\\/oraFormSubmit>$/);\n  if (!match) return invalid();\n  try {\n    const fields = JSON.parse(match[1]);\n    if (!Array.isArray(fields) || fields.length > 6) return invalid();\n    const allowed = [\"about_person_id\", \"about_expertise_id\", \"about_interest_id\", \"about_summary\", \"about_expertise\", \"about_interest\"];\n    const values = {};\n    for (const field of fields) {\n      if (!field || allowed.indexOf(field.id) === -1 || Object.prototype.hasOwnProperty.call(values, field.id) || typeof field.value !== \"string\") return invalid();\n      values[field.id] = text(field.value);\n    }\n    const personId = id(values.about_person_id);\n    const expertiseId = id(values.about_expertise_id);\n    const interestId = id(values.about_interest_id);\n    if (personId !== callerPersonId || !expertiseId || !interestId || !Object.prototype.hasOwnProperty.call(values, \"about_summary\") || !Object.prototype.hasOwnProperty.call(values, \"about_expertise\") || !Object.prototype.hasOwnProperty.call(values, \"about_interest\")) return invalid();\n    return { valid: true, actionId: \"saveAboutMe\", personId: personId, summary: paragraph(values.about_summary), expertise: paragraph(values.about_expertise), expertiseId: expertiseId, interest: paragraph(values.about_interest), interestId: interestId };\n  } catch (e) { return invalid(); }\n}\naction = safeObject(action);\nif (!action) return invalid();\nconst payload = action.data && typeof action.data === \"object\" && !Array.isArray(action.data) ? action.data : action;\nconst personId = id(payload.personId);\nif (payload.actionId !== \"editAboutMe\" || personId !== callerPersonId) return invalid();\nreturn { valid: true, actionId: \"editAboutMe\", personId: personId, tags: Array.isArray(payload.tags) ? payload.tags.filter(function (tag) { return typeof tag === \"string\"; }).map(function (tag) { return tag.replace(/<[^>]*>/g, \"\").trim(); }).filter(Boolean) : [], summary: text(payload.summary), expertise: text(payload.expertise), expertiseId: text(payload.expertiseId), interest: text(payload.interest), interestId: text(payload.interestId) };\n",
