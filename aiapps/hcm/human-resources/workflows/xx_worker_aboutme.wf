        {
          "id": "PREPARE_SAFE_RENDER_CARDS",
          "code": "PREPARE_SAFE_RENDER_CARDS",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Safe Render Cards",
            "description": "Enforces the permitted data and output contract for this HR panel.",
            "returnType": "object",
            "sourceCode": "function reject() { throw new Error(\"The response did not match the permitted HR display contract.\"); }\nfunction text(v) {\n  if (typeof v !== \"string\" && typeof v !== \"number\") return \"\";\n  return String(v).replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]/g, \"\").trim()\n    .replace(/&(?!amp;|lt;|gt;|quot;|apos;|nbsp;)/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\");\n}\nfunction list(v) { if (!Array.isArray(v) || v.length > 1000) reject(); return v; }\nlet displayIndex = 0;\nfunction display(pattern,properties,extra) { return {type:\"oraInfoDisplay\",key:\"xx_worker_aboutme-render_cards-\"+(++displayIndex),payload:Object.assign({patternId:pattern},extra || {},{properties:properties})}; }\nfunction insight(value) { return {type:\"oraInsight\",payload:value}; }\n\nlet blocks=[],visibleText=\"\";\nconst d=$context.$nodes.PREPARE_ABOUT_ME_LLM_DATA.$output.result; const cards=[];\n[[\"Summary\",d.summary],[\"Expertise\",d.areasOfExpertise.Expertise],[\"Interest\",d.areasOfInterest.Interest],[\"Tags\",list(d.tags).join(\", \")]].forEach(function(pair){if(text(pair[1])) cards.push({subject:pair[0],summary:text(pair[1])});});\nblocks=[display(\"multiCardWidget\",{cards:cards},{title:\"\",description:\"\"})]; if(d.editAboutMeAction) blocks.push(insight(d.editAboutMeAction));\n\n// Keep internal identifiers and executable commands outside the model context.\nconst references = {};\nlet referenceIndex = 0;\nfunction protect(value,key,parent) {\n  if (typeof value === \"string\" && ([\"action\",\"drillDownAction\",\"followUpCommand\",\"image\"].includes(key) || (key === \"id\" && /\\d/.test(value)) || (key === \"value\" && parent && [\"hidden\",\"system\"].includes(parent.type)))) {\n    const token = \"HR_REF_\" + (++referenceIndex);\n    references[token] = value;\n    return token;\n  }\n  if (Array.isArray(value)) return value.map(function(v) { return protect(v,\"\",null); });\n  if (value && typeof value === \"object\") {\n    const result = {};\n    Object.keys(value).forEach(function(k) { if ([\"__proto__\",\"prototype\",\"constructor\"].includes(k)) reject(); result[k] = protect(value[k],k,value); });\n    return result;\n  }\n  if (typeof value === \"string\" && /HR_REF_\\d+/.test(value)) reject();\n  return value;\n}\nconst contract = {blocks:blocks,text:visibleText};\nconst modelContract = protect(contract,\"\",null);\nconst modelJson = JSON.stringify(modelContract);\nif (modelJson.length > 1000000) reject();\nreturn {modelJson:modelJson,contract:modelContract,references:references};\n",
            "errorNodeId": "HR_RESPONSE_REJECTED"
          },
          "outcomes": {
            "success": "1780635563089"
          },
