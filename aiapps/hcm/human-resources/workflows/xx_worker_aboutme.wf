            "name": "Validate Request Get About Me Session Worker",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction personNumber(value,name) {\n  if(typeof value!==\"string\" && !(typeof value===\"number\" && Number.isSafeInteger(value) && value>0)) reject(name);\n  const text=String(value).trim();if(!/^[A-Za-z0-9_.@-]{1,50}$/.test(text)) reject(name);return text;\n}\n\nconst checked={};\nchecked[\"personNumber\"]=personNumber(($context.$nodes.VALIDATE_ABOUT_ME_SESSION.$output.result.personNumber),\"personNumber\");\nreturn checked;",
