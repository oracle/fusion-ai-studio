        {
          "id": "1780635563096",
          "code": "PREPARE_ABOUT_ME_LLM_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Prepare About Me Display Data",
            "returnType": "object",
            "description": "Normalizes the person talent profile into safe, display-ready About Me fields for the renderer.",
            "sourceCode": "const profile = $context.$nodes.GET_PERSON_TALENT_PROFILE.$output?.items?.[0] || {};\nfunction text(value) { return typeof value === \"string\" ? value.trim() : \"\"; }\nfunction entries(value) { return Array.isArray(value) ? value : Array.isArray(value?.items) ? value.items : []; }\nfunction plainText(value) { return text(value).replace(/<[^>]*>/g, \"\").replace(/\\s+/g, \" \").trim(); }\nfunction context(value) { if (typeof value === \"string\") { try { value = JSON.parse(value); } catch (e) { return {}; } } return value && typeof value === \"object\" ? value : {}; }\nfunction id(value) { const result = String(value ?? \"\").trim(); return /^\\d+$/.test(result) ? result : \"\"; }\nconst app = $context?.$app || {};\nconst userContext = context(app.$OraUserContext);\nconst selectedPersonId = id($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId);\nconst userId = id(userContext.userId ?? userContext.UserId);\nconst personId = selectedPersonId;\nconst canEdit = Boolean(userId) && selectedPersonId === userId;\nconst expertiseRecord = entries(profile.areasOfExpertise)[0] || {};\nconst interestRecord = entries(profile.areasOfInterest)[0] || {};\nconst summary = plainText(profile.Summary);\nconst expertise = plainText(expertiseRecord.Expertise);\nconst interest = plainText(interestRecord.Interest);\nconst tags = [...new Set(entries(profile.tags).map(function (record) { return plainText(record?.Tag); }).filter(Boolean))];\nconst editAboutMeAction = canEdit ? { title: \"Edit\", actionText: \"editAboutMe\", followUpCommand: 'ora.Invoke(\"editAboutMe\", ' + JSON.stringify({ actionId: \"editAboutMe\", personId: personId, summary: summary, tags: tags, expertise: expertise, expertiseId: id(expertiseRecord.ExpertiseId), interest: interest, interestId: id(interestRecord.InterestId) }) + ')' } : null;\nreturn { hasContent: Boolean(summary || expertise || interest || tags.length), tags: tags, summary: summary, areasOfExpertise: { Expertise: expertise }, areasOfInterest: { Interest: interest }, editAboutMeAction: editAboutMeAction };"
          },
          "outcomes": {
            "success": "1780635563094"
          },
          "inputs": [],
          "diagram": {
            "x": 5731.25,
            "y": 9868
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
