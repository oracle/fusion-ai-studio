        {
          "id": "EXTRACT_ABOUT_ME_PROFILE_ID",
          "code": "EXTRACT_ABOUT_ME_PROFILE_ID",
          "type": "CODE",
          "metadata": {
            "name": "Extract About Me Profile Id",
            "returnType": "object",
            "sourceCode": "function unpack(value) {\n  for (let i = 0; i < 6; i += 1) {\n    if (typeof value === 'string') { value = JSON.parse(value); continue; }\n    if (!value || typeof value !== 'object') return {};\n    if (value.error || value.timeout || value.isError || Number(value.statusCode || 0) >= 400) throw new Error('Unable to verify the current About Me profile.');\n    if (Array.isArray(value.items)) return value;\n    if (value.output !== undefined) { value = value.output; continue; }\n    if (value.result !== undefined) { value = value.result; continue; }\n    break;\n  }\n  return value || {};\n}\nconst output = unpack($context.$nodes.GET_ABOUT_ME_PROFILE_ID.$output);\nconst action = $context.$nodes.PARSE_ABOUT_ME_ACTION.$output.result || {};\nif (action.valid !== true || action.actionId !== 'saveAboutMe') throw new Error('A valid About Me Save action is required.');\nconst rows = Array.isArray(output.items) ? output.items : [];\nif (rows.length !== 1 || (output.hasMore !== undefined && output.hasMore !== false)) throw new Error('Expected exactly one talent profile for About Me Save.');\nconst row = rows[0];\nif (String(row.PersonId || '') !== String(action.personId || '')) throw new Error('The returned talent profile does not match the selected person.');\nconst links = Array.isArray(row.links) ? row.links : [];\nlet resourceKey = '';\nfor (const rel of ['canonical', 'self']) {\n  for (const link of links) {\n    if (link.rel !== rel || typeof link.href !== 'string') continue;\n    const match = link.href.match(/\\/hcmRestApi\\/resources\\/11\\.13\\.18\\.05\\/talentPersonProfiles\\/([A-Za-z0-9_%~-]+)(?:[?#].*)?$/);\n    if (match) { resourceKey = match[1]; break; }\n  }\n  if (resourceKey) break;\n}\nif (!resourceKey) {\n  const contextKey = row['@context'] && row['@context'].key;\n  if (typeof contextKey === 'string' && /^[A-Za-z0-9_%~-]+$/.test(contextKey)) resourceKey = contextKey;\n}\nif (!resourceKey) throw new Error('The talent profile lookup did not return an item link or resource key for About Me Save.');\nif (!/^\\d+$/.test(String(action.expertiseId || '')) || !/^\\d+$/.test(String(action.interestId || ''))) throw new Error('Existing expertise and interest record IDs are required to update About Me.');\nfunction numericRecordId(value, label) {\n  const text = String(value == null ? '' : value).trim();\n  const number = Number(text);\n  if (!/^\\d+$/.test(text) || !Number.isSafeInteger(number) || number <= 0) {\n    throw new Error(label + ' must be a positive integer that can be represented without precision loss.');\n  }\n  return number;\n}\nconst expectedProfileId = numericRecordId(row.ProfileId, 'ProfileId');\nconst current = unpack($context.$nodes.GET_ABOUT_ME_CHILD_RECORDS.$output);\nconst currentRows = Array.isArray(current.items) ? current.items : [];\nif (currentRows.length !== 1 || (current.hasMore !== undefined && current.hasMore !== false)) {\n  throw new Error('Expected exactly one current talent profile for About Me Save.');\n}\nconst currentProfile = currentRows[0];\nif (!currentProfile || numericRecordId(currentProfile.ProfileId, 'ProfileId') !== expectedProfileId) {\n  throw new Error('The current About Me records do not belong to the selected talent profile.');\n}\nfunction verifiedChildId(collection, field, submittedId) {\n  const requestedId = numericRecordId(submittedId, field);\n  const records = Array.isArray(collection) ? collection : collection && collection.items;\n  if (!Array.isArray(records) || (collection.hasMore !== undefined && collection.hasMore !== false)) {\n    throw new Error('Unable to verify the current About Me child records.');\n  }\n  const seen = {};\n  let matchedId = null;\n  for (const record of records) {\n    if (!record || typeof record !== 'object' || Array.isArray(record)) throw new Error('Invalid About Me child record.');\n    const recordId = numericRecordId(record[field], field);\n    if (Object.prototype.hasOwnProperty.call(seen, recordId)) throw new Error('Ambiguous About Me child records.');\n    seen[recordId] = true;\n    if (recordId === requestedId) matchedId = recordId;\n  }\n  if (matchedId === null) throw new Error('The submitted About Me record does not belong to the current profile. Reopen Edit and try again.');\n  return matchedId;\n}\nconst expertiseId = verifiedChildId(currentProfile.areasOfExpertise, 'ExpertiseId', action.expertiseId);\nconst interestId = verifiedChildId(currentProfile.areasOfInterest, 'InterestId', action.interestId);\nif (typeof action.expertise !== 'string') throw new Error('About Me expertise text is missing; reopen Edit and submit the Expertise field.');\nreturn {\n  profileId: resourceKey,\n  expertiseId: expertiseId,\n  interestId: interestId,\n  summary: action.summary || '',\n  expertise: action.expertise,\n  interest: action.interest || ''\n};",
            "description": "Verifies profile ownership and current child-record membership before passing individual About Me field values to fixed BO request templates.",
            "errorNodeId": "SHOW_ABOUT_ME_ACTION_ERROR"
          },
