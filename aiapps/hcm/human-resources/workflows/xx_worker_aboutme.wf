            }
          }
        },
        {
          "id": "CHECK_SAFE_DOWNLOAD_CARD",
          "code": "CHECK_SAFE_DOWNLOAD_CARD",
          "type": "CODE",
          "metadata": {
            "name": "Check communication body",
            "returnType": "object",
            "sourceCode": "const output=$context.$nodes.DOWNLOAD_CARD.$output;\nconst html=$context.$nodes.PDF_DISPLAY.$output;\nconst requested=$context.$app.$OraCommParamsToFill;\nif(!Array.isArray(requested) || !requested[2] || typeof html!==\"string\" || output!==html) throw new Error(\"The About Me communication body was changed or unavailable.\");\nreturn {valid:true,output:output};",
            "errorNodeId": "HR_RESPONSE_REJECTED"
          },
