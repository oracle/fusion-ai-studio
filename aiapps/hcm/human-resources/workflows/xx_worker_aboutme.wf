            "sourceCode": "const p = $context.$nodes.PARSE_ABOUT_ME_ACTION.$output.result || {};\n\nreturn {\n  readOnlyTags: Array.isArray(p.tags) ? p.tags : [],\n  id: 'edit_about_me_form',\n  title: 'Edit About Me',\n  description: '',\n  readOnly: false,\n  submitText: 'Save',\n  cancelText: 'Cancel',\n  fields: [\n    {\n      id: 'about_summary',\n      type: 'textarea',\n      label: 'Summary',\n      value: p.summary || '',\n      rows: 16,\n      scrollable: true\n    },\n    {\n      id: 'about_expertise',\n      type: 'textarea',\n      label: 'Expertise',\n      value: p.expertise || '',\n      rows: 4,\n      scrollable: true\n    },\n    {\n      id: 'about_interest',\n      type: 'textarea',\n      label: 'Areas of Interest',\n      value: p.interest || '',\n      rows: 4,\n      scrollable: true\n    },\n    {\n      id: 'about_person_id',\n      type: 'system',\n      label: '',\n      value: p.personId || ''\n    },\n    {\n      id: 'about_expertise_id',\n      type: 'system',\n      label: '',\n      value: p.expertiseId || ''\n    },\n    {\n      id: 'about_interest_id',\n      type: 'system',\n      label: '',\n      value: p.interestId || ''\n    }\n  ]\n};",
