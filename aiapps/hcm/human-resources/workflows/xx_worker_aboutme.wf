          "type": "CODE",
          "metadata": {
            "name": "Validate About Me Session",
            "sourceCode": "const output = $context.$nodes.FETCH_ABOUT_ME_USER_SESSION.$output;\nif (!output || output.error || output.timeout || output.isError || Number(output.statusCode || 0) >= 400 || (output.hasMore !== undefined && output.hasMore !== false) || !Array.isArray(output.items) || output.items.length !== 1) {\n  throw new Error(\"Unable to verify the signed-in worker.\");\n}\nconst session = output.items[0];\nif (!session || typeof session !== \"object\" || Array.isArray(session)) {\n  throw new Error(\"Unable to verify the signed-in worker.\");\n}\nconst rawPersonNumber = session.PersonNumber;\nif (typeof rawPersonNumber !== \"string\" && !(typeof rawPersonNumber === \"number\" && Number.isSafeInteger(rawPersonNumber) && rawPersonNumber > 0)) {\n  throw new Error(\"Unable to verify the signed-in worker.\");\n}\nconst personNumber = String(rawPersonNumber).trim();\nif (!personNumber || personNumber.length > 50 || !/^[A-Za-z0-9_.@-]+$/.test(personNumber)) {\n  throw new Error(\"Unable to verify the signed-in worker.\");\n}\nreturn { personNumber: personNumber };",
