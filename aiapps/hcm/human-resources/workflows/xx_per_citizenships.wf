        {
          "id": "1781104087302",
          "code": "PREPARE_CITIZENSHIPS_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Citizenships Output",
            "sourceCode": "// Date-only values must never be converted through a time zone.\nfunction parse(value) {\n  if (typeof value === \"string\") { try { return JSON.parse(value); } catch (error) { return null; } }\n  return value;\n}\nfunction collection(value) {\n  const response = parse(value);\n  if (!response || response.error || response.timeout || response.isError ||\n      Number(response.statusCode || response.status || 0) >= 400 ||\n      String(response.hasMore).toLowerCase() === \"true\" || !Array.isArray(response.items)) return [];\n  return response.items;\n}\nconst viewerId = $context.$nodes.RESOLVE_VIEWER_DATE_CONTEXT.$output.result.viewerPersonId;\n// USER_SESSION is bound to the authenticated viewer, never OraAppContext's subject.\nconst sessions = collection($context.$nodes.READ_VIEWER_SESSION?.$output);\nconst session = sessions.length === 1 && sessions[0] ? sessions[0] : {};\nconst preference = typeof session.DateFormat === \"string\" ? session.DateFormat.trim() : \"\";\nconst language = String(session.Language || session.DefaultLanguage || \"\").toLowerCase();\nlet country = typeof session.Territory === \"string\" ? session.Territory.trim().toUpperCase() : \"\";\nif (!country && viewerId) {\n  const countries = [];\n  collection($context.$nodes.GET_VIEWER_WORK_ASSIGNMENT?.$output).forEach(function (row) {\n    if (!row || (row.PersonId != null && String(row.PersonId).trim() !== viewerId)) return;\n    if (row.PrimaryFlag != null && !/^(true|y)$/i.test(String(row.PrimaryFlag))) return;\n    const value = typeof row.LocationCountry === \"string\" ? row.LocationCountry.trim().toUpperCase() : \"\";\n    if (countries.indexOf(value) < 0) countries.push(value);\n  });\n  if (countries.length === 1) country = countries[0];\n}\nconst monthNames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\nfunction preferenceFormat(parts) {\n  // Oracle selfDetails.DateFormat uses Java-style day/month/year tokens.\n  if (!preference || preference.length > 80) return null;\n  const tokens = preference.match(/yyyy|YYYY|yy|YY|MMMM|MMM|MM|M|dd|DD|d|D|[\\s/.,-]+/g);\n  if (!tokens || tokens.join(\"\") !== preference) return null;\n  const dateTokens = tokens.filter(function (token) { return /[yYMdD]/.test(token); });\n  if (dateTokens.length !== 3 ||\n      dateTokens.filter(function (t) { return /^[yY]/.test(t); }).length !== 1 ||\n      dateTokens.filter(function (t) { return /^M/.test(t); }).length !== 1 ||\n      dateTokens.filter(function (t) { return /^[dD]/.test(t); }).length !== 1) return null;\n  if (preference.indexOf(\"MMM\") >= 0 && !/^en(?:[-_]|$)/.test(language)) return null;\n  return tokens.map(function (token) {\n    if (/^(yyyy|YYYY)$/.test(token)) return parts[1];\n    if (/^(yy|YY)$/.test(token)) return parts[1].slice(-2);\n    if (token === \"MMMM\") return monthNames[Number(parts[2]) - 1];\n    if (token === \"MMM\") return monthNames[Number(parts[2]) - 1].slice(0, 3);\n    if (token === \"MM\") return parts[2];\n    if (token === \"M\") return String(Number(parts[2]));\n    if (/^(dd|DD)$/.test(token)) return parts[3];\n    if (/^(d|D)$/.test(token)) return String(Number(parts[3]));\n    return token;\n  }).join(\"\");\n}\nfunction formatDate(value) {\n  if (value == null || value === \"\") return \"\";\n  if (typeof value !== \"string\") return value;\n  const parts = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(value);\n  if (!parts) return value;\n  const year = Number(parts[1]), month = Number(parts[2]), day = Number(parts[3]);\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  if (year < 1 || month < 1 || month > 12 || day < 1 || day > days[month - 1]) return value;\n  const preferred = preferenceFormat(parts);\n  if (preferred !== null) return preferred;\n  if (country === \"US\") return parts[2] + \"/\" + parts[3] + \"/\" + parts[1];\n  if ([\"IN\", \"GB\", \"UK\", \"AU\", \"SG\"].indexOf(country) >= 0) return parts[3] + \"/\" + parts[2] + \"/\" + parts[1];\n  return value;\n}\n\nfunction displayText(value) {\n  return value === null || value === undefined ? \"\" : String(value).trim();\n}\n\nfunction displayRecord(row) {\n  return {\n    citizenshipName: displayText(row.CitizenshipMeaning) || displayText(row.Citizenship) || \"Citizenship\",\n    status: displayText(row.CitizenshipStatusMeaning),\n    startDate: formatDate(displayText(row.FromDate)),\n    endDate: formatDate(displayText(row.ToDate))\n  };\n}\n\n// Expose only the existing user-facing fields, never IDs, links, or raw records.\nconst records = $context.$nodes.SORT_CONTACT_RECORDS.$output.result;\nreturn {\n  initialRecords: records.initialRecords.map(displayRecord),\n  additionalRecords: records.additionalRecords.map(displayRecord)\n};",
            "returnType": "object",
            "errorNodeId": "1781104087318"
          },
          "outcomes": {
            "success": "1781104087319"
          },
          "inputs": [],
          "diagram": {
            "x": 5675,
            "y": 7924
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1781104087319",
          "code": "PREPARE_SAFE_CONTACT_MODEL_INPUT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Safe Contact Model Input",
            "sourceCode": "function fail() { throw new Error(\"The contact data could not be validated.\"); }\nfunction text(value) {\n  if (typeof value !== \"string\" || value.length > 8192) fail();\n  return value;\n}\nfunction flag(value) {\n  if (value === null || value === undefined || value === \"\") return false;\n  if (value === true || value === 1 || /^(true|y|1)$/i.test(String(value))) return true;\n  if (value === false || value === 0 || /^(false|n|0)$/i.test(String(value))) return false;\n  fail();\n}\nfunction safeJson(value) {\n  return JSON.stringify(value).replace(/[<>&]/g, function (character) {\n    return \"\\\\u\" + character.charCodeAt(0).toString(16).padStart(4, \"0\");\n  });\n}\nconst prepared = $context.$nodes.PREPARE_CITIZENSHIPS_OUTPUT.$output.result;\nconst source = $context.$nodes.SORT_CONTACT_RECORDS.$output.result;\nif (!prepared || !Array.isArray(prepared.initialRecords) ||\n    !Array.isArray(prepared.additionalRecords) || prepared.additionalRecords.length !== 0 ||\n    !source || !Array.isArray(source.initialRecords) ||\n    prepared.initialRecords.length !== source.initialRecords.length) fail();\nconst initialRecords = prepared.initialRecords.map(function (row) {\n  if (!row || typeof row !== \"object\" || Array.isArray(row)) fail();\n  return {\n    citizenshipName: text(row.citizenshipName),\n    status: text(row.status),\n    startDate: text(row.startDate),\n    endDate: text(row.endDate)\n  };\n});\nconst queryRecords = initialRecords.map(function (row, index) {\n  return {\n    citizenship: row.citizenshipName,\n    status: row.status,\n    startDate: row.startDate,\n    endDate: row.endDate\n  };\n});\nreturn {\n  initialRecordsJson: safeJson(initialRecords),\n  additionalRecordsJson: \"[]\",\n  queryRecordsJson: safeJson(queryRecords),\n  questionJson: safeJson($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.question)\n};",
            "returnType": "object",
            "description": "Projects only approved contact fields and JSON-escapes markup delimiters before any model reads business data or the bounded query.",
