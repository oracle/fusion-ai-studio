                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"CitizenshipId\": {\n            \"type\": \"string\"\n          },\n          \"Citizenship\": {\n            \"type\": \"string\"\n          },\n          \"CitizenshipMeaning\": {\n            \"type\": \"string\"\n          },\n          \"FromDate\": {\n            \"type\": \"string\"\n          },\n          \"ToDate\": {\n            \"type\": \"string\"\n          },\n          \"CitizenshipStatus\": {\n            \"type\": \"string\"\n          },\n          \"CitizenshipStatusMeaning\": {\n            \"type\": \"string\"\n          },\n          \"PersonId\": {\n            \"type\": \"string\"\n          },\n          \"CreatedBy\": {\n            \"type\": \"string\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdatedBy\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateDate\": {\n            \"type\": \"string\"\n          },\n          \"RowPostState\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"CitizenshipId\",\n          \"Citizenship\",\n          \"CitizenshipMeaning\",\n          \"FromDate\",\n          \"ToDate\",\n          \"CitizenshipStatus\",\n          \"CitizenshipStatusMeaning\",\n          \"PersonId\",\n          \"CreatedBy\",\n          \"CreationDate\",\n          \"LastUpdatedBy\",\n          \"LastUpdateDate\",\n          \"RowPostState\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
                },
                {
                  "id": "1781104087306",
                  "code": "COLLECT_CONTACT_PAGE",
                  "type": "CODE",
                  "metadata": {
                    "name": "Collect Contact Page",
                    "sourceCode": "function parseResponse(value) {\n  if (typeof value !== \"string\") return value;\n  if (value.length > 1048576) throw new Error(\"The contact response exceeds the safe size limit.\");\n  try {\n    return JSON.parse(value);\n  } catch (error) {\n    throw new Error(\"The contact page could not be read.\");\n  }\n}\n\nfunction integer(value) {\n  if (typeof value !== \"number\" && typeof value !== \"string\") return null;\n  if (typeof value === \"string\" && !/^\\d+$/.test(value.trim())) return null;\n  const number = Number(value);\n  return Number.isSafeInteger(number) && number >= 0 && Math.floor(number) === number ? number : null;\n}\n\nfunction flag(value) {\n  if (value === true || value === false) return value;\n  if (typeof value === \"string\" && /^(true|false)$/i.test(value.trim())) {\n    return value.trim().toLowerCase() === \"true\";\n  }\n  return null;\n}\n\nconst state = $context.$variables.contactPaging;\nconst response = parseResponse($context.$nodes.WHILE_FETCH_CONTACT_PAGES.GET_PERSON_CITIZENSHIPS.$output);\nif (!state || !Array.isArray(state.rows) || state.hasMore !== true) {\n  throw new Error(\"The contact paging state is invalid.\");\n}\nif (!response || typeof response !== \"object\" || Array.isArray(response)\n    || response.error || response.timeout || response.isError\n    || Number(response.statusCode || response.status || 0) >= 400\n    || !Array.isArray(response.items)) {\n  throw new Error(\"The contact page could not be loaded completely.\");\n}\n\nconst hasMore = flag(response.hasMore);\nconst pageOffset = integer(response.offset);\nconst pageCount = integer(response.count);\nconst pageLimit = integer(response.limit);\nif (hasMore === null || pageOffset !== state.offset || pageCount !== response.items.length\n    || pageLimit === null || pageLimit < 1 || pageLimit > state.pageSize || pageCount > pageLimit) {\n  throw new Error(\"The contact page has invalid pagination metadata.\");\n}\nif (hasMore && pageCount === 0) {\n  throw new Error(\"The contact paging response made no progress.\");\n}\nif (hasMore && state.pageCount + 1 >= 500) {\n  throw new Error(\"The complete contact list exceeds the safe paging limit.\");\n}\n\nfunction identifier(value) {\n  if (typeof value === \"number\") {\n    if (!Number.isSafeInteger(value) || value <= 0) {\n      throw new Error(\"The contact page contains an invalid identifier.\");\n    }\n    return String(value);\n  }\n  if (typeof value !== \"string\") {\n    throw new Error(\"The contact page contains an invalid identifier.\");\n  }\n  const result = value.trim();\n  if (!/^[0-9]{1,30}$/.test(result) || /^0+$/.test(result)) {\n    throw new Error(\"The contact page contains an invalid identifier.\");\n  }\n  return result;\n}\n\nfunction recordKey(row) {\n  return identifier(row.CitizenshipId);\n}\n\nconst keys = {};\nstate.rows.forEach(function (row) {\n  const key = recordKey(row);\n  if (key) keys[\"record:\" + key] = true;\n});\nconst rows = response.items.map(function (row) {\n  if (!row || typeof row !== \"object\" || Array.isArray(row)) {\n    throw new Error(\"The contact page contains an invalid record.\");\n  }\n  const rowPersonId = identifier(row.PersonId);\n  if (rowPersonId !== state.personId) {\n    throw new Error(\"The contact page does not match the selected employee.\");\n  }\n  const key = recordKey(row);\n  if (!key) throw new Error(\"A contact record has no stable identifier.\");\n  if (key && keys[\"record:\" + key]) {\n    throw new Error(\"The contact pages overlap. Please refresh the panel.\");\n  }\n  if (key) keys[\"record:\" + key] = true;\n  // Retain only fields used for subject checks, pagination, sorting, and display.\n  return {\n    CitizenshipId: key,\n    PersonId: rowPersonId,\n    Citizenship: row.Citizenship,\n    CitizenshipMeaning: row.CitizenshipMeaning,\n    CitizenshipStatusMeaning: row.CitizenshipStatusMeaning,\n    FromDate: row.FromDate,\n    ToDate: row.ToDate\n  };\n});\n\nreturn {\n  rows: state.rows.concat(rows),\n  offset: state.offset + pageCount,\n  pageSize: state.pageSize,\n  pageCount: state.pageCount + 1,\n  hasMore: hasMore,\n  personId: state.personId,\n  effectiveDate: state.effectiveDate\n};",
                    "returnType": "object",
                    "errorNodeId": "1781104087318"
                  },
                  "outcomes": {
                    "success": "1781104087307"
                  },
                  "inputs": [],
