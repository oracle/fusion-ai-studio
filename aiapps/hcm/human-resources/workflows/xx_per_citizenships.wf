        {
          "id": "1781104087308",
          "code": "SORT_CONTACT_RECORDS",
          "type": "CODE",
          "metadata": {
            "name": "Sort Contact Records",
            "sourceCode": "// Sort only after all pages are present. Date-only values never pass through a time zone.\nfunction dateKey(value) {\n  if (typeof value !== \"string\") return \"\";\n  const match = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(value.trim());\n  if (!match) return \"\";\n  const year = Number(match[1]);\n  const month = Number(match[2]);\n  const day = Number(match[3]);\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  return year >= 1 && month >= 1 && month <= 12 && day >= 1 && day <= days[month - 1]\n    ? match[0] : \"\";\n}\n\nconst state = $context.$variables.contactPaging;\nif (!state || state.hasMore !== false || !Array.isArray(state.rows) || state.pageCount < 1) {\n  throw new Error(\"The contact list is incomplete. Please refresh the panel.\");\n}\n\nconst ordered = state.rows.map(function (row, index) {\n  return {\n    row: row,\n    index: index,\n    date: dateKey(row.FromDate)\n  };\n}).sort(function (left, right) {\n  \n  if (left.date !== right.date) return left.date > right.date ? -1 : 1;\n  return left.index - right.index;\n}).map(function (entry) {\n  return entry.row;\n});\n\nreturn {\n  initialRecords: ordered,\n  additionalRecords: [],\n  hasAdditionalRecords: false\n};",
            "returnType": "object",
            "errorNodeId": "1781104087318"
          },
          "outcomes": {
            "success": "1781104087314"
          },
          "inputs": [],
          "diagram": {
            "x": 5675,
            "y": 6814
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
