            "returnType": "object",
            "sourceCode": "function reject() { throw new Error(\"The response did not match the permitted HR display contract.\"); }\nfunction text(v) {\n  if (typeof v !== \"string\" && typeof v !== \"number\") return \"\";\n  return String(v).replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]/g, \"\").trim()\n    .replace(/&(?!amp;|lt;|gt;|quot;|apos;|nbsp;)/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\");\n}\nfunction list(v) { if (!Array.isArray(v) || v.length > 1000) reject(); return v; }\nfunction image(id) { id = String(id == null ? \"\" : id); if (!id) return \"\"; if (!/^\\d{1,18}$/.test(id)) reject(); return \"/hcmUI/personImage?returnSquare=true&returnInitials=Y&removeBackground=Y&personId=\" + id + \"&maxSize=144&id=1779878994029&patternIndex=0\"; }\nfunction put(obj,key,value) { if (value !== \"\" && value != null) obj[key] = value; }\nlet displayIndex = 0;\nfunction display(pattern,properties,extra) { return {type:\"oraInfoDisplay\",key:\"xx_worker_reps-render_all_representatives_list-\"+(++displayIndex),payload:Object.assign({patternId:pattern},extra || {},{properties:properties})}; }\nfunction message(items,extra) { return display(\"messageListWidget\",{items:items},extra); }\nfunction personRows(rows,actions,kind) {\n  return list(rows).map(function(row,i) {\n    const item = {title:text(row.DisplayName) || (kind === \"direct\" ? \"\" : kind === \"representative\" ? \"Representative\" : \"Person\")};\n    if (kind === \"direct\") {\n      put(item,\"subtitle\",[row.JobName,row.DepartmentName,row.LocationName].map(text).filter(Boolean).join(\" | \"));\n      put(item,\"summary\",[row.WorkEmail,row.WorkPhone].map(text).filter(Boolean).join(\" | \"));\n      const dc = Number(row.DirectReportsCount), ac = Number(row.AllReportsCount);\n      if (Number.isFinite(dc) && Number.isFinite(ac) && (dc > 0 || ac > 0)) item.timestamp = \"Directs \" + dc + \" | Total \" + ac;\n    } else if (kind === \"representative\") {\n      put(item,\"subtitle\",text(row.ResponsibilityType));\n      put(item,\"summary\",[row.WorkEmail,row.WorkPhone].map(text).filter(Boolean).join(\" | \"));\n    } else if (kind === \"searchRepresentative\") {\n      put(item,\"subtitle\",text(row.ResponsibilityName)); put(item,\"badgeText\",text(row.ResponsibilityType));\n    } else {\n      put(item,\"subtitle\",text(row.JobName)); put(item,\"badgeText\",text(row.AssignmentNumber));\n      put(item,\"summary\",[row.DepartmentName,row.LocationName].map(text).filter(Boolean).join(\" - \"));\n    }\n    put(item,\"image\",image(row.PersonId));\n    if (row.PersonId) {\n      if (kind === \"direct\" || kind === \"representative\") {\n        const action = kind === \"direct\" ? \"selectDirect\" : \"selectRepresentative\";\n        item.action = 'ora.Invoke(' + JSON.stringify(action) + ', ' + JSON.stringify({actionId:action,personId:String(row.PersonId)}) + ')';\n      } else if (actions && actions[i]) item.action = actions[i];\n    }\n    return item;\n  });\n}\n\n\nlet blocks=[],visibleText=\"\";\nblocks=[message(personRows($context.$nodes.MERGE_ALL_REPRESENTATIVE_CONTACTS.$output.result.items,null,\"representative\"))];\n\n// Keep internal identifiers and executable commands outside the model context.\nconst references = {};\nlet referenceIndex = 0;\nfunction protect(value,key,parent) {\n  if (typeof value === \"string\" && ([\"action\",\"drillDownAction\",\"followUpCommand\",\"image\"].includes(key) || (key === \"id\" && /\\d/.test(value)) || (key === \"value\" && parent && [\"hidden\",\"system\"].includes(parent.type)))) {\n    const token = \"HR_REF_\" + (++referenceIndex);\n    references[token] = value;\n    return token;\n  }\n  if (Array.isArray(value)) return value.map(function(v) { return protect(v,\"\",null); });\n  if (value && typeof value === \"object\") {\n    const result = {};\n    Object.keys(value).forEach(function(k) { if ([\"__proto__\",\"prototype\",\"constructor\"].includes(k)) reject(); result[k] = protect(value[k],k,value); });\n    return result;\n  }\n  if (typeof value === \"string\" && /HR_REF_\\d+/.test(value)) reject();\n  return value;\n}\nconst contract = {blocks:blocks,text:visibleText};\nconst modelContract = protect(contract,\"\",null);\nconst modelJson = JSON.stringify(modelContract);\nif (modelJson.length > 1000000) reject();\nreturn {modelJson:modelJson,contract:modelContract,references:references};\n",
