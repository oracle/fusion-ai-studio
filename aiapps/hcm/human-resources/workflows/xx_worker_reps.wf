        {
          "id": "MERGE_TOP_REPRESENTATIVE_CONTACTS",
          "code": "MERGE_TOP_REPRESENTATIVE_CONTACTS",
          "type": "CODE",
          "metadata": {
            "name": "Merge Enrich Top Representative Contacts Sequentially",
            "returnType": "object",
            "sourceCode": "function parse(v){for(let i=0;i<3&&typeof v==='string';i+=1){try{v=JSON.parse(v)}catch(e){break}}return v}\nfunction text(v){return v==null?'':String(v).trim()}\nfunction collect(v,out){out=out||[];v=parse(v);if(Array.isArray(v)){v.forEach(function(x){collect(x,out)});return out}if(!v||typeof v!=='object')return out;if(text(v.PersonId||v.personId)){out.push(v);return out}['items','result','output','data'].forEach(function(k){if(v[k]!==undefined)collect(v[k],out)});return out}\nfunction byPerson(v){const index={};collect(v,[]).forEach(function(row){const id=text(row.PersonId||row.personId);if(id)index[id]=row});return index}\nconst representatives=collect($context.$nodes.GET_TOP_2_REPRESENTATIVES.$output,[]);\nconst contacts=byPerson($context.$nodes.ENRICH_TOP_REPRESENTATIVE_CONTACTS.$output);\nreturn {items:representatives.map(function(rep){const id=text(rep.PersonId||rep.personId);return Object.assign({},rep,contacts[id]||{})})};",
            "description": "Merges the completed contact-enrichment results with the original initial representative rows."
          },
          "outcomes": {
            "success": "PREPARE_SAFE_RENDER_WORKER_REPRESENTATIVES_LIST"
