                {
                  "id": "ALL_BUILD_ENRICHED_REPRESENTATIVE",
                  "code": "ALL_BUILD_ENRICHED_REPRESENTATIVE",
                  "type": "CODE",
                  "metadata": {
                    "name": "Build Additional Enriched Representative",
                    "returnType": "object",
                    "sourceCode": "function text(value) {\n  return value == null ? \"\" : String(value).trim();\n}\n\nfunction unpack(value) {\n  for (let depth = 0; depth < 12; depth += 1) {\n    if (typeof value === \"string\") {\n      try {\n        value = JSON.parse(value);\n      } catch (error) {\n        throw new Error(\"Representative contact response is not valid JSON.\");\n      }\n      continue;\n    }\n    if (!value || typeof value !== \"object\") return {};\n    if (value.error || value.timeout || value.isError ||\n        Number(value.statusCode || value.status || 0) >= 400) {\n      throw new Error(\"Representative contact lookup failed.\");\n    }\n    const wrapper = [\"output\", \"response\", \"result\", \"data\"].find(function (key) {\n      return value[key] !== undefined;\n    });\n    if (!wrapper) return value;\n    value = value[wrapper];\n  }\n  throw new Error(\"Representative contact response has too many wrappers.\");\n}\n\nfunction primaryWorkPhone(response, expectedPersonId) {\n  if (String(response.hasMore).toLowerCase() === \"true\") {\n    throw new Error(\"Representative phone response is incomplete.\");\n  }\n  if (!Array.isArray(response.items) || response.items.length > 1) {\n    throw new Error(\"Representative phone response has an unexpected worker count.\");\n  }\n  if (!response.items.length) return \"\";\n\n  const workerRow = response.items[0];\n  if (workerRow && workerRow.PersonId != null &&\n      text(workerRow.PersonId) !== expectedPersonId) {\n    throw new Error(\"Representative phone identity could not be verified.\");\n  }\n\n  // Native workflow responses wrap child phones in a paginated collection.\n  // Older flat-array responses remain supported.\n  const phoneChild = response.items[0].phones;\n  let phones;\n  if (Array.isArray(phoneChild)) {\n    phones = phoneChild;\n  } else {\n    const phoneCollection = unpack(phoneChild);\n    if (!Array.isArray(phoneCollection.items) ||\n        String(phoneCollection.hasMore).toLowerCase() === \"true\") {\n      throw new Error(\"Representative phone response is missing or incomplete.\");\n    }\n    phones = phoneCollection.items;\n  }\n\n  const today = new Date().toISOString().slice(0, 10);\n  const numbers = [];\n  phones.forEach(function (phone) {\n    if (phone && phone.PersonId != null &&\n        text(phone.PersonId) !== expectedPersonId) {\n      throw new Error(\"Representative phone identity could not be verified.\");\n    }\n    if (!phone || text(phone.PhoneType).toUpperCase() !== \"W1\" ||\n        !/^(true|y)$/i.test(text(phone.PrimaryFlag))) return;\n    const fromDate = text(phone.FromDate).slice(0, 10);\n    const toDate = text(phone.ToDate).slice(0, 10);\n    if ((fromDate && fromDate > today) || (toDate && toDate < today)) return;\n\n    const phoneNumber = text(phone.PhoneNumber).replace(/\\D/g, \"\");\n    if (!phoneNumber) return;\n    const number = text(phone.CountryCodeNumber).replace(/\\D/g, \"\") +\n      text(phone.AreaCode).replace(/\\D/g, \"\") + phoneNumber;\n    if (numbers.indexOf(number) === -1) numbers.push(number);\n  });\n\n  // Never choose a personal number or guess among distinct primary work numbers.\n  return numbers.length === 1 ? numbers[0] : \"\";\n}\n\nconst current = $context.$nodes.ENRICH_ALL_REPRESENTATIVE_CONTACTS.$currentItem || {};\nconst contact = unpack($context.$nodes.ENRICH_ALL_REPRESENTATIVE_CONTACTS.ALL_GET_REPRESENTATIVE_EMAIL.$output);\nconst expectedPersonId = text(current.PersonId);\nif (!expectedPersonId || text(contact.PersonId) !== expectedPersonId) {\n  throw new Error(\"Representative contact identity could not be verified.\");\n}\nconst phoneResponse = unpack($context.$nodes.ENRICH_ALL_REPRESENTATIVE_CONTACTS.ALL_GET_REPRESENTATIVE_PHONE.$output);\n\n// Keep the existing row contract and the Organization panel's digit-only format.\nreturn Object.assign({}, current, {\n  WorkEmail: text(contact.WorkEmail),\n  WorkPhone: primaryWorkPhone(phoneResponse, expectedPersonId)\n});",
                    "description": "Merges matching work email and work phone into the current additional-list representative row."
                  },
                  "outcomes": {
                    "success": "enrich_all_representative_contacts_end"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
