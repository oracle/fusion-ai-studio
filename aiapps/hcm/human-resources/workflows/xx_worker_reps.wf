        {
          "id": "VALIDATE_REQUEST_GET_SELECTION_ADDITIONAL_REPRESENTATIVES",
          "code": "VALIDATE_REQUEST_GET_SELECTION_ADDITIONAL_REPRESENTATIVES",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get Selection Additional Representatives",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\nfunction page(value,name,min,max) {\n  if(typeof value!==\"number\" && typeof value!==\"string\") reject(name);\n  if(typeof value===\"string\" && !/^[0-9]{1,7}$/.test(value.trim())) reject(name);\n  const number=Number(value);if(!Number.isSafeInteger(number)||number<min||number>max) reject(name);return number;\n}\n\nconst checked={};\nchecked[\"personId\"]=id(($context.$nodes.VALIDATE_SELECTION_SOURCE_ASSIGNMENT.$output.result.personId),\"personId\");\nchecked[\"assignmentId\"]=id(($context.$nodes.VALIDATE_SELECTION_SOURCE_ASSIGNMENT.$output.result.assignmentId),\"assignmentId\");\nchecked[\"limit\"]=page(\"100\",\"limit\",1,500);\nchecked[\"offset\"]=page(\"2\",\"offset\",0,1000000);\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
