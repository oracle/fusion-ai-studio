        {
          "id": "1780052761777",
          "code": "PARSE_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Parse Payload",
            "returnType": "object",
            "sourceCode": "const maxPayloadLength = 16384;\n\nconst parseObject = function (value) {\n  if (typeof value === \"string\") {\n    if (!value.length || value.length > maxPayloadLength) return null;\n    try { value = JSON.parse(value); } catch (e) { return null; }\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) return null;\n  let serialized;\n  try { serialized = JSON.stringify(value); } catch (e) { return null; }\n  if (typeof serialized !== \"string\" || serialized.length > maxPayloadLength) return null;\n  let count = 0;\n  function safeKeys(object, depth) {\n    if (++count > 1000 || depth > 12) return false;\n    if (!object || typeof object !== \"object\") return true;\n    return Object.keys(object).every(function (key) {\n      return [\"__proto__\", \"constructor\", \"prototype\"].indexOf(key) === -1 && safeKeys(object[key], depth + 1);\n    });\n  }\n  return safeKeys(value, 0) ? value : null;\n};\nconst normalizePersonId = function (value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : null;\n  if (typeof value !== \"string\") return null;\n  const trimmed = value.trim();\n  return /^[1-9][0-9]{0,19}$/.test(trimmed) && Number.isSafeInteger(Number(trimmed)) ? trimmed : null;\n};\nconst actionContext = parseObject($context?.$app?.$OraAction);\nif (!actionContext || actionContext.actionId !== \"selectRepresentative\" ||\n    Object.keys(actionContext).some(function (key) { return [\"actionId\", \"personId\"].indexOf(key) === -1; })) {\n  throw new Error(\"Invalid representative selection.\");\n}\nconst personId = normalizePersonId(actionContext.personId);\nif (!personId) throw new Error(\"Invalid representative selection.\");\nreturn { actionId: \"selectRepresentative\", personId: personId, showMorePayload: null };\n",
            "errorNodeId": "RETURN_UNVERIFIED_REPRESENTATIVES",
            "description": "Accepts only a selectRepresentative action with one normalized positive person ID before verifying membership."
          },
