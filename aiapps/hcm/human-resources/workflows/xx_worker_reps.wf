                {
                  "id": "VALIDATE_REQUEST_QUERY_GET_REPRESENTATIVE_EMAIL",
                  "code": "VALIDATE_REQUEST_QUERY_GET_REPRESENTATIVE_EMAIL",
                  "type": "CODE",
                  "metadata": {
                    "name": "Validate Request Query Get Representative Email",
                    "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
                    "returnType": "object",
                    "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\n\nconst checked={};\nchecked[\"personId\"]=id(($context.$nodes.ENRICH_QUERY_REPRESENTATIVE_CONTACTS.$currentItem.PersonId),\"personId\");\nreturn checked;",
                    "errorNodeId": "HR_REQUEST_REJECTED"
