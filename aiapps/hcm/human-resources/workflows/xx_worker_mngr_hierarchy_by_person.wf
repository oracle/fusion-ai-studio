          "code": "GET_WORKER_CONNECTIONS",
          "type": "BO_FUNCTION",
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_EMPLOYMENTGHR",
            "functionName": "GetWorkerConnections",
            "name": "Get Worker Connections",
            "description": "Returns worker connection records for the supplied person and assignment, including line-manager hierarchy relationships."
          },
          "outcomes": {
            "success": "1777368656803"
          },
          "inputs": [
            {
              "id": "1777368572503_1",
              "name": "personId",
              "type": "integer",
              "value": "{{$context.$nodes.VALIDATE_REQUEST_GET_WORKER_CONNECTIONS.$output.result.personId}}",
              "required": true
            },
            {
              "id": "1777368572503_2",
              "name": "assignmentId",
              "type": "integer",
              "value": "{{$context.$nodes.VALIDATE_REQUEST_GET_WORKER_CONNECTIONS.$output.result.assignmentId}}",
