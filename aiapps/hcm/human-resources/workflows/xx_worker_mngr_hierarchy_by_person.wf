        {
          "id": "1777368656803",
          "code": "WORKER_CONNECTIONS_TRANSFORM",
          "type": "CODE",
          "metadata": {
            "name": "Worker Connections Transform",
            "returnType": "array",
            "sourceCode": "const input = $context.$triggers.REST.$input || {};\nconst data = $context.$nodes.GET_WORKER_CONNECTIONS.$output?.items;\nconst items = Array.isArray(data) ? data : [];\nconst personId = Number(input.personId);\n\nif (!Number.isFinite(personId)) {\n  return [];\n}\n\nconst filteredList = items.filter((obj) =>\n  Number(obj?.PersonId) === personId && obj?.RelationshipType === \"LINE_MANAGER\"\n);\n\nfilteredList.sort((a, b) => Number(b?.Level ?? 0) - Number(a?.Level ?? 0));\n\nreturn filteredList.map((obj) => ({\n  DisplayName: obj?.RelatedDisplayName ?? \"\",\n  ManagerPersonId: obj?.RelatedPersonId ?? null,\n  ManagerAssignmentId: obj?.RelatedPersonAssignmentId ?? null,\n  RelationshipType: obj?.RelationshipType ?? \"\",\n  RelationshipTypeMeaning: \"Line Manager\",\n  Level: obj?.Level ?? 0\n}));"
          },
          "outcomes": {
            "success": "1777368521121"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5000,
            "y": 6982
          }
        },
        {
          "id": "VALIDATE_REQUEST_GET_WORKER_PRIMARY_ASSIGNMENT",
          "code": "VALIDATE_REQUEST_GET_WORKER_PRIMARY_ASSIGNMENT",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get Worker Primary Assignment",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\n\nconst checked={};\nchecked[\"personId\"]=id(($context.$triggers.REST.$input.personId),\"personId\");\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1777368447477"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5450,
            "y": 5650
          }
        },
        {
          "id": "VALIDATE_REQUEST_GET_WORKER_CONNECTIONS",
          "code": "VALIDATE_REQUEST_GET_WORKER_CONNECTIONS",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get Worker Connections",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\n\nconst checked={};\nchecked[\"personId\"]=id(($context.$triggers.REST.$input.personId),\"personId\");\nchecked[\"assignmentId\"]=id(($context.$nodes.GET_ASSIGNMENTID.$output.result),\"assignmentId\");\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1777368546973"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5000,
            "y": 6538
          }
        },
