        {
          "id": "1777878988623",
          "code": "GET_QUERY_TYPE",
          "type": "CODE",
          "metadata": {
            "name": "Get Query Type",
            "returnType": "string",
            "sourceCode": "const input=$context.$triggers.REST.$input || {};\nconst present=function(value){return value!==null && value!==undefined && String(value).trim()!==\"\";};\nif(!present(input.personId)) throw new Error(\"A personId is required to verify assignment ownership before reading history.\");\nreturn \"PersonId\";",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1777879057307"
          },
          "inputs": [],
          "diagram": {
            "x": 5450,
            "y": 5206
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1777879057307",
          "code": "SWITCH_QUERY",
          "type": "CONDITION",
          "metadata": {
            "name": "Switch Query"
          },
          "outcomes": {
