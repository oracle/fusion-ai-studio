        {
          "id": "VALIDATE_REQUEST_GET_WORKER_ASSIGNMENT_HISTORY",
          "code": "VALIDATE_REQUEST_GET_WORKER_ASSIGNMENT_HISTORY",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get Worker Assignment History",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\nfunction date(value,name) {\n  if(typeof value!==\"string\" || !/^\\d{4}-\\d{2}-\\d{2}$/.test(value) || value<\"1900-01-01\" || value>\"9999-12-31\") reject(name);\n  const parsed=new Date(value+\"T00:00:00Z\");if(!Number.isFinite(parsed.getTime()) || parsed.toISOString().slice(0,10)!==value) reject(name);return value;\n}\n\nconst checked={};\nchecked[\"assignmentId\"]=id(($context.$nodes.GET_PAYLOAD.$output.result.assignmentId),\"assignmentId\");\nchecked[\"effectiveDate\"]=date(($context.$nodes.GET_PAYLOAD.$output.result.effectiveDate),\"effectiveDate\");\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1777457051049"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
