            "false": "1777456888914"
          },
          "inputs": [
            {
              "id": "1777879057309_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.GET_QUERY_TYPE.$output.result==\"PersonId\"}}"
            }
          ],
          "diagram": {
