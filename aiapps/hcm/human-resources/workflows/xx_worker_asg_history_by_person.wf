            "y": 5428
          },
          "convergenceTargetId": "1777456888914"
        },
        {
          "id": "VALIDATE_REQUEST_GET_WORKER_PRIMARY_ASSIGNMENT",
          "code": "VALIDATE_REQUEST_GET_WORKER_PRIMARY_ASSIGNMENT",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get Worker Primary Assignment",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\n\nconst checked={};\nchecked[\"personId\"]=id(($context.$triggers.REST.$input.personId),\"personId\");\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1777456829024"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5000,
            "y": 5650
          }
        },
        {
          "id": "1777456829024",
          "code": "GET_WORKER_PRIMARY_ASSIGNMENT",
          "type": "BO_FUNCTION",
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_EMPLOYMENTGHR",
            "functionName": "GetAssignmentInformationByPerson",
            "name": "Get Worker Primary Assignment",
            "description": "Returns worker assignment rows for the supplied person so the workflow can select the primary assignment locally."
          },
          "outcomes": {
            "success": "1777456888914"
          },
          "inputs": [
            {
              "id": "1777456829024_personId",
              "name": "personId",
              "value": "{{$context.$nodes.VALIDATE_REQUEST_GET_WORKER_PRIMARY_ASSIGNMENT.$output.result.personId}}",
              "required": true,
              "type": "integer"
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 5872
          },
          "convergenceTargetId": "1777879107769",
          "outputSpecification": "{}"
        },
        {
          "id": "1777456888914",
          "code": "GET_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Get Payload",
            "returnType": "object",
            "sourceCode": "function id(v){const text=String(v==null?\"\":v).trim();if(!/^[1-9][0-9]{0,15}$/.test(text)||!Number.isSafeInteger(Number(text)))throw new Error(\"Invalid assignment ownership identifiers.\");return text;}\nconst input=$context.$triggers.REST.$input || {};\nconst personId=id(input.personId);\nconst response=$context.$nodes.GET_WORKER_PRIMARY_ASSIGNMENT.$output;\nif(!response || response.error || response.timeout || response.isError || Number(response.statusCode||response.status||0)>=400 || !Array.isArray(response.items) || !response.items.length)throw new Error(\"The worker's primary assignment could not be verified.\");\nconst row=response.items[0];\nif(!row || (row.PersonId!=null && id(row.PersonId)!==personId))throw new Error(\"Assignment does not belong to this worker.\");\nconst assignmentId=id(row.AssignmentId);\nif(input.assignmentId!=null && String(input.assignmentId).trim()!==\"\" && id(input.assignmentId)!==assignmentId)throw new Error(\"The requested assignment is not the worker's current primary assignment.\");\nreturn {assignmentId:assignmentId,effectiveDate:$context.$system.$currentDate || new Date().toISOString().slice(0,10)};",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1777879057308"
          },
          "inputs": [],
          "diagram": {
            "x": 5450,
            "y": 6094
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1777879057308",
          "code": "HAS_ASSIGNMENT_ID",
          "type": "CONDITION",
          "metadata": {
            "name": "Has Assignment Id"
          },
