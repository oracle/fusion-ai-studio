        {
          "id": "GET_ASSIGNMENTS",
          "code": "GET_ASSIGNMENTS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Worker Assignments",
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_EMPLOYMENTGHR",
            "functionName": "GetAssignmentInformationByPerson"
          },
          "outcomes": {
            "success": "SELECT_PRIMARY_ASSIGNMENT"
          },
          "inputs": [
            {
              "id": "GET_ASSIGNMENTS_personId",
              "name": "personId",
              "type": "integer",
              "value": "{{$context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId}}",
