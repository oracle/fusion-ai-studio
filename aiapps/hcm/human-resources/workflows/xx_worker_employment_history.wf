        {
          "id": "1791555257113",
          "code": "GET_VIEWER_DATE_FORMAT",
          "type": "CODE",
          "metadata": {
            "name": "Get Viewer Date Format",
            "sourceCode": "// Date-only values must never be converted through a time zone.\nfunction parse(value) {\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return null;\n    }\n  }\n  return value;\n}\n\nfunction collection(value) {\n  var response = parse(value);\n\n  if (\n    !response ||\n    response.error ||\n    response.timeout ||\n    response.isError ||\n    Number(response.statusCode || response.status || 0) >= 400 ||\n    String(response.hasMore).toLowerCase() === \"true\" ||\n    !Array.isArray(response.items)\n  ) {\n    return [];\n  }\n\n  return response.items;\n}\n\nvar sessions = collection($context.$nodes.READ_VIEWER_SESSION?.$output);\nvar session = sessions.length === 1 && sessions[0] ? sessions[0] : {};\nvar preference = typeof session.DateFormat === \"string\"\n  ? session.DateFormat.trim()\n  : \"\";\nvar language = String(session.Language || session.DefaultLanguage || \"\").toLowerCase();\nvar country = typeof session.Territory === \"string\"\n  ? session.Territory.trim().toUpperCase()\n  : \"\";\n\n// Match the Performance Goals fallback using only the authenticated viewer.\nvar viewerId = $context.$nodes.RESOLVE_VIEWER_DATE_CONTEXT.$output.result.viewerPersonId;\n\nif (!country && viewerId) {\n  var countries = [];\n\n  collection($context.$nodes.GET_VIEWER_WORK_ASSIGNMENT?.$output).forEach(function (row) {\n    if (!row || (row.PersonId != null && String(row.PersonId).trim() !== viewerId)) return;\n    if (row.PrimaryFlag != null && !/^(true|y)$/i.test(String(row.PrimaryFlag))) return;\n\n    var value = typeof row.LocationCountry === \"string\"\n      ? row.LocationCountry.trim().toUpperCase()\n      : \"\";\n\n    if (countries.indexOf(value) < 0) countries.push(value);\n  });\n\n  if (countries.length === 1) country = countries[0];\n}\n\nvar monthNames = [\n  \"January\", \"February\", \"March\", \"April\", \"May\", \"June\",\n  \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"\n];\n\nfunction preferenceFormat(parts) {\n  if (!preference || preference.length > 80) return null;\n\n  var tokens = preference.match(\n    /yyyy|YYYY|yy|YY|MMMM|MMM|MM|M|dd|DD|d|D|[\\s/.,-]+/g\n  );\n\n  if (!tokens || tokens.join(\"\") !== preference) return null;\n\n  var dateTokens = tokens.filter(function (token) {\n    return /[yYMdD]/.test(token);\n  });\n\n  if (\n    dateTokens.length !== 3 ||\n    dateTokens.filter(function (token) { return /^[yY]/.test(token); }).length !== 1 ||\n    dateTokens.filter(function (token) { return /^M/.test(token); }).length !== 1 ||\n    dateTokens.filter(function (token) { return /^[dD]/.test(token); }).length !== 1\n  ) {\n    return null;\n  }\n\n  if (preference.indexOf(\"MMM\") >= 0 && !/^en(?:[-_]|$)/.test(language)) {\n    return null;\n  }\n\n  return tokens.map(function (token) {\n    if (/^(yyyy|YYYY)$/.test(token)) return parts[1];\n    if (/^(yy|YY)$/.test(token)) return parts[1].slice(-2);\n    if (token === \"MMMM\") return monthNames[Number(parts[2]) - 1];\n    if (token === \"MMM\") return monthNames[Number(parts[2]) - 1].slice(0, 3);\n    if (token === \"MM\") return parts[2];\n    if (token === \"M\") return String(Number(parts[2]));\n    if (/^(dd|DD)$/.test(token)) return parts[3];\n    if (/^(d|D)$/.test(token)) return String(Number(parts[3]));\n    return token;\n  }).join(\"\");\n}\n\nfunction formatDate(value) {\n  if (value == null || value === \"\") return \"\";\n  if (typeof value !== \"string\") return value;\n\n  var parts = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(value);\n  if (!parts) return value;\n\n  var year = Number(parts[1]);\n  var month = Number(parts[2]);\n  var day = Number(parts[3]);\n  var leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\n  var days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n\n  if (year < 1 || month < 1 || month > 12 || day < 1 || day > days[month - 1]) {\n    return value;\n  }\n\n  var preferred = preferenceFormat(parts);\n  if (preferred !== null) return preferred;\n\n  if (country === \"US\") return parts[2] + \"/\" + parts[3] + \"/\" + parts[1];\n  if ([\"IN\", \"GB\", \"UK\", \"AU\", \"SG\"].indexOf(country) >= 0) {\n    return parts[3] + \"/\" + parts[2] + \"/\" + parts[1];\n  }\n\n  return value;\n}\n\n\n// Keep the original prepared records and raw dates unchanged for query and sorting.\nconst prepared = $context.$nodes.BUILD_EMPLOYMENT_HISTORY.$output.result || {};\n\nfunction records(value) {\n  if (Array.isArray(value)) return value;\n  if (Array.isArray(value?.items)) return value.items;\n  if (typeof value?.output === \"string\") {\n    try {\n      return records(JSON.parse(value.output));\n    } catch (error) {\n      return [];\n    }\n  }\n  if (Array.isArray(value?.result?.items)) return value.result.items;\n  if (Array.isArray(value?.result)) return value.result;\n  return [];\n}\n\nfunction firstDate() {\n  for (var i = 0; i < arguments.length; i += 1) {\n    var value = arguments[i];\n    if (value != null && String(value).trim()) return String(value).trim();\n  }\n  return \"\";\n}\n\nconst original = records($context.$nodes.GET_ASSIGNMENT_HISTORY?.$output);\nconst result = Object.assign({}, prepared);\n\nresult.records = (Array.isArray(prepared.records) ? prepared.records : []).map(function (record, index) {\n  var row = original[index] || {};\n  var start = firstDate(row.EffectiveStartDate, row.StartDate, row.DateStart);\n  var end = firstDate(row.EffectiveEndDate, row.EndDate);\n  var display = Object.assign({}, record);\n\n  display.startDateDisplay = formatDate(start);\n  display.endDateDisplay = end.indexOf(\"4712-12-31\") === 0\n    ? \"Current\"\n    : formatDate(end);\n\n  return display;\n});\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
