        {
          "id": "BUILD_EMPLOYMENT_HISTORY",
          "code": "BUILD_EMPLOYMENT_HISTORY",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Employment History",
            "returnType": "object",
            "sourceCode": "const assignment = $context.$nodes.SELECT_PRIMARY_ASSIGNMENT.$output?.result?.assignment || {};\nfunction rows(value) {\n  if (Array.isArray(value)) return value;\n  if (Array.isArray(value?.items)) return value.items;\n  if (typeof value?.output === \"string\") { try { return rows(JSON.parse(value.output)); } catch (e) { return []; } }\n  if (Array.isArray(value?.result?.items)) return value.result.items;\n  if (Array.isArray(value?.result)) return value.result;\n  return [];\n}\nfunction text() { for (let i = 0; i < arguments.length; i += 1) { const value = arguments[i]; if (value !== null && value !== undefined && String(value).trim()) return String(value).trim(); } return \"Not available\"; }\nfunction date(value) { const textValue = text(value); return textValue === \"Not available\" ? textValue : textValue.slice(0, 10); }\nfunction endDate(value) { const valueText = text(value); return valueText === \"Not available\" || valueText.indexOf(\"4712-12-31\") === 0 ? \"Current\" : valueText.slice(0, 10); }\nfunction normalize(row, future) {\n  return {\n    personDisplayName: text(row.PersonDisplayName, row.DisplayName, row.WorkerDisplayName, assignment.PersonDisplayName, assignment.DisplayName, assignment.PersonName),\n    businessTitle: text(row.BusinessTitle, row.AssignmentName, row.JobName, row.Job),\n    assignment: text(row.AssignmentName, row.AssignmentNumber),\n    job: text(row.JobName, row.Job),\n    position: text(row.PositionName, row.Position),\n    department: text(row.DepartmentName, row.Department),\n    businessUnit: text(row.BusinessUnitName, row.BusinessUnit, assignment.BusinessUnitName, assignment.BusinessUnit),\n    \"location\": text(row.LocationName, row.Location),\n    manager: text(row.ManagerName, row.ManagerDisplayName),\n    legalEmployer: text(row.LegalEmployerName, row.LegalEmployer),\n    workerType: text(row.WorkerType, row.AssignmentType),\n    startDate: date(row.EffectiveStartDate, row.StartDate, row.DateStart),\n    endDate: endDate(row.EffectiveEndDate, row.EndDate),\n    action: text(row.ActionName, row.Action, row.ActionCode),\n    actionReason: text(row.ActionReasonName, row.ActionReason, row.ActionReasonCode),\n    future: future === true\n  };\n}\nconst history = rows($context.$nodes.GET_ASSIGNMENT_HISTORY.$output).map(function (row) { return normalize(row, false); });\nconst future = [];\nconst records = history;\nreturn {\n  employee: {\n    name: text(assignment.PersonDisplayName, assignment.DisplayName, assignment.PersonName),\n    businessTitle: text(assignment.BusinessTitle, assignment.AssignmentName, assignment.JobName),\n    department: text(assignment.DepartmentName, assignment.Department),\n    \"location\": text(assignment.LocationName, assignment.Location),\n    manager: text(assignment.ManagerName, assignment.ManagerDisplayName),\n    legalEmployer: text(assignment.LegalEmployerName, assignment.LegalEmployer),\n    workerType: text(assignment.WorkerType, assignment.AssignmentType)\n  },\n  records: records,\n  historyCount: history.length,\n  futureCount: future.length\n};"
          },
          "outcomes": {
            "success": "ROUTE_RESPONSE"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
