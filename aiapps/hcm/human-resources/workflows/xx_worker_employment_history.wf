        },
        {
          "id": "SELECT_PRIMARY_ASSIGNMENT",
          "code": "SELECT_PRIMARY_ASSIGNMENT",
          "type": "CODE",
          "metadata": {
            "name": "Select Primary Assignment",
            "returnType": "object",
            "sourceCode": "// Validate values before they become finder parameters. This does not grant access.\nfunction fail() { throw new Error(\"Employment assignment data could not be validated.\"); }\nfunction identifier(value) {\n  if (typeof value === \"number\") {\n    if (!Number.isSafeInteger(value) || value <= 0) fail();\n    return String(value);\n  }\n  if (typeof value !== \"string\" || !/^[1-9][0-9]{0,29}$/.test(value.trim())) fail();\n  return value.trim();\n}\nconst expectedPersonId = identifier($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId);\nconst response = $context.$nodes.GET_ASSIGNMENTS.$output;\nif (!response || typeof response !== \"object\" || Array.isArray(response) ||\n    response.error || response.timeout || response.isError ||\n    Number(response.statusCode || 0) >= 400 || !Array.isArray(response.items)) fail();\nconst rows = response.items;\nrows.forEach(function (row) {\n  if (!row || typeof row !== \"object\" || Array.isArray(row)) fail();\n  // PersonId is optional in this response; reject a mismatch whenever supplied.\n  if (row.PersonId != null && identifier(row.PersonId) !== expectedPersonId) fail();\n  const assignmentId = identifier(row.AssignmentId == null ? row.assignmentId : row.AssignmentId);\n  if (row.AssignmentId != null && row.assignmentId != null && identifier(row.assignmentId) !== assignmentId) fail();\n});\nconst effectiveDate = $context.$system.$currentDate;\nconst parts = typeof effectiveDate === \"string\" && /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(effectiveDate);\nif (!parts) fail();\nconst year = Number(parts[1]), month = Number(parts[2]), day = Number(parts[3]);\nconst leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\nconst days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\nif (year < 1 || month < 1 || month > 12 || day < 1 || day > days[month - 1]) fail();\nfunction text(value) { return typeof value === \"string\" ? value.trim() : value == null ? \"\" : String(value).trim(); }\nconst primary = rows.find(function (row) { return row.PrimaryAssignmentFlag === true || text(row.PrimaryAssignmentFlag).toUpperCase() === \"Y\" || text(row.AssignmentStatusType).toUpperCase() === \"ACTIVE\"; }) || rows[0] || {};\nreturn { assignmentId: rows.length ? identifier(primary.AssignmentId == null ? primary.assignmentId : primary.AssignmentId) : \"\", assignment: primary, effectiveDate: effectiveDate };\n"
          },
          "outcomes": {
            "success": "HAS_ASSIGNMENT_ID"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
