        },
        {
          "id": "1788348100100",
          "code": "GENERATE_EMPLOYMENT_CHANGE_URLS",
          "type": "CODE",
          "metadata": {
            "description": "Creates Manager Change, Change Location, and Promote Redwood deep links from a worker’s primary assignment details.",
            "name": "Generate Employment Change URLs",
            "returnType": "object",
            "sourceCode": "const response = $context?.$nodes?.GET_ASSIGNMENT_HISTORY?.$output;\n\nconst assignments = Array.isArray(response?.items) ? response.items : [];\n\nconst assignment =\n  assignments.find(function (item) {\n    return item?.EffectiveLatestChange === \"Y\";\n  }) ||\n  assignments[0] ||\n  null;\n\nconst normalizeString = function (value) {\n  if (value === null || value === undefined) return null;\n\n  const trimmed = String(value).trim();\n  return trimmed ? trimmed : null;\n};\n\nconst getOrigin = function (links) {\n  if (!Array.isArray(links)) return null;\n\n  const selfLink = links.find(function (link) {\n    return link?.rel === \"self\" && typeof link?.href === \"string\";\n  });\n\n  if (!selfLink) return null;\n\n  const match = selfLink.href.match(\n    /https:\\/\\/[A-Za-z0-9.-]+(?::[0-9]{1,5})?/\n  );\n\n  return match ? match[0] : null;\n};\n\nconst encodeParameter = function (value) {\n  return encodeURIComponent(String(value))\n    .replace(/'/g, \"%27\")\n    .replace(/!/g, \"%21\")\n    .replace(/\\(/g, \"%28\")\n    .replace(/\\)/g, \"%29\")\n    .replace(/\\*/g, \"%2A\");\n};\n\nconst origin = getOrigin(response?.links);\n\nconst assignmentId = normalizeString(assignment?.AssignmentId);\nconst assignmentNumber = normalizeString(assignment?.AssignmentNumber);\nconst personId = normalizeString(assignment?.PersonId);\nconst personNumber = normalizeString(assignment?.PersonNumber);\nconst displayName = normalizeString(assignment?.PersonDisplayName);\n\nconst businessTitle =\n  normalizeString(assignment?.AssignmentName) ||\n  normalizeString(assignment?.Job) ||\n  assignmentNumber;\n\nconst effectiveDate = \"2026-09-01\";\nconst navigationContext = \"'MyClientGroups'\";\n\nconst createUrl = function (action) {\n  if (\n    !origin ||\n    !assignmentId ||\n    !assignmentNumber ||\n    !businessTitle ||\n    !displayName ||\n    !personId ||\n    !personNumber\n  ) {\n    return null;\n  }\n\n  const parameters =\n    action === \"location\"\n      ? [\n          [\"pAssignmentNumber\", assignmentNumber],\n          [\"pAssignmentId\", assignmentId]\n        ]\n      : [\n          [\"pAssignmentId\", assignmentId],\n          [\"pAssignmentNumber\", assignmentNumber]\n        ];\n\n  parameters.push(\n    [\"pBusinessTitle\", businessTitle],\n    [\"pDisplayName\", displayName],\n    [\"pEffectiveDate\", effectiveDate],\n    [\"pNavContext\", navigationContext],\n    [\"pPersonId\", personId],\n    [\"pPersonNumber\", personNumber]\n  );\n\n  const queryString = parameters\n    .map(function (parameter) {\n      return (\n        encodeParameter(parameter[0]) +\n        \"=\" +\n        encodeParameter(parameter[1])\n      );\n    })\n    .join(\"&\");\n\n  return (\n    origin +\n    \"/fscmUI/redwood/employment-change/update/\" +\n    action +\n    \"?\" +\n    queryString\n  );\n};\n\nreturn {\n  changeManagerURL: createUrl(\"manager\"),\n  changeLocationURL: createUrl(\"location\"),\n  promoteURL: createUrl(\"promote\")\n};"
          },
          "diagram": {
