          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentNumber\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentName\": {\n            \"type\": \"string\"\n          },\n          \"LegalEmployerName\": {\n            \"type\": \"string\"\n          },\n          \"StartDate\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryFlag\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryAssignmentFlag\": {\n            \"type\": \"string\"\n          },\n          \"WorkerType\": {\n            \"type\": \"string\"\n          },\n          \"WorkerNumber\": {\n            \"type\": \"string\"\n          },\n          \"ManagerName\": {\n            \"type\": \"string\"\n          },\n          \"BusinessUnitName\": {\n            \"type\": \"string\"\n          },\n          \"DepartmentName\": {\n            \"type\": \"string\"\n          },\n          \"JobCode\": {\n            \"type\": \"string\"\n          },\n          \"JobName\": {\n            \"type\": \"string\"\n          },\n          \"PositionCode\": {\n            \"type\": \"string\"\n          },\n          \"PositionName\": {\n            \"type\": \"string\"\n          },\n          \"LocationCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationName\": {\n            \"type\": \"string\"\n          },\n          \"GradeCode\": {\n            \"type\": \"string\"\n          },\n          \"GradeName\": {\n            \"type\": \"string\"\n          },\n          \"LocationPostalCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationCountry\": {\n            \"type\": \"string\"\n          },\n          \"LengthOfServiceYears\": {\n            \"type\": \"string\"\n          },\n          \"MarkedAsFavoriteFlag\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"PersonId\",\n          \"AssignmentId\",\n          \"AssignmentNumber\",\n          \"AssignmentName\",\n          \"LegalEmployerName\",\n          \"StartDate\",\n          \"PrimaryFlag\",\n          \"PrimaryAssignmentFlag\",\n          \"WorkerType\",\n          \"WorkerNumber\",\n          \"ManagerName\",\n          \"BusinessUnitName\",\n          \"DepartmentName\",\n          \"JobCode\",\n          \"JobName\",\n          \"PositionCode\",\n          \"PositionName\",\n          \"LocationCode\",\n          \"LocationName\",\n          \"GradeCode\",\n          \"GradeName\",\n          \"LocationPostalCode\",\n          \"LocationCountry\",\n          \"LengthOfServiceYears\",\n          \"MarkedAsFavoriteFlag\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "1791887485647",
          "code": "VALIDATE_EMPLOYMENT_HISTORY_RENDERING",
          "type": "CODE",
          "metadata": {
            "name": "Validate Employment History Rendering",
            "returnType": "string",
            "sourceCode": "const prepared = $context.$nodes.GET_VIEWER_DATE_FORMAT.$output?.result;\nconst output = $context.$nodes.RENDER_EMPLOYMENT_HISTORY.$output;\nconst rendered = typeof output === \"string\"\n  ? output\n  : output && typeof output.result === \"string\"\n    ? output.result\n    : null;\n\nif (!prepared || !Array.isArray(prepared.records) || rendered === null) {\n  throw new Error(\"Unable to validate employment history rendering\");\n}\n\nconst columns = [\"Business Title\", \"Start Date\", \"End Date\", \"Business Unit\", \"Legal Employer\", \"Location\"];\nconst orderedRecords = prepared.records.map(function (record, index) {\n  return { record: record, index: index };\n});\n\norderedRecords.sort(function (left, right) {\n  const leftDate = String(left.record.startDate ?? \"\");\n  const rightDate = String(right.record.startDate ?? \"\");\n  return rightDate.localeCompare(leftDate) || left.index - right.index;\n});\n\nconst rows = orderedRecords.map(function (entry) {\n  const record = entry.record;\n  return {\n    cells: [\n      record.businessTitle,\n      record.startDateDisplay,\n      record.endDateDisplay,\n      record.businessUnit,\n      record.legalEmployer,\n      record.location\n    ]\n  };\n});\n\nconst widget = { patternId: \"multiRecordWidget\", properties: { cols: columns, rows: rows } };\nconst prefix = '<oraInfoDisplay key=\"summary\">';\nconst suffix = \"</oraInfoDisplay>\";\nconst markup = rendered.trim();\n\nif (!markup.startsWith(prefix) || !markup.endsWith(suffix)) {\n  throw new Error(\"Employment history renderer returned invalid markup\");\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(markup.slice(prefix.length, markup.length - suffix.length));\n} catch (error) {\n  throw new Error(\"Employment history renderer returned invalid JSON\");\n}\n\nfunction exactKeys(value, keys) {\n  return value && typeof value === \"object\" && !Array.isArray(value) &&\n    Object.keys(value).sort().join(\",\") === keys.slice().sort().join(\",\");\n}\n\nif (\n  !exactKeys(parsed, [\"patternId\", \"properties\"]) ||\n  parsed.patternId !== widget.patternId ||\n  !exactKeys(parsed.properties, [\"cols\", \"rows\"]) ||\n  JSON.stringify(parsed.properties.cols) !== JSON.stringify(columns) ||\n  !Array.isArray(parsed.properties.rows) ||\n  parsed.properties.rows.length !== rows.length ||\n  parsed.properties.rows.some(function (row, index) {\n    return !exactKeys(row, [\"cells\"]) ||\n      JSON.stringify(row.cells) !== JSON.stringify(rows[index].cells);\n  })\n) {\n  throw new Error(\"Employment history renderer output failed validation\");\n}\n\nconst safeJson = JSON.stringify(widget)\n  .replace(/&/g, \"\\\\u0026\")\n  .replace(/</g, \"\\\\u003C\")\n  .replace(/>/g, \"\\\\u003E\");\n\nreturn '<oraInfoDisplay key=\"summary\">' + safeJson + '</oraInfoDisplay>';"
          },
          "outcomes": {
            "success": "1791887485649"
          },
