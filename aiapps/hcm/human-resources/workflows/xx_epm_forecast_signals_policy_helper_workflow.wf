    "humanApprovalFlag": false,
    "waitFlag": false,
    "triggers": [
      {
        "type": "CAPABILITY",
        "inputs": [
          {
            "name": "runWorkforcePolicyAnalysis",
            "description": "Applies the approved workforce policy to a batch of up to 25 employee records and returns raise or reduction planning-priority scores keyed by employeeId. Use getRaiseFormulaBatch for raise, compensation-pool, market-correction, and retention-investment analysis; use getReductionFormulaBatch for reduction and over-market analysis. Accepts only canonical normalized inputs permitted for the selected action. Supports sparse records without inventing missing values or locally changing policy weights. Preserves returned scores and reports scoring failures. Does not modify employee records or make final employment decisions.",
            "category": "Generic",
            "readOnly": true,
            "requiresCompute": true,
            "typeSpecification": "{\n  \"type\": \"object\",\n  \"oneOf\": [\n    {\n      \"properties\": {\n        \"action\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"getRaiseFormulaBatch\"\n          ]\n        },\n        \"payload\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"records\": {\n              \"type\": \"array\",\n              \"minItems\": 1,\n              \"maxItems\": 25,\n              \"items\": {\n                \"$ref\": \"#/definitions/raiseRecord\"\n              }\n            }\n          },\n          \"required\": [\n            \"records\"\n          ],\n          \"additionalProperties\": false\n        }\n      },\n      \"required\": [\n        \"action\",\n        \"payload\"\n      ],\n      \"additionalProperties\": false\n    },\n    {\n      \"properties\": {\n        \"action\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"getReductionFormulaBatch\"\n          ]\n        },\n        \"payload\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"records\": {\n              \"type\": \"array\",\n              \"minItems\": 1,\n              \"maxItems\": 25,\n              \"items\": {\n                \"$ref\": \"#/definitions/reductionRecord\"\n              }\n            }\n          },\n          \"required\": [\n            \"records\"\n          ],\n          \"additionalProperties\": false\n        }\n      },\n      \"required\": [\n        \"action\",\n        \"payload\"\n      ],\n      \"additionalProperties\": false\n    }\n  ],\n  \"definitions\": {\n    \"normalizedValue\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"raiseRecord\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"employeeId\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"Performance\": {\n          \"$ref\": \"#/definitions/normalizedValue\"\n        },\n        \"Potential\": {\n          \"$ref\": \"#/definitions/normalizedValue\"\n        },\n        \"Criticality\": {\n          \"$ref\": \"#/definitions/normalizedValue\"\n        },\n        \"Retention\": {\n          \"$ref\": \"#/definitions/normalizedValue\"\n        },\n        \"Scarcity\": {\n          \"$ref\": \"#/definitions/normalizedValue\"\n        },\n        \"UnderMarket\": {\n          \"type\": \"number\",\n          \"minimum\": 0\n        },\n        \"Impact\": {\n          \"$ref\": \"#/definitions/normalizedValue\"\n        }\n      },\n      \"required\": [\n        \"employeeId\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"reductionRecord\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"employeeId\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"Performance\": {\n          \"$ref\": \"#/definitions/normalizedValue\"\n        },\n        \"Productivity\": {\n          \"$ref\": \"#/definitions/normalizedValue\"\n        },\n        \"Criticality\": {\n          \"$ref\": \"#/definitions/normalizedValue\"\n        },\n        \"Scarcity\": {\n          \"$ref\": \"#/definitions/normalizedValue\"\n        },\n        \"OverMarket\": {\n          \"type\": \"number\",\n          \"minimum\": 0\n        },\n        \"Impact\": {\n          \"$ref\": \"#/definitions/normalizedValue\"\n        }\n      },\n      \"required\": [\n        \"employeeId\"\n      ],\n      \"additionalProperties\": false\n    }\n  }\n}"
          },
          {
            "name": "getLocationMarketData",
            "description": "Retrieves the configured, governed location and labor-market context used for workforce and budget planning. Returns the available location identifiers, names, market indicators, and supporting policy attributes as structured JSON, preserving source values and identifying unavailable information. Provides context for analysis without inventing employee attributes, overriding workforce policy scores, or automatically protecting or excluding employees. Does not modify business records.",
            "category": "Generic",
            "readOnly": true,
            "requiresCompute": true,
            "typeSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {},\n  \"additionalProperties\": false\n}"
          },
          {
            "name": "getRoleStratergyData",
            "description": "Retrieves the configured, governed role-strategy context used for workforce and compensation planning. Returns available role or role-family identifiers, names, criticality, market context, raise caps, reduction sensitivity, and supporting policy attributes as structured JSON. Preserves source values and identifies missing information. Provides analytical context without filling missing employee fields, overriding employee policy scores, or automatically protecting or excluding records. Does not modify business records.",
            "category": "Generic",
            "readOnly": true,
            "requiresCompute": true,
            "typeSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {},\n  \"additionalProperties\": false\n}"
          }
        ]
      }
    ],
