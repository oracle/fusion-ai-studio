        {
          "id": "score-employees-loop",
          "code": "SCORE_EMPLOYEES",
          "type": "LOOP",
          "metadata": {
            "name": "Score Employees",
            "loopType": "SEQUENTIAL",
            "dataPipeline": {
              "rootNode": "start_score-employees-loop",
              "pipelineNodes": [
                {
                  "id": "start_score-employees-loop",
                  "code": "START",
                  "type": "START",
                  "metadata": {
                    "name": "Start",
                    "description": "Start of score iteration"
                  },
                  "inputs": [],
                  "outcomes": {
                    "success": "1794497637481"
                  },
                  "diagram": {
                    "x": 6228,
                    "y": 5518
                  }
                },
                {
                  "id": "1794497637481",
                  "code": "SCORE_POLICY",
                  "type": "POLICY",
                  "metadata": {
                    "name": "Score Policy",
                    "policyCode": "XX_RAISE_AND_REDUCTION_PRIORITY_SCORE_CALCULATION_POLICY",
                    "functionCode": "SCORECALCULATION"
                  },
                  "diagram": {
                    "x": 6106,
                    "y": 5669
                  },
                  "outcomes": {
                    "success": "score-capture-policy-result"
                  },
                  "inputs": [
                    {
                      "id": "1794497637481_Performance",
                      "name": "Performance",
                      "type": "string",
                      "value": "{{$context.$nodes.SCORE_EMPLOYEES.$currentItem.Performance === null || $context.$nodes.SCORE_EMPLOYEES.$currentItem.Performance === undefined ? \"\" : $context.$nodes.SCORE_EMPLOYEES.$currentItem.Performance}}"
                    },
                    {
                      "id": "1794497637481_Potential",
                      "name": "Potential",
                      "type": "string",
                      "value": "{{$context.$nodes.SCORE_EMPLOYEES.$currentItem.Potential === null || $context.$nodes.SCORE_EMPLOYEES.$currentItem.Potential === undefined ? \"\" : $context.$nodes.SCORE_EMPLOYEES.$currentItem.Potential}}"
                    },
                    {
                      "id": "1794497637481_Criticality",
                      "name": "Criticality",
                      "type": "string",
                      "value": "{{$context.$nodes.SCORE_EMPLOYEES.$currentItem.Criticality === null || $context.$nodes.SCORE_EMPLOYEES.$currentItem.Criticality === undefined ? \"\" : $context.$nodes.SCORE_EMPLOYEES.$currentItem.Criticality}}"
                    },
                    {
                      "id": "1794497637481_Retention",
                      "name": "Retention",
                      "type": "string",
                      "value": "{{$context.$nodes.SCORE_EMPLOYEES.$currentItem.Retention === null || $context.$nodes.SCORE_EMPLOYEES.$currentItem.Retention === undefined ? \"\" : $context.$nodes.SCORE_EMPLOYEES.$currentItem.Retention}}"
                    },
                    {
                      "id": "1794497637481_Scarcity",
                      "name": "Scarcity",
                      "type": "string",
                      "value": "{{$context.$nodes.SCORE_EMPLOYEES.$currentItem.Scarcity === null || $context.$nodes.SCORE_EMPLOYEES.$currentItem.Scarcity === undefined ? \"\" : $context.$nodes.SCORE_EMPLOYEES.$currentItem.Scarcity}}"
                    },
                    {
                      "id": "1794497637481_UnderMarket",
                      "name": "UnderMarket",
                      "type": "string",
                      "value": "{{$context.$nodes.SCORE_EMPLOYEES.$currentItem.UnderMarket === null || $context.$nodes.SCORE_EMPLOYEES.$currentItem.UnderMarket === undefined ? \"\" : $context.$nodes.SCORE_EMPLOYEES.$currentItem.UnderMarket}}"
                    },
                    {
                      "id": "1794497637481_OverMarket",
                      "name": "OverMarket",
                      "type": "string",
                      "value": "{{$context.$nodes.SCORE_EMPLOYEES.$currentItem.OverMarket === null || $context.$nodes.SCORE_EMPLOYEES.$currentItem.OverMarket === undefined ? \"\" : $context.$nodes.SCORE_EMPLOYEES.$currentItem.OverMarket}}"
                    },
                    {
                      "id": "1794497637481_Impact",
                      "name": "Impact",
                      "type": "string",
                      "value": "{{$context.$nodes.SCORE_EMPLOYEES.$currentItem.Impact === null || $context.$nodes.SCORE_EMPLOYEES.$currentItem.Impact === undefined ? \"\" : $context.$nodes.SCORE_EMPLOYEES.$currentItem.Impact}}"
                    },
                    {
                      "id": "1794497637481_Productivity",
                      "name": "Productivity",
                      "type": "string",
                      "value": "{{$context.$nodes.SCORE_EMPLOYEES.$currentItem.Productivity === null || $context.$nodes.SCORE_EMPLOYEES.$currentItem.Productivity === undefined ? \"\" : $context.$nodes.SCORE_EMPLOYEES.$currentItem.Productivity}}"
                    }
                  ]
                },
                {
                  "id": "score-capture-policy-result",
                  "code": "CAPTURE_SCORE_RESULT",
                  "type": "CODE",
                  "metadata": {
                    "name": "Capture Employee Policy Score",
                    "returnType": "array",
                    "sourceCode": "var record = $context.$nodes.SCORE_EMPLOYEES.$currentItem;\nvar action = $context.$variables.score_actionPayload.action;\nvar raw = $context.$nodes.SCORE_EMPLOYEES.SCORE_POLICY.$output;\nvar result = raw;\nif (typeof result === \"string\") {\n    try { result = JSON.parse(result); } catch (error) { result = null; }\n}\nif (result && result.result !== undefined) {\n    result = result.result;\n    if (typeof result === \"string\") {\n        try { result = JSON.parse(result); } catch (error) { result = null; }\n    }\n}\nvar model;\nif (action === \"getRaiseFormulaBatch\") {\n    model = \"raisePriority\";\n} else if (action === \"getReductionFormulaBatch\") {\n    model = \"reductionPriority\";\n} else {\n    throw new Error(\"Unsupported workforce policy action.\");\n}\nvar selected = result && result[model];\nvar entry = { employeeId: record.employeeId, score: null };\nif (selected && typeof selected.score === \"number\" && isFinite(selected.score)) {\n    entry.score = selected.score;\n    entry.priority = selected.priority;\n    entry.missingInputs = Array.isArray(selected.missingInputs) ? selected.missingInputs : [];\n} else {\n    entry.priority = selected ? selected.priority : null;\n    entry.missingInputs = selected && Array.isArray(selected.missingInputs) ? selected.missingInputs : [];\n    entry.error = selected ? \"The policy could not calculate the requested score because required inputs are missing or invalid.\" : \"The policy did not return a recognized scoring result.\";\n}\nvar previous = Array.isArray($context.$variables.score_results) ? $context.$variables.score_results : [];\nreturn previous.concat([entry]);"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "outcomes": {
                    "success": "score-store-policy-result"
                  },
                  "diagram": {
                    "x": 6106,
                    "y": 5891
                  }
                },
                {
                  "id": "score-store-policy-result",
                  "code": "STORE_SCORE_RESULT",
                  "type": "SET_FIELDS",
                  "metadata": {
                    "name": "Store Employee Policy Score"
                  },
                  "inputs": [
                    {
                      "id": "store-score-results-value",
                      "name": "score_results",
                      "value": "{{$context.$nodes.SCORE_EMPLOYEES.CAPTURE_SCORE_RESULT.$output.result}}"
                    }
                  ],
                  "outcomes": {
                    "success": "end_score-employees-loop"
                  },
                  "diagram": {
                    "x": 6106,
                    "y": 6113
                  }
                },
                {
                  "id": "end_score-employees-loop",
                  "code": "END",
                  "type": "END",
                  "metadata": {
                    "name": "End",
                    "description": "End of score iteration"
                  },
                  "inputs": [],
                  "outcomes": {}
                }
              ]
            }
          },
          "outcomes": {
