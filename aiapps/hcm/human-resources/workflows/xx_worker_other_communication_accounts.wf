  "workflowId": "300100717478123",
  "workflowCode": "XX_WORKER_OTHER_COMMUNICATION_ACCOUNTS",
  "name": "Worker Other Communication Accounts",
  "description": "Displays the selected worker's other communication accounts, including provider and account name. Answers questions using the available communication account records.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "id": "start",
          "code": "START",
          "type": "START",
          "metadata": {
            "name": "Start",
            "description": "Start of data pipeline"
          },
          "outcomes": {
            "success": "1"
          },
          "inputs": [],
          "diagram": {
            "x": 5592,
            "y": 5000
          }
        },
        {
          "id": "1",
          "code": "EXTRACT_PERSON_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Extract Person Context",
            "returnType": "object",
            "sourceCode": "const maximumContextLength = 32768;\nconst own = (object, key) => Object.prototype.hasOwnProperty.call(object, key);\nfunction fail() { throw new Error('Invalid contact request.'); }\n\nfunction contextObject(value) {\n  if (value == null || value === '') return {};\n  if (typeof value === 'string') {\n    if (value.length > maximumContextLength) fail();\n    try { value = JSON.parse(value); } catch (error) { fail(); }\n  }\n  if (!value || typeof value !== 'object' || Array.isArray(value)) fail();\n  const prototype = Object.getPrototypeOf(value);\n  if (prototype !== Object.prototype && prototype !== null) fail();\n  let serialized;\n  try { serialized = JSON.stringify(value); } catch (error) { fail(); }\n  if (typeof serialized !== 'string' || serialized.length > maximumContextLength) fail();\n  let visited = 0;\n  function inspect(item, depth) {\n    if (++visited > 2000 || depth > 12) fail();\n    if (!item || typeof item !== 'object') return;\n    Object.keys(item).forEach(function (key) {\n      if (key === '__proto__' || key === 'prototype' || key === 'constructor') fail();\n      inspect(item[key], depth + 1);\n    });\n  }\n  inspect(value, 0);\n  return value;\n}\n\nfunction positiveId(object, key) {\n  if (!own(object, key) || object[key] === undefined) return null;\n  const value = object[key];\n  if (typeof value === 'number') {\n    if (!Number.isSafeInteger(value) || value <= 0) fail();\n    return String(value);\n  }\n  if (typeof value !== 'string') fail();\n  const normalized = value.trim();\n  if (!/^[1-9][0-9]{0,29}$/.test(normalized)) fail();\n  return normalized;\n}\n\nconst appContext = contextObject($context?.$app?.$OraAppContext);\nconst userContext = contextObject($context?.$app?.$OraUserContext);\nconst restInput = contextObject($context?.$triggers?.REST?.$input);\nconst viewerPersonId = own(userContext, 'userId')\n  ? positiveId(userContext, 'userId') : positiveId(userContext, 'UserId');\nif (!viewerPersonId) fail();\nif (own(userContext, 'userId') && own(userContext, 'UserId') &&\n    positiveId(userContext, 'UserId') !== viewerPersonId) fail();\n\n// Prefer the employee selected by the app; fall back only when no selection exists.\nconst selectedValue = own(appContext, 'personId') ? appContext.personId : undefined;\nconst selectionAbsent = selectedValue == null ||\n  (typeof selectedValue === 'string' && !selectedValue.trim());\nconst selectedPersonId = selectionAbsent ? null : positiveId(appContext, 'personId');\n// Use an explicit input only when the app has not selected a person.\nlet inputPersonId = null;\nif (!selectedPersonId && own(restInput, 'personId') && restInput.personId != null &&\n    !(typeof restInput.personId === 'string' && !restInput.personId.trim())) {\n  inputPersonId = positiveId(restInput, 'personId');\n}\nconst personId = selectedPersonId || inputPersonId || viewerPersonId;\n// Identifier validation does not grant access; native-authenticated BO calls enforce it.\n// Keep the signed-in viewer separate for date and session preferences.\nreturn { personId, viewerPersonId, source: selectedPersonId ? 'OraAppContext' : inputPersonId ? 'REST' : 'OraUserContext' };",
            "description": "Validates app and viewer contexts; uses the selected app personId first, otherwise the signed-in viewer. Backend authorization remains required."
          },
          "outcomes": {
            "success": "3"
          },
          "inputs": [],
          "diagram": {
            "x": 5470,
            "y": 5206
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "3",
          "code": "APP_MESSAGE_HINT_SWITCH",
          "type": "SWITCH",
          "metadata": {
            "name": "Route App Message Hint"
          },
          "outcomes": {
            "InitDisplay": "9",
            "Query": "7"
          },
          "inputs": [
            {
              "id": "3_caseExpression",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$app.$OraMessageHint}}"
            }
          ],
          "diagram": {
            "x": 5470,
            "y": 5428
          },
          "convergenceTargetId": "end"
        },
        {
          "id": "12",
          "code": "PREPARE_COMMUNICATION_ACCOUNTS_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Communication Accounts Output",
            "sourceCode": "function displayText(value) {\n  return value === null || value === undefined ? \"\" : String(value).trim();\n}\n\nfunction serializeForElement(value) {\n  return JSON.stringify(value)\n    .replace(/&/g, \"\\\\u0026\")\n    .replace(/</g, \"\\\\u003C\")\n    .replace(/>/g, \"\\\\u003E\");\n}\n\nvar response = $context.$nodes.GET_OTHER_COMMUNICATION_ACCOUNTS.$output || {};\nvar rows = Array.isArray(response.items) ? response.items : [];\nvar items = [];\n\nrows.forEach(function (worker) {\n  var accounts = worker && worker.otherCommunicationAccounts;\n  var accountRows = accounts && Array.isArray(accounts.items) ? accounts.items : [];\n\n  accountRows.forEach(function (row) {\n    var item = {\n      title:\n        displayText(row && row.ProviderMeaning) ||\n        displayText(row && row.Provider) ||\n        \"Communication account\"\n    };\n\n    var accountName = displayText(row && row.AccountName);\n    if (accountName) item.subtitle = \"ID: \" + accountName;\n\n    items.push(item);\n  });\n});\n\nvar widget = {\n  patternId: \"messageListWidget\",\n  properties: {\n    subtitle: \"Other communication accounts\",\n    items: items\n  }\n};\n\nreturn '<oraInfoDisplay key=\"summary\">' +\n  serializeForElement(widget) +\n  '</oraInfoDisplay>';",
            "returnType": "string"
          },
          "outcomes": {
            "success": "4"
          },
          "inputs": [],
          "diagram": {
            "x": 5245,
            "y": 6370
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "4",
          "code": "RENDER_INIT_DISPLAY",
          "type": "LLM",
          "metadata": {
            "name": "Render Other Communication Accounts",
            "chatHistoryEnabled": false,
            "answerInUserLanguage": false
