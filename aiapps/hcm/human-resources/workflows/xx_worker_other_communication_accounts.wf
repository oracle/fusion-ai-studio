        {
          "id": "11",
          "code": "GET_URL_LINK",
          "type": "CODE",
          "metadata": {
            "name": "Get Url Link",
            "returnType": "string",
            "description": "Extracts the URL from the Contact Info For Others deeplink output.",
            "sourceCode": "const raw = String($context.$nodes.GET_CONTACT_INFO_DEEPLINK.$output || \"\");\nconst match = raw.match(/href=['\"]([^'\"]+)['\"]/);\nreturn match ? match[1] : \"\";"
          },
