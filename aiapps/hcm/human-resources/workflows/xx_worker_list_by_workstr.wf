        {
          "id": "VALIDATE_REQUEST_GET_WORKER_DETAILS",
          "code": "VALIDATE_REQUEST_GET_WORKER_DETAILS",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get Worker Details",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\nfunction page(value,name,min,max) {\n  if(typeof value!==\"number\" && typeof value!==\"string\") reject(name);\n  if(typeof value===\"string\" && !/^[0-9]{1,7}$/.test(value.trim())) reject(name);\n  const number=Number(value);if(!Number.isSafeInteger(number)||number<min||number>max) reject(name);return number;\n}\nfunction ownKeys(value,allowed) {\n  if(!value || typeof value!==\"object\" || Array.isArray(value)) reject(\"payload\");\n  Object.keys(value).forEach(function(k){if(allowed.indexOf(k)<0) reject(k);});\n}\nfunction plain(value,name,max) {\n  if(typeof value!==\"string\" || value.length>max || /[\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]/.test(value)) reject(name);return value;\n}\nfunction search(value,aggregation,expectedSecurity,expectedFields) {\n  if(typeof value === \"string\") {if(value.length>100000) reject(\"payload\");value=JSON.parse(value);}\n  ownKeys(value,aggregation ? [\"securityFilters\",\"facets\",\"facetValueQuery\",\"query\",\"searchFields\",\"filters\",\"offset\",\"limit\"] : [\"securityFilters\",\"displayFields\",\"query\",\"searchFields\",\"filters\",\"offset\",\"limit\"]);\n  // These fields belong to the authored operation, never a client payload.\n  if(JSON.stringify(value.securityFilters)!==JSON.stringify(expectedSecurity)) {\n    const security=value.securityFilters;ownKeys(security,[\"type\",\"value\",\"context\"]);\n    if(security.type!==expectedSecurity.type || security.value!==expectedSecurity.value || security.context!==expectedSecurity.context) reject(\"securityFilters\");\n  }\n  value.securityFilters=expectedSecurity;\n  if(!aggregation) {\n    if(!Array.isArray(value.displayFields) || value.displayFields.length!==expectedFields.length || value.displayFields.some(function(field,i){return field!==expectedFields[i];})) reject(\"displayFields\");\n    value.displayFields=expectedFields;\n  }\n  const names=[\"PersonName\",\"DisplayName\",\"PersonId\",\"PersonNumber\",\"AssignmentId\",\"AssignmentNumber\",\"Manager\",\"Reports\",\"JobId\",\"JobName\",\"JobCode\",\"DepartmentName\",\"PositionId\",\"PositionName\",\"PositionCode\",\"LocationId\",\"LocationName\",\"LocationCode\",\"GradeId\",\"GradeName\",\"GradeCode\",\"BusinessUnitId\",\"BusinessUnitName\",\"Country\",\"City\",\"Timezone\",\"TimeZone\",\"WorkPhone\",\"WorkEmail\",\"ManagerReports\",\"PrimaryAssignmentOnly\"];\n  if(value.filters!==undefined) {\n    if(!Array.isArray(value.filters)||value.filters.length>30) reject(\"filters\");\n    value.filters.forEach(function(filter){\n      ownKeys(filter,[\"name\",\"terms\",\"term\",\"value\"]);\n      if(names.indexOf(filter.name)<0) reject(\"filter name\");\n      const slots=[\"terms\",\"term\",\"value\"].filter(function(k){return Object.prototype.hasOwnProperty.call(filter,k);});if(slots.length!==1) reject(\"filter value\");\n      if(filter.name===\"ManagerReports\") {if(slots[0]!==\"value\" || [\"DIRECTS\",\"ALL\"].indexOf(filter.value)<0) reject(\"ManagerReports\");return;}\n      if(filter.name===\"PrimaryAssignmentOnly\") {if(slots[0]!==\"value\" || filter.value!==true) reject(\"PrimaryAssignmentOnly\");return;}\n      const values=slots[0]===\"terms\" ? filter.terms : [filter[slots[0]]];if(!Array.isArray(values)||!values.length||values.length>20) reject(\"terms\");\n      values.forEach(function(v){if(/(?:Id|ID)$/.test(filter.name)||[\"Manager\",\"Reports\"].indexOf(filter.name)>=0) id(v,filter.name);else plain(v,filter.name,500);});\n    });\n  }\n  if(value.query!==undefined) plain(value.query,\"query\",500);\n  if(value.facetValueQuery!==undefined) plain(value.facetValueQuery,\"facetValueQuery\",500);\n  if(value.searchFields!==undefined && (JSON.stringify(value.searchFields)!=='[\"DisplayName\"]')) reject(\"searchFields\");\n  if(aggregation) {if(!Array.isArray(value.facets)||value.facets.length!==1||[\"JobName\",\"JobCode\",\"DepartmentName\",\"PositionName\",\"PositionCode\",\"LocationName\",\"LocationCode\",\"GradeName\",\"GradeCode\",\"BusinessUnitName\"].indexOf(value.facets[0])<0) reject(\"facets\");}\n  if(value.offset!==undefined) value.offset=page(value.offset,\"offset\",0,1000000);\n  if(value.limit!==undefined) value.limit=page(value.limit,\"limit\",1,500);\n  return JSON.stringify(value);\n}\n\nconst checked={};\nchecked[\"payload\"]=search(($context.$nodes.CREATE_PAYLOAD.$output.result),false,{\"type\": \"QuickAction\", \"value\": \"HRIdentificationInfo\", \"context\": \"MyClientGroups\"},[\"DisplayName\", \"DepartmentName\", \"JobName\", \"LocationName\", \"PositionName\", \"PersonId\", \"PersonNumber\", \"AssignmentNumber\"]);\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1776760231912"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
