        {
          "id": "end",
          "code": "END",
          "type": "END",
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "inputs": []
        },
        {
          "id": "VALIDATE_MANAGER_ID",
          "code": "VALIDATE_MANAGER_ID",
          "type": "CODE",
          "metadata": {
            "name": "Validate Manager Person Identifier",
            "returnType": "object",
            "sourceCode": "const value = $context.$triggers.REST.$input.managerId;\nif (typeof value === 'number' && (!Number.isSafeInteger(value) || value <= 0)) throw new Error('Invalid manager person identifier');\nif (typeof value !== 'number' && typeof value !== 'string') throw new Error('Invalid manager person identifier');\nconst managerId = String(value).trim();\nif (!/^[1-9][0-9]{0,29}$/.test(managerId)) throw new Error('Invalid manager person identifier');\nreturn {managerId};",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "inputs": [],
          "outcomes": {
            "success": "FETCH_MANAGER_ASSIGNMENT"
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5000,
            "y": 5650
          }
        },
        {
          "id": "FETCH_MANAGER_ASSIGNMENT",
          "code": "FETCH_MANAGER_ASSIGNMENT",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Resolve Manager Primary Assignment",
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_EMPLOYMENTGHR",
            "functionName": "GetWorkerPrimaryAssignmentInfo"
          },
