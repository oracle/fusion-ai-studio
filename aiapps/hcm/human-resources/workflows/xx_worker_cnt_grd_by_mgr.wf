        {
          "id": "1777550732898",
          "code": "GET_QUERY_TYPE",
          "type": "CODE",
          "metadata": {
            "name": "Get Query Type",
            "returnType": "string",
            "sourceCode": "const input = $context.$triggers.REST.$input || {};\nconst hasValue = (value) => value !== null && value !== undefined && String(value).trim() !== \"\" && String(value).trim() !== \"<provide a value>\";\n\nif (hasValue(input.managerId)) return \"ManagerId\";\nreturn \"\";"
          },
          "outcomes": {
            "success": "1777550823360"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5450,
            "y": 5206
          }
        },
        {
          "id": "1777550823360",
          "code": "CHECKMANAGERID",
          "type": "CONDITION",
          "metadata": {
            "name": "checkManagerId"
          },
          "outcomes": {
            "true": "VALIDATE_MANAGER_ID",
            "false": "1777550748765"
          },
          "inputs": [
            {
              "id": "1777550823360_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.GET_QUERY_TYPE.$output.result==\"ManagerId\"}}"
            }
          ],
          "convergenceTargetId": "1777550748765",
          "diagram": {
            "x": 5450,
            "y": 5428
          }
        },
        {
          "id": "VALIDATE_REQUEST_WORKERCOUNTBYMANAGERANDGRADE",
          "code": "VALIDATE_REQUEST_WORKERCOUNTBYMANAGERANDGRADE",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Workercountbymanagerandgrade",
            "description": "Builds manager-scoped aggregation filters from the primary assignment. Counts all direct and indirect reports; rejects missing or malformed assignment IDs before the request.",
            "returnType": "object",
            "sourceCode": "const rows = $context.$nodes.FETCH_MANAGER_ASSIGNMENT.$output?.items;\nconst managerAssignmentId = rows?.[0]?.AssignmentId;\nif (typeof managerAssignmentId === 'number' && !Number.isSafeInteger(managerAssignmentId)) throw new Error('Unsafe manager assignment identifier');\nif (managerAssignmentId === null || managerAssignmentId === undefined || !/^[1-9][0-9]{0,29}$/.test(String(managerAssignmentId))) throw new Error('Manager primary assignment could not be resolved');\nreturn {payload: JSON.stringify({\n  facets: ['GradeName'],\n  securityFilters: {type: 'PersonSearch', value: 'AdvancedSearch'},\n  filters: [\n    {name: 'Manager', terms: [String(managerAssignmentId)]},\n    {name: 'ManagerReports', value: 'ALL'},\n    {name: 'PrimaryAssignmentOnly', value: true}\n  ]\n})};",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "1777550849802"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5000,
            "y": 6094
          }
        },
        {
          "id": "1777550849802",
          "code": "WORKERCOUNTBYMANAGERANDGRADE",
          "type": "BO_FUNCTION",
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_PERSONSEARCHESGHR",
            "functionName": "GetWorkerCount",
            "name": "Get Worker Count by Manager and Grade",
            "description": "Returns worker aggregation counts using the supplied workerAggregationsV2 JSON payload."
          },
          "outcomes": {
            "success": "1777550748765"
          },
          "inputs": [
            {
              "id": "1777550871520_1",
              "name": "payload",
              "value": "{{$context.$nodes.VALIDATE_REQUEST_WORKERCOUNTBYMANAGERANDGRADE.$output.result.payload}}",
              "required": false,
              "type": "string"
            }
          ],
          "outputSpecification": "{}",
          "diagram": {
            "x": 5000,
            "y": 6316
          }
        },
        {
          "id": "1777550748765",
          "code": "GET_WORKERS_CNT",
          "type": "CODE",
          "metadata": {
            "name": "Get Worker Counts",
            "returnType": "array",
            "sourceCode": "const type = $context.$nodes.GET_QUERY_TYPE.$output.result;\nif (type !== \"ManagerId\") return [];\nreturn $context.$nodes.WORKERCOUNTBYMANAGERANDGRADE.$output?.facets?.[0]?.values ?? [];"
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5450,
            "y": 6538
          }
        },
        {
          "id": "HR_REQUEST_REJECTED",
          "code": "HR_REQUEST_REJECTED",
          "type": "RETURN",
          "metadata": {
            "name": "Reject Invalid HR Request"
          },
          "inputs": [
            {
              "name": "returnValue",
