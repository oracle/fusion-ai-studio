        {
          "id": "1781102834234",
          "code": "PREPARE_SAFE_CONTACT_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Safe Contact Question",
            "description": "Provides a bounded question and an allowlisted fresh business-data projection to the answer model; excludes identifiers, context and audit fields.",
            "sourceCode": "const request = $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result;\nconst rawPrepared = $context.$nodes.PREPARE_ADDRESSES_OUTPUT.$output.result;\n// Runtime adapters may already decode the prepared JSON string.\nconst prepared = typeof rawPrepared === \"string\" ? JSON.parse(rawPrepared) : rawPrepared;\nif (request.stage !== \"Query\" || typeof request.question !== \"string\" ||\n    !request.question || request.question.length > 8000 ||\n    !prepared || typeof prepared !== \"object\" || Array.isArray(prepared) || !Array.isArray(prepared.queryRecords)) {\n  throw new Error(\"Invalid contact question.\");\n}\nfunction safeJson(value) {\n  return JSON.stringify(value).replace(/[<>&]/g, function (character) {\n    return \"\\\\u\" + character.charCodeAt(0).toString(16).padStart(4, \"0\");\n  });\n}\nreturn {\n  questionJson: safeJson(request.question),\n  recordsJson: safeJson(prepared.queryRecords)\n};",
            "returnType": "object",
            "errorNodeId": "1781102834233"
          },
          "outcomes": {
            "success": "1781102834217"
          },
          "inputs": [],
          "diagram": {
            "x": 6350,
            "y": 8368
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1781102834217",
          "code": "ANSWER_QUERY",
          "type": "LLM",
          "metadata": {
            "name": "Answer Query",
            "chatHistoryEnabled": false,
            "answerInUserLanguage": false,
