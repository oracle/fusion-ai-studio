          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentNumber\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentName\": {\n            \"type\": \"string\"\n          },\n          \"LegalEmployerName\": {\n            \"type\": \"string\"\n          },\n          \"StartDate\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryFlag\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryAssignmentFlag\": {\n            \"type\": \"string\"\n          },\n          \"WorkerType\": {\n            \"type\": \"string\"\n          },\n          \"WorkerNumber\": {\n            \"type\": \"string\"\n          },\n          \"ManagerName\": {\n            \"type\": \"string\"\n          },\n          \"BusinessUnitName\": {\n            \"type\": \"string\"\n          },\n          \"DepartmentName\": {\n            \"type\": \"string\"\n          },\n          \"JobCode\": {\n            \"type\": \"string\"\n          },\n          \"JobName\": {\n            \"type\": \"string\"\n          },\n          \"PositionCode\": {\n            \"type\": \"string\"\n          },\n          \"PositionName\": {\n            \"type\": \"string\"\n          },\n          \"LocationCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationName\": {\n            \"type\": \"string\"\n          },\n          \"GradeCode\": {\n            \"type\": \"string\"\n          },\n          \"GradeName\": {\n            \"type\": \"string\"\n          },\n          \"LocationPostalCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationCountry\": {\n            \"type\": \"string\"\n          },\n          \"LengthOfServiceYears\": {\n            \"type\": \"string\"\n          },\n          \"MarkedAsFavoriteFlag\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"PersonId\",\n          \"AssignmentId\",\n          \"AssignmentNumber\",\n          \"AssignmentName\",\n          \"LegalEmployerName\",\n          \"StartDate\",\n          \"PrimaryFlag\",\n          \"PrimaryAssignmentFlag\",\n          \"WorkerType\",\n          \"WorkerNumber\",\n          \"ManagerName\",\n          \"BusinessUnitName\",\n          \"DepartmentName\",\n          \"JobCode\",\n          \"JobName\",\n          \"PositionCode\",\n          \"PositionName\",\n          \"LocationCode\",\n          \"LocationName\",\n          \"GradeCode\",\n          \"GradeName\",\n          \"LocationPostalCode\",\n          \"LocationCountry\",\n          \"LengthOfServiceYears\",\n          \"MarkedAsFavoriteFlag\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "1781102834219",
          "code": "PREPARE_ADDRESSES_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Addresses Output",
            "sourceCode": "// Date-only values must never be converted through a time zone.\nfunction parse(value) {\n  if (typeof value === \"string\") { try { return JSON.parse(value); } catch (error) { return null; } }\n  return value;\n}\nfunction collection(value) {\n  const response = parse(value);\n  if (!response || response.error || response.timeout || response.isError ||\n      Number(response.statusCode || response.status || 0) >= 400 ||\n      String(response.hasMore).toLowerCase() === \"true\" || !Array.isArray(response.items)) return [];\n  return response.items;\n}\nconst viewerId = $context.$nodes.RESOLVE_VIEWER_DATE_CONTEXT.$output.result.viewerPersonId;\n// USER_SESSION is bound to the authenticated viewer, never OraAppContext's subject.\nconst sessions = collection($context.$nodes.READ_VIEWER_SESSION?.$output);\nconst session = sessions.length === 1 && sessions[0] ? sessions[0] : {};\nconst preference = typeof session.DateFormat === \"string\" ? session.DateFormat.trim() : \"\";\nconst language = String(session.Language || session.DefaultLanguage || \"\").toLowerCase();\nlet country = typeof session.Territory === \"string\" ? session.Territory.trim().toUpperCase() : \"\";\nif (!country && viewerId) {\n  const countries = [];\n  collection($context.$nodes.GET_VIEWER_WORK_ASSIGNMENT?.$output).forEach(function (row) {\n    if (!row || (row.PersonId != null && String(row.PersonId).trim() !== viewerId)) return;\n    if (row.PrimaryFlag != null && !/^(true|y)$/i.test(String(row.PrimaryFlag))) return;\n    const value = typeof row.LocationCountry === \"string\" ? row.LocationCountry.trim().toUpperCase() : \"\";\n    if (countries.indexOf(value) < 0) countries.push(value);\n  });\n  if (countries.length === 1) country = countries[0];\n}\nconst monthNames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\nfunction preferenceFormat(parts) {\n  // Oracle selfDetails.DateFormat uses Java-style day/month/year tokens.\n  if (!preference || preference.length > 80) return null;\n  const tokens = preference.match(/yyyy|YYYY|yy|YY|MMMM|MMM|MM|M|dd|DD|d|D|[\\s/.,-]+/g);\n  if (!tokens || tokens.join(\"\") !== preference) return null;\n  const dateTokens = tokens.filter(function (token) { return /[yYMdD]/.test(token); });\n  if (dateTokens.length !== 3 ||\n      dateTokens.filter(function (t) { return /^[yY]/.test(t); }).length !== 1 ||\n      dateTokens.filter(function (t) { return /^M/.test(t); }).length !== 1 ||\n      dateTokens.filter(function (t) { return /^[dD]/.test(t); }).length !== 1) return null;\n  if (preference.indexOf(\"MMM\") >= 0 && !/^en(?:[-_]|$)/.test(language)) return null;\n  return tokens.map(function (token) {\n    if (/^(yyyy|YYYY)$/.test(token)) return parts[1];\n    if (/^(yy|YY)$/.test(token)) return parts[1].slice(-2);\n    if (token === \"MMMM\") return monthNames[Number(parts[2]) - 1];\n    if (token === \"MMM\") return monthNames[Number(parts[2]) - 1].slice(0, 3);\n    if (token === \"MM\") return parts[2];\n    if (token === \"M\") return String(Number(parts[2]));\n    if (/^(dd|DD)$/.test(token)) return parts[3];\n    if (/^(d|D)$/.test(token)) return String(Number(parts[3]));\n    return token;\n  }).join(\"\");\n}\nfunction formatDate(value) {\n  if (value == null || value === \"\") return \"-\";\n  if (typeof value !== \"string\") return value;\n  const parts = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(value);\n  if (!parts) return value;\n  const year = Number(parts[1]), month = Number(parts[2]), day = Number(parts[3]);\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  if (year < 1 || month < 1 || month > 12 || day < 1 || day > days[month - 1]) return value;\n  const preferred = preferenceFormat(parts);\n  if (preferred !== null) return preferred;\n  if (country === \"US\") return parts[2] + \"/\" + parts[3] + \"/\" + parts[1];\n  if ([\"IN\", \"GB\", \"UK\", \"AU\", \"SG\"].indexOf(country) >= 0) return parts[3] + \"/\" + parts[2] + \"/\" + parts[1];\n  return value;\n}\n\nconst state = $context.$variables.contactPaging;\nif (!state || state.personId !== $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId ||\n    state.hasMore !== false || !Array.isArray(state.items)) {\n  throw new Error(\"The complete addresses list is required before display.\");\n}\n\nfunction text(value) {\n  if (value == null) return \"\";\n  if (typeof value !== \"string\" && typeof value !== \"number\" && typeof value !== \"boolean\") {\n    throw new Error(\"Invalid contact field.\");\n  }\n  const result = String(value).trim();\n  if (result.length > 32768) throw new Error(\"Invalid contact field.\");\n  return result;\n}\n\nfunction primary(value) {\n  return value === true || value === 1 || /^(true|y|1)$/i.test(text(value));\n}\n\nfunction dateKey(value) {\n  const match = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(text(value));\n  if (!match) return \"\";\n  const year = Number(match[1]);\n  const month = Number(match[2]);\n  const day = Number(match[3]);\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  if (year < 1 || month < 1 || month > 12 || day < 1 || day > days[month - 1]) return \"\";\n  return match[0];\n}\n\n// Sort the full collection, never just the first API page.\n// Do not filter expired, future, or non-primary records.\nconst sorted = state.items.map(function (row, index) {\n  return { row: row, index: index, primary: primary(row.PrimaryFlag), date: dateKey(row.EffectiveStartDate) };\n}).sort(function (left, right) {\n  if (left.primary !== right.primary) return left.primary ? -1 : 1;\n  if (left.date !== right.date) {\n    if (!left.date) return 1;\n    if (!right.date) return -1;\n    return left.date > right.date ? -1 : 1;\n  }\n  return left.index - right.index;\n});\n\nconst items = sorted.map(function (entry) {\n  const row = entry.row;\n  const item = { title: text(row.FormattedSingleLineAddress) || \"Address\" };\n  if (entry.primary) item.subtitle = \"Primary\";\n  const summary = text(row.EffectiveStartDate);\n  if (summary) item.summary = \"Start Date: \" + formatDate(summary);\n  const badgeText = text(row.AddressTypeMeaning);\n  if (badgeText) {\n    item.badgeText = badgeText;\n    item.priority = \"medium\";\n  }\n  return item;\n});\n\nconst queryFields = [\"AddressLine1\",\"AddressLine2\",\"AddressLine3\",\"AddressLine4\",\"TownOrCity\",\"Region1\",\"Region2\",\"Region3\",\"Country\",\"CountryName\",\"PostalCode\",\"LongPostalCode\",\"Building\",\"FloorNumber\",\"FormattedMultiLineAddress\",\"FormattedSingleLineAddress\",\"AddressType\",\"AddressTypeMeaning\",\"PrimaryFlag\",\"EffectiveStartDate\",\"EffectiveEndDate\"];\nconst queryDateFields = [\"EffectiveStartDate\",\"EffectiveEndDate\"];\nconst queryRecords = sorted.map(function (entry) {\n  const record = {};\n  queryFields.forEach(function (field) {\n    if (!Object.prototype.hasOwnProperty.call(entry.row, field)) return;\n    const value = entry.row[field];\n    if (value == null || value === \"\") return;\n    const normalized = text(value);\n    record[field] = queryDateFields.indexOf(field) >= 0 ? formatDate(normalized) : normalized;\n  });\n  return record;\n});\n\nreturn JSON.stringify({\n  queryRecords: queryRecords,\n  initialItems: items,\n  remainingItems: [],\n  hasAdditionalItems: false,\n  totalCount: items.length\n}).replace(/[<>&]/g, function (character) {\n  return \"\\\\u\" + character.charCodeAt(0).toString(16).padStart(4, \"0\");\n});",
            "returnType": "string",
            "description": "Sorts the complete collection primary-first and effective-date descending, then prepares all records for the initial panel.",
            "errorNodeId": "1781102834233"
          },
          "outcomes": {
            "success": "1781102834238"
          },
          "inputs": [],
          "diagram": {
            "x": 5675,
            "y": 7702
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1781102834238",
          "code": "PREPARE_SAFE_CONTACT_DISPLAY",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Safe Contact Display",
            "sourceCode": "let prepared=$context.$nodes.PREPARE_ADDRESSES_OUTPUT.$output.result;\nif(typeof prepared===\"string\")prepared=JSON.parse(prepared);\nfunction safe(items){if(!Array.isArray(items))throw new Error(\"Invalid display records\");return JSON.stringify(items.map(function(row){const result={};[\"title\",\"subtitle\",\"summary\",\"badgeText\",\"priority\"].forEach(function(k){if(Object.prototype.hasOwnProperty.call(row,k))result[k]=row[k];});return result;})).replace(/</g,\"\\\\u003c\").replace(/>/g,\"\\\\u003e\").replace(/&/g,\"\\\\u0026\");}\nreturn {initialItemsJson:safe(prepared.initialItems),remainingItemsJson:safe(prepared.remainingItems)};",
            "returnType": "object",
            "errorNodeId": "1781102834233"
          },
          "outcomes": {
            "success": "1781102834225"
          },
          "inputs": [],
          "diagram": {
            "x": 5675,
            "y": 7924
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
