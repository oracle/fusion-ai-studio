                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AddressId\": {\n            \"type\": \"string\"\n          },\n          \"EffectiveStartDate\": {\n            \"type\": \"string\"\n          },\n          \"EffectiveEndDate\": {\n            \"type\": \"string\"\n          },\n          \"AddressLine1\": {\n            \"type\": \"string\"\n          },\n          \"AddressLine2\": {\n            \"type\": \"null\"\n          },\n          \"AddressLine3\": {\n            \"type\": \"null\"\n          },\n          \"AddressLine4\": {\n            \"type\": \"null\"\n          },\n          \"TownOrCity\": {\n            \"type\": \"string\"\n          },\n          \"Region1\": {\n            \"type\": \"string\"\n          },\n          \"Region2\": {\n            \"type\": \"string\"\n          },\n          \"Region3\": {\n            \"type\": \"null\"\n          },\n          \"Country\": {\n            \"type\": \"string\"\n          },\n          \"CountryName\": {\n            \"type\": \"string\"\n          },\n          \"PostalCode\": {\n            \"type\": \"string\"\n          },\n          \"LongPostalCode\": {\n            \"anyOf\": [\n              {\n                \"type\": \"null\"\n              },\n              {\n                \"type\": \"string\"\n              }\n            ]\n          },\n          \"AddlAddressAttribute1\": {\n            \"type\": \"null\"\n          },\n          \"AddlAddressAttribute2\": {\n            \"type\": \"null\"\n          },\n          \"AddlAddressAttribute3\": {\n            \"type\": \"null\"\n          },\n          \"AddlAddressAttribute4\": {\n            \"type\": \"null\"\n          },\n          \"AddlAddressAttribute5\": {\n            \"type\": \"null\"\n          },\n          \"Building\": {\n            \"type\": \"null\"\n          },\n          \"FloorNumber\": {\n            \"type\": \"null\"\n          },\n          \"CreatedBy\": {\n            \"type\": \"string\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdatedBy\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateDate\": {\n            \"type\": \"string\"\n          },\n          \"PersonAddrUsageId\": {\n            \"type\": \"string\"\n          },\n          \"AddressType\": {\n            \"type\": \"string\"\n          },\n          \"AddressTypeMeaning\": {\n            \"type\": \"string\"\n          },\n          \"PersonId\": {\n            \"type\": \"string\"\n          },\n          \"UsageLastUpdateDate\": {\n            \"type\": \"string\"\n          },\n          \"UsageLastUpdatedBy\": {\n            \"type\": \"string\"\n          },\n          \"ValidationStatusCode\": {\n            \"anyOf\": [\n              {\n                \"type\": \"null\"\n              },\n              {\n                \"type\": \"string\"\n              }\n            ]\n          },\n          \"Provider\": {\n            \"anyOf\": [\n              {\n                \"type\": \"null\"\n              },\n              {\n                \"type\": \"string\"\n              }\n            ]\n          },\n          \"Longitude\": {\n            \"anyOf\": [\n              {\n                \"type\": \"null\"\n              },\n              {\n                \"type\": \"string\"\n              }\n            ]\n          },\n          \"Latitude\": {\n            \"anyOf\": [\n              {\n                \"type\": \"null\"\n              },\n              {\n                \"type\": \"string\"\n              }\n            ]\n          },\n          \"ValidateAddressExtraInfo\": {\n            \"type\": \"null\"\n          },\n          \"FormattedMultiLineAddress\": {\n            \"type\": \"string\"\n          },\n          \"FormattedSingleLineAddress\": {\n            \"type\": \"string\"\n          },\n          \"AddressStyleCode\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"PrimaryAsOfAddressESDFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"RowPostState\": {\n            \"type\": \"string\"\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\"\n              },\n              \"headers\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"ETag\": {\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"ETag\"\n                ],\n                \"additionalProperties\": false\n              },\n              \"links\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"rel\": {\n                      \"type\": \"string\"\n                    },\n                    \"href\": {\n                      \"type\": \"string\"\n                    },\n                    \"name\": {\n                      \"type\": \"string\"\n                    },\n                    \"kind\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"rel\",\n                    \"href\",\n                    \"name\",\n                    \"kind\"\n                  ],\n                  \"additionalProperties\": false\n                }\n              }\n            },\n            \"required\": [\n              \"key\",\n              \"headers\",\n              \"links\"\n            ],\n            \"additionalProperties\": false\n          }\n        },\n        \"required\": [\n          \"AddressId\",\n          \"EffectiveStartDate\",\n          \"EffectiveEndDate\",\n          \"AddressLine1\",\n          \"AddressLine2\",\n          \"AddressLine3\",\n          \"AddressLine4\",\n          \"TownOrCity\",\n          \"Region1\",\n          \"Region2\",\n          \"Region3\",\n          \"Country\",\n          \"CountryName\",\n          \"PostalCode\",\n          \"LongPostalCode\",\n          \"AddlAddressAttribute1\",\n          \"AddlAddressAttribute2\",\n          \"AddlAddressAttribute3\",\n          \"AddlAddressAttribute4\",\n          \"AddlAddressAttribute5\",\n          \"Building\",\n          \"FloorNumber\",\n          \"CreatedBy\",\n          \"CreationDate\",\n          \"LastUpdatedBy\",\n          \"LastUpdateDate\",\n          \"PersonAddrUsageId\",\n          \"AddressType\",\n          \"AddressTypeMeaning\",\n          \"PersonId\",\n          \"UsageLastUpdateDate\",\n          \"UsageLastUpdatedBy\",\n          \"ValidationStatusCode\",\n          \"Provider\",\n          \"Longitude\",\n          \"Latitude\",\n          \"ValidateAddressExtraInfo\",\n          \"FormattedMultiLineAddress\",\n          \"FormattedSingleLineAddress\",\n          \"AddressStyleCode\",\n          \"PrimaryFlag\",\n          \"PrimaryAsOfAddressESDFlag\",\n          \"RowPostState\",\n          \"@context\"\n        ],\n        \"additionalProperties\": true\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
                },
                {
                  "id": "1781102834223",
                  "code": "APPEND_CONTACT_PAGE",
                  "type": "CODE",
                  "metadata": {
                    "name": "Append Contact Page",
                    "returnType": "object",
                    "sourceCode": "const state = $context.$variables.contactPaging;\nlet response = $context.$nodes.WHILE_CONTACT_PAGES.GET_PERSON_ADDRESSES.$output;\n\nfunction fail(detail) {\n  throw new Error(\"Complete addresses could not be retrieved. \" + detail);\n}\n\nfunction text(value) {\n  return value == null ? \"\" : String(value).trim();\n}\n\nfunction integer(value, label) {\n  const raw = text(value);\n  if (!/^\\d+$/.test(raw)) fail(\"Invalid \" + label + \".\");\n  const number = Number(raw);\n  if (!Number.isSafeInteger(number) || number < 0) fail(\"Invalid \" + label + \".\");\n  return number;\n}\n\nfunction boolean(value) {\n  if (value === true || value === 1 || /^(true|y|1)$/i.test(text(value))) return true;\n  if (value === false || value === 0 || /^(false|n|0)$/i.test(text(value))) return false;\n  fail(\"Invalid pagination continuation flag.\");\n}\n\nfunction recordKey(row) {\n  const identity = text(row.PersonAddrUsageId) || text(row.AddressId);\n  if (!identity) fail(\"A contact record has no stable identifier.\");\n  return identity + \"|\" + text(row.AddressId) + \"|\" + text(row.EffectiveStartDate) + \"|\" + text(row.EffectiveEndDate);\n}\n\nif (!state || !Array.isArray(state.items) || !Array.isArray(state.seenKeys) ||\n    !Number.isSafeInteger(state.offset) || state.offset < 0 ||\n    !Number.isSafeInteger(state.pageCount) || state.pageCount < 0 || state.pageCount >= 100 || state.offset > 10000 ||\n    state.personId !== $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId ||\n    state.hasMore !== true) {\n  fail(\"Invalid paging state.\");\n}\nif (typeof response === \"string\") {\n  if (response.length > 1048576) fail(\"Response exceeds the safe size limit.\");\n  try { response = JSON.parse(response); } catch (error) { fail(\"Invalid response.\"); }\n}\nif (!response || typeof response !== \"object\" || Array.isArray(response) ||\n    response.error || response.timeout === true || text(response.timeout).toLowerCase() === \"true\" ||\n    response.isError === true || text(response.isError).toLowerCase() === \"true\" ||\n    Number(response.statusCode || response.status || 0) >= 400 || !Array.isArray(response.items)) {\n  fail(\"The service returned an error or an invalid collection.\");\n}\n\nconst offset = integer(response.offset, \"page offset\");\nconst count = integer(response.count, \"page count\");\nconst limit = integer(response.limit, \"page limit\");\nconst hasMore = boolean(response.hasMore);\nif (offset !== state.offset || limit < 1 || limit > 100 || count !== response.items.length || count > limit) {\n  fail(\"Inconsistent pagination metadata.\");\n}\nif (hasMore && count === 0) fail(\"The next page would not advance.\");\n\nif (state.pageCount >= 100 || state.items.length + count > 10000) fail(\"The retrieval safety limit was exceeded.\");\n\nconst seen = state.seenKeys.slice();\nconst items = state.items.slice();\nresponse.items.forEach(function (row) {\n  if (!row || typeof row !== \"object\" || Array.isArray(row) ||\n      text(row.PersonId) !== state.personId) {\n    fail(\"A contact record does not belong to the selected person.\");\n  }\n  const key = recordKey(row);\n  if (seen.indexOf(key) !== -1) fail(\"A repeated contact record prevents reliable pagination.\");\n  seen.push(key);\n  items.push(row);\n});\n\nconst nextOffset = offset + count;\nconst pageCount = state.pageCount + 1;\nif (!Number.isSafeInteger(nextOffset) || (hasMore && nextOffset <= state.offset)) {\n  fail(\"The next page would not advance.\");\n}\nif (hasMore && (pageCount >= 100 || items.length >= 10000)) {\n  fail(\"The retrieval safety limit was reached before all records were returned.\");\n}\nreturn {\n  personId: state.personId,\n  offset: nextOffset,\n  pageCount: pageCount,\n  hasMore: hasMore,\n  items: items,\n  seenKeys: seen\n};",
                    "description": "Checks each page and accumulates complete contact data; incomplete or mismatched data fails explicitly.",
                    "errorNodeId": "1781102834233"
                  },
                  "outcomes": {
                    "success": "1781102834224"
                  },
                  "inputs": [],
                  "diagram": {
                    "x": 5675,
                    "y": 6335
                  },
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
