            "sourceCode": "\nfunction securePlainObject(value) {\n  return !!value && typeof value === \"object\" && !Array.isArray(value) &&\n    (Object.getPrototypeOf(value) === Object.prototype || Object.getPrototypeOf(value) === null);\n}\nfunction secureObject(value, maximum = 16384) {\n  if (typeof value === \"string\") {\n    if (!value.trim() || value.length > maximum) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value)) return null;\n  let count = 0;\n  function safeTree(item, depth) {\n    if (++count > 2000 || depth > 12) return false;\n    if (!item || typeof item !== \"object\") return true;\n    if (!Array.isArray(item) && !securePlainObject(item)) return false;\n    return Object.keys(item).every(function (key) {\n      return ![\"__proto__\", \"constructor\", \"prototype\"].includes(key) && safeTree(item[key], depth + 1);\n    });\n  }\n  return safeTree(value, 0) ? value : null;\n}\nfunction secureId(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  return typeof value === \"string\" && /^[1-9][0-9]{0,19}$/.test(value.trim()) ? value.trim() : \"\";\n}\nfunction secureText(value, maximum = 4000) {\n  return typeof value === \"string\" && value.length <= maximum\n    ? value.replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/g, \"\").trim() : \"\";\n}\nfunction secureEscape(value) {\n  return value.replace(/[&<>]/g, function (character) {\n    return String.fromCharCode(38) + ({ \"&\": \"amp\", \"<\": \"lt\", \">\": \"gt\" })[character] + \";\";\n  });\n}\nfunction secureCollection(value, maximum = 500) {\n  if (typeof value === \"string\") {\n    if (value.length > 1000000) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value) || value.error || value.timeout || value.isError ||\n      Number(value.status