s\": {\n              \"key\": {\n                \"type\": \"string\"\n              },\n              \"headers\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"ETag\": {\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"ETag\"\n                ],\n                \"additionalProperties\": false\n              }\n            },\n            \"required\": [\n              \"key\",\n              \"headers\"\n            ],\n            \"additionalProperties\": false\n          }\n        },\n        \"required\": [\n          \"ActualCompletionDate\",\n          \"CertificateNumber\",\n          \"CertificationId\",\n          \"CertificationURL\",\n          \"Comments\",\n          \"CompletedAmount\",\n          \"ContentItemId\",\n          \"Country\",\n          \"CountryMeaning\",\n          \"CreatedBy\",\n          \"CreationDate\",\n          \"Establishment\",\n          \"EstablishmentId\",\n          \"ExpirationDate\",\n          \"IssueDate\",\n          \"IssuedBy\",\n          \"LastRenewalDate\",\n          \"LastUpdateDate\",\n          \"LastUpdatedBy\",\n          \"LicenseOrCertificate\",\n          \"OriginalIssueYear\",\n          \"OtherEstablishment\",\n          \"OtherLicenseOrCertificate\",\n          \"RenewalDate\",\n          \"RenewalInprogress\",\n          \"RenewalInprogressMeaning\",\n          \"RenewalRequired\",\n          \"RenewalRequiredMeaning\",\n          \"Restrictions\",\n          \"Source\",\n          \"State\",\n          \"Status\",\n          \"StatusMeaning\",\n          \"Title\",\n          \"TotalAmount\",\n          \"TrainingCompletedUnits\",\n          \"Verified\",\n          \"VerifiedMeaning\",\n          \"RelatedItemFlag\",\n          \"ThirdPartyVerificationFlag\",\n          \"ExternalPartyVerifyBy\",\n          \"ExternalPartyVerifyDate\",\n          \"SectionI