        {
          "id": "1785145042613",
          "code": "BUILD_ACCOMPLISHMENT_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Build Accomplishment Context",
            "description": "Creates an allowlisted, bounded achievement query context from fresh records; excludes internal identifiers and URLs.",
            "returnType": "object",
            "sourceCode": "\nfunction securePlainObject(value) {\n  return !!value && typeof value === \"object\" && !Array.isArray(value) &&\n    (Object.getPrototypeOf(value) === Object.prototype || Object.getPrototypeOf(value) === null);\n}\nfunction secureObject(value, maximum = 16384) {\n  if (typeof value === \"string\") {\n    if (!value.trim() || value.length > maximum) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value)) return null;\n  let count = 0;\n  function safeTree(item, depth) {\n    if (++count > 2000 || depth > 12) return false;\n    if (!item || typeof item !== \"object\") return true;\n    if (!Array.isArray(item) && !securePlainObject(item)) return false;\n    return Object.keys(item).every(function (key) {\n      return ![\"__proto__\", \"constructor\", \"prototype\"].includes(key) && safeTree(item[key], depth + 1);\n    });\n  }\n  return safeTree(value, 0) ? value : null;\n}\nfunction secureId(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  return typeof value === \"string\" && /^[1-9][0-9]{0,19}$/.test(value.trim()) ? value.trim() : \"\";\n}\nfunction secureText(value, maximum = 4000) {\n  return typeof value === \"string\" && value.length <= maximum\n    ? value.replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/g, \"\").trim() : \"\";\n}\nfunction secureEscape(value) {\n  return value.replace(/[&<>]/g, function (character) {\n    return String.fromCharCode(38) + ({ \"&\": \"amp\", \"<\": \"lt\", \">\": \"gt\" })[character] + \";\";\n  });\n}\nfunction secureCollection(value, maximum = 500) {\n  if (typeof value === \"string\") {\n    if (value.length > 1000000) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value) || value.error || value.timeout || value.isError ||\n      Number(value.statusCode || value.status || 0) >= 400 || !Array.isArray(value.items) ||\n      value.items.length > maximum || !value.items.every(securePlainObject)) return null;\n  return value;\n}\nfunction secureUrl(value) {\n  if (typeof value !== \"string\" || value.length > 2048) return \"\";\n  const url = value.trim();\n  if (/[\\s\\\\<>\"'\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/.test(url) ||\n      /%(?:0[0-9a-f]|1[0-9a-f]|7f|5c)/i.test(url)) return \"\";\n  return /^https?:\\/\\/(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$/i.test(url) ? url : \"\";\n}\n\nfunction section(output, field) {\n  const response = secureCollection(output);\n  if (!response) throw new Error(\"Achievement records could not be verified.\");\n  return response.items.map(function (row) {\n    return { [field]: secureEscape(secureText(row[field], 1000)) };\n  }).filter(function (row) { return !!row[field]; });\n}\nconst data = {\n  honors: section($context.$nodes.FETCH_QUERY_HONOR_ITEMS.$output, \"HonorOrAward\"),\n  accomplishments: section($context.$nodes.FETCH_QUERY_ACCOMPLISHMENT_ITEMS.$output, \"Accomplishment\"),\n  certifications: section($context.$nodes.FETCH_QUERY_CERTIFICATION_ITEMS.$output, \"LicenseOrCertificate\")\n};\nreturn Object.assign({}, data, {\n  valid: true,\n  hasAccomplishments: data.honors.length + data.accomplishments.length + data.certifications.length > 0,\n  dataJson: JSON.stringify(data).replace(/</g, \"\\\\u003c\").replace(/>/g, \"\\\\u003e\").replace(/&/g, \"\\\\u0026\")\n});",
            "errorNodeId": "1785148140858"
