  },\n          \"Source\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateDate\": {\n            \"type\": \"string\"\n          },\n          \"RelatedItemFlag\": {\n            \"type\": \"string\"\n          },\n          \"SectionId\": {\n            \"type\": \"string\"\n          },\n          \"ProfileId\": {\n            \"type\": \"string\"\n          },\n          \"SourceType\": {\n            \"type\": \"string\"\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\"\n              },\n              \"headers\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"ETag\": {\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"ETag\"\n                ],\n                \"additionalProperties\": false\n              }\n            },\n            \"required\": [\n              \"key\",\n              \"headers\"\n            ],\n            \"additionalProperties\": false\n          }\n        },\n        \"required\": [\n          \"HonorId\",\n          \"ContentItemId\",\n          \"HonorOrAward\",\n          \"OtherHonorOrAward\",\n          \"Points\",\n          \"AwardDate\",\n          \"BadgeSourceURL\",\n          \"HonorOrAwardDescription\",\n          \"Organization\",\n          \"IssueYear\",\n          \"CompletionDate\",\n          \"ExpirationDate\",\n          \"TypeOfAward\",\n          \"EstablishmentId\",\n          \"Establishment\",\n          \"OtherEstablishment\",\n          \"Title\",\n          \"Grantor\",\n          \"HonorURL\",\n          \"TypeOfAwardMeaning\",\n          \"Comments\",\n          \"Description\",\n          \"Source\",\n          \"LastUpdateDate\",\n          \"RelatedItemFlag\",\n          \"SectionId\",\n          \"ProfileId\",\n          \"SourceType\",\n          \"@context\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
