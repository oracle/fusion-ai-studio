        {
          "id": "1795071981312",
          "code": "FETCH_SIGNAL_DETAILS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Fetch Signal Details",
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_FORECAST_SIGNALS",
            "functionName": "getSignalDetails"
          },
          "diagram": {
            "x": 5450,
            "y": 6316
          },
          "outcomes": {
            "success": "prepare_signal_details"
          },
          "inputs": [
            {
              "id": "1795071981312_application",
