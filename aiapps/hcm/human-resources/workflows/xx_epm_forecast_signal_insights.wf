        {
          "id": "1795161075606",
          "code": "DISPAY_SIGNAL_SUMMARY",
          "type": "LLM",
          "metadata": {
            "name": "Dispay Signal Summary"
          },
          "diagram": {
            "x": 6650,
            "y": 6316
