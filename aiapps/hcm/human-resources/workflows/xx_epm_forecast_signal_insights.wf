          },
          "inputs": [
            {
              "id": "1795181994280_collection",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.FILTER_EPM_INSTANCES.$output.result}}"
            }
          ]
        },
        {
          "id": "1795189123090",
          "code": "FILTER_APPLICATIONS",
          "type": "CODE",
          "metadata": {
            "name": "Filter Applications",
            "sourceCode": "var rows = $context.$variables.epmApplications;\nif (!Array.isArray(rows)) throw new Error('Application lookup did not return a valid list.');\nvar query = '';\nif ($context.$app.$OraMessageHint === 'QueryContextSuggestions') {\n  var intent = $context.$nodes.RESOLVE_CONTEXT_SEARCH_INTENT.$output;\n  if (typeof intent === 'string') {\n    var intentText = intent.trim();\n    if (intentText.charAt(0) !== '{') {\n      throw new Error('Intent extraction returned display markup or other non-JSON content. Expected a JSON object from RESOLVE_CONTEXT_SEARCH_INTENT.');\n    }\n    try { intent = JSON.parse(intentText); }\n    catch (parseError) { throw new Error('Intent extraction returned invalid JSON.'); }\n  }\n  if (!intent || typeof intent.applicationName !== 'string') throw new Error('Application search intent is invalid.');\n  query = intent.applicationName.trim().toLowerCase();\n}\nreturn rows.filter(function (row) {\n  return !query || (row && typeof row.applicationName === 'string' &&\n    row.applicationName.toLowerCase().indexOf(query) !== -1);\n});",
            "returnType": "array"
          },
          "outcomes": {
            "success": "1795018975494"
          },
          "inputs": [],
          "diagram": {
            "x": 6500,
