            "returnType": "string",
            "sourceCode": "let oraMsg = $context.$app.$OraMessageHint || \"\";\n\nlet msg = \"\";\n\nif ( oraMsg === \"InitDisplay\" || oraMsg === \"Summary\" || oraMsg === \"InitActions\") {\n  msg = \"initialFlow\";\n}\nelse if(oraMsg == \"InitContextSuggestions\" || oraMsg == \"QueryContextSuggestions\"){\n  msg = \"contextSuggestions\";\n}\nelse {\n  msg = oraMsg;\n}\n\nreturn msg;"
          },
