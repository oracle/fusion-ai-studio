                  "outcomes": {
                    "success": "1795182457680"
                  },
                  "inputs": [
                    {
                      "id": "1795182345305_epmInstance",
                      "name": "epmInstance",
                      "value": "{{$context.$nodes.FILTER_EPM_INSTANCES.$output.result[$context.$variables.epmInstanceNumber].code}}",
