                  "code": "FETCH_ALL_APPLICATIONS",
                  "type": "BO_FUNCTION",
                  "metadata": {
                    "name": "Fetch All Applications",
                    "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_FORECAST_SIGNALS",
                    "functionName": "listApplications"
                  },
                  "diagram": {
                    "x": 6050,
                    "y": 6557
                  },
                  "outcomes": {
