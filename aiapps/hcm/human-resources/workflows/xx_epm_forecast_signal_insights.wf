                  ]
                },
                {
                  "id": "1795182457680",
                  "code": "PROCESS_APPLICATIONS_LIST",
                  "type": "CODE",
                  "metadata": {
                    "name": "Process Applications List",
                    "returnType": "array",
                    "sourceCode": "let epm = $context.$nodes.FILTER_EPM_INSTANCES.$output.result[$context.$variables.epmInstanceNumber];\nlet apps = $context.$nodes.ITERATE_EPM_INSTANCES.FETCH_ALL_APPLICATIONS.$output.items;\nlet existing = $context.$variables.epmApplications;\n\nif (!Array.isArray(existing)) {\n  existing = [];\n}\n\nif (!Array.isArray(apps)) {\n  apps = [];\n}\n\nvar result = existing.concat(apps.map(function (appName) {\n  return {\n    epmInstance: epm.code,\n    applicationName: appName.name,\n    epmInstanceName: epm.name\n  };\n}));\n\nreturn result; "
                  },
                  "diagram": {
                    "x": 6500,
                    "y": 7223
                  },
                  "outcomes": {
                    "success": "1795182911803"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
