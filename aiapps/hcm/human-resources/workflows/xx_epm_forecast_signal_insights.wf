                  "inputs": [
                    {
                      "id": "1795182345305_epmInstance",
                      "name": "epmInstance",
                      "value": "{{$context.$nodes.LIST_EPM_INSTANCES.$output.items[$context.$variables.epmInstanceNumber].code}}",
                      "required": true,
