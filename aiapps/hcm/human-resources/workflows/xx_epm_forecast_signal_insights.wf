            "name": "Process Application Context",
            "returnType": "object",
            "sourceCode": "function safeParse(input, fallback = null) {\n  if (typeof input !== \"string\") {\n    return input;\n  }\n\n  try {\n    return JSON.parse(input);\n  } catch {\n    return fallback;\n  }\n}\n\nlet result = $context.$app.$OraAppContext || {};\n\nlet res = safeParse(result,{});\n\nreturn res;"
          },
