              "value": "{{$context.$nodes.EXTRACT_SIGNAL_QUERY.$output.limit}}",
              "required": false
            },
            {
              "id": "1795189123092_status",
              "name": "status",
              "value": "{{$context.$nodes.EXTRACT_SIGNAL_QUERY.$output.status}}",
              "required": false
            },
            {
              "id": "1795189123092_epmInstance",
