        {
          "id": "1788267073986",
          "code": "PREPARE_ABOUT_ME_DISPLAY_DATA",
          "type": "CODE",
          "metadata": {
            "description": "Normalizes the person talent profile into safe, display-ready About Me fields for the renderer.",
            "name": "Prepare About Me Display Data 1",
            "returnType": "object",
            "sourceCode": "const profile = $context.$nodes.GET_PERSON_TALENT_PROFILE_1.$output?.items?.[0] || {};\nconsole.log(profile); \nfunction text(value) { return typeof value === \"string\" ? value.trim() : \"\"; }\nfunction entries(value) { return Array.isArray(value) ? value : Array.isArray(value?.items) ? value.items : []; }\nfunction plainText(value) { return text(value).replace(/<[^>]*>/g, \"\").replace(/\\s+/g, \" \").trim(); }\nfunction context(value) { if (typeof value === \"string\") { try { value = JSON.parse(value); } catch (e) { return {}; } } return value && typeof value === \"object\" ? value : {}; }\nfunction id(value) { const result = String(value ?? \"\").trim(); return /^\\d+$/.test(result) ? result : \"\"; }\nconst app = $context?.$app || {};\nconst appContext = context(app.$OraAppContext);\nconst userContext = context(app.$OraUserContext);\nconst selectedPersonId = id(appContext.personId ?? appContext.PersonId);\nconst userId = id(userContext.userId ?? userContext.UserId);\nconst personId = selectedPersonId || userId;\nconst canEdit = Boolean(userId) && (!selectedPersonId || selectedPersonId === userId);\nconst expertiseRecord = entries(profile.areasOfExpertise)[0] || {};\nconst interestRecord = entries(profile.areasOfInterest)[0] || {};\nconst summary = plainText(profile.Summary);\nconst expertise = plainText(expertiseRecord.Expertise);\nconst interest = plainText(interestRecord.Interest);\nconst tags = entries(profile.tags).map(function (item) { return plainText(item?.Tag); }).filter(Boolean).join(\", \");\nreturn { hasContent: Boolean(summary || expertise || interest || tags), summary: summary, areasOfExpertise: { Expertise: expertise }, areasOfInterest: { Interest: interest }, tags: { \"Expertise Tags\": tags }};"
          },
