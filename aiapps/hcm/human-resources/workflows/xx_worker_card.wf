            "name": "Parse Output",
            "sourceCode": "let primaryAssignmentDetails = $context.$nodes.GET_ASSIGNMENT_INFORMATION_BY_PERSON.$output?.items?.[0] ?? {};\n\nlet personDetails = $context.$nodes.GET_PERSON_DETAILS.$output;\nlet emailDetails = {\n  \"WorkEmail\": $context.$nodes.GET_PERSON_DETAILS.$output.WorkEmail\n};\n\nlet phoneDetails = $context.$nodes.GET_PERSON_PHONES.$output;\n\nlet otherCommunicationAccountsDetails = $context.$nodes.GET_PERSON_OTHER_COMMUNICATION_ACCOUNTS.$output?.items?.[0]?.otherCommunicationAccounts?.items ?? [];\n\n\nreturn {\n  \"personDetails\": personDetails,\n  \"primaryAssignmentDetails\": primaryAssignmentDetails,\n  \"emailDetails\": emailDetails,\n  \"phoneDetails\": phoneDetails,\n  \"otherCommunicationAccountsDetails\": otherCommunicationAccountsDetails\n};",
            "returnType": "object"
