          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"ProfileId\": {\n            \"type\": \"string\"\n          },\n          \"Summary\": {\n            \"type\": \"string\"\n          },\n          \"CareerAmbassadorFlag\": {\n            \"type\": \"string\"\n          },\n          \"CareerAmbassadorSummary\": {\n            \"type\": \"string\"\n          },\n          \"favoriteLinks\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"BookmarkId\": {\n                  \"type\": \"string\"\n                },\n                \"Description\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"additionalProperties\": true\n            }\n          },\n          \"areasOfExpertise\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"ExpertiseId\": {\n                  \"type\": \"string\"\n                },\n                \"Expertise\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"additionalProperties\": true\n            }\n          },\n          \"areasOfInterest\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"InterestId\": {\n                  \"type\": \"string\"\n                },\n                \"Interest\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"additionalProperties\": true\n            }\n          },\n          \"tags\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"TagId\": {\n                  \"type\": \"string\"\n                },\n                \"Tag\": {\n                  \"type\": \"string\"\n                },\n                \"ContentItemId\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"additionalProperties\": true\n            }\n          },\n          \"skillSections\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"SectionName\": {\n                  \"type\": \"string\"\n                },\n                \"SectionId\": {\n                  \"type\": \"string\"\n                },\n                \"SectionContext\": {\n                  \"type\": \"string\"\n                },\n                \"ProfileSectionId\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"additionalProperties\": true\n            }\n          }\n        },\n        \"additionalProperties\": true\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"additionalProperties\": true\n      }\n    }\n  },\n  \"additionalProperties\": true,\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\"\n}"
