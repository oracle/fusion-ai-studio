          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"contextType\": {\n            \"type\": \"string\"\n          },\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"timeCreated\": {\n            \"type\": \"string\"\n          },\n          \"timeUpdated\": {\n            \"type\": \"string\"\n          },\n          \"hiddenFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"visibilityCode\": {\n            \"type\": \"string\"\n          },\n          \"$id\": {\n            \"type\": \"string\"\n          },\n          \"$context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"etag\": {\n                \"type\": \"string\"\n              },\n              \"links\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"$self\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"href\": {\n                        \"type\": \"string\"\n                      }\n                    },\n                    \"required\": [\n                      \"href\"\n                    ],\n                    \"additionalProperties\": false\n                  }\n                },\n                \"required\": [\n                  \"$self\"\n                ],\n                \"additionalProperties\": false\n              }\n            },\n            \"required\": [\n              \"etag\",\n              \"links\"\n            ],\n            \"additionalProperties\": false\n          },\n          \"author\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"string\"\n              },\n              \"$id\": {\n                \"type\": \"string\"\n              },\n              \"$context\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"etag\": {\n                    \"type\": \"string\"\n                  },\n                  \"links\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"$self\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                          \"href\": {\n                            \"type\": \"string\"\n                          }\n                        },\n                        \"required\": [\n                          \"href\"\n                        ],\n                        \"additionalProperties\": false\n                      }\n                    },\n                    \"required\": [\n                      \"$self\"\n                    ],\n                    \"additionalProperties\": false\n                  }\n                },\n                \"required\": [\n                  \"etag\",\n                  \"links\"\n                ],\n                \"additionalProperties\": false\n              },\n              \"names\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"items\": {\n                    \"type\": \"array\",\n                    \"items\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"displayName\": {\n                          \"type\": \"string\"\n                        },\n                        \"$id\": {\n                          \"type\": \"string\"\n                        },\n                        \"$context\": {\n                          \"type\": \"object\",\n                          \"properties\": {\n                            \"etag\": {\n                              \"type\": \"string\"\n                            },\n                            \"links\": {\n                              \"type\": \"object\",\n                              \"properties\": {\n                                \"$self\": {\n                                  \"type\": \"object\",\n                                  \"properties\": {\n                                    \"href\": {\n                                      \"type\": \"string\"\n                                    }\n                                  },\n                                  \"required\": [\n                                    \"href\"\n                                  ],\n                                  \"additionalProperties\": false\n                                }\n                              },\n                              \"required\": [\n                                \"$self\"\n                              ],\n                              \"additionalProperties\": false\n                            }\n                          },\n                          \"required\": [\n                            \"etag\",\n                            \"links\"\n                          ],\n                          \"additionalProperties\": false\n                        }\n                      },\n                      \"required\": [\n                        \"displayName\",\n                        \"$id\",\n                        \"$context\"\n                      ],\n                      \"additionalProperties\": false\n                    }\n                  },\n                  \"hasMore\": {\n                    \"type\": \"boolean\"\n                  }\n                },\n                \"required\": [\n                  \"items\",\n                  \"hasMore\"\n                ],\n                \"additionalProperties\": false\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"$id\",\n              \"$context\",\n              \"names\"\n            ],\n            \"additionalProperties\": false\n          },\n          \"worker\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"string\"\n              },\n              \"$id\": {\n                \"type\": \"string\"\n              },\n              \"$context\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"etag\": {\n                    \"type\": \"string\"\n                  },\n                  \"links\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"$self\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                          \"href\": {\n                            \"type\": \"string\"\n                          }\n                        },\n                        \"required\": [\n                          \"href\"\n                        ],\n                        \"additionalProperties\": false\n                      }\n                    },\n                    \"required\": [\n                      \"$self\"\n                    ],\n                    \"additionalProperties\": false\n                  }\n                },\n                \"required\": [\n                  \"etag\",\n                  \"links\"\n                ],\n                \"additionalProperties\": false\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"$id\",\n              \"$context\"\n            ],\n            \"additionalProperties\": false\n          }\n        },\n        \"required\": [\n          \"contextType\",\n          \"text\",\n          \"timeCreated\",\n          \"timeUpdated\",\n          \"hiddenFlag\",\n          \"visibilityCode\",\n          \"$id\",\n          \"$context\",\n          \"author\",\n          \"worker\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"hasMore\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "1788344962622",
          "code": "PREPARE_OTHER_PEOPLE_FEEDBACK",
          "type": "CODE",
          "metadata": {
            "description": "Normalizes readable Person Feedback Notes recommendations, author names and dates for the worker email.",
            "name": "Prepare Other People Feedback",
            "returnType": "object",
            "sourceCode": "const personId = String($context.$nodes.EXTRACT_PERSON_CONTEXT.$output?.result?.personId || \"\");\nconst notes = Array.isArray($context.$nodes.GET_PERSON_NOTES.$output?.items) ? $context.$nodes.GET_PERSON_NOTES.$output.items : [];\n\nfunction dateOnly(value) {\n  const text = String(value || \"\").trim();\n  const match = text.match(/^(\\d{4}-\\d{2}-\\d{2})/);\n  return match ? match[1] : \"\";\n}\n\nfunction plainText(value) {\n  if (typeof value !== \"string\") return \"\";\n  const entities = {amp:\"&\", lt:\"<\", gt:\">\", quot:'\"', apos:\"'\", nbsp:\" \"};\n  return value.replace(/<(script|style)\\b[^>]*>[\\s\\S]*?<\\/\\1\\s*>/gi, \"\")\n    .replace(/<br\\s*\\/?\\s*>|<\\/p\\s*>|<\\/div\\s*>|<\\/li\\s*>/gi, \"\\n\")\n    .replace(/<[^>]*>/g, \"\")\n    .replace(/&(amp|lt|gt|quot|apos|nbsp);/gi, function(match, entity) { return entities[entity.toLowerCase()]; })\n    .replace(/[ \\t]+\\n/g,\"\\n\").replace(/\\n{3,}/g,\"\\n\\n\").trim();\n}\nconst feedback = notes.filter(function (note) {\n  return typeof note?.text === \"string\" && plainText(note.text);\n}).map(function (note) {\n  return {\n    feedback: plainText(note.text),\n    author: (Array.isArray(note.author?.names?.items) ? note.author.names.items : []).map(function(name) { return plainText(name.displayName); }).find(Boolean) || \"Anonymous\",\n    visibility: String(note.visibilityCode || \"\").trim(),\n    category: \"\",\n    createdOn: dateOnly(note.timeCreated)\n  };\n});\n\nconst addFeedbackAction = {\n  title: \"Add Recommendation\",\n  actionText: \"addFeedback\",\n  followUpCommand: 'ora.Invoke(\"feedback\", ' + JSON.stringify({\n    actionId: \"addFeedback\"\n  }) + ')'\n};\n\nconst result = { personId: personId, feedback: feedback, addFeedbackAction: addFeedbackAction };\nreturn result;"
          },
          "diagram": {
            "x": 5470,
