        {
          "id": "1791553939618",
          "code": "GET_VIEWER_WORK_ASSIGNMENT",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Retrieve Logged-in Viewer Work Location",
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_EMPLOYMENTGHR",
            "functionName": "GetAssignmentInformationByPerson",
            "errorNodeId": "12"
          },
          "outcomes": {
            "success": "12"
          },
          "inputs": [
            {
              "id": "1791553939618_personId",
              "name": "personId",
              "type": "string",
              "value": "{{$context.$nodes.RESOLVE_VIEWER_DATE_CONTEXT.$output.result.viewerPersonId}}"
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 7036
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentNumber\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentName\": {\n            \"type\": \"string\"\n          },\n          \"LegalEmployerName\": {\n            \"type\": \"string\"\n          },\n          \"StartDate\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryFlag\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryAssignmentFlag\": {\n            \"type\": \"string\"\n          },\n          \"WorkerType\": {\n            \"type\": \"string\"\n          },\n          \"WorkerNumber\": {\n            \"type\": \"string\"\n          },\n          \"ManagerName\": {\n            \"type\": \"string\"\n          },\n          \"BusinessUnitName\": {\n            \"type\": \"string\"\n          },\n          \"DepartmentName\": {\n            \"type\": \"string\"\n          },\n          \"JobCode\": {\n            \"type\": \"string\"\n          },\n          \"JobName\": {\n            \"type\": \"string\"\n          },\n          \"PositionCode\": {\n            \"type\": \"string\"\n          },\n          \"PositionName\": {\n            \"type\": \"string\"\n          },\n          \"LocationCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationName\": {\n            \"type\": \"string\"\n          },\n          \"GradeCode\": {\n            \"type\": \"string\"\n          },\n          \"GradeName\": {\n            \"type\": \"string\"\n          },\n          \"LocationPostalCode\": {\n            \"type\": \"string\"\n          },\n          \"LocationCountry\": {\n            \"type\": \"string\"\n          },\n          \"LengthOfServiceYears\": {\n            \"type\": \"string\"\n          },\n          \"MarkedAsFavoriteFlag\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"PersonId\",\n          \"AssignmentId\",\n          \"AssignmentNumber\",\n          \"AssignmentName\",\n          \"LegalEmployerName\",\n          \"StartDate\",\n          \"PrimaryFlag\",\n          \"PrimaryAssignmentFlag\",\n          \"WorkerType\",\n          \"WorkerNumber\",\n          \"ManagerName\",\n          \"BusinessUnitName\",\n          \"DepartmentName\",\n          \"JobCode\",\n          \"JobName\",\n          \"PositionCode\",\n          \"PositionName\",\n          \"LocationCode\",\n          \"LocationName\",\n          \"GradeCode\",\n          \"GradeName\",\n          \"LocationPostalCode\",\n          \"LocationCountry\",\n          \"LengthOfServiceYears\",\n          \"MarkedAsFavoriteFlag\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "12",
          "code": "PREPARE_VISAS_PERMITS_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Visa and Permit Details Output",
            "sourceCode": "\nfunction fail() { throw new Error('The visa and permit response could not be loaded safely.'); }\nlet response = $context.$nodes.GET_PERSON_VISAS_PERMITS.$output;\nif (typeof response === 'string') {\n  if (response.length > 1048576) fail();\n  try { response = JSON.parse(response); } catch (error) { fail(); }\n}\nif (!response || typeof response !== 'object' || Array.isArray(response) ||\n    response.error || response.isError || response.timeout ||\n    Number(response.statusCode || response.status || 0) >= 400 ||\n    !Array.isArray(response.items) || response.items.length > 500 ||\n    !(response.hasMore === false || response.hasMore === 'false')) fail();\nconst subject = $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId;\nresponse.items.forEach(function (row) {\n  if (!row || typeof row !== 'object' || Array.isArray(row) ||\n      row.PersonId == null || String(row.PersonId).trim() !== subject) fail();\n});\n\nfunction displayText(value) {\n  if (value == null) return \"\";\n  if (typeof value !== \"string\" || value.length > 8192) fail();\n  return value.trim();\n}\n\nfunction serializeForElement(value) {\n  return JSON.stringify(value)\n    .replace(/&/g, \"\\\\u0026\")\n    .replace(/</g, \"\\\\u003C\")\n    .replace(/>/g, \"\\\\u003E\");\n}\n\n// Date-only values must never be converted through a time zone.\nfunction parse(value) {\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return null;\n    }\n  }\n  return value;\n}\n\nfunction collection(value) {\n  var response = parse(value);\n\n  if (\n    !response ||\n    response.error ||\n    response.timeout ||\n    response.isError ||\n    Number(response.statusCode || response.status || 0) >= 400 ||\n    String(response.hasMore).toLowerCase() === \"true\" ||\n    !Array.isArray(response.items)\n  ) {\n    return [];\n  }\n\n  return response.items;\n}\n\nvar sessions = collection($context.$nodes.READ_VIEWER_SESSION?.$output);\nvar session = sessions.length === 1 && sessions[0] ? sessions[0] : {};\nvar preference = typeof session.DateFormat === \"string\"\n  ? session.DateFormat.trim()\n  : \"\";\nvar language = String(session.Language || session.DefaultLanguage || \"\").toLowerCase();\nvar country = typeof session.Territory === \"string\"\n  ? session.Territory.trim().toUpperCase()\n  : \"\";\n\n// Match the Performance Goals fallback using only the authenticated viewer.\nvar viewerId = $context.$nodes.RESOLVE_VIEWER_DATE_CONTEXT.$output.result.viewerPersonId;\n\nif (!country && viewerId) {\n  var countries = [];\n\n  collection($context.$nodes.GET_VIEWER_WORK_ASSIGNMENT?.$output).forEach(function (row) {\n    if (!row || (row.PersonId != null && String(row.PersonId).trim() !== viewerId)) return;\n    if (row.PrimaryFlag != null && !/^(true|y)$/i.test(String(row.PrimaryFlag))) return;\n\n    var value = typeof row.LocationCountry === \"string\"\n      ? row.LocationCountry.trim().toUpperCase()\n      : \"\";\n\n    if (countries.indexOf(value) < 0) countries.push(value);\n  });\n\n  if (countries.length === 1) country = countries[0];\n}\n\nvar monthNames = [\n  \"January\", \"February\", \"March\", \"April\", \"May\", \"June\",\n  \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"\n];\n\nfunction preferenceFormat(parts) {\n  if (!preference || preference.length > 80) return null;\n\n  var tokens = preference.match(\n    /yyyy|YYYY|yy|YY|MMMM|MMM|MM|M|dd|DD|d|D|[\\s/.,-]+/g\n  );\n\n  if (!tokens || tokens.join(\"\") !== preference) return null;\n\n  var dateTokens = tokens.filter(function (token) {\n    return /[yYMdD]/.test(token);\n  });\n\n  if (\n    dateTokens.length !== 3 ||\n    dateTokens.filter(function (token) { return /^[yY]/.test(token); }).length !== 1 ||\n    dateTokens.filter(function (token) { return /^M/.test(token); }).length !== 1 ||\n    dateTokens.filter(function (token) { return /^[dD]/.test(token); }).length !== 1\n  ) {\n    return null;\n  }\n\n  if (preference.indexOf(\"MMM\") >= 0 && !/^en(?:[-_]|$)/.test(language)) {\n    return null;\n  }\n\n  return tokens.map(function (token) {\n    if (/^(yyyy|YYYY)$/.test(token)) return parts[1];\n    if (/^(yy|YY)$/.test(token)) return parts[1].slice(-2);\n    if (token === \"MMMM\") return monthNames[Number(parts[2]) - 1];\n    if (token === \"MMM\") return monthNames[Number(parts[2]) - 1].slice(0, 3);\n    if (token === \"MM\") return parts[2];\n    if (token === \"M\") return String(Number(parts[2]));\n    if (/^(dd|DD)$/.test(token)) return parts[3];\n    if (/^(d|D)$/.test(token)) return String(Number(parts[3]));\n    return token;\n  }).join(\"\");\n}\n\nfunction formatDate(value) {\n  if (value == null || value === \"\") return \"\";\n  if (typeof value !== \"string\") return value;\n\n  var parts = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(value);\n  if (!parts) return value;\n\n  var year = Number(parts[1]);\n  var month = Number(parts[2]);\n  var day = Number(parts[3]);\n  var leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\n  var days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n\n  if (year < 1 || month < 1 || month > 12 || day < 1 || day > days[month - 1]) {\n    return value;\n  }\n\n  var preferred = preferenceFormat(parts);\n  if (preferred !== null) return preferred;\n\n  if (country === \"US\") return parts[2] + \"/\" + parts[3] + \"/\" + parts[1];\n  if ([\"IN\", \"GB\", \"UK\", \"AU\", \"SG\"].indexOf(country) >= 0) {\n    return parts[3] + \"/\" + parts[2] + \"/\" + parts[1];\n  }\n\n  return value;\n}\n\n\nvar rows = Array.isArray(response.items) ? response.items.slice() : [];\n\n// Latest EffectiveStartDate first; oldest last.\nrows.sort(function (a, b) {\n  var dateA = displayText(a && a.EffectiveStartDate);\n  var dateB = displayText(b && b.EffectiveStartDate);\n\n  return new Date(dateB || 0).getTime() - new Date(dateA || 0).getTime();\n});\n\nvar items = rows.map(function (row) {\n  var item = {\n    title: displayText(row && row.VisaPermitNumber) || \"Visa or permit\"\n  };\n\n  var subtitleParts = [\n    displayText(row && row.VisaPermitTypeMeaning),\n    displayText(row && row.VisaPermitCategoryMeaning),\n    displayText(row && row.VisaPermitStatusMeaning)\n  ].filter(Boolean);\n\n  if (subtitleParts.length) {\n    item.subtitle = subtitleParts.join(\" | \");\n  }\n\n  var badgeText = displayText(row && row.IssuingCountryName);\n  if (badgeText) {\n    item.badgeText = badgeText;\n    item.priority = \"medium\";\n  }\n\n  var fromDate = formatDate(displayText(row && row.IssueDate));\n  var toDate = formatDate(displayText(row && row.EntryDate));\n\n  if (fromDate || toDate) {\n    item.summary = fromDate && toDate\n      ? \"Start Date: \" + fromDate + \" | End Date: \" + toDate\n      : fromDate\n        ? \"Start Date: \" + fromDate\n        : \"End Date: \" + toDate;\n  }\n\n  return item;\n});\n\nvar widget = {\n  patternId: \"messageListWidget\",\n  properties: {\n    subtitle: \"Visa and permit details\",\n    items: items\n  }\n};\n\nreturn '<oraInfoDisplay key=\"summary\">' +\n  serializeForElement(widget) +\n  '</oraInfoDisplay>';",
            "returnType": "string",
            "errorNodeId": "hr_visa_request_error"
          },
          "outcomes": {
            "success": "4"
          },
          "inputs": [],
          "diagram": {
            "x": 5450,
            "y": 7258
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
