  "workflowId": "300100717477131",
  "workflowCode": "XX_PER_VISAS_PERMITS",
  "name": "Worker Visas and Permits",
  "description": "Displays current and future visa and permit records for the selected worker, including document number, type, status, issuing country, and available dates. Answers questions using the available visa and permit information.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "id": "start",
          "code": "START",
          "type": "START",
          "metadata": {
