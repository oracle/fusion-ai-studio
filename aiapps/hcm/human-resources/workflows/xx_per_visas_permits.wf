          }
        },
        {
          "id": "1791553939619",
          "code": "VALIDATE_VISA_RENDERING",
          "type": "CODE",
          "metadata": {
            "name": "Validate Visa Rendering",
            "sourceCode": "const expected = $context.$nodes.PREPARE_VISAS_PERMITS_OUTPUT.$output?.result;\nconst output = $context.$nodes.RENDER_INIT_DISPLAY.$output;\nconst rendered = typeof output === \"string\"\n  ? output\n  : output && typeof output.result === \"string\"\n    ? output.result\n    : null;\n\nif (typeof expected !== \"string\" || rendered === null) {\n  throw new Error(\"Unable to validate visa/permit rendering\");\n}\n\nif (rendered.trim() !== expected.trim()) {\n  throw new Error(\"Visa/permit rendering did not match validated output\");\n}\n\nreturn expected;",
            "returnType": "string",
            "errorNodeId": "hr_visa_request_error"
          },
          "outcomes": {
            "success": "1791553939620"
          },
          "inputs": [],
          "diagram": {
            "x": 5450,
            "y": 7702
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1791553939620",
          "code": "RETURN_VALIDATED_VISA_DISPLAY",
          "type": "RETURN",
          "metadata": {
            "name": "Return Validated Visa Display"
          },
          "outcomes": {},
          "inputs": [
            {
              "id": "1791553939620_returnValue",
