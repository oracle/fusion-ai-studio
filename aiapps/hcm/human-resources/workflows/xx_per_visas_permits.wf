        {
          "id": "hr_safe_visa_query",
          "code": "PREPARE_SAFE_VISA_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Safe Visa Query",
            "sourceCode": "\nfunction fail() { throw new Error('The visa and permit response could not be loaded safely.'); }\nlet response = $context.$nodes.GET_PERSON_VISAS_PERMITS_QUERY.$output;\nif (typeof response === 'string') {\n  if (response.length > 1048576) fail();\n  try { response = JSON.parse(response); } catch (error) { fail(); }\n}\nif (!response || typeof response !== 'object' || Array.isArray(response) ||\n    response.error || response.isError || response.timeout ||\n    Number(response.statusCode || response.status || 0) >= 400 ||\n    !Array.isArray(response.items) || response.items.length > 500 ||\n    !(response.hasMore === false || response.hasMore === 'false')) fail();\nconst subject = $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId;\nresponse.items.forEach(function (row) {\n  if (!row || typeof row !== 'object' || Array.isArray(row) ||\n      row.PersonId == null || String(row.PersonId).trim() !== subject) fail();\n});\n\nconst fields = [\"VisaPermitNumber\", \"VisaPermitTypeMeaning\", \"VisaPermitCategoryMeaning\", \"VisaPermitStatusMeaning\", \"IssuingCountryName\", \"IssuingAuthority\", \"IssuingLocation\", \"Profession\", \"IssueDate\", \"EntryDate\", \"ExpirationDate\", \"EffectiveStartDate\", \"EffectiveEndDate\"];\nconst records = response.items.map(function (row) {\n  const record = {};\n  fields.forEach(function (field) {\n    const value = row[field];\n    if (value == null || value === '') return;\n    if (typeof value !== 'string' || value.length > 8192) fail();\n    record[field] = value.trim();\n  });\n  return record;\n});\nfunction safeJson(value) {\n  return JSON.stringify(value).replace(/[<>&]/g, function (character) {\n    return '\\\\u' + character.charCodeAt(0).toString(16).padStart(4, '0');\n  });\n}\nreturn {\n  recordsJson: safeJson(records),\n  questionJson: safeJson($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.question)\n};\n",
            "returnType": "object",
            "errorNodeId": "hr_visa_request_error"
          },
          "outcomes": {
            "success": "5"
          },
          "inputs": [],
          "diagram": {
            "x": 6145,
            "y": 6370
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
