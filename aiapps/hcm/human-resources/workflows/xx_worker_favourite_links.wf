        {
          "id": "parse_minimal_edit_links_action",
          "code": "PARSE_MINIMAL_EDIT_LINKS_ACTION",
          "type": "CODE",
          "metadata": {
            "name": "Parse Minimal Edit Links Action",
            "returnType": "object",
            "description": "Validates allowlisted edit/add/save actions and bounded form fields, rejects duplicate or unknown fields and enforces the viewer's own person ID before any write path.",
            "sourceCode": "\nfunction securePlainObject(value) {\n  return !!value && typeof value === \"object\" && !Array.isArray(value) &&\n    (Object.getPrototypeOf(value) === Object.prototype || Object.getPrototypeOf(value) === null);\n}\nfunction secureObject(value, maximum = 16384) {\n  if (typeof value === \"string\") {\n    if (!value.trim() || value.length > maximum) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value)) return null;\n  let count = 0;\n  function safeTree(item, depth) {\n    if (++count > 2000 || depth > 12) return false;\n    if (!item || typeof item !== \"object\") return true;\n    if (!Array.isArray(item) && !securePlainObject(item)) return false;\n    return Object.keys(item).every(function (key) {\n      return ![\"__proto__\", \"constructor\", \"prototype\"].includes(key) && safeTree(item[key], depth + 1);\n    });\n  }\n  return safeTree(value, 0) ? value : null;\n}\nfunction secureId(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  return typeof value === \"string\" && /^[1-9][0-9]{0,19}$/.test(value.trim()) ? value.trim() : \"\";\n}\nfunction secureText(value, maximum = 4000) {\n  return typeof value === \"string\" && value.length <= maximum\n    ? value.replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/g, \"\").trim() : \"\";\n}\nfunction secureEscape(value) {\n  return value.replace(/[&<>]/g, function (character) {\n    return String.fromCharCode(38) + ({ \"&\": \"amp\", \"<\": \"lt\", \">\": \"gt\" })[character] + \";\";\n  });\n}\nfunction secureCollection(value, maximum = 500) {\n  if (typeof value === \"string\") {\n    if (value.length > 1000000) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value) || value.error || value.timeout || value.isError ||\n      Number(value.statusCode || value.status || 0) >= 400 || !Array.isArray(value.items) ||\n      value.items.length > maximum || !value.items.every(securePlainObject)) return null;\n  return value;\n}\nfunction secureUrl(value) {\n  if (typeof value !== \"string\" || value.length > 2048) return \"\";\n  const url = value.trim();\n  if (/[\\s\\\\<>\"'\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/.test(url) ||\n      /%(?:0[0-9a-f]|1[0-9a-f]|7f|5c)/i.test(url)) return \"\";\n  return /^https?:\\/\\/(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$/i.test(url) ? url : \"\";\n}\nconst canEditLinks = $context.$nodes.RESOLVE_EDIT_LINKS_PERMISSION.$output?.result?.canEditLinks === true;\nif (!canEditLinks) return { valid: false, actionId: \"\", personId: \"\", favoriteLinks: { items: [] } };\n\n\nconst app = $context.$app || {};\nconst viewerId = $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.loggedInPersonId;\nlet action = app.$OraActionPayload != null && app.$OraActionPayload !== \"\" ? app.$OraActionPayload : app.$OraAction;\nif ((typeof action === \"string\" && action.length > 16384) ||\n    (typeof action !== \"string\" && !secureObject(action))) return { valid: false };\n\n\nfunction text(value, maxLength) { return typeof value === \"string\" ? value.trim().slice(0, maxLength) : \"\"; }\nfunction numericId(value) { const id = String(value ?? \"\").trim(); return /^\\d+$/.test(id) ? id : \"\"; }\nfunction hrefFrom(value) { return secureUrl(value); }\nfunction fromFormSubmit(value) {\n  const match = String(value || \"\").trim().match(/^<oraFormSubmit\\s+id=\"([^\"]+)\">([\\s\\S]*)<\\/oraFormSubmit>$/);\n  if (!match || (match[1] !== \"edit_favorite_links_form\" && match[1] !== \"add_favorite_link_form\")) return null;\n  try {\n    const fields = JSON.parse(match[2]); if (!Array.isArray(fields) || fields.length > 40) return null;\n    const seen = Object.create(null);\n    const grouped = {};\n    fields.forEach(function (field) {\n      if (!securePlainObject(field)) throw new Error(\"Invalid form\");\n      const id = text(field.id, 240);\n      if (seen[id]) throw new Error(\"Duplicate field\");\n      seen[id] = true;\n      const found = id.match(/^link_(\\d+)_(\\d*)_(description|href)$/);\n      const addFound = id.match(/^addlink_(\\d+)_(description|href)$/);\n      if (!found && !addFound) throw new Error(\"Unknown form field\");\n      const personId = found ? found[1] : addFound[1];\n      if (personId !== viewerId) throw new Error(\"Employee mismatch\");\n      const bookmarkId = found ? found[2] : \"\";\n      const fieldName = found ? found[3] : addFound[2];\n      const key = personId + \":\" + bookmarkId;\n      grouped[key] = grouped[key] || { personId: personId, BookmarkId: bookmarkId, description: \"\", href: \"\" };\n      grouped[key][fieldName] = text(field?.value, 4096);\n    });\n    const values = Object.keys(grouped).map(function (key) {\n      const item = grouped[key], href = hrefFrom(item.href);\n      return item.description && href ? { personId: item.personId, BookmarkId: item.BookmarkId, description: item.description.slice(0, 500), href: href } : null;\n    }).filter(Boolean);\n    const first = values[0] || {};\n    return { actionId: \"saveLink\", personId: first.personId || \"\", items: values };\n  } catch (e) { return null; }\n}\n\nif (typeof action === \"string\") {\n  const formResult = fromFormSubmit(action);\n  if (formResult) return { valid: formResult.items.length === 1 && formResult.personId === viewerId, actionId: formResult.actionId, personId: formResult.personId, favoriteLinks: { items: formResult.items } };\n  action = secureObject(action);\n}\nconst payload = action && typeof action === \"object\" ? (action.data && typeof action.data === \"object\" ? action.data : action) : {};\nif (!secureObject(payload) || Object.keys(payload).some(key => ![\"actionId\", \"favoriteLinks\"].includes(key)) ||\n    (payload.favoriteLinks && Object.keys(payload.favoriteLinks).some(key => key !== \"items\"))) return { valid: false };\nconst sourceLinks = payload.favoriteLinks && typeof payload.favoriteLinks === \"object\" ? payload.favoriteLinks : null;\nconst sourceItems = Array.isArray(sourceLinks?.items) ? sourceLinks.items : [];\nif (sourceItems.length > 20 || !sourceItems.length || !sourceItems.every(function (item) { return securePlainObject(item) && secureId(item.personId ?? item.PersonId) === viewerId && Object.keys(item).every(function (key) { return [\"personId\", \"PersonId\", \"BookmarkId\", \"bookmarkId\", \"description\", \"Description\", \"href\", \"URL\"].includes(key); }); })) return { valid: false };\nconst suppliedActionId = String(payload.actionId || action?.actionId || \"\");\nconst actionId = suppliedActionId;\nif (![\"editLink\", \"addLink\", \"saveLink\"].includes(actionId)) return { valid: false };\nconst personId = numericId(sourceItems[0]?.personId ?? sourceItems[0]?.PersonId);\nconst items = sourceItems.map(function (item) {\n  const bookmarkId = text(item?.BookmarkId ?? item?.bookmarkId, 100), description = text(item?.description ?? item?.Description, 500), rawHref = text(item?.href ?? item?.URL, 4096), href = hrefFrom(rawHref);\n  const isEmptyRow = bookmarkId === \"\" && description === \"\" && rawHref === \"\";\n  const itemPersonId = numericId(item?.personId ?? item?.PersonId) || personId;\n  return description && href ? { personId: itemPersonId, BookmarkId: bookmarkId, description: description, href: href } : isEmptyRow ? { personId: itemPersonId, BookmarkId: \"\", description: \"\", href: \"\" } : null;\n}).filter(Boolean);\nreturn { valid: personId === viewerId && ((actionId === \"editLink\" && Array.isArray(sourceLinks?.items) && personId !== \"\") || (actionId === \"addLink\" && personId !== \"\") || (actionId === \"saveLink\" && items.length === 1 && personId !== \"\")), actionId: actionId, personId: personId, favoriteLinks: { items: items } };",
