        {
          "id": "resolve_edit_links_permission",
          "code": "RESOLVE_EDIT_LINKS_PERMISSION",
          "type": "CODE",
          "metadata": {
            "name": "Resolve Edit Links Permission",
            "returnType": "object",
            "description": "Allows link editing only when validated selected person and signed-in viewer IDs match; malformed app context never grants edit permission.",
            "sourceCode": "\nconst context = $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result;\nreturn { canEditLinks: context.valid === true && !!context.loggedInPersonId &&\n  context.personId === context.loggedInPersonId };\n",
            "errorNodeId": "1"
          },
          "outcomes": {
            "success": "switch_message_hint"
          },
          "inputs": [],
          "diagram": {
