            "sourceCode": "const parsed = $context.$nodes.PARSE_MINIMAL_EDIT_LINKS_ACTION.$output?.result || {};\nconst personId = String(parsed.personId || parsed.favoriteLinks?.items?.[0]?.personId || \"\");\nreturn {\n  id: \"add_favorite_link_form\",\n  title: \"Add Links\",\n  description: \"\",\n  readOnly: false,\n  submitText: \"Save\",\n  cancelText: \"Cancel\",\n  fields: [\n    { id: \"addlink_\" + personId + \"_description\", type: \"text\", label: \"Name\", value: \"\" },\n    { id: \"addlink_\" + personId + \"_href\", type: \"text\", label: \"URL\", value: \"\" }\n  ]\n};",
