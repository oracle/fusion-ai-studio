        },
        {
          "id": "VALIDATE_REQUEST_GET_PERSON_TALENT_PROFILE",
          "code": "VALIDATE_REQUEST_GET_PERSON_TALENT_PROFILE",
          "type": "CODE",
          "metadata": {
            "name": "Validate Request Get Person Talent Profile",
            "description": "Rejects malformed identifiers, query/finder delimiters and unsupported request-body fields before the BO request. This is input validation; native Fusion authorization remains mandatory.",
            "returnType": "object",
            "sourceCode": "function reject(name) { throw new Error(\"Invalid HR request parameter: \" + name); }\nfunction id(value,name) {\n  if(typeof value === \"number\") {if(!Number.isSafeInteger(value)||value<=0) reject(name);return value;}\n  if(typeof value!==\"string\" || !/^[1-9][0-9]{0,15}$/.test(value.trim()) || !Number.isSafeInteger(Number(value.trim()))) reject(name);\n  return Number(value.trim());\n}\n\nconst checked={};\nchecked[\"personId\"]=id(($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId),\"personId\");\nreturn checked;",
            "errorNodeId": "HR_REQUEST_REJECTED"
          },
          "outcomes": {
            "success": "get_person_talent_profile"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5900,
            "y": 8980
          }
        },
        {
          "id": "get_person_talent_profile",
          "code": "GET_PERSON_TALENT_PROFILE",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Person Talent Profile",
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_TALENTPERSONPROFILES",
            "functionName": "getall_talentPersonProfiles",
            "description": "Uses Oracle-authorized getall_talentPersonProfiles on ORA_HCM_GLOBALHUMA_XX_TALENTPERSONPROFILES.",
            "errorNodeId": "1"
          },
          "outcomes": {
            "success": "prepare_favourite_links_data"
          },
          "inputs": [
            {
              "id": "talent_profile_person_id",
              "name": "personId",
              "value": "{{$context.$nodes.VALIDATE_REQUEST_GET_PERSON_TALENT_PROFILE.$output.result.personId}}",
              "required": false,
              "type": "integer"
            }
          ],
          "diagram": {
            "x": 5900,
            "y": 9202
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"ProfileId\": {\n            \"type\": \"string\"\n          },\n          \"Summary\": {\n            \"type\": \"string\"\n          },\n          \"CareerAmbassadorFlag\": {\n            \"type\": \"string\"\n          },\n          \"CareerAmbassadorSummary\": {\n            \"type\": \"string\"\n          },\n          \"favoriteLinks\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"BookmarkId\": {\n                  \"type\": \"string\"\n                },\n                \"Description\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"BookmarkId\",\n                \"Description\"\n              ],\n              \"additionalProperties\": false\n            }\n          },\n          \"areasOfExpertise\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"ExpertiseId\": {\n                  \"type\": \"string\"\n                },\n                \"Expertise\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"ExpertiseId\",\n                \"Expertise\"\n              ],\n              \"additionalProperties\": false\n            }\n          },\n          \"areasOfInterest\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"InterestId\": {\n                  \"type\": \"string\"\n                },\n                \"Interest\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"InterestId\",\n                \"Interest\"\n              ],\n              \"additionalProperties\": false\n            }\n          },\n          \"tags\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"TagId\": {\n                  \"type\": \"string\"\n                },\n                \"Tag\": {\n                  \"type\": \"string\"\n                },\n                \"ContentItemId\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"TagId\",\n                \"Tag\",\n                \"ContentItemId\"\n              ],\n              \"additionalProperties\": false\n            }\n          },\n          \"skillSections\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"SectionName\": {\n                  \"type\": \"string\"\n                },\n                \"SectionId\": {\n                  \"type\": \"string\"\n                },\n                \"SectionContext\": {\n                  \"type\": \"string\"\n                },\n                \"ProfileSectionId\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"SectionName\",\n                \"SectionId\",\n                \"SectionContext\",\n                \"ProfileSectionId\"\n              ],\n              \"additionalProperties\": false\n            }\n          }\n        },\n        \"required\": [\n          \"ProfileId\",\n          \"Summary\",\n          \"CareerAmbassadorFlag\",\n          \"CareerAmbassadorSummary\",\n          \"favoriteLinks\",\n          \"areasOfExpertise\",\n          \"areasOfInterest\",\n          \"tags\",\n          \"skillSections\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "prepare_favourite_links_data",
          "code": "PREPARE_FAVOURITE_LINKS_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Favourite Links Data",
            "returnType": "object",
            "description": "Normalizes validated favorite links from the person talent profile for display.",
            "sourceCode": "\nfunction securePlainObject(value) {\n  return !!value && typeof value === \"object\" && !Array.isArray(value) &&\n    (Object.getPrototypeOf(value) === Object.prototype || Object.getPrototypeOf(value) === null);\n}\nfunction secureObject(value, maximum = 16384) {\n  if (typeof value === \"string\") {\n    if (!value.trim() || value.length > maximum) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value)) return null;\n  let count = 0;\n  function safeTree(item, depth) {\n    if (++count > 2000 || depth > 12) return false;\n    if (!item || typeof item !== \"object\") return true;\n    if (!Array.isArray(item) && !securePlainObject(item)) return false;\n    return Object.keys(item).every(function (key) {\n      return ![\"__proto__\", \"constructor\", \"prototype\"].includes(key) && safeTree(item[key], depth + 1);\n    });\n  }\n  return safeTree(value, 0) ? value : null;\n}\nfunction secureId(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  return typeof value === \"string\" && /^[1-9][0-9]{0,19}$/.test(value.trim()) ? value.trim() : \"\";\n}\nfunction secureText(value, maximum = 4000) {\n  return typeof value === \"string\" && value.length <= maximum\n    ? value.replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/g, \"\").trim() : \"\";\n}\nfunction secureEscape(value) {\n  return value.replace(/[&<>]/g, function (character) {\n    return String.fromCharCode(38) + ({ \"&\": \"amp\", \"<\": \"lt\", \">\": \"gt\" })[character] + \";\";\n  });\n}\nfunction secureCollection(value, maximum = 500) {\n  if (typeof value === \"string\") {\n    if (value.length > 1000000) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value) || value.error || value.timeout || value.isError ||\n      Number(value.statusCode || value.status || 0) >= 400 || !Array.isArray(value.items) ||\n      value.items.length > maximum || !value.items.every(securePlainObject)) return null;\n  return value;\n}\nfunction secureUrl(value) {\n  if (typeof value !== \"string\" || value.length > 2048) return \"\";\n  const url = value.trim();\n  if (/[\\s\\\\<>\"'\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/.test(url) ||\n      /%(?:0[0-9a-f]|1[0-9a-f]|7f|5c)/i.test(url)) return \"\";\n  return /^https?:\\/\\/(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$/i.test(url) ? url : \"\";\n}\nconst response = secureCollection($context.$nodes.GET_PERSON_TALENT_PROFILE.$output);\nconst personIdExpected = $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId;\nif (!response || response.items.length !== 1 || String(response.hasMore).toLowerCase() === \"true\" ||\n    (response.items[0].PersonId != null && String(response.items[0].PersonId) !== personIdExpected)) throw new Error(\"Favourite Links data could not be verified.\");\nconst profile = response.items[0];\n\nfunction text(value, maxLength = 4000) { return secureText(value, maxLength); }\nfunction entries(value) {\n  if (Array.isArray(value)) return value;\n  if (Array.isArray(value?.items)) return value.items;\n  return [];\n}\nfunction isHttpUrl(value) { return !!secureUrl(value); }\nfunction markdownLabel(value) { return value.replace(/\\\\/g, \"\\\\\\\\\").replace(/\\[/g, \"\\\\[\").replace(/\\]/g, \"\\\\]\"); }\nfunction markdownUrl(value) { return value.replace(/\\\\/g, \"\\\\\\\\\").replace(/\\)/g, \"\\\\)\"); }\n\nconst favoriteLinks = entries(profile.favoriteLinks).map(function (item) {\n  const description = text(item?.Description);\n  const url = text(item?.URL);\n  return description && isHttpUrl(url) ? \"[\" + markdownLabel(description) + \"](\" + markdownUrl(url) + \")\" : \"\";\n}).filter(Boolean).join(\"\\n\");\n\nconst editLinksAction = {\n  title: \"Edit Links\",\n  actionText: \"editLinks\",\n  followUpCommand: 'ora.Invoke(\"favouriteLinks\", ' + JSON.stringify({ actionId: \"editLinks\" }) + ')'\n};\n\nreturn { hasContent: Boolean(favoriteLinks), favoriteLinks: favoriteLinks, editLinksAction: editLinksAction };",
            "errorNodeId": "1"
          },
          "outcomes": {
            "success": "favourite_links_available"
          },
          "inputs": [],
          "diagram": {
            "x": 5900,
            "y": 9424
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "favourite_links_available",
          "code": "FAVOURITE_LINKS_AVAILABLE",
          "type": "CONDITION",
          "metadata": {
            "name": "Favourite Links Available",
            "description": "Routes only requests that satisfy Favourite Links Available."
