        {
          "id": "extract_person_context",
          "code": "EXTRACT_PERSON_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Validate Panel Request and Employee Context",
            "returnType": "object",
            "sourceCode": "$context.$variables.contextData = null;\n\nfunction plainObject(value) {\n  return !!value && typeof value === \"object\" && !Array.isArray(value) &&\n    (Object.getPrototypeOf(value) === Object.prototype || Object.getPrototypeOf(value) === null);\n}\nfunction safeObject(value, maximum = 16384) {\n  if (typeof value === \"string\") {\n    if (!value.trim() || value.length > maximum) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!plainObject(value)) return null;\n  let count = 0;\n  function safeTree(item, depth) {\n    if (++count > 2000 || depth > 12) return false;\n    if (!item || typeof item !== \"object\") return true;\n    if (!Array.isArray(item) && !plainObject(item)) return false;\n    return Object.keys(item).every(function (key) {\n      return ![\"__proto__\", \"constructor\", \"prototype\"].includes(key) && safeTree(item[key], depth + 1);\n    });\n  }\n  return safeTree(value, 0) ? value : null;\n}\nfunction numericId(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  return typeof value === \"string\" && /^[1-9][0-9]{0,19}$/.test(value.trim()) ? value.trim() : \"\";\n}\nfunction text(value, maximum = 4000) {\n  return typeof value === \"string\" && value.length <= maximum\n    ? value.replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/g, \"\").trim() : \"\";\n}\nfunction escapeText(value) {\n  return value.replace(/[&<>]/g, function (character) {\n    return String.fromCharCode(38) + ({ \"&\": \"amp\", \"<\": \"lt\", \">\": \"gt\" })[character] + \";\";\n  });\n}\nfunction collection(value, maximum = 500) {\n  if (typeof value === \"string\") {\n    if (value.length > 1000000) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!plainObject(value) || value.error || value.timeout || value.isError ||\n      Number(value.statusCode || value.status || 0) >= 400 || !Array.isArray(value.items) ||\n      value.items.length > maximum || !value.items.every(plainObject)) return null;\n  return value;\n}\nfunction webUrl(value) {\n  if (typeof value !== \"string\" || value.length > 2048) return \"\";\n  const url = value.trim();\n  if (/[\\s\\\\<>\"'\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/.test(url) ||\n      /%(?:0[0-9a-f]|1[0-9a-f]|7f|5c)/i.test(url)) return \"\";\n  return /^https?:\\/\\/(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$/i.test(url) ? url : \"\";\n}\n\nconst app = $context.$app || {};\nconst stage = app.$OraMessageHint;\nconst rejected = { valid: false, personId: \"\", loggedInPersonId: \"\", hasSelectedPersonId: false,\n  isFeedbackAction: false, isFeedbackQuery: false, questionJson: \"\", errorMessage: \"Unable to process this panel request. Select a valid employee and retry.\" };\nif (![\"InitDisplay\",\"AdditionalContent\",\"Query\",\"InvokeAction\"].includes(stage)) return rejected;\nconst rawApp = app.$OraAppContext;\nconst appPresent = rawApp != null && !(typeof rawApp === \"string\" && !rawApp.trim());\nconst selected = appPresent ? safeObject(rawApp) : null;\nif (appPresent && !selected) return rejected;\nconst viewer = safeObject(app.$OraUserContext);\nfunction aliasId(object, keys) {\n  if (!object) return \"\";\n  const supplied = keys.filter(function (key) { return Object.prototype.hasOwnProperty.call(object, key); });\n  if (!supplied.length) return \"\";\n  const values = supplied.map(function (key) { return numericId(object[key]); });\n  return values.every(function (value) { return value && value === values[0]; }) ? values[0] : \"\";\n}\nfunction missing(value) {\n  return value == null || (typeof value === \"string\" && !value.trim());\n}\nconst selectedKeys = selected ? [\"personId\", \"PersonId\"].filter(function (key) {\n  return Object.prototype.hasOwnProperty.call(selected, key) && !missing(selected[key]);\n}) : [];\nconst selectedValues = selectedKeys.map(function (key) { return numericId(selected[key]); });\nif (!selectedValues.every(function (value) { return value && value === selectedValues[0]; })) return rejected;\nconst selectedId = selectedValues[0] || \"\";\nconst viewerId = aliasId(viewer, [\"userId\", \"UserId\"]);\nconst rawRestPersonId = $context?.$triggers?.REST?.$input?.personId;\nconst passedPersonId = !selectedId && !missing(rawRestPersonId) ? numericId(rawRestPersonId) : \"\";\nif (!selectedId && !missing(rawRestPersonId) && !passedPersonId) return rejected;\nconst resolvedId = selectedId || passedPersonId || viewerId;\nif (true && !resolvedId) return rejected;\nif (stage === \"Query\" && (!text($context.$system.$inputMessage, 4000))) return rejected;\nconst questionJson = stage === \"Query\" ? JSON.stringify({ question: text($context.$system.$inputMessage, 4000) })\n  .replace(/[<>&]/g, function (c) { return \"\\\\u\" + c.charCodeAt(0).toString(16).padStart(4, \"0\"); }) : \"\";\nreturn { valid: true, personId: resolvedId, loggedInPersonId: viewerId,\n  hasSelectedPersonId: !!selectedId, isFeedbackAction: stage === \"InvokeAction\",\n  isFeedbackQuery: stage === \"Query\", questionJson: questionJson, errorMessage: \"\" };\n",
            "description": "Validates supported app stages, bounded JSON context, positive employee IDs and a bounded question. Explicit malformed selected-worker context fails closed; only absent context permits signed-in-user fallback. Oracle BO authorization remains authoritative.",
            "errorNodeId": "1"
          },
          "outcomes": {
            "success": "2"
          },
          "inputs": [],
          "diagram": {
            "x": 6125,
            "y": 5206
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
