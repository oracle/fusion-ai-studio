            "sourceCode": "const allowed=[\"description\", \"url\", \"Expertise Tags\"];\n\nfunction reject() { throw new Error(\"Unverified HR answer.\"); }\nfunction clean(value) { return value.replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]/g,\"\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\nlet size=0;const blocked=[];\nfunction project(value,depth) {\n  if(depth>20) reject();\n  if(typeof value === \"string\") {\n    size+=value.length;if(size>1000000) reject();\n    // Cached contexts and the existing *Json values can be serialized JSON.\n    const trimmed=value.trim();\n    if(depth===0 && /^[\\[{\\\"]/.test(trimmed)) {try {return project(JSON.parse(trimmed),depth+1);}catch(e){reject();}}\n    return clean(value);\n  }\n  if(Array.isArray(value)) {if(value.length>1000) reject();return value.map(function(v){return project(v,depth+1);});}\n  if(value && typeof value === \"object\") {\n    const result={};Object.keys(value).forEach(function(k){\n      if(allowed.indexOf(k)>=0) result[k]=project(value[k],depth+1);\n      else if(/(?:Id|ID|Identifier|Key)$/.test(k) && [\"string\",\"number\"].includes(typeof value[k])) blocked.push(String(value[k]));\n    });return result;\n  }\n  if(value==null || typeof value === \"boolean\" || (typeof value === \"number\" && Number.isFinite(value))) return value;\n  reject();\n}\n\nconst raw=[$context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.questionJson,$context.$variables.contextData];\nconst projected=raw.map(function(v){return project(v,0);});\n\nconst allowedUrls=[];\nfunction collectUrls(v) {\n  if(typeof v === \"string\") (v.match(/https?:\\/\\/[^\\s<>\"\\])]+/gi)||[]).forEach(function(url){allowedUrls.push(url);});\n  else if(Array.isArray(v)) v.forEach(collectUrls);\n  else if(v && typeof v===\"object\") Object.keys(v).forEach(function(k){collectUrls(v[k]);});\n}\nprojected.forEach(collectUrls);\nreturn {modelJson:JSON.stringify(projected),values:projected.map(function(v){return JSON.stringify(v);}),blocked:blocked,allowedUrls:allowedUrls};\n",
            "errorNodeId": "HR_RESPONSE_REJECTED"
          },
