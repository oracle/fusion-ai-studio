        {
          "id": "extract_profile_id_for_save",
          "code": "EXTRACT_PROFILE_ID_FOR_SAVE",
          "type": "CODE",
          "metadata": {
            "name": "Extract Profile Id For Save",
            "returnType": "object",
            "description": "Resolves exactly one Oracle-authorized self profile and verifies an update's BookmarkId belongs to that fresh profile before selecting the canonical child-resource key.",
            "sourceCode": "\nfunction securePlainObject(value) {\n  return !!value && typeof value === \"object\" && !Array.isArray(value) &&\n    (Object.getPrototypeOf(value) === Object.prototype || Object.getPrototypeOf(value) === null);\n}\nfunction secureObject(value, maximum = 16384) {\n  if (typeof value === \"string\") {\n    if (!value.trim() || value.length > maximum) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value)) return null;\n  let count = 0;\n  function safeTree(item, depth) {\n    if (++count > 2000 || depth > 12) return false;\n    if (!item || typeof item !== \"object\") return true;\n    if (!Array.isArray(item) && !securePlainObject(item)) return false;\n    return Object.keys(item).every(function (key) {\n      return ![\"__proto__\", \"constructor\", \"prototype\"].includes(key) && safeTree(item[key], depth + 1);\n    });\n  }\n  return safeTree(value, 0) ? value : null;\n}\nfunction secureId(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  return typeof value === \"string\" && /^[1-9][0-9]{0,19}$/.test(value.trim()) ? value.trim() : \"\";\n}\nfunction secureText(value, maximum = 4000) {\n  return typeof value === \"string\" && value.length <= maximum\n    ? value.replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/g, \"\").trim() : \"\";\n}\nfunction secureEscape(value) {\n  return value.replace(/[&<>]/g, function (character) {\n    return String.fromCharCode(38) + ({ \"&\": \"amp\", \"<\": \"lt\", \">\": \"gt\" })[character] + \";\";\n  });\n}\nfunction secureCollection(value, maximum = 500) {\n  if (typeof value === \"string\") {\n    if (value.length > 1000000) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value) || value.error || value.timeout || value.isError ||\n      Number(value.statusCode || value.status || 0) >= 400 || !Array.isArray(value.items) ||\n      value.items.length > maximum || !value.items.every(securePlainObject)) return null;\n  return value;\n}\nfunction secureUrl(value) {\n  if (typeof value !== \"string\" || value.length > 2048) return \"\";\n  const url = value.trim();\n  if (/[\\s\\\\<>\"'\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/.test(url) ||\n      /%(?:0[0-9a-f]|1[0-9a-f]|7f|5c)/i.test(url)) return \"\";\n  return /^https?:\\/\\/(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$/i.test(url) ? url : \"\";\n}\nfunction unpack(value) {\n  for (let index = 0; index < 6; index += 1) {\n    if (typeof value === \"string\") {\n      try {\n        value = JSON.parse(value);\n      } catch (error) {\n        return null;\n      }\n      continue;\n    }\n    if (!value || typeof value !== \"object\" || Array.isArray(value)) return null;\n    if (value.error || value.timeout || value.isError ||\n        Number(value.statusCode || value.status || 0) >= 400) return null;\n    if (Array.isArray(value.items)) return value;\n    if (value.output !== undefined) {\n      value = value.output;\n      continue;\n    }\n    if (value.result !== undefined) {\n      value = value.result;\n      continue;\n    }\n    return null;\n  }\n  return null;\n}\n\nconst output = unpack($context.$nodes.GET_TALENT_PROFILE_FOR_SAVE.$output);\nconst personId = $context.$nodes.PREPARE_SAVE_LINK_PAYLOAD.$output.result.personId;\nif (!output || output.items.length !== 1 ||\n    String(output.hasMore).toLowerCase() === \"true\") return { profileId: \"\" };\n\nconst row = output.items[0];\nconst bookmarkId = $context.$nodes.PREPARE_SAVE_LINK_PAYLOAD.$output.result.bookmarkId;\nif (bookmarkId) {\n  const owned = secureCollection($context.$nodes.READ_OWN_LINKS_FOR_SAVE.$output, 10);\n  if (!owned || owned.items.length !== 1) return { profileId: \"\" };\n  const links = Array.isArray(owned.items[0].favoriteLinks) ? owned.items[0].favoriteLinks : owned.items[0].favoriteLinks?.items;\n  if (!Array.isArray(links) || links.filter(function (link) { return String(link?.BookmarkId || \"\") === bookmarkId; }).length !== 1) return { profileId: \"\" };\n}\nif (!row || String(row.PersonId || \"\") !== String(personId)) return { profileId: \"\" };\n\n// Oracle's child-resource path requires the canonical key, not numeric ProfileId.\nconst links = Array.isArray(row.links) ? row.links : [];\nlet resourceKey = \"\";\nfor (const relation of [\"canonical\", \"self\"]) {\n  for (const link of links) {\n    if (!link || link.rel !== relation || typeof link.href !== \"string\") continue;\n    const match = link.href.match(/\\/hcmRestApi\\/resources\\/11\\.13\\.18\\.05\\/talentPersonProfiles\\/([A-Za-z0-9_%~-]+)(?:[?#].*)?$/);\n    if (match) {\n      resourceKey = match[1];\n      break;\n    }\n  }\n  if (resourceKey) break;\n}\nif (!resourceKey) {\n  const contextKey = row[\"@context\"] && row[\"@context\"].key;\n  if (typeof contextKey === \"string\" && /^[A-Za-z0-9_%~-]+$/.test(contextKey)) {\n    resourceKey = contextKey;\n  }\n}\nreturn { profileId: resourceKey };",
            "errorNodeId": "1"
          },
