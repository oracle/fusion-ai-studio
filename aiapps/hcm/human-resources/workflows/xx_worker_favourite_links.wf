        {
          "id": "prepare_minimal_edit_links_form",
          "code": "PREPARE_MINIMAL_EDIT_LINKS_FORM",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Minimal Edit Links Form",
            "returnType": "object",
            "description": "Maps only the selected editLink payload into editable Name and URL fields and supplies a clickable Add Another footer action.",
            "sourceCode": "const parsed = $context.$nodes.PARSE_MINIMAL_EDIT_LINKS_ACTION.$output?.result || {};\nconst links = parsed.favoriteLinks?.items || [];\nconst personId = String(parsed.personId || \"\");\nconst fields = links.flatMap(function (link) {\n  const bookmarkId = String(link.BookmarkId || \"\");\n  return [\n    { id: \"link_\" + personId + \"_\" + bookmarkId + \"_description\", type: \"text\", label: \"Name\", value: link.description },\n    { id: \"link_\" + personId + \"_\" + bookmarkId + \"_href\", type: \"text\", label: \"URL\", value: link.href }\n  ];\n});\nconst nextItems = links.map(function (link) { return { personId: String(link.personId || personId), BookmarkId: String(link.BookmarkId || \"\"), description: String(link.description || \"\"), href: String(link.href || \"\") }; });\nnextItems.push({ personId: personId, BookmarkId: \"\", description: \"\", href: \"\" });\nconst addAnotherAction = { text: \"Add Another\", actionText: \"addAnother\", followUpCommand: 'ora.Invoke(\"editLink\", ' + JSON.stringify({ actionId: \"editLink\", favoriteLinks: { items: nextItems } }) + ')', placement: \"beforeSubmit\" };\nreturn { id: \"edit_favorite_links_form\", title: \"Edit Favorite Links\", description: \"\", readOnly: false, submitText: \"Save\", cancelText: \"Cancel\", actions: [addAnotherAction], fields: fields };",
            "errorNodeId": "1"
