            "returnType": "object",
            "description": "Builds a bounded Description/URL body only for a validated self-service submission with a permitted HTTP(S) URL.",
            "sourceCode": "\nfunction securePlainObject(value) {\n  return !!value && typeof value === \"object\" && !Array.isArray(value) &&\n    (Object.getPrototypeOf(value) === Object.prototype || Object.getPrototypeOf(value) === null);\n}\nfunction secureObject(value, maximum = 16384) {\n  if (typeof value === \"string\") {\n    if (!value.trim() || value.length > maximum) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value)) return null;\n  let count = 0;\n  function safeTree(item, depth) {\n    if (++count > 2000 || depth > 12) return false;\n    if (!item || typeof item !== \"object\") return true;\n    if (!Array.isArray(item) && !securePlainObject(item)) return false;\n    return Object.keys(item).every(function (key) {\n      return ![\"__proto__\", \"constructor\", \"prototype\"].includes(key) && safeTree(item[key], depth + 1);\n    });\n  }\n  return safeTree(value, 0) ? value : null;\n}\nfunction secureId(value) {\n  if (typeof value === \"number\") return Number.isSafeInteger(value) && value > 0 ? String(value) : \"\";\n  return typeof value === \"string\" && /^[1-9][0-9]{0,19}$/.test(value.trim()) ? value.trim() : \"\";\n}\nfunction secureText(value, maximum = 4000) {\n  return typeof value === \"string\" && value.length <= maximum\n    ? value.replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/g, \"\").trim() : \"\";\n}\nfunction secureEscape(value) {\n  return value.replace(/[&<>]/g, function (character) {\n    return String.fromCharCode(38) + ({ \"&\": \"amp\", \"<\": \"lt\", \">\": \"gt\" })[character] + \";\";\n  });\n}\nfunction secureCollection(value, maximum = 500) {\n  if (typeof value === \"string\") {\n    if (value.length > 1000000) return null;\n    try { value = JSON.parse(value); } catch (error) { return null; }\n  }\n  if (!securePlainObject(value) || value.error || value.timeout || value.isError ||\n      Number(value.statusCode || value.status || 0) >= 400 || !Array.isArray(value.items) ||\n      value.items.length > maximum || !value.items.every(securePlainObject)) return null;\n  return value;\n}\nfunction secureUrl(value) {\n  if (typeof value !== \"string\" || value.length > 2048) return \"\";\n  const url = value.trim();\n  if (/[\\s\\\\<>\"'\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]/.test(url) ||\n      /%(?:0[0-9a-f]|1[0-9a-f]|7f|5c)/i.test(url)) return \"\";\n  return /^https?:\\/\\/(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$/i.test(url) ? url : \"\";\n}\nconst item = $context.$nodes.PARSE_MINIMAL_EDIT_LINKS_ACTION.$output?.result?.favoriteLinks?.items?.[0] || {};\nconst maxContextLength = 16384;\n\nfunction objectFrom(value) {\n  if (typeof value === \"string\") {\n    if (value.length === 0 || value.length > maxContextLength) return null;\n    try { value = JSON.parse(value); } catch (e) { return null; }\n  }\n  return value && typeof value === \"object\" && !Array.isArray(value) ? value : null;\n}\nfunction numericId(value) {\n  const id = String(value ?? \"\").trim();\n  return /^\\d+$/.test(id) ? id : \"\";\n}\nfunction firstId(candidates, keys) {\n  for (let index = 0; index < candidates.length; index += 1) {\n    const context = objectFrom(candidates[index]);\n    if (!context) continue;\n    for (let keyIndex = 0; keyIndex < keys.length; keyIndex += 1) {\n      const id = numericId(context[keys[keyIndex]]);\n      if (id) return id;\n    }\n  }\n  return \"\";\n}\n\nconst app = $context?.$app || {};\nconst appPersonId = firstId([\n  app.$OraAppContext,\n  app.OraAppContext,\n  $context?.$OraAppContext,\n  $context?.OraAppContext\n], [\"personId\", \"PersonId\"]);\nconst loggedInUserId = firstId([\n  app.$OraUserContext,\n  app.OraUserContext,\n  $context?.$OraUserContext,\n  $context?.OraUserContext\n], [\"userId\", \"UserId\"]);\nconst submittedPersonId = String(item.personId || $context.$nodes.PARSE_MINIMAL_EDIT_LINKS_ACTION.$output?.result?.personId || \"\").trim();\nconst rawAction = String($context?.$app?.$OraAction ?? $context?.$app?.OraAction ?? \"\");\nconst submittedFieldMatch = rawAction.match(/link_(\\d+)_(\\d+)_(?:description|href)/);\nconst fieldPersonId = submittedFieldMatch ? submittedFieldMatch[1] : \"\";\nconst personId = /^\\d+$/.test(submittedPersonId) ? submittedPersonId : (/^\\d+$/.test(fieldPersonId) ? fieldPersonId : (appPersonId || loggedInUserId));\n\nconst bookmarkId = String(item.BookmarkId || \"\").trim();\nconst description = String(item.description || \"\").trim().slice(0, 500);\nconst href = String(item.href || \"\").trim().slice(0, 2048);\nconst viewerId = $context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.loggedInPersonId;\nconst parsed = $context.$nodes.PARSE_MINIMAL_EDIT_LINKS_ACTION.$output.result;\nconst valid = parsed.valid === true && personId === viewerId && description !== \"\" && !!secureUrl(href) &&\n  (bookmarkId === \"\" || !!secureId(bookmarkId));\nreturn {\n  valid: valid,\n  personId: personId,\n  bookmarkId: bookmarkId,\n  hasBookmarkId: /^\\d+$/.test(bookmarkId),\n  BookmarkId: bookmarkId,\n  URL: href,\n  Description: description,\n  payload: JSON.stringify({ Description: description, URL: href })\n};",
