        {
          "id": "query_help",
          "code": "QUERY_HELP",
          "type": "RETURN",
          "metadata": {
            "name": "Query Help"
          },
          "outcomes": {},
          "inputs": [
            {
              "id": "query_help_returnValue",
              "name": "returnValue",
              "type": "string",
              "value": "This search supports finding employees by the following attributes only: Person, Manager, Location, Department, Position, Job, Work Email, or Phone Number. Select lookup attributes or enter email and phone values directly, then ask to see matching employees."
            }
          ],
          "diagram": {
