            "y": 6094
          }
        },
        {
          "id": "prepare_lookup",
          "code": "PREPARE_LOOKUP",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Lookup",
            "sourceCode": "var f = $context.$app.$OraQueryFilter;\nif (typeof f === 'string') {\n  try {\n    f = JSON.parse(f);\n  } catch (e) {\n    f = null;\n  }\n}\nvar mapping = {\n  manager: 'Manager',\n  person: 'PersonName',\n  location: 'LocationName',\n  department: 'DepartmentName',\n  position: 'PositionName',\n  job: 'JobName'\n};\nvar category = f && typeof f.categoryId === 'string' ? f.categoryId : '';\nvar search = f && typeof f.searchString === 'string' ? f.searchString.trim() : '';\nvar known = Object.prototype.hasOwnProperty.call(mapping, category);\nreturn {\n  valid: !!f && known && search.length <= 200 && !/[\\u0000-\\u001f]/.test(search),\n  category: category,\n  field: known ? mapping[category] : '',\n  search: search\n};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "lookup_valid"
          },
          "inputs": [],
          "diagram": {
            "x": 6462.5,
            "y": 5650
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "lookup_valid",
          "code": "LOOKUP_VALID",
          "type": "CONDITION",
          "metadata": {
            "name": "Lookup Valid"
          },
          "outcomes": {
            "true": "route_lookup_category",
            "false": "empty_lookup"
          },
          "inputs": [
            {
              "id": "lookup_valid_condition",
              "name": "condition",
              "type": "string",
              "value": "{{!!$context.$nodes.PREPARE_LOOKUP.$output.result.valid}}"
            }
          ],
          "diagram": {
            "x": 6462.5,
            "y": 5872
          },
          "convergenceTargetId": "end"
        },
        {
          "id": "route_lookup_category",
          "code": "ROUTE_LOOKUP_CATEGORY",
          "type": "SWITCH",
          "metadata": {
            "name": "Choose Manager, Person or facet lookup"
          },
          "outcomes": {
            "Facet": "fetch_facet_values",
            "Manager": "fetch_managers_initial",
            "ManagerWithQuery": "fetch_managers_query",
            "Person": "fetch_lookup_managers",
            "PersonWithQuery": "fetch_people_query",
            "success": ""
          },
          "inputs": [
            {
              "id": "route_lookup_category_caseExpression",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_LOOKUP.$output.result.category === \"manager\" ? ($context.$nodes.PREPARE_LOOKUP.$output.result.search ? \"ManagerWithQuery\" : \"Manager\") : ($context.$nodes.PREPARE_LOOKUP.$output.result.category === \"person\" ? ($context.$nodes.PREPARE_LOOKUP.$output.result.search ? \"PersonWithQuery\" : \"Person\") : \"Facet\")}}"
            }
          ],
          "diagram": {
            "x": 6237.5,
            "y": 6094
          },
          "convergenceTargetId": "end"
        },
        {
          "id": "fetch_lookup_managers",
          "code": "FETCH_LOOKUP_MANAGERS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Look up people without query",
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_PERSONSEARCHESGHR",
            "functionName": "GetLookupPeople",
            "errorNodeId": "empty_lookup"
          },
          "outcomes": {
            "success": "normalize_lookup_managers"
          },
          "inputs": [],
          "diagram": {
            "x": 6012.5,
            "y": 6316
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AssignmentId\": {\n            \"type\": \"string\"\n          },\n          \"DisplayName\": {\n            \"type\": \"string\"\n          },\n          \"PersonId\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"AssignmentId\",\n          \"DisplayName\",\n          \"PersonId\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\n    \"count\",\n    \"hasMore\",\n    \"items\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "normalize_lookup_managers",
          "code": "NORMALIZE_LOOKUP_MANAGERS",
          "type": "CODE",
          "metadata": {
            "name": "Normalize People and Manager Lookups",
            "sourceCode": "var lookup = $context.$nodes.PREPARE_LOOKUP.$output.result;\nvar isManager = lookup.category === 'manager';\nvar response;\nif (isManager) {\n  response = lookup.search\n    ? $context.$nodes.FETCH_MANAGERS_QUERY.$output\n    : $context.$nodes.FETCH_MANAGERS_INITIAL.$output;\n} else {\n  response = lookup.search\n    ? $context.$nodes.FETCH_PEOPLE_QUERY.$output\n    : $context.$nodes.FETCH_LOOKUP_MANAGERS.$output;\n}\nfunction text(v) {\n  return v == null ? '' : String(v).trim();\n}\nvar seen = {};\nvar items = [];\nresponse.items.forEach(function (r) {\n  var personId = text(r.PersonId);\n  var assignmentId = text(r.AssignmentId);\n  var name = text(r.DisplayName);\n  if (seen[personId]) return;\n  seen[personId] = true;\n  var metadata = {\n    personId: personId\n  };\n  if (isManager) metadata.assignmentId = assignmentId;\n  items.push({\n    name: name,\n    metadata: metadata\n  });\n});\nreturn {\n  items: items,\n  hasMore: response.hasMore === true || response.hasMore === 'true'\n};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "return_people_lookup"
          },
          "inputs": [],
          "diagram": {
            "x": 6687.5,
            "y": 6538
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "return_people_lookup",
          "code": "RETURN_PEOPLE_LOOKUP",
          "type": "RETURN",
          "metadata": {
            "name": "Return People Lookup"
          },
          "outcomes": {},
          "inputs": [
            {
              "id": "return_people_lookup_returnValue",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.NORMALIZE_LOOKUP_MANAGERS.$output.result.items}}"
            }
          ],
          "diagram": {
            "x": 6687.5,
            "y": 6760
          }
        },
        {
          "id": "fetch_facet_values",
          "code": "FETCH_FACET_VALUES",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Find workforce filter values",
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_PERSONSEARCHESGHR",
            "functionName": "GetLookupFacetValues",
            "errorNodeId": "empty_lookup"
          },
          "outcomes": {
            "success": "normalize_facet_values"
          },
          "inputs": [
            {
              "id": "fetch_facet_values_facetField",
              "name": "facetField",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_LOOKUP.$output.result.field}}"
            },
            {
              "id": "fetch_facet_values_searchText",
              "name": "searchText",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_LOOKUP.$output.result.search}}"
            }
          ],
          "diagram": {
            "x": 5112.5,
            "y": 6316
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"facets\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"values\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"value\": {\n                  \"type\": \"string\"\n                },\n                \"count\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"value\",\n                \"count\"\n              ],\n              \"additionalProperties\": false\n            }\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"values\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"facets\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "normalize_facet_values",
          "code": "NORMALIZE_FACET_VALUES",
          "type": "CODE",
          "metadata": {
            "name": "Normalize Facet Values",
            "sourceCode": "var response = $context.$nodes.FETCH_FACET_VALUES.$output;\nvar field = $context.$nodes.PREPARE_LOOKUP.$output.result.field;\nvar facet = response.facets.filter(function (f) {\n  return f.name === field;\n})[0];\nif (!facet) return {\n  items: []\n};\nvar seen = {};\nvar items = [];\nfacet.values.forEach(function (v) {\n  var label = v.value.trim();\n  if (!label || Object.prototype.hasOwnProperty.call(seen, label)) return;\n  seen[label] = true;\n  items.push(label);\n});\nreturn {\n  items: items.slice(0, 25)\n};\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "return_facet_lookup"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 6538
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "return_facet_lookup",
          "code": "RETURN_FACET_LOOKUP",
          "type": "RETURN",
          "metadata": {
            "name": "Return Facet Lookup"
          },
          "outcomes": {},
          "inputs": [
