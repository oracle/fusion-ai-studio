            "name": "Prepare Safe Contact Display",
            "sourceCode": "let prepared=$context.$nodes.PREPARE_PHONES_OUTPUT.$output.result;\nif(typeof prepared===\"string\")prepared=JSON.parse(prepared);\nfunction safe(items){if(!Array.isArray(items))throw new Error(\"Invalid display records\");return JSON.stringify(items.map(function(row){const result={};[\"title\",\"subtitle\",\"summary\",\"badgeText\",\"priority\"].forEach(function(k){if(Object.prototype.hasOwnProperty.call(row,k))result[k]=row[k];});return result;})).replace(/</g,\"\\\\u003c\").replace(/>/g,\"\\\\u003e\").replace(/&/g,\"\\\\u0026\");}\nreturn {initialItemsJson:safe(prepared.initialItems),remainingItemsJson:safe(prepared.remainingItems)};",
            "returnType": "object",
