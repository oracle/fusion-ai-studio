        {
          "id": "1",
          "code": "EXTRACT_PERSON_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Validate Contact Request",
            "returnType": "object",
            "description": "Validates bounded object contexts and positive identifiers, resolves app context then REST personId then signed-in viewer, and keeps the viewer separate.",
            "sourceCode": "const maximumContextLength = 32768;\nconst own = (object, key) => Object.prototype.hasOwnProperty.call(object, key);\nfunction fail() { throw new Error('Invalid contact request.'); }\n\nfunction contextObject(value) {\n  if (value == null || value === '') return {};\n  if (typeof value === 'string') {\n    if (value.length > maximumContextLength) fail();\n    try { value = JSON.parse(value); } catch (error) { fail(); }\n  }\n  if (!value || typeof value !== 'object' || Array.isArray(value)) fail();\n  const prototype = Object.getPrototypeOf(value);\n  if (prototype !== Object.prototype && prototype !== null) fail();\n  let serialized;\n  try { serialized = JSON.stringify(value); } catch (error) { fail(); }\n  if (typeof serialized !== 'string' || serialized.length > maximumContextLength) fail();\n  let visited = 0;\n  function inspect(item, depth) {\n    if (++visited > 2000 || depth > 12) fail();\n    if (!item || typeof item !== 'object') return;\n    Object.keys(item).forEach(function (key) {\n      if (key === '__proto__' || key === 'prototype' || key === 'constructor') fail();\n      inspect(item[key], depth + 1);\n    });\n  }\n  inspect(value, 0);\n  return value;\n}\n\nfunction positiveId(object, key) {\n  if (!own(object, key) || object[key] === undefined) return null;\n  const value = object[key];\n  if (typeof value === 'number') {\n    if (!Number.isSafeInteger(value) || value <= 0) fail();\n    return String(value);\n  }\n  if (typeof value !== 'string') fail();\n  const normalized = value.trim();\n  if (!/^[1-9][0-9]{0,29}$/.test(normalized)) fail();\n  return normalized;\n}\n\nconst appContext = contextObject($context?.$app?.$OraAppContext);\nconst userContext = contextObject($context?.$app?.$OraUserContext);\nconst restInput = contextObject($context?.$triggers?.REST?.$input);\nconst appPersonId = positiveId(appContext, 'personId');\n// Optional REST inputs may be materialized as blank or null when omitted.\n// A valid app subject wins; an unused REST field cannot change that selection.\nconst triggerValue = own(restInput, 'personId') ? restInput.personId : undefined;\nconst triggerAbsent = triggerValue == null ||\n  (typeof triggerValue === 'string' && !triggerValue.trim());\nconst triggerPersonId = appPersonId || triggerAbsent ? null : positiveId(restInput, 'personId');\nconst viewerPersonId = positiveId(userContext, 'userId');\n// Require a viewer identity before accepting any selected or REST subject.\n// Subject authorization remains enforced by the native-authenticated backend.\nif (!viewerPersonId) fail();\nconst personId = appPersonId || triggerPersonId || viewerPersonId;\nif (!personId) fail();\n\nconst hint = $context?.$app?.$OraMessageHint;\nconst stage = hint == null || hint === '' ? 'Query' : hint;\nif (['InitDisplay', 'AdditionalContent', 'Query'].indexOf(stage) === -1) fail();\nlet question = '';\nif (stage === 'Query') {\n  const message = $context?.$system?.$inputMessage;\n  if (typeof message !== 'string' || !message.trim() || message.length > 8000) fail();\n  question = message.trim();\n}\n// Valid syntax selects the subject; the existing backend still enforces authorization.\n// The authenticated viewer remains separate from the viewed person's date context.\nreturn { personId, viewerPersonId, stage, question };",
            "errorNodeId": "26"
          },
          "outcomes": {
            "success": "12"
          },
          "inputs": [],
          "diagram": {
            "x": 5675,
            "y": 5206
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "12",
          "code": "INITIALIZE_CONTACT_PAGING",
          "type": "CODE",
          "metadata": {
            "name": "Initialize Contact Paging",
            "sourceCode": "const personId = String($context.$nodes.EXTRACT_PERSON_CONTEXT.$output.result.personId || \"\").trim();\nif (!personId) throw new Error(\"A person is required to retrieve contact records.\");\n\nreturn {\n  personId: personId,\n  offset: 0,\n  pageCount: 0,\n  hasMore: true,\n  items: [],\n  seenKeys: []\n};",
            "returnType": "object",
            "description": "Starts complete request-scoped retrieval for the validated subject; no conversation cache is reused.",
            "errorNodeId": "26"
          },
          "outcomes": {
            "success": "13"
          },
          "inputs": [],
          "diagram": {
            "x": 5675,
            "y": 5428
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
