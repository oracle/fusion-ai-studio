            "query": {
              "NoteText": "<note text>",
              "NoteVisibilityCode": "<note visibility code>"
            },
            "sampleType": "request"
          }
        ]
      },
      {
        "name": "create_person_note",
        "description": "Creates a new person note by submitting data to the personNotesV2 resource using a POST operation. This function allows adding notes associated with a person in the system.",
        "operationType": "POST",
        "resourcePath": "/hcmRestApi/resources/11.13.18.05/personNotesV2",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n \t   \"AuthorId\": \"{AuthorId}\",\n           \"WorkerId\": \"{WorkerId}\",\n           \"NoteVisibilityCode\": \"{NoteVisibilityCode}\",\n           \"ContextType\": \"{ContextType}\",\n           \"ContextId\": \"{ContextId}\",\n           \"ContextType2\": \"{ContextType2}\",\n           \"ContextId2\": \"{ContextId2}\",\n           \"NoteText\": \"{NoteText}\"\n\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
