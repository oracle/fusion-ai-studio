        "resourcePath": "/hcmRestApi/resources/11.13.18.05/personNotesV2/{NoteId}",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n    \"HiddenFlag\" : \"{HiddenFlag}\"\n}",
