            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "HiddenFlag",
            "dataType": "boolean",
            "description": "Indicates whether the note is hidden or shown. The default value is Show.",
            "id": 3,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
        "sampleQueries": [
