          }
        ]
      },
      {
        "name": "update_person_note",
        "description": "Update a person note",
        "operationType": "PATCH",
        "resourcePath": "/hcmRestApi/resources/11.13.18.05/personNotesV2/{NoteId}",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n    \"NoteText\": \"{NoteText}\",\n    \"NoteVisibilityCode\" : \"{NoteVisibilityCode}\"\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "NoteId",
            "dataType": "integer",
            "description": "System-generated primary key of the note.",
            "id": 7,
            "isToken": true,
            "location": "path",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "NoteText",
            "dataType": "string",
            "description": "Text of the note.",
            "id": 8,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "NoteVisibilityCode",
            "dataType": "string",
            "description": "Visibility of the note. Valid options are: ALL, MANAGERS, MANAGERS_AND_SUBJECT, PRIVATE, SUBJECT, MANAGERS_SUBJECT_PEERS. Administrators can remove any of the options via configuration for the specified context type.",
            "id": 9,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
        "sampleQueries": [
