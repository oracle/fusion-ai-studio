  "name": "Person Headers Data Object Access",
  "description": "Retrieves the data-object access permissions for a person as of an effective date.",
  "objectCode": "ORA_HCM_GLOBALHUMA_XX_PERSON_HEADERS_DATA_OBJECT_ACCESS",
  "family": "HCM",
  "product": "GLOBAL_HUMAN_RESOURCES",
