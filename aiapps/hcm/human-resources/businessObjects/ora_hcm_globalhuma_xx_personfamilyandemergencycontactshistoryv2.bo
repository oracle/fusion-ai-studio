        "resourcePath": "/hcmRestApi/resources/11.13.18.05/contactRelationshipsAll?finder=findDateEffectiveRecords;RequestedMode=currentFuture,RequestedDate={effectiveDate},ContextName=Contact&onlyData=true&orderBy=EffectiveStartDate:desc&q=RelatedPersonId={personId} and ExistingPerson != 'PENDING'&fields=ContactRelationshipId,RelatedPersonId,EffectiveStartDate,EffectiveEndDate,EmergencyContactFlag,ContactPhoneNumber,ContactEmailAddress,PrimaryContactFlag,ContactDisplayName,ContactTypeMeaning&limit=100&offset={offset}",
