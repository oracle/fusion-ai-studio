        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n    \"securityFilters\": {\n        \"type\": \"QuickAction\",\n        \"value\": \"HRIdentificationInfo\",\n        \"context\": \"MyClientGroups\"\n    },\n    \"query\": \"{workerName}\",\n    \"searchFields\": [\n        \"DisplayName\"\n    ],\n    \"displayFields\": [\n        \"DisplayName\",\n        \"DepartmentName\",\n        \"JobName\",\n        \"LocationName\",\n        \"PositionName\",\n        \"PersonId\",\n        \"PersonNumber\",\n        \"AssignmentNumber\"\n    ],\n    \"offset\": 0\n}",
