            "location": "body",
            "source": "manual",
            "defaultValue": "undefined"
          }
        ],
        "sampleQueries": [
          {
            "description": "Get worker aggregation counts using a workerAggregationsV2 payload",
            "query": {
              "payload": {
                "securityFilters": "<security filters>",
                "facets": [
                  "<facet name>"
                ],
                "facetValueQuery": "<facet value query>"
              }
            },
            "sampleType": "request"
