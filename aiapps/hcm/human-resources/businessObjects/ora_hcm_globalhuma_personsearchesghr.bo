      {
        "name": "GetLookupManagers",
        "description": "Returns up to 25 accessible primary-assignment managers ordered by display name. Uses AssignmentManagerFlag Yes, PersonSearch AdvancedSearch access controls and native authentication.",
        "operationType": "POST",
        "resourcePath": "/hcmRestApi/redwood/11.13.18.05/workerSearchesV2",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n  \"displayFields\": [\n    \"DisplayName\",\n    \"PersonId\",\n    \"AssignmentId\",\n    \"DepartmentName\",\n    \"JobName\",\n    \"LocationName\"\n  ],\n  \"filters\": [\n    {\n      \"name\": \"PrimaryAssignmentOnly\",\n      \"value\": true\n    },\n    {\n      \"name\": \"AssignmentManagerFlag\",\n      \"terms\": [\n        \"Yes\"\n      ]\n    }\n  ],\n  \"limit\": 25,\n  \"offset\": 0,\n  \"securityFilters\": {\n    \"type\": \"PersonSearch\",\n    \"value\": \"AdvancedSearch\"\n  },\n  \"sort\": [\n    {\n      \"direction\": \"asc\",\n      \"name\": \"DisplayName\"\n    }\n  ]\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [],
        "headers": {
          "Content-Type": "application/json"
        },
        "sampleQueries": [
