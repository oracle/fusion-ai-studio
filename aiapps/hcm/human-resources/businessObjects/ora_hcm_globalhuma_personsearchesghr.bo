        "sampleQueries": [
          {
            "description": "Shows the BO-defined worker search request. Replace <managerPersonId>; all other payload fields are fixed by the function.",
            "query": {
              "securityFilters": {
                "type": "QuickAction",
                "value": "HRIdentificationInfo",
                "context": "MyClientGroups"
              },
              "filters": [
                {
                  "name": "Manager",
                  "terms": [
                    "<managerPersonId>"
                  ]
                },
                {
                  "name": "ManagerReports",
                  "value": "DIRECTS"
                },
                {
                  "name": "PrimaryAssignmentOnly",
                  "value": true
                }
              ],
              "displayFields": [
                "PersonId",
                "PersonNumber",
                "DisplayName",
                "AssignmentId",
                "AssignmentNumber",
                "BusinessTitle",
                "DepartmentName",
                "BusinessUnitName",
                "JobName",
                "JobCode",
                "PositionName",
                "PositionCode",
                "LocationName",
                "LocationCode",
                "LocationId"
              ],
              "offset": 0,
              "limit": 499
            },
            "sampleType": "request"
          }
        ]
      },
      {
        "name": "GetLookupFacetValues",
        "description": "Returns accessible Location, Department, Position or Job lookup values with a fixed PrimaryAssignmentOnly filter, PersonSearch AdvancedSearch security and native authentication.",
        "operationType": "POST",
        "resourcePath": "/hcmRestApi/redwood/11.13.18.05/workerAggregationsV2",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n  \"securityFilters\": {\n    \"type\": \"PersonSearch\",\n    \"value\": \"AdvancedSearch\"\n  },\n  \"facets\": [\n    \"{facetField}\"\n  ],\n  \"filters\": [\n    {\n      \"name\": \"PrimaryAssignmentOnly\",\n      \"value\": true\n    }\n  ],\n  \"facetValueQuery\": \"{searchText}\"\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
