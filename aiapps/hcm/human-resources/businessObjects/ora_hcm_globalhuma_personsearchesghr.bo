        "name": "GetWorkerCount",
        "description": "Returns worker aggregation counts for a supplied workerAggregationsV2 request payload.",
        "operationType": "POST",
        "resourcePath": "/hcmRestApi/redwood/11.13.18.05/workerAggregationsV2",
