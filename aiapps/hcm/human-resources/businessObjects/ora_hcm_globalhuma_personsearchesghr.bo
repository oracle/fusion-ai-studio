      {
        "name": "GetWorkersByManagerAssignmentId",
        "description": "Gets workers reporting directly or indirectly to a manager identified by manager assignment ID.",
        "operationType": "POST",
        "resourcePath": "/hcmRestApi/redwood/11.13.18.05/workerSearchesV2",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n  \"securityFilters\": {\n    \"type\": \"PersonSearch\",\n    \"value\": \"AdvancedSearch\"\n  },\n  \"filters\": [\n    {\n      \"name\": \"Manager\",\n      \"terms\": [\"{managerAssignmentId}\"]\n    },\n    {\n      \"name\": \"ManagerReports\",\n      \"value\": \"{directType}\"\n    }\n  ],\n  \"displayFields\": [\n    \"DisplayName\",\n    \"BusinessTitle\",\n    \"DepartmentName\",\n    \"JobName\",\n    \"LocationName\",\n    \"PositionName\",\n    \"PersonId\",\n    \"PersonNumber\",\n    \"AssignmentId\",\n    \"AssignmentNumber\",\n    \"ManagerDisplayName\"\n  ],\n  \"offset\": {offset},\n  \"limit\": {limit},\n  \"sort\": [\n    {\n      \"name\": \"{sortby}\",\n      \"direction\": \"{direction}\"\n    }\n  ]\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "managerAssignmentId",
            "dataType": "integer",
            "description": "Manager assignment ID used by the WorkerSearchesV2 Manager filter. Pass the identifier as a string to preserve 64-bit precision.",
            "id": 797,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "directType",
            "dataType": "string",
            "description": "Reporting scope relative to the selected manager assignment. Use DIRECTS for immediate reports or ALL for the complete reporting hierarchy.",
            "id": 798,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "offset",
            "dataType": "integer",
            "description": "Zero-based result offset used for pagination. Pass a non-negative integer.",
            "id": 799,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "limit",
            "dataType": "integer",
            "description": "Maximum number of workers to return in the page. Pass a positive integer supported by WorkerSearchesV2.",
            "id": 800,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "sortby",
            "dataType": "string",
            "description": "WorkerSearchesV2 sort attribute. Use DisplayName for alphabetical sorting or Relevance for relevance sorting.",
            "id": 801,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "direction",
            "dataType": "string",
            "description": "Sort direction. Use asc or desc with DisplayName; use desc with Relevance.",
            "id": 802,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
        "sampleQueries": [
          {
            "description": "Sample response for GetWorkersByManagerAssignmentId with redacted field-name placeholders.",
            "query": {
              "items": [
                {
                  "DisplayName": "<displayName>",
                  "BusinessTitle": "<businessTitle>",
                  "PersonNumber": "<personNumber>",
                  "PersonId": "<personId>",
                  "AssignmentId": "<assignmentId>"
                }
              ],
              "count": "<count>",
              "limit": "<limit>",
              "offset": "<offset>",
              "hasMore": "<hasMore>"
            },
            "sampleType": "response"
          }
        ]
      },
