        {
          "id": "1792392383397",
          "code": "TEAM_SKILLS_AGGREGATION_DETAILS",
          "type": "CODE",
          "metadata": {
            "name": "Team Skills Aggregation Details",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst raw =\n  $context.$nodes.FETCH_TEAM_SKILLS_AGGREGATIONS.$output;\n\nconst response = typeof raw === \"string\" ? JSON.parse(raw) : raw;\n\nconst skillsAggregation = Array.isArray(response?.items)\n  ? response.items[0] || {}\n  : response || {};\n\nconst core = skillsAggregation.Core || {};\n  const role = skillsAggregation.Role || {};\n\nconst toCount = (value) => {\n  if (typeof value === \"number\") {\n    return Number.isSafeInteger(value) && value >= 0 ? value : 0;\n  }\n\n  if (typeof value !== \"string\") return 0;\n\n  const text = value.trim();\n  if (!/^\\d+$/.test(text)) return 0;\n\n  const count = Number(text);\n  return Number.isSafeInteger(count) ? count : 0;\n};\n\n  const coreAchieved = toCount(core.AchievedCount);\nconst coreTotal = toCount(core.TotalCount);\n\nconst roleAchieved = toCount(role.AchievedCount);\nconst roleTotal = toCount(role.TotalCount);\n const coreDeveloping = coreTotal - coreAchieved;\n\n  const roleDeveloping = roleTotal - roleAchieved;\n\n  return {\n    coreSkills: {\n      total: coreTotal,\n      achieved: coreAchieved,\n      developing: coreDeveloping\n    },\n    roleSkills: {\n      total: roleTotal,\n      achieved: roleAchieved,\n      developing: roleDeveloping\n    }\n  };",
            "returnType": "object"
          },
          "diagram": {
            "x": 5770,
            "y": 6833
          },
          "outcomes": {
            "success": "1793090046091"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
