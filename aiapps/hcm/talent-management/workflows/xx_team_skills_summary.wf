        {
          "id": "1792394049134",
          "code": "GENERATE_LOWEST_SKILLS_RESPONSE",
          "type": "CODE",
          "metadata": {
            "name": "Generate Lowest Skills Response",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst roleSkills = $context.$nodes.FETCH_LOWEST_ROLE_SKILLS_ACHIEVED.$output;\nconst coreSkills = $context.$nodes.FETCH_LOWEST_CORE_SKILLS_ACHIEVED.$output;\n\nfunction normalizeInput(value) {\n  if (!value) return {};\n\n  if (typeof value === \"string\") {\n    try {\n      value = JSON.parse(value);\n    } catch (error) {\n      return {};\n    }\n  }\n\n  return value.result || value;\n}\n\nfunction mapSkillBucket(data, category) {\n  const items = Array.isArray(data?.items) ? data.items : [];\n\n  return {\n    category,\n    totalSkills: items.reduce((sum, item) => sum + (item.TotalCount || 0), 0),\n    achievedSkills: items.reduce((sum, item) => sum + (item.AchievedCount || 0), 0),\n    developingSkills: items.reduce((sum, item) => sum + (item.DevelopingCount || 0), 0),\n    items: items.map((item) => ({\n      skillName: item.SkillName || \"\",\n      skillId: item.SkillId || null,\n      achievedCount: item.AchievedCount || 0,\n      developingCount: item.DevelopingCount || 0,\n      totalCount: item.TotalCount || 0,\n      achievedPerson: item.AchievedPerson || [],\n      developingPerson: item.DevelopingPerson || []\n    }))\n  };\n}\n\nreturn {\n  roleSkills: mapSkillBucket(normalizeInput(roleSkills), \"role\"),\n  coreSkills: mapSkillBucket(normalizeInput(coreSkills), \"core\")\n};"
          },
          "diagram": {
            "x": 7613.5,
            "y": 6833
          },
          "outcomes": {
            "success": "1793090046091"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1799999990002",
          "code": "SANITIZE_TEAM_SUMMARY_FOR_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Remove Identifiers From Query Data",
            "description": "Creates a bounded query-only projection without person, assignment, or raw record identifiers.",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) throw new Error(\"Workflow input exceeds validation limits.\");\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) { stack.push([key, depth + 1]); stack.push([value[key], depth + 1]); }\n  }\n})($context);\n\n\nconst source = $context.$nodes.FORMAT_DIRECT_REPORT_SKILL_DETAILS?.$output?.result;\nif (!source || typeof source !== \"object\" || Array.isArray(source)) {\n  throw new Error(\"Direct-report skill data is unavailable for query processing.\");\n}\n\nconst safeResult = Object.create(null);\nconst skillNamePattern = /^[\\p{L}\\p{M}\\p{N}.][\\p{L}\\p{M}\\p{N} .,'’()&+\\/#_-]{0,119}$/u;\nconst employeeNamePattern = /^[\\p{L}\\p{M}\\p{N} .,'’()&-]{1,160}$/u;\nconst safeText = (value, maxLength = 512) => {\n  if (value == null || value === \"\") return \"\";\n  if (typeof value !== \"string\" || value.length > maxLength) throw new Error(\"Direct-report text failed validation.\");\n  return value;\n};\nconst safeCount = (value) => {\n  if (!Number.isInteger(value) || value < 0 || value > 1000000) throw new Error(\"Direct-report count failed validation.\");\n  return value;\n};\n\nfor (const [employeeName, summary] of Object.entries(source)) {\n  if (!employeeNamePattern.test(employeeName)) throw new Error(\"Employee name failed validation.\");\n  const skills = Array.isArray(summary?.skills) ? summary.skills : [];\n  safeResult[employeeName] = {\n    employeeName,\n    totalSkills: safeCount(summary?.totalSkills),\n    achievedSkills: safeCount(summary?.achievedSkills),\n    developingSkills: safeCount(summary?.developingSkills),\n    coreSkills: {\n      total: safeCount(summary?.coreSkills?.total),\n      achieved: safeCount(summary?.coreSkills?.achieved),\n      developing: safeCount(summary?.coreSkills?.developing)\n    },\n    roleSkills: {\n      total: safeCount(summary?.roleSkills?.total),\n      achieved: safeCount(summary?.roleSkills?.achieved),\n      developing: safeCount(summary?.roleSkills?.developing)\n    },\n    skills: skills.map((skill) => {\n      const skillName = safeText(skill?.skillName, 120);\n      if (skillName && !skillNamePattern.test(skillName)) throw new Error(\"Skill name failed validation.\");\n      return {\n        skillName,\n        skillType: safeText(skill?.skillType, 80),\n        category: skill?.category === \"core\" || skill?.category === \"role\" ? skill.category : \"other\",\n        achieved: skill?.achieved === true,\n        group: safeText(skill?.group, 128),\n        rating: safeText(skill?.rating, 128),\n        requiredRating: safeText(skill?.requiredRating, 128),\n        assignmentSource: safeText(skill?.assignmentSource, 128)\n      };\n    })\n  };\n}\n\nreturn safeResult;\n"
          },
          "outcomes": {
            "success": "1793090046091"
          },
          "inputs": [],
          "diagram": {
            "x": 5137,
            "y": 7997
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
