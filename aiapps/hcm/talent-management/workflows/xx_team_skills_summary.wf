        {
          "id": "1784712267256",
          "code": "GENERATE_SUMMARY_RESPONSE",
          "type": "LLM",
          "metadata": {
            "name": "Generate Summary Response"
          },
          "diagram": {
            "x": 5983.633157307121,
            "y": 8758.654885907898
          },
          "outcomes": {
