          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1792669047390",
          "code": "GET_SKILL_NAME",
          "type": "CODE",
          "metadata": {
            "name": "Get Skill Name",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst restInput = $context?.$triggers?.REST?.$input;\nconst rawContext = $context?.$app?.$OraAppContext;\n\nlet appContext = null;\n\nif (typeof rawContext === \"string\" && rawContext.trim() !== \"\") {\n  try {\n    appContext = JSON.parse(rawContext);\n  } catch (error) {\n    appContext = null;\n  }\n} else if (\n  rawContext &&\n  typeof rawContext === \"object\" &&\n  !Array.isArray(rawContext)\n) {\n  appContext = rawContext;\n}\n\nconst candidates = [\n  restInput?.skillName,\n  restInput?.SkillName,\n  appContext?.skillName,\n  appContext?.SkillName\n];\n\nconst skillName = candidates\n  .map(value => value == null ? \"\" : String(value).trim())\n  .find(value => value !== \"\") || \"\";\nconst validSkillName = /^[\\p{L}\\p{M}\\p{N}.][\\p{L}\\p{M}\\p{N} .,'’()&+\\/#_-]{0,119}$/u;\n\nif (!validSkillName.test(skillName)) {\n  throw new Error(\"SkillName must be a non-empty, bounded skill name.\");\n}\n\nreturn skillName;",
            "returnType": "string"
          },
