        {
          "id": "1792418658971",
          "code": "BUILD_SELECTED_SKILL_ROWS_WF",
          "type": "CODE",
          "metadata": {
            "name": "Build Selected Skill Rows WF",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nfunction a(value){return Array.isArray(value)?value:(value&&Array.isArray(value.items)?value.items:[])}function text(value){return value===null||value===undefined||String(value).trim()===''?'Not available':String(value)}const SkillName = $context.$nodes.GET_SKILL_NAME.$output.result;\nconst SkillType = \"ALL\";\nconst detailResponse=$context.$nodes.GET_SELECTED_SKILL_DETAILS_WF.$output||{};const detailData=detailResponse.output&&detailResponse.output.response?detailResponse.output.response:detailResponse;const descriptionResponse=$context.$nodes.GET_SELECTED_SKILL_DESCRIPTION_WF.$output||{};const descriptionData=descriptionResponse.output&&descriptionResponse.output.response?descriptionResponse.output.response:descriptionResponse;const choices=Array.isArray(descriptionData.choices)?descriptionData.choices:[];return {skillName:text(SkillName),skillType:text(SkillType),description:text(choices[0]&&choices[0].text),rows:a(detailData).map(function(item){item=item||{};return {displayName:text(item.DisplayName||item.PersonDisplayName),assignmentName:text(item.AssignmentName),achievedLevel:text(item.AchievedLevel||item.AchievedLevelName),requiredLevel:text(item.RequiredLevel||item.RequiredLevelName),endorsementsCount:text(item.EndorsementsCount)}})};"
          },
          "diagram": {
            "x": 5765,
            "y": 6094
          },
          "outcomes": {
