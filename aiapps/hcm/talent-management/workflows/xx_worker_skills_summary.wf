          ],
          "diagram": {
            "x": 5526.5,
            "y": 5650
          },
          "outputSpecification": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"items\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"Skill\":{\"type\":[\"string\",\"null\"]},\"SkillName\":{\"type\":[\"string\",\"null\"]},\"PersonName\":{\"type\":[\"string\",\"null\"]},\"DisplayName\":{\"type\":[\"string\",\"null\"]},\"ManagerNumericRating\":{\"type\":[\"number\",\"string\",\"null\"]},\"ManagerRatingDescription\":{\"type\":[\"string\",\"null\"]},\"RequiredNumericRating\":{\"type\":[\"number\",\"string\",\"null\"]},\"RequiredRatingDescription\":{\"type\":[\"string\",\"null\"]},\"Group\":{\"type\":[\"string\",\"null\"]},\"GroupMeaning\":{\"type\":[\"string\",\"null\"]},\"SkillCriteriaTypeCode\":{\"type\":[\"string\",\"null\"]}}}},\"count\":{\"type\":\"integer\"},\"hasMore\":{\"type\":\"boolean\"},\"limit\":{\"type\":\"integer\"},\"offset\":{\"type\":\"integer\"},\"links\":{\"type\":\"array\"}}}"
        },
        {
          "id": "4",
          "code": "PREPARE_SKILL_SUMMARY_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Skill Summary Data",
            "description": "Minimizes and normalizes the selected employee's public skills into safe display and query fields, development status, and aggregate counts.",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst rawResponse = $context.$nodes.GET_PERSON_PUBLIC_SKILLS?.$output;\nlet response = rawResponse;\n\nif (typeof rawResponse === \"string\") {\n  try {\n    response = JSON.parse(rawResponse);\n  } catch (error) {\n    response = {};\n  }\n}\n\nconst items = Array.isArray(response?.items) ? response.items : [];\nconst toText = (value) => value === null || value === undefined || String(value).trim() === \"\" ? \"-\" : String(value);\nconst toNumber = (value) => {\n  if (value === null || value === undefined) return null;\n  if (typeof value === \"number\") return Number.isFinite(value) ? value : null;\n  if (typeof value !== \"string\") return null;\n  const numericString = value.trim();\n  if (!/^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$/.test(numericString)) return null;\n  const numericValue = Number(numericString);\n  return Number.isFinite(numericValue) ? numericValue : null;\n};\n\nlet employeeName = \"\";\nlet coreSkillCount = 0;\nlet roleSkillCount = 0;\nlet developedSkillCount = 0;\nlet developingSkillCount = 0;\nlet notAssessedSkillCount = 0;\n\nconst skills = items.map((item) => {\n  const managerRating = toNumber(item?.ManagerNumericRating);\n  const requiredRating = toNumber(item?.RequiredNumericRating);\n  const criteriaTypeCode = toText(item?.SkillCriteriaTypeCode);\n  const skillType = criteriaTypeCode.includes(\"CORE\") ? \"Core Skill\"  : \"Role Skill\";\n  const groupType = toText(item?.GroupMeaning);\n\n  if (!employeeName) {\n    const candidateName = item?.PersonName ?? item?.DisplayName;\n    if (candidateName !== null && candidateName !== undefined && String(candidateName).trim() !== \"\") {\n      employeeName = String(candidateName);\n    }\n  }\n  if (skillType === \"Core Skill\") coreSkillCount += 1;\n  if (skillType === \"Role Skill\") roleSkillCount += 1;\n  if (groupType === \"Developed Skill\") developedSkillCount += 1;\n  else if (groupType === \"Developing Skill\") developingSkillCount += 1;\n  else notAssessedSkillCount += 1;\n\n  return {\n    skillName: toText(item?.Skill ?? item?.SkillName),\n    skillType: skillType,\n    managerNumericRating: managerRating === null ? \"-\" : String(managerRating),\n    managerRatingDescription: toText(item?.ManagerRatingDescription),\n    requiredNumericRating: requiredRating === null ? \"-\" : String(requiredRating),\n    requiredRatingDescription: toText(item?.RequiredRatingDescription),\n    group: toText(item?.Group),\n    groupMeaning: toText(item?.GroupMeaning),\n  };\n});\n\nreturn {\n  employeeName: employeeName || \"-\",\n  skills: skills,\n  totals: {\n    totalSkillCount: skills.length,\n    coreSkillCount: coreSkillCount,\n    roleSkillCount: roleSkillCount,\n    developedSkillCount: developedSkillCount,\n    developingSkillCount: developingSkillCount,\n    notAssessedSkillCount: notAssessedSkillCount\n  }\n};"
          },
          "outcomes": {
            "success": "9"
          },
          "inputs": [],
          "diagram": {
            "x": 5526.5,
            "y": 5872
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "9",
          "code": "IS_WORKFLOW_MODE",
          "type": "CONDITION",
