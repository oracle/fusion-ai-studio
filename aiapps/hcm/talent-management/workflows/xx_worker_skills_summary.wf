        {
          "id": "1",
          "code": "RESOLVE_APP_PERSON_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Resolve Person ID",
            "description": "Uses triggers.personId for REST workflow runs when supplied, otherwise safely parses OraAppContext or OraUserContext; it never substitutes a fallback employee.",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst rawInputPersonId = $context?.$triggers?.REST?.$input?.personId;\nconst rawContext = $context?.$app?.$OraAppContext;\nconst rawUserContext = $context?.$app?.$OraUserContext;\n\nlet appContext = null;\nlet userContext = null;\n\nif (typeof rawContext === \"string\" && rawContext.trim() !== \"\") {\n  try {\n    appContext = JSON.parse(rawContext);\n  } catch (error) {\n    appContext = null;\n  }\n} else if (rawContext && typeof rawContext === \"object\" && !Array.isArray(rawContext)) {\n  appContext = rawContext;\n}\n\nif (typeof rawUserContext === \"string\" && rawUserContext.trim() !== \"\") {\n  try {\n    userContext = JSON.parse(rawUserContext);\n  } catch (error) {\n    userContext = null;\n  }\n} else if (rawUserContext && typeof rawUserContext === \"object\" && !Array.isArray(rawUserContext)) {\n  userContext = rawUserContext;\n}\n\nconst hasInputPersonId = rawInputPersonId !== null && rawInputPersonId !== undefined && String(rawInputPersonId).trim() !== \"\";\nconst candidate = hasInputPersonId ? rawInputPersonId : appContext?.personId ?? appContext?.PersonId ?? userContext?.userId;\nconst personId = typeof candidate === \"string\" ? candidate.trim() : Number.isSafeInteger(candidate) && candidate >= 0 ? String(candidate) : \"\";\nconst isValid = /^[0-9]{1,20}$/.test(personId);\n\nreturn {\n  personId: isValid ? personId : \"\",\n  isValid,\n  errorMessage: isValid ? \"\" : \"A valid numeric personId input or app/user context is required.\"\n};"
          },
          "outcomes": {
            "success": "2"
          },
          "inputs": [],
          "diagram": {
            "x": 5780,
            "y": 5206
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "2",
          "code": "HAS_VALID_PERSON_ID",
