        {
          "id": "3",
          "code": "GET_PERSON_PUBLIC_SKILLS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Person Public Skills",
            "description": "Retrieves only the selected employee's public skills and the rating, development, and criteria data needed for the summary.",
            "businessObjectCode": "ORA_HCM_TALENT_XX_TEAM_SKILLS_DETAILS",
            "functionName": "Get_Talent_Person_Public_Skills"
          },
          "outcomes": {
