        {
          "id": "1",
          "code": "RESOLVE_APP_PERSON_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Resolve App Person Context",
            "description": "Uses triggers.personId when supplied for REST workflow runs, otherwise parses supported person-context inputs.",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst triggerInput = $context?.$triggers?.REST?.$input || {};\nconst app = $context?.$app || {};\nconst rawInputPersonId = triggerInput.personId ?? triggerInput.PersonId;\nconst rawContext = app.$OraAppContext ?? app.OraAppContext ?? triggerInput.$OraAppContext ?? triggerInput.OraAppContext ?? $context?.$OraAppContext ?? $context?.OraAppContext;\nconst rawUserContext = app.$OraUserContext ?? app.OraUserContext ?? triggerInput.$OraUserContext ?? triggerInput.OraUserContext ?? $context?.$OraUserContext ?? $context?.OraUserContext;\n\nconst parseContext = (value) => {\n  if (typeof value === \"string\" && value.trim() !== \"\") {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return null;\n    }\n  }\n  return value && typeof value === \"object\" && !Array.isArray(value) ? value : null;\n};\n\nconst appContext = parseContext(rawContext);\nconst userContext = parseContext(rawUserContext);\nconst hasInputPersonId = rawInputPersonId !== null && rawInputPersonId !== undefined && String(rawInputPersonId).trim() !== \"\";\nconst candidate = hasInputPersonId ? rawInputPersonId : appContext?.personId ?? appContext?.PersonId ?? userContext?.userId;\nconst personId = typeof candidate === \"string\" ? candidate.trim() : Number.isSafeInteger(candidate) && candidate >= 0 ? String(candidate) : \"\";\nconst isValid = /^[0-9]{1,20}$/.test(personId);\nreturn {\n  personId: isValid ? personId : \"\",\n  isValid,\n  errorMessage: isValid ? \"\" : \"A valid numeric personId input or app/user context is required.\"\n};"
          },
          "outcomes": {
            "success": "2"
          },
