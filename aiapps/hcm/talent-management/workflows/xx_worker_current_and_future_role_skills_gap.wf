            }
          ],
          "diagram": {
            "x": 5000,
            "y": 9202
          },
          "outputSpecification": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"items\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}},\"count\":{\"type\":\"integer\"},\"hasMore\":{\"type\":\"boolean\"},\"limit\":{\"type\":\"integer\"},\"offset\":{\"type\":\"integer\"}},\"additionalProperties\":true}\n"
        },
        {
          "id": "20",
          "code": "ANALYZE_CURRENT_AND_FUTURE_SKILLS_GAP",
          "type": "CODE",
          "metadata": {
            "name": "Analyze Current and Future Skills Gap",
            "description": "Compares current and future role required skills with employee public skills, identifying missing skills and skills below the required manager rating.",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\n\nconst parseResponse = (rawResponse) => {\n  if (typeof rawResponse !== \"string\") return rawResponse || {};\n  try {\n    return JSON.parse(rawResponse);\n  } catch (error) {\n    return {};\n  }\n};\n\nconst getItems = (nodeCode) => {\n  const response = parseResponse($context.$nodes[nodeCode]?.$output);\n  return Array.isArray(response?.items) ? response.items : [];\n};\n\nconst normalize = (value) => value === null || value === undefined ? \"\" : String(value).trim();\nconst normalizeKey = (value) => normalize(value).toLocaleLowerCase();\nconst toNumber = (value) => {\n  const text = typeof value === \"number\" ? String(value) : typeof value === \"string\" ? value.trim() : \"\";\n  if (!/^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$/.test(text)) return null;\n  const numericValue = Number(text);\n  return Number.isFinite(numericValue) && numericValue >= 0 && numericValue <= Number.MAX_SAFE_INTEGER ? numericValue : null;\n};\n\nconst publicSkillsByName = new Map();\ngetItems(\"GET_PERSON_PUBLIC_SKILLS\").forEach((item) => {\n  const skillName = normalize(item?.Skill);\n  const skillKey = normalizeKey(skillName);\n  if (!skillKey) return;\n\n  const managerNumericRating = toNumber(item?.ManagerNumericRating);\n  const existing = publicSkillsByName.get(skillKey);\n  if (!existing || (managerNumericRating !== null && (existing.managerNumericRating === null || managerNumericRating > existing.managerNumericRating))) {\n    publicSkillsByName.set(skillKey, { skillName, managerNumericRating });\n  }\n}); // considering no skill if manager rating is null\n\nconst requiredSkillsForRole = (nodeCode) => {\n  const requiredByName = new Map();\n  getItems(nodeCode).forEach((item) => {\n    const skillName = normalize(item?.SkillName ?? item?.Skill);\n    const skillKey = normalizeKey(skillName);\n    if (!skillKey) return;\n\n    const minimumSkillNumericRating = toNumber(item?.MinimumSkillNumericRating);\n    const existing = requiredByName.get(skillKey);\n    if (!existing || (minimumSkillNumericRating !== null && (existing.minimumSkillNumericRating === null || minimumSkillNumericRating > existing.minimumSkillNumericRating))) {\n      requiredByName.set(skillKey, { skillName, minimumSkillNumericRating });\n    }\n  });\n  return Array.from(requiredByName.values());\n};\n\nconst findSkillGaps = (requiredSkills) => requiredSkills.reduce((gaps, requiredSkill) => {\n  const publicSkill = publicSkillsByName.get(normalizeKey(requiredSkill.skillName));\n  const requiredMinimumRating = requiredSkill.minimumSkillNumericRating;\n\n  if (!publicSkill) {\n    gaps.push({\n      skillName: requiredSkill.skillName,\n      managerNumericRating: \"-\",\n      minimumSkillNumericRating: requiredMinimumRating === null ? \"-\" : requiredMinimumRating,\n      gapType: \"Missing public skill\"\n    });\n  } else if (requiredMinimumRating !== null && publicSkill.managerNumericRating !== null && publicSkill.managerNumericRating < requiredMinimumRating) {\n    gaps.push({\n      skillName: requiredSkill.skillName,\n      managerNumericRating: publicSkill.managerNumericRating,\n      minimumSkillNumericRating: requiredMinimumRating,\n      gapType: \"Manager rating below required minimum\"\n    });\n  }\n\n  return gaps;\n}, []);\n\nconst allRequirementsMeetTargets = (requiredSkills) => requiredSkills.length > 0 && requiredSkills.every((requiredSkill) => {\n  const publicSkill = publicSkillsByName.get(normalizeKey(requiredSkill.skillName));\n  return requiredSkill.minimumSkillNumericRating !== null && publicSkill?.managerNumericRating !== null && publicSkill?.managerNumericRating >= requiredSkill.minimumSkillNumericRating;\n});\n\nconst currentRequiredSkills = requiredSkillsForRole(\"GET_CURRENT_ROLE_REQUIRED_SKILLS\");\nconst futureRequiredSkills = requiredSkillsForRole(\"GET_FUTURE_ROLE_REQUIRED_SKILLS\");\nconst currentJob = $context.$nodes.EXTRACT_CURRENT_JOB_CONTEXT?.$output?.result || {};\nconst futureJob = $context.$nodes.EXTRACT_FUTURE_JOB_PROFILE_ID?.$output?.result || {};\nconst currentSkillGaps = findSkillGaps(currentRequiredSkills);\nconst futureSkillGaps = findSkillGaps(futureRequiredSkills);\nconst hasCurrentRequirements = currentRequiredSkills.length > 0;\nconst hasFutureRole = futureJob.isValid === true;\nconst currentRoleMeetsTargets = allRequirementsMeetTargets(currentRequiredSkills);\nconst futureRoleMeetsTargets = allRequirementsMeetTargets(futureRequiredSkills);\nconst allAvailableRolesMeetTargets = currentRoleMeetsTargets && (!hasFutureRole || futureRoleMeetsTargets);\n\nreturn {\n  currentRole: {\n  roleName: normalize(currentJob.jobName) || \"Current role\",\n  requiredSkills: currentRequiredSkills.map((skill) => skill.skillName),\n  skillGaps: currentSkillGaps,\n  status: !hasCurrentRequirements\n    ? \"unavailable-data\"\n    : currentRoleMeetsTargets\n      ? \"verified-achievement\"\n      : currentSkillGaps.length > 0\n        ? \"skill-gaps\"\n        : \"incomplete-data\",\n  statusMessage: !hasCurrentRequirements\n    ? \"Current-role required skills are unavailable; achievement could not be verified.\"\n    : currentRoleMeetsTargets\n      ? \"All required skills for the current role are at or above the target proficiency level.\"\n      : currentSkillGaps.length === 0\n        ? \"Current-role skill proficiency data is incomplete; achievement could not be verified.\"\n        : \"\"\n},\n  futureRole: hasFutureRole ? {\n    roleName: normalize(futureJob.profileName) || \"Future role\",\n    readinessLevel: normalize(futureJob.readinessLevel) || \"-\",\n    requiredSkills: futureRequiredSkills.map((skill) => skill.skillName),\n    skillGaps: futureSkillGaps,\n    statusMessage: futureRequiredSkills.length === 0 ? \"Required skills are not available for the future role.\" : futureRoleMeetsTargets ? \"All required skills for the future role are at or above the target proficiency level.\" : \"\"\n  } : null,\n  allAvailableRolesMeetTargets,\n  futureRoleUnavailableMessage: hasFutureRole ? \"\" : \"No future role is listed in the talent profile’s advancement readiness.\",\n  employeePublicSkills: Array.from(publicSkillsByName.values()).map((skill) => skill.skillName)\n};\n"
          },
          "outcomes": {
            "success": "31"
          },
          "inputs": [],
          "diagram": {
            "x": 5979.5,
            "y": 9424
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
