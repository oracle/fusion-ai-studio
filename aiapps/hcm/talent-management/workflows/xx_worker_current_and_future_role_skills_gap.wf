        {
          "id": "32",
          "code": "RETURN_CURRENT_AND_FUTURE_SKILLS_GAP_JSON",
          "type": "CODE",
          "metadata": {
            "name": "Return Current and Future Skills Gap JSON",
            "description": "Returns the prepared current and future role skills-gap analysis as structured JSON for REST workflow mode.",
            "returnType": "object",
            "sourceCode": "const gapAnalysis = $context.$nodes.ANALYZE_CURRENT_AND_FUTURE_SKILLS_GAP?.$output?.result;\n\nif (!gapAnalysis || typeof gapAnalysis !== \"object\" || Array.isArray(gapAnalysis)) {\n  throw new Error(\"The current and future role skills-gap analysis could not be prepared.\");\n}\n\nreturn gapAnalysis;"
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
