        {
          "id": "4",
          "code": "EXTRACT_CURRENT_JOB_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Extract Current Job Context",
            "description": "Selects the primary assignment and safely extracts its job name and job code for an exact active-job match.",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst rawResponse = $context.$nodes.GET_CURRENT_ASSIGNMENT_INFORMATION?.$output;\nlet response = rawResponse;\n\nif (typeof rawResponse === \"string\") {\n  try {\n    response = JSON.parse(rawResponse);\n  } catch (error) {\n    response = {};\n  }\n}\n\nconst assignments = Array.isArray(response?.items) ? response.items : [];\nconst assignment = assignments.find((item) => item?.PrimaryFlag === true || item?.PrimaryAssignmentFlag === true) || assignments[0] || {};\nconst jobName = assignment?.JobName === null || assignment?.JobName === undefined ? \"\" : String(assignment.JobName).trim();\nconst jobCode = assignment?.JobCode === null || assignment?.JobCode === undefined ? \"\" : String(assignment.JobCode).trim();\nconst isValid = /^[\\p{L}\\p{M}\\p{N} .,'’()&+\\/#_-]{1,200}$/u.test(jobName) && /^[A-Za-z0-9][A-Za-z0-9._\\/-]{0,79}$/.test(jobCode);\n\nreturn {\n  jobName,\n  jobCode,\n  isValid,\n  errorMessage: isValid ? \"\" : \"The selected person does not have a primary assignment with both a job name and job code.\"\n};"
          },
