        },
        {
          "id": "17",
          "code": "EXTRACT_FUTURE_JOB_PROFILE_ID",
          "type": "CODE",
          "metadata": {
            "name": "Extract Future Job Profile ID",
            "description": "Safely extracts the future job profile ID and available profile name from the most recent advancement readiness record.",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst rawResponse = $context.$nodes.GET_ADVANCEMENT_READINESS?.$output;\nlet response = rawResponse;\nif( typeof rawResponse === \"string\") {\n  try {\n    response = JSON.parse( rawResponse);\n  }\n  catch( error) {\n    response = {};\n  }\n}\nconst readiness = Array.isArray( response?.items) ? response.items[ 0] || {}: {};\nconst profileIdValue = readiness?.JobProfileId;\nconst profileId = profileIdValue === null || profileIdValue === undefined ? \"\" : String( profileIdValue).trim();\nconst profileNameValue = readiness?.JobProfile\nconst readinessLevel = readiness?.ReadinessLevelCode === null || readiness?.ReadinessLevelCode === undefined ? \"\" : String( readiness.ReadinessLevelCode).trim();\nconst isValid = /^[0-9]{1,20}$/.test(profileId);\nreturn {\n  profileId: isValid ? profileId : \"\",\n  profileName: profileNameValue === null || profileNameValue === undefined ? \"\" : String( profileNameValue).trim(),\n  readinessLevel,\n  isValid,\n  errorMessage: isValid ? \"\" : \"No future job profile is available in the selected person's advancement readiness records.\"\n};"
          },
          "outcomes": {
            "success": "18"
          },
          "inputs": [],
          "diagram": {
            "x": 5523.5,
            "y": 8758
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
