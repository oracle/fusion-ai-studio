          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Retrieve Future Role Required Skills",
            "description": "Retrieves the skills required for the job profile identified through the selected person’s advancement readiness.",
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_XX_JOBPROFILEREQUIREMENTS",
            "functionName": "GetRequiredSkillsForJobProfile",
            "sourceCode": ""
          },
          "outcomes": {
