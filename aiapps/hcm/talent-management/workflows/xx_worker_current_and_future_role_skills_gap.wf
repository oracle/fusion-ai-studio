          "type": "CODE",
          "metadata": {
            "name": "Extract Current Job Profile ID",
            "description": "Safely extracts the current job profile ID from the matched job’s model profile relation.",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst rawResponse = $context.$nodes.GET_CURRENT_JOB_PROFILE?.$output;\nlet response = rawResponse;\n\nif (typeof rawResponse === \"string\") {\n  try {\n    response = JSON.parse(rawResponse);\n  } catch (error) {\n    response = {};\n  }\n}\n\nconst relation = Array.isArray(response?.items) ? response.items[0] || {} : {};\nconst profiles = relation?.modelProfile || {};\nconst profile = Array.isArray(profiles?.items) ? profiles.items[0] || {} : {}; \nconst profileId = profile?.ProfileId === null || profile?.ProfileId === undefined ? \"\" : String(profile.ProfileId).trim();\nconst isValid = /^[0-9]{1,20}$/.test(profileId);\n\nreturn {\n  profileId: isValid ? profileId : \"\",\n  profileName: isValid ? String(profile.Name || \"\") : \"\",\n  isValid,\n  errorMessage: isValid ? \"\" : \"No job profile is associated with the selected person's current job.\"\n};"
