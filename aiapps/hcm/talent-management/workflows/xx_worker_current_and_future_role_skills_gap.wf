        {
          "id": "6",
          "code": "MATCH_CURRENT_JOB_BY_NAME_AND_CODE",
          "type": "CODE",
          "metadata": {
            "name": "Match Current Job by Name and Code",
            "description": "Selects the active job whose job name and job code exactly match the selected person’s current assignment.",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst rawResponse = $context.$nodes.SEARCH_CURRENT_ACTIVE_JOBS?.$output;\nlet response = rawResponse;\n\nif (typeof rawResponse === \"string\") {\n  try {\n    response = JSON.parse(rawResponse);\n  } catch (error) {\n    response = {};\n  }\n}\n\nconst currentJob = $context.$nodes.EXTRACT_CURRENT_JOB_CONTEXT?.$output?.result || {};\nconst normalize = (value) => value === null || value === undefined ? \"\" : String(value).trim().toLocaleLowerCase();\nconst expectedName = normalize(currentJob.jobName);\nconst expectedCode = normalize(currentJob.jobCode);\nconst items = Array.isArray(response?.items) ? response.items : [];\nconst match = items.find((item) => normalize(item?.JobName) === expectedName && normalize(item?.JobCode) === expectedCode) || null;\nconst jobId = match?.JobId === null || match?.JobId === undefined ? \"\" : String(match.JobId).trim();\nconst isValid = /^[0-9]{1,20}$/.test(jobId);\nreturn {\n  jobId: isValid ? jobId : \"\",\n  jobName: isValid ? String(match.JobName || \"\") : \"\",\n  jobCode: isValid ? String(match.JobCode || \"\") : \"\",\n  isValid,\n  errorMessage: isValid ? \"\" : \"No active job exactly matches the selected person's current job name and job code.\"\n};"
          },
