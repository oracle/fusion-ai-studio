          "metadata": {
            "name": "Return Worker Skills Details JSON",
            "returnType": "object",
            "sourceCode": "const employeeSkills = $context.$nodes.PREPARE_SKILL_DISPLAY_ROWS.$output.result.skills;\nreturn employeeSkills;"
          },
