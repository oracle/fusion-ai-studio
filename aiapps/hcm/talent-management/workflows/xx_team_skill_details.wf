          "inputs": [
            {
              "id": "1790003396370_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.directReportsSkills != null && typeof $context.$variables.directReportsSkills === \"object\" && !Array.isArray($context.$variables.directReportsSkills) && Object.keys($context.$variables.directReportsSkills).length > 0}}"
            }
          ]
        },
        {
          "id": "1799999990001",
          "code": "SANITIZE_TEAM_SKILLS_FOR_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Remove Identifiers From Query Data",
            "description": "Creates a bounded query-only projection without person, assignment, or raw record identifiers.",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\n          \"Workflow input contains an invalid or oversized string.\"\n        );\n      }\n      continue;\n    }\n\n    if (\n      value === null ||\n      typeof value !== \"object\" ||\n      seen.has(value)\n    ) {\n      continue;\n    }\n\n    seen.add(value);\n\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst source =\n  $context.$nodes.FORMAT_DIRECT_REPORT_SKILL_DETAILS?.$output?.result;\n\nif (!source || typeof source !== \"object\" || Array.isArray(source)) {\n  throw new Error(\n    \"Direct-report skill data is unavailable for query processing.\"\n  );\n}\n\nconst safeResult = Object.create(null);\n\nconst skillNamePattern =\n  /^[\\p{L}\\p{M}\\p{N}.][\\p{L}\\p{M}\\p{N} .,'’()&+\\/#_-]{0,119}$/u;\n\n// Allow underscores in employee names.\nconst employeeNamePattern =\n  /^[\\p{L}\\p{M}\\p{N} _.,'’()&-]{1,160}$/u;\n\nconst safeText = (value, maxLength = 512) => {\n  if (value == null || value === \"\") return \"\";\n\n  if (typeof value !== \"string\" || value.length > maxLength) {\n    throw new Error(\"Direct-report text failed validation.\");\n  }\n\n  return value;\n};\n\nconst safeCount = (value) => {\n  if (!Number.isInteger(value) || value < 0 || value > 1000000) {\n    throw new Error(\"Direct-report count failed validation.\");\n  }\n\n  return value;\n};\n\nfor (const [employeeName, summary] of Object.entries(source)) {\n  if (!employeeNamePattern.test(employeeName)) {\n    throw new Error(\n      \"Employee name contains invalid characters or exceeds \" +\n      `160 characters: ${JSON.stringify(employeeName)}`\n    );\n  }\n\n  const skills = Array.isArray(summary?.skills)\n    ? summary.skills\n    : [];\n\n  safeResult[employeeName] = {\n    employeeName,\n    totalSkills: safeCount(summary?.totalSkills),\n    achievedSkills: safeCount(summary?.achievedSkills),\n    developingSkills: safeCount(summary?.developingSkills),\n\n    coreSkills: {\n      total: safeCount(summary?.coreSkills?.total),\n      achieved: safeCount(summary?.coreSkills?.achieved),\n      developing: safeCount(summary?.coreSkills?.developing)\n    },\n\n    roleSkills: {\n      total: safeCount(summary?.roleSkills?.total),\n      achieved: safeCount(summary?.roleSkills?.achieved),\n      developing: safeCount(summary?.roleSkills?.developing)\n    },\n\n    skills: skills.map((skill) => {\n      const skillName = safeText(skill?.skillName, 120);\n\n      if (skillName && !skillNamePattern.test(skillName)) {\n        throw new Error(\n          `Skill name failed validation: ${JSON.stringify(skillName)}`\n        );\n      }\n\n      return {\n        skillName,\n        skillType: safeText(skill?.skillType, 80),\n        category:\n          skill?.category === \"core\" || skill?.category === \"role\"\n            ? skill.category\n            : \"other\",\n        achieved: skill?.achieved === true,\n        group: safeText(skill?.group, 128),\n        rating: safeText(skill?.rating, 128),\n        requiredRating: safeText(skill?.requiredRating, 128),\n        assignmentSource: safeText(skill?.assignmentSource, 128)\n      };\n    })\n  };\n}\n\nreturn safeResult;"
          },
          "outcomes": {
            "success": "1784704945682"
          },
          "inputs": [],
          "diagram": {
            "x": 5501,
            "y": 7978
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1793082417995",
