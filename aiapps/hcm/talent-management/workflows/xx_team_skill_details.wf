                {
                  "id": "1784704805247",
                  "code": "FETCH_DIRECT_REPORT_SKILLS_WF",
                  "type": "CODE",
                  "metadata": {
                    "name": "Fetch Direct Report Skills WF",
                    "sourceCode": "const data =\n  $context.$nodes.GET_SKILLS_OF_ALL_DIRECT_REPORTS_WF.FETCH_TALENT_PERSON_PUBLIC_SKILLS_WF.$output;\n\nconst items = Array.isArray(data?.items) ? data.items : [];\n\nconst employee =\n  $context.$nodes.GET_SKILLS_OF_ALL_DIRECT_REPORTS_WF.$currentItem;\n\nconst employeeName = employee?.displayName;\n\nif (typeof employeeName !== \"string\" || employeeName.trim() === \"\") {\n  throw new Error(\"Direct report identity is unavailable.\");\n}\n\nconst employeeSkills = {\n  [employeeName]: {\n    PersonId: employee?.personId,\n    Skills: items.reduce((skills, item) => {\n      skills[item.Skill] = {\n        ProfileId: item.ProfileId,\n        ProfileCode: item.ProfileCode,\n        PersonId: item.PersonId,\n        PersonNumber: item.PersonNumber,\n        DisplayName: item.DisplayName,\n        AssignmentName: item.AssignmentName,\n        SkillId: item.SkillId,\n        ContentItemId: item.ContentItemId,\n        Skill: item.Skill,\n        ProficiencyLevelId: item.ProficiencyLevelId,\n        NumericRating: item.NumericRating,\n        RatingName: item.RatingName,\n        RatingDescription: item.RatingDescription,\n        RequiredProficiencyLevelId: item.RequiredProficiencyLevelId,\n        RequiredNumericRating: item.RequiredNumericRating,\n        RequiredRatingDescription: item.RequiredRatingDescription,\n        RequiredFlag: item.RequiredFlag,\n        AssignedByLoggedInPersonFlag: item.AssignedByLoggedInPersonFlag,\n        ConfirmationFlag: item.ConfirmationFlag,\n        Group: item.Group,\n        GroupMeaning: item.GroupMeaning,\n        EndorsementCount: item.EndorsementCount,\n        EndorsementConfirmationFlag: item.EndorsementConfirmationFlag,\n        EndorsementRequestFlag: item.EndorsementRequestFlag,\n        EndorsedFlag: item.EndorsedFlag,\n        RatingModelEnabledFlag: item.RatingModelEnabledFlag,\n        HighestProficiencyLevelFlag: item.HighestProficiencyLevelFlag,\n        EndorsementId: item.EndorsementId,\n        SkillCenterAccessFlag: item.SkillCenterAccessFlag,\n        MarkSkillAsDevelopingFlag: item.MarkSkillAsDevelopingFlag,\n        DomainCode: item.DomainCode,\n        ItemDescription: item.ItemDescription,\n        DomainMeaning: item.DomainMeaning,\n        SkillCriteriaTypeCode: item.SkillCriteriaTypeCode,\n        AssignmentSource: item.AssignmentSource,\n        ManagerEndorsementStatus: item.ManagerEndorsementStatus,\n        ManagerRatingLevelId: item.ManagerRatingLevelId,\n        ManagerNumericRating: item.ManagerNumericRating,\n        ManagerRatingDescription: item.ManagerRatingDescription,\n        SelfEndorsementStatus: item.SelfEndorsementStatus,\n        SelfRatingLevelId: item.SelfRatingLevelId,\n        SelfNumericRating: item.SelfNumericRating,\n        SelfRatingDescription: item.SelfRatingDescription,\n        LastUpdateDate: item.LastUpdateDate,\n        AssignedOn: item.AssignedOn,\n        ConfirmationDate: item.ConfirmationDate,\n        DateAchieved: item.DateAchieved,\n        ManagerId: item.ManagerId,\n        AssignmentSupervisorId: item.AssignmentSupervisorId\n      };\n      return skills;\n    }, {})\n  }\n};\n\nreturn employeeSkills;",
                    "returnType": "object"
