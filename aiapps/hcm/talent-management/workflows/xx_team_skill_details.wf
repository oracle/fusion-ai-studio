        {
          "id": "1784626075201",
          "code": "GET_DIRECT_REPORTS",
          "type": "CODE",
          "metadata": {
            "name": "Get Direct Reports",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\"Workflow input contains an invalid or oversized string.\");\n      }\n      continue;\n    }\n    if (value === null || typeof value !== \"object\" || seen.has(value)) continue;\n    seen.add(value);\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst rawResponse =\n  $context.$nodes.GET_ALL_DIRECT_REPORT_DETAILS?.$output?.output;\n\nlet response;\n\nif (typeof rawResponse === \"string\") {\n  try {\n    response = JSON.parse(rawResponse);\n  } catch (error) {\n    throw new Error(\n      \"invalid data.\"\n    );\n  }\n} else if (\n  rawResponse !== null &&\n  typeof rawResponse === \"object\" &&\n  !Array.isArray(rawResponse)\n) {\n  response = rawResponse;\n} else {\n  throw new Error(\n    \"no valid response object.\"\n  );\n}\n\nif (!Object.prototype.hasOwnProperty.call(response, \"result\")) {\n  throw new Error(\n    \"response is missing result.\"\n  );\n}\n\nreturn response.result;"
          },
          "diagram": {
            "x": 5534,
            "y": 6814
          },
          "outcomes": {
            "success": "1793082417995"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1784633038070",
          "code": "FORMAT_DIRECT_REPORT_SKILL_DETAILS",
          "type": "CODE",
          "metadata": {
            "name": "Format Direct Report Skill Details",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\n          \"Workflow input contains an invalid or oversized string.\"\n        );\n      }\n      continue;\n    }\n\n    if (\n      value === null ||\n      typeof value !== \"object\" ||\n      seen.has(value)\n    ) {\n      continue;\n    }\n\n    seen.add(value);\n\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst input =\n  $context?.$nodes?.GET_SKILLS_OF_ALL_DIRECT_REPORTS?.$output;\n\nfunction parseMaybeJson(value) {\n  if (value == null) return null;\n\n  let parsed = value;\n\n  while (typeof parsed === \"string\") {\n    const text = parsed.trim();\n\n    if (!text) return null;\n\n    // Only try parsing strings that look like JSON.\n    const looksLikeJson =\n      (text.startsWith(\"{\") && text.endsWith(\"}\")) ||\n      (text.startsWith(\"[\") && text.endsWith(\"]\")) ||\n      (text.startsWith('\"') && text.endsWith('\"'));\n\n    if (!looksLikeJson) {\n      return null;\n    }\n\n    try {\n      parsed = JSON.parse(text);\n    } catch (error) {\n      return null;\n    }\n  }\n\n  return parsed;\n}\n\nfunction normalizeInputs(input) {\n  const parsed = parseMaybeJson(input);\n\n  if (!parsed) return [];\n\n  if (Array.isArray(parsed)) {\n    return parsed.flatMap(item => {\n      const inner = parseMaybeJson(item);\n\n      if (!inner) return [];\n\n      return Array.isArray(inner?.directReportsSkills)\n        ? inner.directReportsSkills\n        : inner?.result\n          ? [inner]\n          : [];\n    });\n  }\n\n  if (Array.isArray(parsed?.directReportsSkills)) {\n    return parsed.directReportsSkills;\n  }\n\n  if (parsed?.result && typeof parsed.result === \"object\") {\n    return [parsed];\n  }\n\n  return [];\n}\n\nfunction buildEmployeeSkillReport() {\n  const items = normalizeInputs(input);\n\n  if (items.length === 0) {\n    throw new Error(\"No valid skills data found.\");\n  }\n\n  const output = Object.create(null);\n\n  for (const item of items) {\n    const result = item?.result || {};\n\n    for (const [employeeName, employeeData] of Object.entries(result)) {\n      // Underscores are allowed. Keep the hyphen at the end.\n      if (!/^[\\p{L}\\p{M}\\p{N} _.,'’()&-]{1,160}$/u.test(employeeName)) {\n        throw new Error(\n          \"Employee name contains invalid characters or exceeds \" +\n          `160 characters: ${JSON.stringify(employeeName)}`\n        );\n      }\n\n      const skillsMap = employeeData?.Skills || {};\n      const skills = Object.values(skillsMap);\n\n      const rawPersonId =\n        employeeData?.PersonId ?? skills[0]?.PersonId;\n\n      const personId =\n        rawPersonId === null || rawPersonId === undefined\n          ? \"\"\n          : String(rawPersonId).trim();\n\n      if (!/^[0-9]{1,20}$/.test(personId)) {\n        throw new Error(\"Direct-report person ID failed validation.\");\n      }\n\n      const summary = {\n        employeeName,\n        personId,\n        assignmentName: skills[0]?.AssignmentName || null,\n        totalSkills: skills.length,\n        achievedSkills: 0,\n        developingSkills: 0,\n        coreSkills: {\n          total: 0,\n          achieved: 0,\n          developing: 0\n        },\n        roleSkills: {\n          total: 0,\n          achieved: 0,\n          developing: 0\n        },\n        skills: []\n      };\n\n      for (const skill of skills) {\n        const isRoleSkill =\n          skill.SkillCriteriaTypeCode === \"ORA_JOB_ROLE\";\n\n        const isAchieved =\n          Boolean(skill.DateAchieved) ||\n          skill.Group === \"ORA_DEVELOPED\";\n\n        if (isAchieved) {\n          summary.achievedSkills++;\n        } else {\n          summary.developingSkills++;\n        }\n\n        const category = isRoleSkill\n          ? summary.roleSkills\n          : summary.coreSkills;\n\n        category.total++;\n\n        if (isAchieved) {\n          category.achieved++;\n        } else {\n          category.developing++;\n        }\n\n        summary.skills.push({\n          skillName: skill.Skill,\n          skillType: skill.SkillCriteriaTypeCode,\n          category: isRoleSkill ? \"role\" : \"core\",\n          achieved: isAchieved,\n          group: skill.Group,\n          rating: skill.RatingName,\n          requiredRating: skill.RequiredRatingDescription,\n          assignmentSource: skill.AssignmentSource,\n          dateAchieved: skill.DateAchieved\n        });\n      }\n\n      output[employeeName] = summary;\n    }\n  }\n\n  return output;\n}\n\nreturn buildEmployeeSkillReport();"
          },
          "diagram": {
            "x": 5501,
            "y": 7756
          },
          "outcomes": {
            "success": "1799999990001"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
