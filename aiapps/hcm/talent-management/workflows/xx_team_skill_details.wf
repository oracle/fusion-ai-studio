          "type": "LOOP",
          "metadata": {
            "name": "Get Skills of All Direct Reports",
            "dataPipeline": {
              "rootNode": "start_1793082417995",
              "pipelineNodes": [
                {
                  "id": "start_1793082417995",
                  "code": "START",
                  "type": "START",
                  "metadata": {
                    "description": "Start of data pipeline",
                    "name": "Start"
