          "outputSpecification": "<oraInfoDisplay key=\"list\">\n{\n  \"title\": \"Skills Summary\",\n  \"patternId\": \"multiRecordWidget\",\n  \"description\": \"Employee skill achievement, learning, and assignment counts.\",\n  \"properties\": {\n    \"subtitle\": \"Role and Core Skills\",\n    \"cols\": [\n      \"Skill Name\",\n      \"Skill Category\",\n      \"Skilled Employees Count\",\n      \"Learning Employees Count\",\n      \"Assigned Employees Count\"\n    ],\n    \"rows\": [\n      {\n        \"cells\": [\"Flask Web Development\", \"Core\", 0, 4, 4],\n        \"drillDownAction\": \"ora.Invoke(\\\"openSkillDetails\\\", { \\\"SkillName\\\":\\\"Flask Web Development\\\" })\"\n      }\n    ]\n  }\n}\n</oraInfoDisplay>\n\n<oraInfoDisplay key=\"contextual-role-skills\">\n{\n  \"title\": \"Role Skills\",\n  \"patternId\": \"chartWidget\",\n  \"description\": \"Skilled and learning employee counts by role skill.\",\n  \"properties\": {\n    \"type\": \"bar\",\n    \"data\": {\n      \"labels\": [],\n      \"datasets\": [\n        {\n          \"label\": \"Skilled Employees Count\",\n          \"data\": []\n        },\n        {\n          \"label\": \"Learning Employees Count\",\n          \"data\": []\n        }\n      ]\n    },\n    \"insights\": []\n  }\n}\n</oraInfoDisplay>\n\n<oraInfoDisplay key=\"contextual-core-skills\">\n{\n  \"title\": \"Core Skills\",\n  \"patternId\": \"chartWidget\",\n  \"description\": \"Skilled and learning employee counts by core skill.\",\n  \"properties\": {\n    \"type\": \"bar\",\n    \"data\": {\n      \"labels\": [],\n      \"datasets\": [\n        {\n          \"label\": \"Skilled Employees Count\",\n          \"data\": []\n        },\n        {\n          \"label\": \"Learning Employees Count\",\n          \"data\": []\n        }\n      ]\n    },\n    \"insights\": []\n  }\n}\n</oraInfoDisplay>"
        },
