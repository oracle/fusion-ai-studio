        {
          "id": "1784791280302",
          "code": "HIGHEST_AND_LOWEST_ACHIEVED_SKILLS",
          "type": "CODE",
          "metadata": {
            "name": "Highest and Lowest Achieved Skills",
            "returnType": "object",
            "sourceCode": "(function validateWorkflowContextStrings(root) {\n  const stack = [[root, 0]];\n  const seen = new WeakSet();\n  let inspected = 0;\n  const safeString = /^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$/u;\n\n  while (stack.length > 0) {\n    const [value, depth] = stack.pop();\n    inspected += 1;\n\n    if (inspected > 100000 || depth > 64) {\n      throw new Error(\"Workflow input exceeds validation limits.\");\n    }\n\n    if (typeof value === \"string\") {\n      if (value.length > 1048576 || !safeString.test(value)) {\n        throw new Error(\n          \"Workflow input contains an invalid or oversized string.\"\n        );\n      }\n      continue;\n    }\n\n    if (value === null || typeof value !== \"object\" || seen.has(value)) {\n      continue;\n    }\n\n    seen.add(value);\n\n    for (const key of Object.keys(value)) {\n      stack.push([key, depth + 1]);\n      stack.push([value[key], depth + 1]);\n    }\n  }\n})($context);\n\nconst lowestRoleSkills =\n  $context.$nodes.FETCH_LOWEST_ROLE_SKILLS_ACHIEVED.$output;\n\nconst lowestCoreSkills =\n  $context.$nodes.FETCH_LOWEST_CORE_SKILLS_ACHIEVED.$output;\n\nconst highestRoleSkills =\n  $context.$nodes.FETCH_HIGHEST_ROLE_SKILLS_ACHIEVED.$output;\n\nconst highestCoreSkills =\n  $context.$nodes.FETCH_HIGHEST_CORE_SKILLS_ACHIEVED.$output;\n\nconst skillCount = 2;\n\nfunction toCount(value) {\n  if (typeof value === \"number\") {\n    return Number.isSafeInteger(value) && value >= 0 ? value : 0;\n  }\n\n  if (typeof value !== \"string\") return 0;\n\n  const text = value.trim();\n  if (!/^\\d+$/.test(text)) return 0;\n\n  const count = Number(text);\n  return Number.isSafeInteger(count) ? count : 0;\n}\n\nfunction normalizeInput(value) {\n  if (!value) return {};\n\n  if (typeof value === \"string\") {\n    try {\n      return normalizeInput(JSON.parse(value));\n    } catch (error) {\n      return {};\n    }\n  }\n\n  if (value.result !== undefined) {\n    return normalizeInput(value.result);\n  }\n\n  if (value.output !== undefined) {\n    return normalizeInput(value.output);\n  }\n\n  return value;\n}\n\nfunction getSkills(value, direction, count = skillCount) {\n  const data = normalizeInput(value);\n  const items = Array.isArray(data?.items) ? data.items : [];\n\n  return items\n    .map((item) => ({\n      skillName: item.SkillName || \"\",\n      skillId: item.SkillId ?? null,\n      achievedCount: toCount(item.AchievedCount),\ndevelopingCount: toCount(item.DevelopingCount),\ntotalCount: toCount(item.TotalCount),\n      achievedPerson: item.AchievedPerson || [],\n      developingPerson: item.DevelopingPerson || []\n    }))\n    .filter((item) => {\n      return direction === \"highest\"\n        ? item.achievedCount > 0\n        : item.developingCount > 0;\n    })\n    .sort((a, b) => {\n      const achievedDifference =\n        direction === \"highest\"\n          ? b.achievedCount - a.achievedCount\n          : a.achievedCount - b.achievedCount;\n\n      return achievedDifference || b.totalCount - a.totalCount;\n    })\n    .slice(0, count);\n}\n\nreturn {\n  lowestAchieved: {\n    coreSkills: getSkills(lowestCoreSkills, \"lowest\"),\n    roleSkills: getSkills(lowestRoleSkills, \"lowest\")\n  },\n  highestAchieved: {\n    roleSkills: getSkills(highestRoleSkills, \"highest\"),\n    coreSkills: getSkills(highestCoreSkills, \"highest\")\n  }\n};",
            "sourceType": "code"
          },
          "diagram": {
