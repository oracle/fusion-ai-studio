    "tools": [
      {
        "name": "personSkillDetailsSearches",
        "description": "Gets skill details that match the specified criteria for people who are developing or have achieved those skills.",
        "operationType": "POST",
        "resourcePath": "/hcmRestApi/redwood/11.13.18.05/personSkillDetailsSearches",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n  \"filters\": [\n    { \"name\": \"SkillType\", \"value\": \"{skillType}\" },\n    { \"name\": \"ManagerId\", \"value\": \"{managerId}\" },\n    { \"name\": \"Reports\", \"value\": \"{reportsType}\" },\n    { \"name\": \"SkillName\", \"terms\": {skillName} }\n  ],\n  \"limit\": \"{limit}\",\n  \"offset\": \"{offset}\",\n  \"sort\": [{ \"name\": \"{sortAttributeName}\", \"direction\": \"{sortDirection}\" }]\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "skillType",
            "dataType": "string",
            "description": "Ways to categorize skills. Valid values are Core, Role, Other, All.",
            "id": 2,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "managerId",
            "dataType": "integer",
            "description": "Unique identifier of the manager.",
            "id": 3,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "reportsType",
            "dataType": "string",
            "description": "Identifies the level of subordinates in the manager hierarchy. Valid values are directs, all.",
            "id": 4,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "skillName",
            "dataType": "string",
