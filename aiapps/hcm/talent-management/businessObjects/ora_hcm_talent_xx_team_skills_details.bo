  "name": "Team Skills Details",
  "description": "Retrieves team skill counts, worker public skills, skill descriptions, and skill aggregations using supplied person, manager, and skill identifiers.",
  "objectCode": "ORA_HCM_TALENT_XX_TEAM_SKILLS_DETAILS",
  "family": "HCM",
  "product": "TALENT",
  "objectSource": "ADF_BC",
  "restResourcePath": "/hcmRestApi",
  "restResourceIdentifier": "-1",
  "seededFlag": false,
  "mandatoryFlag": false,
  "objectProperties": {
    "jsonSchemaName": "supportedObjectProperties",
    "jsonSchemaVersion": 1,
    "tools": [
      {
        "name": "Skills_In_Team",
        "description": "Retrieves skill names and IDs with achieved, developing, and total counts for the specified manager and skill type, ordered by achieved count in the requested direction and limited to the specified number of skills.",
        "operationType": "POST",
        "resourcePath": "/hcmRestApi/redwood/11.13.18.05/teamSkillsSearches",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n  \"limit\": {limit},\n  \"offset\": 0,\n  \"sort\": [\n    {\n      \"name\": \"AchievedCount\",\n      \"direction\": \"{AchievedCountDirection}\"\n    }\n  ],\n  \"filters\": [\n    {\n      \"name\": \"SkillType\",\n      \"value\": \"{SkillType}\"\n    },\n    {\n      \"name\": \"Reports\",\n      \"value\": \"all\"\n    },\n    {\n      \"name\": \"ManagerId\",\n      \"value\": \"{ManagerId}\"\n    }\n  ]\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "limit",
            "dataType": "string",
            "description": "Maximum number of skill-summary records to return.",
            "id": 2,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "AchievedCountDirection",
            "dataType": "string",
            "description": "Sort direction for AchievedCount: ASC for the lowest counts or DESC for the highest counts.",
            "id": 3,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "SkillType",
            "dataType": "string",
            "description": "Skill category to include: Core or Role.",
            "id": 4,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "ManagerId",
            "dataType": "string",
            "description": "HCM person ID of the manager whose reporting population's skill counts should be returned.",
            "id": 5,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
        "sampleQueries": [
          {
            "description": "Example response containing team skill counts. All scalar values are placeholders; no sample data is included.",
            "query": {
              "totalResults": "<total_results>",
              "offset": "<offset>",
              "hasMore": "<has_more>",
              "limit": "<limit>",
              "count": "<count>",
              "items": [
                {
                  "SkillName": "<skill_name>",
                  "SkillId": "<skill_id>",
                  "AchievedCount": "<achieved_count>",
                  "DevelopingCount": "<developing_count>",
                  "TotalCount": "<total_count>"
                }
              ],
              "query": "<query>"
            },
            "sampleType": "response"
          }
        ]
      },
      {
        "name": "Person_Skills_In_Team",
        "description": "Retrieves up to 10 direct reports for the specified manager and skill type, with each worker's name, person ID, assignment name, and achieved, developing, and total skill counts, ordered by achieved count in the requested direction.",
        "operationType": "POST",
        "resourcePath": "/hcmRestApi/resources/11.13.18.05/personSkillsSearches",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n  \"limit\": 10,\n  \"offset\": 0,\n  \"sort\": [\n    {\n      \"name\": \"AchievedCount\",\n      \"direction\": \"{AchievedCountDirection}\"\n    }\n  ],\n  \"filters\": [\n    {\n      \"name\": \"SkillType\",\n      \"value\": \"{SkillType}\"\n    },\n    {\n      \"name\": \"Reports\",\n      \"value\": \"all\"\n    },\n    {\n       \"name\": \"HasAttainment\",\n       \"value\": \"true\"\n    },\n    {\n      \"name\": \"ManagerId\",\n      \"value\": \"{ManagerId}\"\n    }\n  ]\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "AchievedCountDirection",
            "dataType": "string",
            "description": "Sort direction for AchievedCount: ASC for the lowest counts or DESC for the highest counts.",
