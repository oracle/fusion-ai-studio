              "limit": "<limit>",
              "offset": "<offset>"
            },
            "sampleType": "response"
          }
        ]
      },
      {
        "name": "Get_Direct_Person_Skill_Details",
        "description": "Retrieves skill details for the specified skill type and name among the direct reports of the manager with the specified person ID, including worker names, assignment names, achieved and required skill levels, and endorsement counts.",
        "operationType": "POST",
        "resourcePath": "/hcmRestApi/redwood/11.13.18.05/personSkillDetailsSearches",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n  \"limit\": 25,\n  \"offset\": 0,\n  \"sort\": [\n    {\n      \"name\": \"AchievedLevel\",\n      \"direction\": \"desc\"\n    }\n  ],\n  \"filters\": [\n    {\n      \"name\": \"SkillType\",\n      \"value\": \"{SkillType}\"\n    },\n    {\n      \"name\": \"Reports\",\n      \"value\": \"directs\"\n    },\n    {\n      \"name\": \"ManagerId\",\n      \"value\": {ManagerPersonId}\n    },\n    {\n      \"name\": \"SkillName\",\n      \"terms\": [\n        \"{SkillName}\"\n      ]\n    }\n  ]\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "SkillType",
            "dataType": "string",
            "description": "Skill category used to filter direct-report skill results.",
            "id": 19,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "ManagerPersonId",
            "dataType": "string",
            "description": "HCM person ID of the manager whose direct reports should be searched.",
            "id": 20,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "SkillName",
            "dataType": "string",
            "description": "Skill name used to filter direct-report skill results.",
            "id": 21,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
