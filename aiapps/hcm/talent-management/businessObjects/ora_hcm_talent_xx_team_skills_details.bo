      {
        "name": "Get_Team_Skills_Aggregations",
        "description": "Retrieves achieved, developing, and total counts for each skill in the reporting population of the manager with the specified person ID.",
        "operationType": "POST",
        "resourcePath": "/hcmRestApi/redwood/11.13.18.05/teamSkillsAggregations",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n  \"finder\": {\n    \"name\": \"GetSkillsSummary\",\n    \"parameters\": [\n      {\"name\": \"Reports\", \"value\": \"All\"},\n      {\"name\": \"ManagerId\", \"value\": \"{ManagerPersonId}\"}\n    ]\n  }\n}",
        "useNativeAuthentication": false,
        "customAuthenticationHeader": "application/json",
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "ManagerPersonId",
            "dataType": "string",
            "description": "HCM person ID of the manager whose reporting-population skill counts should be returned.",
